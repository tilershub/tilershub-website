---
export const prerender = true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>You're Offline · TilersHub</title>
  <meta name="theme-color" content="#1B3A6B" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0F2444;
      color: #fff;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 20px;
      text-align: center;
    }
    .icon { font-size: 64px; margin-bottom: 20px; }
    h1 { font-size: 24px; font-weight: 700; margin-bottom: 10px; }
    p { font-size: 15px; color: rgba(255,255,255,0.65); line-height: 1.7; max-width: 320px; margin-bottom: 28px; }
    .btn {
      display: inline-flex; align-items: center; gap: 6px;
      background: #E05A2B; color: #fff; text-decoration: none;
      padding: 12px 28px; border-radius: 12px; font-size: 15px; font-weight: 700;
    }
    .logo { font-size: 13px; font-weight: 800; letter-spacing: 2px; color: rgba(255,255,255,0.35); margin-top: 40px; }
  </style>
</head>
<body>
  <div class="icon">📡</div>
  <h1>You're offline</h1>
  <p>Check your internet connection and try again. Some pages may be available from your cache.</p>
  <a class="btn" href="/" onclick="location.reload()">Try Again</a>
  <div class="logo">TILERSHUB</div>
</body>
</html>
