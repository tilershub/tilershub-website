---
// Legacy /job?id=<uuid> URLs 301 to the canonical /jobs/<slug>-<uuid> path.
export const prerender = false
import { jobPath } from '../lib/jobs.js'

const id = Astro.url.searchParams.get('id')
if (!id) return Astro.redirect('/jobs', 302)

const { data: job } = await Astro.locals.supabase
  .from('projects')
  .select('id,project_type,city,district')
  .eq('id', id)
  .single()

if (!job) return Astro.redirect('/jobs', 302)
return Astro.redirect(jobPath(job), 301)
---
