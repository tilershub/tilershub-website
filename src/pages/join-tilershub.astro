---
import Layout from '../layouts/Layout.astro'
import JoinForm from '../components/JoinForm.jsx'
---

<Layout
  title="Join TilersHub as a Provider · Free Listing"
  description="Join TilersHub and get discovered by homeowners across Sri Lanka. Free listing for tilers, workshops, suppliers and contractors."
>

  <!-- Header -->
  <div style="background:var(--navy);padding:48px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <a href="/" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:rgba(255,255,255,0.4);letter-spacing:1px;text-transform:uppercase;font-weight:600;margin-bottom:24px;text-decoration:none;">← TilersHub</a>
      <div style="font-size:9px;font-weight:700;color:rgba(37,211,102,0.7);letter-spacing:3px;text-transform:uppercase;margin-bottom:14px;">Free · No Commission</div>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin-bottom:12px;line-height:1.2;">
        Join <span style="color:var(--terra);">TilersHub</span> as a Provider
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:440px;margin:0 auto;line-height:1.9;">
        Get listed for free — homeowners across Sri Lanka will find you. Direct WhatsApp leads, no middlemen.
      </p>
    </div>
  </div>

  <!-- Benefits -->
  <div style="background:var(--surface-2);border-bottom:1px solid var(--border);padding:24px 20px;">
    <div style="max-width:780px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:16px;text-align:center;">
      {[
        { icon: '✓', title: 'Free Listing', text: 'Always free, no hidden fees' },
        { icon: '💬', title: 'Direct Leads', text: 'Customers contact you via WhatsApp' },
        { icon: '🚫', title: 'No Commission', text: '100% of your earnings are yours' },
        { icon: '🏷️', title: 'Get Verified', text: 'Earn the TH Verified badge' },
      ].map(b => (
        <div style="padding:14px 10px;">
          <div style="font-size:20px;margin-bottom:6px;">{b.icon}</div>
          <div style="font-size:13px;font-weight:700;color:var(--text);margin-bottom:3px;">{b.title}</div>
          <div style="font-size:11px;color:var(--text-3);">{b.text}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Form -->
  <section style="background:var(--surface);padding:48px 20px 64px;">
    <JoinForm client:load />
  </section>

</Layout>
