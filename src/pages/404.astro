---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Page Not Found · TilersHub"
  description="The page you're looking for doesn't exist. Find tilers, workshops and tile brands on TilersHub."
>
  <div style="background:var(--surface);min-height:60vh;display:flex;align-items:center;justify-content:center;padding:60px 20px;">
    <div style="max-width:480px;text-align:center;">
      <div style="font-size:72px;margin-bottom:16px;">🔲</div>
      <div style="font-size:11px;font-weight:700;color:var(--terra);letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;">404 · Not Found</div>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,38px);font-weight:700;color:var(--text);margin-bottom:14px;line-height:1.2;">
        මෙම ටයිලය <em style="color:var(--terra);font-style:normal;">නොමැත</em>
      </h1>
      <p style="font-size:14px;color:var(--text-3);line-height:1.8;margin-bottom:32px;">
        ඔබ සොයන පිටුව නොමැත හෝ ස්ථානය වෙනස් කර ඇත. ටයිලිං වෘත්තිකයන් සොයා ගැනීමට ආපසු යමු.
      </p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/" class="btn btn-navy btn-lg">🏠 මුල් පිටුව</a>
        <a href="/providers" class="btn btn-outline btn-lg">👷 ටයිලර් සොයන්න</a>
      </div>
      <div style="margin-top:32px;display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/estimator" style="font-size:13px;color:var(--text-3);text-decoration:none;display:flex;align-items:center;gap:5px;">📐 ගාස්තු ගණනය</a>
        <a href="/brands" style="font-size:13px;color:var(--text-3);text-decoration:none;display:flex;align-items:center;gap:5px;">🏷️ ටයිල් බ්‍රෑන්ඩ්</a>
        <a href="/post-project" style="font-size:13px;color:var(--text-3);text-decoration:none;display:flex;align-items:center;gap:5px;">📋 ව්‍යාපෘතිය පල කරන්න</a>
      </div>
    </div>
  </div>
</Layout>
