---
import Layout from '../layouts/Layout.astro'
import ExploreApp from '../components/ExploreApp.jsx'
---

<Layout title="ටයිලර් සොයන්න · TilersHub">

  <!-- Page header -->
  <div style="background: var(--charcoal); position: relative; overflow: hidden; padding: 52px 28px 48px; text-align: center;">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(193,96,58,0.6) 39px, rgba(193,96,58,0.6) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(193,96,58,0.6) 39px, rgba(193,96,58,0.6) 40px); pointer-events: none;"></div>
    <div style="position: absolute; top: -80px; left: 50%; transform: translateX(-50%); width: 500px; height: 300px; background: radial-gradient(ellipse, rgba(193,96,58,0.1) 0%, transparent 70%); pointer-events: none;"></div>
    <div style="position: relative;">
      <span class="section-tag" style="border-color: rgba(193,96,58,0.3); color: var(--terracotta-muted);">ටයිලර් සොයන්න</span>
      <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(26px, 5vw, 44px); color: var(--white); font-weight: 700; margin: 12px 0 12px; line-height: 1.15;">
        දක්ෂ <span style="color: var(--terracotta);">ටයිලර්වරුන්</span> සොයා ගන්න
      </h1>
      <p style="font-size: 14px; color: rgba(245,240,232,0.42); max-width: 440px; margin: 0 auto 24px; line-height: 1.9;">
        ශ්‍රී ලංකාව පුරා ටයිල් ප්‍රවීණයන් WhatsApp හරහා කෙලින්ම සම්බන්ධ වෙන්න
      </p>
      <div style="display: inline-flex; gap: 0; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; overflow: hidden;">
        {[
          { n: '500+', l: 'ටයිලර්' },
          { n: '25', l: 'දිස්ත්‍රික්ක' },
          { n: 'නොමිලේ', l: 'සේවාව' },
        ].map((s, i, arr) => (
          <div style={`text-align: center; padding: 10px 22px; border-right: ${i < arr.length - 1 ? '1px solid rgba(255,255,255,0.06)' : 'none'};`}>
            <div style="font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: var(--terracotta);">{s.n}</div>
            <div style="font-size: 10px; color: rgba(245,240,232,0.3); margin-top: 2px;">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══ LUXEHOME PREMIUM PROVIDER ═══ -->
  <div style="background: linear-gradient(180deg, #0e0b06 0%, #120e08 100%); padding: 28px 28px 0; border-bottom: 1px solid rgba(212,175,55,0.12);">
    <div style="max-width: 1100px; margin: 0 auto;">

      <!-- Label row -->
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
        <div style="height: 1px; flex: 1; background: rgba(212,175,55,0.15);"></div>
        <span style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.55); letter-spacing: 3px; text-transform: uppercase; white-space: nowrap;">◆ Premium Provider</span>
        <div style="height: 1px; flex: 1; background: rgba(212,175,55,0.15);"></div>
      </div>

      <!-- Main card -->
      <div style="background: linear-gradient(135deg, #1a1408 0%, #261c0c 50%, #1a1408 100%); border-radius: 20px; border: 1px solid rgba(212,175,55,0.18); overflow: hidden; margin-bottom: 28px; box-shadow: 0 8px 40px rgba(0,0,0,0.4), 0 0 0 1px rgba(212,175,55,0.06);">

        <!-- Top section: brand + headline -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; padding: 28px 32px 20px;">
          <div style="display: flex; align-items: center; gap: 20px;">
            <!-- Logo block -->
            <div style="display: flex; align-items: baseline; gap: 2px; flex-shrink: 0;">
              <span style="font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #D4AF37; letter-spacing: -0.5px; line-height: 1;">LUXE</span>
              <span style="font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 400; color: rgba(255,255,255,0.88); letter-spacing: -0.5px; line-height: 1;">home</span>
            </div>
            <div style="width: 1px; height: 32px; background: rgba(212,175,55,0.2); flex-shrink: 0;"></div>
            <div>
              <div style="font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 2px;">Sri Lanka's Premium Tile Supplier</div>
              <div style="font-size: 11px; color: rgba(255,255,255,0.35);">Bathroom · Floor · Staircase · Anti-slip certified · Free islandwide delivery</div>
            </div>
          </div>
          <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 8px; background: #D4AF37; color: #0c0804; border-radius: 10px; padding: 10px 20px; font-size: 12px; font-weight: 800; text-decoration: none; letter-spacing: 0.3px; white-space: nowrap; box-shadow: 0 4px 16px rgba(212,175,55,0.3); flex-shrink: 0;">
            🌐 Visit luxehome.lk
          </a>
        </div>

        <!-- Divider -->
        <div style="height: 1px; background: rgba(212,175,55,0.1); margin: 0 32px;"></div>

        <!-- Service cards row -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0;">

          <!-- Bathroom -->
          <a href="/sponsor/luxehome" style="display: block; text-decoration: none; padding: 22px 28px; border-right: 1px solid rgba(212,175,55,0.08); transition: background 0.2s;" onmouseover="this.style.background='rgba(212,175,55,0.04)'" onmouseout="this.style.background='transparent'">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
              <div style="width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #261c0c, #3a2a10); border: 1px solid rgba(212,175,55,0.2); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">🚿</div>
              <div>
                <div style="font-size: 13px; font-weight: 700; color: #D4AF37; line-height: 1.2;">Bathroom Renovation</div>
                <div style="font-size: 10px; color: rgba(255,255,255,0.3); margin-top: 2px;">Wall & floor tile packages</div>
              </div>
            </div>
            <p style="font-size: 11px; color: rgba(255,255,255,0.35); line-height: 1.7; margin-bottom: 10px;">Premium anti-slip certified tiles. Complete renovation packages with free islandwide delivery above Rs. 50,000.</p>
            <span style="font-size: 11px; font-weight: 700; color: rgba(212,175,55,0.7); letter-spacing: 0.3px;">View Collections →</span>
          </a>

          <!-- Floor -->
          <a href="/sponsor/luxehome-floor" style="display: block; text-decoration: none; padding: 22px 28px; border-right: 1px solid rgba(212,175,55,0.08); transition: background 0.2s;" onmouseover="this.style.background='rgba(193,96,58,0.05)'" onmouseout="this.style.background='transparent'">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
              <div style="width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #2c1a0e, #3c2412); border: 1px solid rgba(193,96,58,0.2); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">🏠</div>
              <div>
                <div style="font-size: 13px; font-weight: 700; color: #C1603A; line-height: 1.2;">Floor Tiling</div>
                <div style="font-size: 10px; color: rgba(255,255,255,0.3); margin-top: 2px;">Large format · Herringbone · Classic</div>
              </div>
            </div>
            <p style="font-size: 11px; color: rgba(255,255,255,0.35); line-height: 1.7; margin-bottom: 10px;">Rectified edges for near-zero grout lines. From marble classics to bold contemporary styles.</p>
            <span style="font-size: 11px; font-weight: 700; color: rgba(193,96,58,0.7); letter-spacing: 0.3px;">View Floor Tiles →</span>
          </a>

          <!-- Staircase -->
          <a href="/sponsor/luxehome-staircase" style="display: block; text-decoration: none; padding: 22px 28px; transition: background 0.2s;" onmouseover="this.style.background='rgba(138,184,212,0.04)'" onmouseout="this.style.background='transparent'">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
              <div style="width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #0d1218, #182030); border: 1px solid rgba(138,184,212,0.2); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">🪜</div>
              <div>
                <div style="font-size: 13px; font-weight: 700; color: #8AB8D4; line-height: 1.2;">Staircase Tiling</div>
                <div style="font-size: 10px; color: rgba(255,255,255,0.3); margin-top: 2px;">Anti-slip tread · Premium risers</div>
              </div>
            </div>
            <p style="font-size: 11px; color: rgba(255,255,255,0.35); line-height: 1.7; margin-bottom: 10px;">R11-rated anti-slip tread tiles with beautifully matched risers. Precision cut to your measurements.</p>
            <span style="font-size: 11px; font-weight: 700; color: rgba(138,184,212,0.7); letter-spacing: 0.3px;">View Staircase →</span>
          </a>

        </div>
      </div>

    </div>
  </div>

  <!-- Interactive explore app (React island) -->
  <ExploreApp client:only="react" />

</Layout>
