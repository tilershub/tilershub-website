                <div style="font-size:16px;font-weight:700;color:#7c3aed;">Rs.{tiler.daily_rate_min}–{tiler.daily_rate_max || '?'}</div>
                <div style="font-size:10px;color:#94a3b8;margin-top:3px;font-weight:600;">Per sq.ft</div>
