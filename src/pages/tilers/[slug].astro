          <div style="height:1px;background:#e2e8f0;margin-bottom:14px;"></div>
          <div style="font-size:12px;color:#64748b;line-height:1.8;">
            <div>📍 Based in <strong style="color:#374151;">{city}</strong></div>
            {tiler.district && tiler.district !== tiler.city && (
              <div>🗺️ {tiler.district} District</div>
