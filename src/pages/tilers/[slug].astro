---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase.js'

export async function getStaticPaths() {
  const { data: tilers } = await supabase
    .from('tilers')
    .select('id,slug')
    .eq('featured', true)
    .not('slug', 'is', null)
  const paths = []
  for (const t of tilers || []) {
    paths.push({ params: { slug: t.slug }, props: { lookupSlug: t.slug } })
  }
  return paths
}

const { slug } = Astro.params
const { lookupSlug } = Astro.props

const { data: tiler } = await supabase
  .from('tilers')
  .select('*')
  .eq('slug', lookupSlug)
  .single()

if (!tiler || !tiler.featured) return Astro.redirect('/providers')

const name    = tiler.full_name
const phone   = tiler.whatsapp || tiler.phone
const altPhone = (tiler.whatsapp && tiler.phone && tiler.whatsapp !== tiler.phone) ? tiler.phone : null
const city    = tiler.city || tiler.district
const rating  = tiler.avg_rating ? parseFloat(tiler.avg_rating) : 0
const services = tiler.services || []

function waLink(p, n) {
  const digits = (p || '').replace(/\D/g, '')
  const normalized = digits.startsWith('94') ? digits : '94' + digits.replace(/^0/, '')
  const who = n ? `*${n}*` : 'ඔබව'
  const msg = encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *TilersHub* (www.tilershub.lk) හරහා ${who} සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *TilersHub.lk* Lead\nස්තූතියි! 🏠`)
  return `https://wa.me/${normalized}?text=${msg}`
}

function stars(r) {
  const full = Math.floor(r)
  const half = r - full >= 0.5 ? 1 : 0
  const empty = 5 - full - half
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty)
}
---

<Layout
  title={`${name} · Skilled Tiler in ${city} · TilersHub`}
  description={`${name} is a TilersHub-featured, Skilled-verified tiler based in ${city}, Sri Lanka. ${tiler.experience_years}+ years experience. Contact directly on WhatsApp.`}
