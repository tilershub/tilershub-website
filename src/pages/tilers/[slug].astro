---
// /tilers/<district> → SSR district landing page ("Tilers in Colombo").
// Any other slug keeps the legacy behaviour: 301 to the provider profile.
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { districtBySlug, districtPath, serviceDistrictPath, neighborDistricts, LOCATION_SERVICE_SLUGS } from '../../lib/locations.js'
import { LABOUR, ADHESIVE_TIERS, EXTRAS, typicalCostPerSqft } from '../../lib/costData.js'
import { SERVICES } from '../../lib/services.js'
import { jobPath, timeAgo } from '../../lib/jobs.js'

const { slug } = Astro.params
const district = districtBySlug(slug)
if (!district) return Astro.redirect(`/providers/${slug}`, 301)

const supabase = Astro.locals.supabase

const [{ data: providersRaw }, { data: jobsRaw }] = await Promise.all([
  supabase
    .from('providers')
    .select('id,name,city,district,verification_status,slug,services,whatsapp,phone,description,profile_image,avg_rating,experience_years,cover_image,daily_rate_min,review_count,service_areas')
    .eq('status', 'active')
    .limit(200),
  supabase
    .from('projects')
    .select('id,project_type,city,district,created_at,budget_range,description')
    .eq('status', 'active')
    .eq('district', district.name)
    .order('created_at', { ascending: false })
    .limit(5),
])

const providers = (providersRaw || []).filter(p =>
  p.district === district.name ||
  (p.service_areas || []).includes(district.name) ||
  (p.city || '').toLowerCase().includes(district.name.toLowerCase())
).slice(0, 24)

const jobs = jobsRaw || []
const total = providers.length
const neighbors = neighborDistricts(district.slug)
const locServices = LOCATION_SERVICE_SLUGS.map(s => SERVICES.find(x => x.slug === s)).filter(Boolean)
const cost = typicalCostPerSqft()
const year = new Date().getFullYear()

const AVATAR_COLORS = ['#0F766E','#0f766e','#7c3aed','#b45309','#0369a1','#D97706','#15803d','#be185d']
function avatarColor(name) {
  let h = 0
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function initials(name) {
  return name.split(' ').slice(0, 2).map(w => w[0] || '').join('').toUpperCase() || '?'
}
function waLink(phone, name) {
  const cleaned = phone.replace(/\D/g, '')
  const intl = cleaned.startsWith('0') ? '94' + cleaned.slice(1) : cleaned
  return `https://wa.me/${intl}?text=${encodeURIComponent(`Hi, I found you on TilersHub. I'm looking for a tiler in ${district.name}.`)}`
}

const pageTitle = `Tilers in ${district.name} — Verified Tiling Professionals (${year}) | TilersHub`
const pageDesc = `Find ${total > 0 ? total + '+' : ''} verified tilers in ${district.name}, Sri Lanka. Compare quotes on WhatsApp, see current tiling rates (Rs. ${LABOUR.min}–${LABOUR.max}/sq.ft labour) and post your project free.`
const SITE = 'https://www.tilershub.lk'

const FAQS = [
  { q: `How much do tilers charge in ${district.name}?`,
    a: `Tiling labour in ${district.name} typically costs Rs. ${LABOUR.min}–${LABOUR.max} per sq.ft depending on tile size and pattern. Including adhesive, grout and levelling clips, expect roughly Rs. ${cost.low}–${cost.high} per sq.ft excluding tiles. Use the free TilersHub calculator for a full estimate.` },
  { q: `How do I find a reliable tiler in ${district.name}?`,
    a: `Post your project free on TilersHub describing the work, and verified tilers serving ${district.name} (${district.towns.slice(0, 3).join(', ')} and nearby towns) will send you bids on WhatsApp. Compare experience, reviews and quotes before choosing.` },
  { q: `Which areas of ${district.name} do TilersHub professionals cover?`,
    a: `Providers on TilersHub serve all major towns in ${district.name} district including ${district.towns.join(', ')}.` },
  { q: `Is it free to hire a tiler through TilersHub?`,
    a: 'Yes — posting a project and receiving bids is completely free for homeowners. TilersHub charges no commission; you deal with the tiler directly on WhatsApp.' },
]

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Tiling services in ${district.name}`,
  description: pageDesc,
  provider: { '@type': 'Organization', name: 'TilersHub', url: SITE },
  areaServed: { '@type': 'AdministrativeArea', name: `${district.name} District, Sri Lanka` },
  url: `${SITE}${districtPath(district)}`,
})

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=600')
---

<Layout title={pageTitle} description={pageDesc}>
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <script slot="head" type="application/ld+json" set:html={serviceSchema} />

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#042F2E 0%,#115E59 100%);padding:32px 20px 30px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:960px;margin:0 auto;">
      <Breadcrumbs items={[{ name: 'Find Tilers', href: '/providers?type=tiler' }, { name: district.name }]} light />
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(22px,4.5vw,32px);font-weight:700;color:#fff;margin:0 0 8px;">
        <span class="en-text">Tilers in {district.name} — Verified Tiling Professionals</span>
        <span class="si-text">{district.nameSi} ටයිලර්වරු — සත්‍යාපිත වෘත්තිකයන්</span>
      </h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:0 0 18px;line-height:1.7;max-width:640px;">
        <span class="en-text">{district.region} Compare verified tilers, see current rates, and get quotes on WhatsApp — free.</span>
        <span class="si-text">{district.nameSi} දිස්ත්‍රික්කයේ සත්‍යාපිත ටයිලර්වරුන්ගෙන් නොමිලේ ලංසු ලබා ගන්න.</span>
      </p>
      <a href={`/post-project?district=${encodeURIComponent(district.name)}`}
        style="display:inline-flex;align-items:center;gap:8px;background:#D97706;color:#fff;border-radius:24px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(217,119,6,0.4);">
        📋 <span class="en-text">Post a Project in {district.name}</span><span class="si-text">ව්‍යාපෘතිය පලකරන්න</span>
      </a>
    </div>
  </div>

  <!-- Providers -->
  <div style="background:#f8fafc;padding:24px 16px 40px;">
    <div style="max-width:960px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
        <h2 style="font-size:15px;font-weight:800;color:#0f172a;margin:0;">{total > 0 ? `${total} tiling professional${total !== 1 ? 's' : ''} serving ${district.name}` : `Tiling professionals serving ${district.name}`}</h2>
        <a href="/providers" style="font-size:12px;color:#D97706;font-weight:600;text-decoration:none;">Browse all ›</a>
      </div>

      {total === 0 ? (
        <div style="text-align:center;padding:36px 20px;background:#fff;border-radius:16px;border:1px solid #e2e8f0;">
          <div style="font-size:36px;margin-bottom:10px;">👷</div>
          <p style="font-size:13px;color:#64748b;margin:0 0 16px;line-height:1.7;">No providers listed in {district.name} yet — post your project and nearby tilers will bid, or be the first to join.</p>
          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <a href="/post-project" style="display:inline-flex;background:#D97706;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">📋 Post a Project</a>
            <a href="/join-tilershub" style="display:inline-flex;background:#0F766E;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">✅ Join as Provider</a>
          </div>
        </div>
      ) : (
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
          {providers.map(p => {
            const color = avatarColor(p.name || 'P')
            const inits = initials(p.name || 'P')
            const phone = p.whatsapp || p.phone
            const isVerified = ['th_master','th_certified_pro','th_verified'].includes(p.verification_status)
            const coverSrc = p.cover_image || p.profile_image
            const cardHref = p.slug ? `/providers/${p.slug}` : null
            return (
              <div onclick={cardHref ? `location.href='${cardHref}'` : undefined} style={`display:flex;flex-direction:column;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,0.08);${cardHref ? 'cursor:pointer;' : ''}`}>
                <div style="position:relative;height:160px;flex-shrink:0;">
                  {coverSrc
                    ? <img src={coverSrc} alt={`${p.name} — tiler in ${district.name}`} style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                    : <div style={`width:100%;height:100%;background:${color};display:flex;align-items:center;justify-content:center;`}>
                        <span style="font-size:42px;font-weight:800;color:rgba(255,255,255,0.85);">{inits}</span>
                      </div>
                  }
                  {isVerified && (
                    <span style="position:absolute;top:10px;right:10px;background:#16a34a;color:#fff;font-size:10px;font-weight:700;border-radius:20px;padding:3px 9px;">✓ Verified</span>
                  )}
                </div>
                <div style="padding:14px 16px;display:flex;flex-direction:column;flex:1;">
                  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:5px;">
                    <span style="font-size:15px;font-weight:700;color:#0f172a;line-height:1.25;">{p.name}</span>
                    {p.daily_rate_min && (
                      <span style="font-size:11px;font-weight:700;color:#D97706;white-space:nowrap;flex-shrink:0;">From Rs. {Number(p.daily_rate_min).toLocaleString()}/day</span>
                    )}
                  </div>
                  <div style="font-size:12px;margin-bottom:8px;">
                    {p.avg_rating > 0
                      ? <span style="color:#f59e0b;">⭐ {Number(p.avg_rating).toFixed(1)}{p.review_count ? ` (${p.review_count} reviews)` : ''}</span>
                      : <span style="color:#94a3b8;">New · No reviews yet</span>
                    }
                  </div>
                  <div style="border-top:1px solid #f1f5f9;margin-top:auto;padding-top:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    {p.experience_years > 0 && (
                      <span style="font-size:11px;font-weight:600;color:#16a34a;">🛡 {p.experience_years}+ yrs</span>
                    )}
                    <span style="font-size:11px;color:#64748b;">📍 {p.city || p.district}</span>
                    <div style="margin-left:auto;display:flex;gap:6px;">
                      {phone && (
                        <a href={waLink(phone, p.name)} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()"
                          style="display:inline-flex;align-items:center;background:#25D366;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">💬</a>
                      )}
                      {cardHref && (
                        <a href={cardHref} onclick="event.stopPropagation()"
                          style="display:inline-flex;align-items:center;background:#0F766E;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">View ›</a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Recent jobs in district -->
  {jobs.length > 0 && (
    <div style="background:#fff;padding:28px 16px;border-top:1px solid #f1f5f9;">
      <div style="max-width:720px;margin:0 auto;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
          <h2 style="font-size:15px;font-weight:800;color:#0f172a;margin:0;">Recent tiling projects in {district.name}</h2>
          <a href="/jobs" style="font-size:12px;color:#D97706;font-weight:600;text-decoration:none;">View all ›</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {jobs.map(j => (
            <a href={jobPath(j)} style="display:block;background:#f8fafc;border:1px solid #e8edf5;border-radius:14px;padding:14px 16px;text-decoration:none;color:inherit;">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:4px;">
                <span style="font-size:13px;font-weight:700;color:#0f172a;">{j.project_type}</span>
                <span style="font-size:10px;color:#94a3b8;white-space:nowrap;flex-shrink:0;">{timeAgo(j.created_at)}</span>
              </div>
              {j.city && <div style="font-size:11px;color:#64748b;margin-bottom:4px;">📍 {j.city}</div>}
              {j.description && <p style="font-size:12px;color:#64748b;margin:0;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{j.description}</p>}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Cost snapshot -->
  <div style="background:#f8fafc;padding:28px 16px;border-top:1px solid #f1f5f9;">
    <div style="max-width:720px;margin:0 auto;">
      <h2 style="font-size:15px;font-weight:800;color:#0f172a;margin:0 0 10px;">Tiling cost in {district.name} ({year})</h2>
      <p style="font-size:13px;color:#475569;line-height:1.9;margin:0 0 14px;">
        Tiling labour in {district.name} runs <strong>Rs. {LABOUR.min}–{LABOUR.max}/sq.ft</strong>. With adhesive
        (C1 Rs. {ADHESIVE_TIERS[0].rate} – C2TE Rs. {ADHESIVE_TIERS[2].rate}/sq.ft), grout Rs. {EXTRAS.grout}/sq.ft and level clips
        Rs. {EXTRAS.levelClips}/sq.ft, budget roughly <strong>Rs. {cost.low}–{cost.high} per sq.ft</strong> before tile material.
      </p>
      <a href="/estimator" style="display:inline-flex;align-items:center;gap:7px;background:#0F766E;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
        📐 Calculate your tiling cost →
      </a>
    </div>
  </div>

  <!-- Services + towns + neighbors -->
  <div style="background:#fff;padding:28px 16px 40px;border-top:1px solid #f1f5f9;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:22px;">

      <div>
        <h2 style="font-size:14px;font-weight:800;color:#0f172a;margin:0 0 10px;">Popular services in {district.name}</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {locServices.map(s => (
            <a href={serviceDistrictPath(s.slug, district)} style="font-size:12px;font-weight:700;color:#0F766E;background:#F0FDFA;border:1px solid #99F6E4;border-radius:20px;padding:7px 14px;text-decoration:none;">{s.icon} {s.label} in {district.name}</a>
          ))}
        </div>
      </div>

      <div>
        <h2 style="font-size:14px;font-weight:800;color:#0f172a;margin:0 0 10px;">Areas served in {district.name} district</h2>
        <p style="font-size:13px;color:#64748b;line-height:1.9;margin:0;">
          TilersHub professionals cover {district.towns.join(' · ')} and surrounding areas.
        </p>
      </div>

      <div>
        <h2 style="font-size:14px;font-weight:800;color:#0f172a;margin:0 0 10px;">Nearby districts</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {neighbors.map(n => (
            <a href={districtPath(n)} style="font-size:12px;font-weight:700;color:#475569;background:#f8fafc;border:1px solid #e2e8f0;border-radius:20px;padding:7px 14px;text-decoration:none;">Tilers in {n.name}</a>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div>
        <h2 style="font-size:15px;font-weight:800;color:#0f172a;margin:0 0 12px;">Hiring a tiler in {district.name} — FAQ</h2>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {FAQS.map(f => (
            <details style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px 16px;">
              <summary style="font-size:13px;font-weight:700;color:#0f172a;cursor:pointer;">{f.q}</summary>
              <p style="font-size:13px;color:#475569;line-height:1.8;margin:10px 0 0;">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- CTA -->
  <div style="background:linear-gradient(135deg,#115E59 0%,#042F2E 100%);padding:36px 20px;text-align:center;">
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(18px,4vw,24px);font-weight:700;color:#fff;margin:0 0 10px;">
      <span class="en-text">Need tiling done in {district.name}?</span>
      <span class="si-text">{district.nameSi} හි ටයිලිං සේවාවක් අවශ්‍යද?</span>
    </h2>
    <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:0 0 20px;">
      <span class="en-text">Post free — get quotes from verified tilers on WhatsApp</span>
      <span class="si-text">නොමිලේ පලකරන්න — WhatsApp හරහා ලංසු ලබා ගන්න</span>
    </p>
    <a href="/post-project" style="display:inline-flex;align-items:center;gap:8px;background:#D97706;color:#fff;border-radius:24px;padding:13px 28px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(217,119,6,0.45);">
      📋 <span class="en-text">Post Your Project →</span><span class="si-text">ව්‍යාපෘතිය පලකරන්න →</span>
    </a>
  </div>

</Layout>
