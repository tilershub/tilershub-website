---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase.js'
import ReviewsSection from '../../components/ReviewsSection.jsx'
import ClaimProfile from '../../components/ClaimProfile.jsx'
import EditProfileButton from '../../components/EditProfileButton.jsx'

export async function getStaticPaths() {
  const { data: tilers } = await supabase
    .from('tilers')
    .select('id,slug')
    .eq('is_verified', true)
    .not('slug', 'is', null)
  const paths = []
  for (const t of tilers || []) {
    paths.push({ params: { slug: t.slug }, props: { lookupSlug: t.slug } })
  }
  return paths
}

const { slug } = Astro.params
const { lookupSlug } = Astro.props

const { data: tiler } = await supabase
  .from('tilers')
  .select('*')
  .eq('slug', lookupSlug)
  .single()

if (!tiler || !tiler.is_verified) return Astro.redirect('/providers')

const name    = tiler.full_name
const phone   = tiler.whatsapp || tiler.phone
const altPhone = (tiler.whatsapp && tiler.phone && tiler.whatsapp !== tiler.phone) ? tiler.phone : null
const city    = tiler.city || tiler.district
const rating  = tiler.avg_rating ? parseFloat(tiler.avg_rating) : 0
const services = tiler.services || []

function waLink(p, n) {
  const digits = (p || '').replace(/\D/g, '')
  const normalized = digits.startsWith('94') ? digits : '94' + digits.replace(/^0/, '')
  const who = n ? `*${n}*` : 'ඔබව'
  const msg = encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *TilersHub* (www.tilershub.lk) හරහා ${who} සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *TilersHub.lk* Lead\nස්තූතියි! 🏠`)
  return `https://wa.me/${normalized}?text=${msg}`
}

function stars(r) {
  const full = Math.floor(r)
  const half = r - full >= 0.5 ? 1 : 0
  const empty = 5 - full - half
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty)
}

const localBizSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name,
  description: `${name} is a Skill Verified tiling professional in ${city}, Sri Lanka.${services.length ? ' Services: ' + services.slice(0,3).join(', ') + '.' : ''}`,
  url: `https://www.tilershub.lk/tilers/${tiler.slug}`,
  address: { '@type': 'PostalAddress', addressLocality: city, addressRegion: tiler.district || city, addressCountry: 'LK' },
  areaServed: tiler.district || city,
  priceRange: tiler.daily_rate_min ? `Rs. ${tiler.daily_rate_min}–${tiler.daily_rate_max || '?'} per sq.ft` : 'Contact for quote',
}
if (rating > 0 && tiler.review_count > 0) {
  localBizSchema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: rating.toFixed(1),
    reviewCount: tiler.review_count,
    bestRating: '5',
    worstRating: '1',
  }
}
const schemaStr = JSON.stringify(localBizSchema)
---

<Layout
  title={`${name} · Skill Verified Tiler in ${city} · TilersHub`}
  description={`${name} is a Skill Verified tiler based in ${city}, Sri Lanka${tiler.experience_years > 0 ? ` with ${tiler.experience_years}+ years experience` : ''}. Contact directly on WhatsApp via TilersHub.`}
>
  <script slot="head" type="application/ld+json" set:html={schemaStr} />

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#0A1C38 0%,#1B3A6B 60%,#243F70 100%);position:relative;overflow:hidden;">
    <!-- Tile-grid texture -->
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 29px,rgba(255,255,255,0.8) 29px,rgba(255,255,255,0.8) 30px),repeating-linear-gradient(90deg,transparent,transparent 29px,rgba(255,255,255,0.8) 29px,rgba(255,255,255,0.8) 30px);pointer-events:none;"></div>
    <!-- Gold accent bar -->
    <div style="height:3px;background:linear-gradient(90deg,#D4AF37,#f0d060,#D4AF37);"></div>

    <div style="max-width:860px;margin:0 auto;padding:40px 24px 48px;position:relative;">
      <!-- Back link -->
      <a href="/providers" style="display:inline-flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,0.45);letter-spacing:1px;font-weight:600;margin-bottom:32px;text-decoration:none;">← සියලු ටයිලර්</a>

      <div style="display:flex;align-items:flex-start;gap:24px;flex-wrap:wrap;">
        <!-- Avatar — always initials (no unrelated portrait photos) -->
        <div style="width:96px;height:96px;border-radius:50%;border:3px solid rgba(212,175,55,0.5);background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;font-size:34px;font-weight:800;color:#fff;flex-shrink:0;box-shadow:0 4px 20px rgba(0,0,0,0.3);letter-spacing:-1px;">
          {name.split(' ').map((w: string) => w[0]).join('').slice(0,2).toUpperCase()}
        </div>

        <div style="flex:1;min-width:0;">
          <!-- Badges row -->
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
            <span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(22,163,74,0.2);color:#4ade80;border:1px solid rgba(74,222,128,0.3);">✓ ශිල්පය සත්‍යාපිත</span>
            {tiler.featured && (
              <span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(212,175,55,0.15);color:#D4AF37;border:1px solid rgba(212,175,55,0.35);">⭐ TilersHub ප්‍රමුඛ</span>
            )}
          </div>

          <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,5vw,42px);font-weight:700;color:#fff;margin-bottom:8px;line-height:1.15;">{name}</h1>
          <div style="font-size:15px;color:rgba(255,255,255,0.65);margin-bottom:16px;">📍 {city}{tiler.district && tiler.district !== tiler.city ? `, ${tiler.district} District` : ''}</div>

          <!-- Quick stats -->
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px;">
            <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:5px 12px;border-radius:20px;background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
              🛠️ {tiler.experience_years}+ වසර අත්දැකීම
            </span>
            {rating > 0 && (
              <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:5px 12px;border-radius:20px;background:rgba(212,175,55,0.12);color:#D4AF37;border:1px solid rgba(212,175,55,0.3);">
                {stars(rating)} {rating.toFixed(1)}
              </span>
            )}
            {tiler.daily_rate_min && (
              <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:5px 12px;border-radius:20px;background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);">
                Rs.{tiler.daily_rate_min}–{tiler.daily_rate_max || '?'}/sqft
              </span>
            )}
          </div>

          <!-- Hero CTA -->
          <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;">
            {phone && (
              <a href={waLink(phone, name)} target="_blank" rel="noopener noreferrer"
                style="display:inline-flex;align-items:center;gap:10px;background:#25D366;color:#fff;border-radius:14px;padding:14px 28px;font-size:15px;font-weight:700;text-decoration:none;box-shadow:0 6px 20px rgba(37,211,102,0.3);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                WhatsApp
              </a>
            )}
            {altPhone && (
              <a href={waLink(altPhone, name)} target="_blank" rel="noopener noreferrer"
                style="display:inline-flex;align-items:center;gap:8px;background:rgba(240,253,244,0.15);color:#fff;border:1.5px solid rgba(255,255,255,0.3);border-radius:14px;padding:13px 22px;font-size:14px;font-weight:700;text-decoration:none;">
                💬 වෙනත් අංකය
              </a>
            )}
            <button id="hero-review-btn"
              style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.12);color:#fff;border:1.5px solid rgba(255,255,255,0.3);border-radius:14px;padding:13px 22px;font-size:14px;font-weight:700;cursor:pointer;backdrop-filter:blur(6px);">
              ⭐ ශ්‍රේණිය දෙන්න
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <section style="background:#f8fafc;padding:40px 24px 72px;">
    <div style="max-width:860px;margin:0 auto;display:grid;grid-template-columns:1fr 280px;gap:28px;align-items:start;">

      <!-- Left column -->
      <div>

        <!-- About -->
        {tiler.bio && (
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:26px;margin-bottom:20px;">
            <h2 style="font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px;">ගැන</h2>
            <p style="font-size:14px;color:#374151;line-height:1.85;">{tiler.bio}</p>
          </div>
        )}

        <!-- Services -->
        {services.length > 0 && (
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:26px;margin-bottom:20px;">
            <h2 style="font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:14px;">සේවාවන්</h2>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {services.map((s: string) => (
                <span style="font-size:12px;font-weight:600;padding:6px 14px;border-radius:20px;background:#eef3fb;color:#1B3A6B;border:1px solid #d5e2f5;">{s}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Stats -->
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:26px;margin-bottom:20px;">
          <h2 style="font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:16px;">අත්දැකීම</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:12px;">
            <div style="background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;padding:16px;text-align:center;">
              <div style="font-size:24px;font-weight:700;color:#1B3A6B;">{tiler.experience_years}+</div>
              <div style="font-size:10px;color:#94a3b8;margin-top:3px;font-weight:600;">අත්දැකීම් (වසර)</div>
            </div>
            {tiler.total_jobs > 0 && (
              <div style="background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;padding:16px;text-align:center;">
                <div style="font-size:24px;font-weight:700;color:#1B3A6B;">{tiler.total_jobs}</div>
                <div style="font-size:10px;color:#94a3b8;margin-top:3px;font-weight:600;">සේවා ගණන</div>
              </div>
            )}
            {rating > 0 && (
              <div style="background:#fffbeb;border-radius:12px;border:1px solid #fde68a;padding:16px;text-align:center;">
                <div style="font-size:24px;font-weight:700;color:#92400e;">⭐ {rating.toFixed(1)}</div>
                <div style="font-size:10px;color:#94a3b8;margin-top:3px;font-weight:600;">සමාලෝචන {tiler.review_count || 0}</div>
              </div>
            )}
            {tiler.daily_rate_min && (
              <div style="background:#f5f3ff;border-radius:12px;border:1px solid #e9d5ff;padding:16px;text-align:center;">
                <div style="font-size:16px;font-weight:700;color:#7c3aed;">Rs.{tiler.daily_rate_min}–{tiler.daily_rate_max || '?'}</div>
                <div style="font-size:10px;color:#94a3b8;margin-top:3px;font-weight:600;">sq.ft ට</div>
              </div>
            )}
          </div>
        </div>

        <!-- Portfolio -->
        {(tiler.gallery || []).length > 0 && (
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:26px;margin-bottom:20px;">
            <h2 style="font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:16px;">📸 ගැලරිය</h2>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;">
              {(tiler.gallery || []).map((img: string, i: number) => (
                <img src={img} alt={`Work photo ${i + 1}`}
                  style="width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;border:1px solid #e2e8f0;" />
              ))}
            </div>
          </div>
        )}

        <!-- Reviews -->
        <ReviewsSection client:load tilerId={tiler.id} />

        <!-- Related blog reading -->
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:20px;margin-bottom:20px;">
          <h2 style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px;">📰 ප්‍රයෝජනවත් ලිපි</h2>
          <div style="display:flex;flex-direction:column;gap:8px;">
            {[
              { slug:'how-to-choose-a-tiler',             icon:'👷', color:'#1B3A6B', cat:'බඳවා ගැනීමේ ඉඟි',  title:'හොඳ ටයිලර් කෙනෙකු තෝරා ගන්නේ කෙසේද?' },
              { slug:'waterproofing-bathroom-guide',       icon:'💧', color:'#0369a1', cat:'ක්‍රම',             title:'ජලනිරෝධය වැදගත් ඇයි?' },
              { slug:'bathroom-renovation-cost-sri-lanka', icon:'💰', color:'#0f766e', cat:'මිල මාර්ගෝපදේශය',  title:'නාන කාමර ප්‍රතිසංස්කරණ පිරිවැය 2025' },
            ].map(p => (
              <a href={`/blog/${p.slug}`}
                style="display:flex;align-items:center;gap:0;background:#f8fafc;border-radius:10px;overflow:hidden;border:1px solid #f1f5f9;text-decoration:none;color:inherit;">
                <div style={`width:44px;height:44px;background:${p.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:18px;`}>{p.icon}</div>
                <div style="flex:1;padding:8px 10px;min-width:0;">
                  <span style="font-size:8px;font-weight:700;color:#E05A2B;">{p.cat}</span>
                  <div style="font-size:11px;font-weight:600;color:#111827;line-height:1.3;margin-top:1px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{p.title}</div>
                </div>
                <div style="padding:0 10px;font-size:16px;color:#cbd5e1;flex-shrink:0;">›</div>
              </a>
            ))}
          </div>
        </div>

        <!-- Trust section -->
        <div style="background:linear-gradient(135deg,#0F2444,#1B3A6B);border-radius:16px;padding:28px;color:#fff;">
          <h2 style="font-size:14px;font-weight:700;color:#D4AF37;margin-bottom:14px;letter-spacing:0.5px;">ශිල්ප-සත්‍යාපිත ටයිලර් කෙනෙකු තෝරාගත යුත්තේ ඇයි?</h2>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div style="display:flex;align-items:flex-start;gap:10px;">
              <span style="font-size:18px;flex-shrink:0;">✓</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#e2e8f0;margin-bottom:2px;">ශිල්ප සත්‍යාපිත</div>
                <div style="font-size:11px;color:rgba(255,255,255,0.55);line-height:1.5;">TilersHub කණ්ඩායම විසින් සමාලෝචිත</div>
              </div>
            </div>
            <div style="display:flex;align-items:flex-start;gap:10px;">
              <span style="font-size:18px;flex-shrink:0;">⭐</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#e2e8f0;margin-bottom:2px;">5+ වසර අත්දැකීම</div>
                <div style="font-size:11px;color:rgba(255,255,255,0.55);line-height:1.5;">ක්ෂේත්‍රයේ ඔප්පු කළ ජය ගත හැකි ශිල්පියා</div>
              </div>
            </div>
            <div style="display:flex;align-items:flex-start;gap:10px;">
              <span style="font-size:18px;flex-shrink:0;">💬</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#e2e8f0;margin-bottom:2px;">WhatsApp සෘජු සම්බන්ධතාව</div>
                <div style="font-size:11px;color:rgba(255,255,255,0.55);line-height:1.5;">මැදිහත්කරුවන් නැතිව කෙළින්ම කතා කරන්න</div>
              </div>
            </div>
            <div style="display:flex;align-items:flex-start;gap:10px;">
              <span style="font-size:18px;flex-shrink:0;">📍</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#e2e8f0;margin-bottom:2px;">දේශීය වෘත්තිකයා</div>
                <div style="font-size:11px;color:rgba(255,255,255,0.55);line-height:1.5;">{city} සහ ආසන්න ප්‍රදේශ ආවරණය</div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right column: sticky contact card -->
      <div style="position:sticky;top:80px;">
        <div style="background:#fff;border:1.5px solid #e2e8f0;border-radius:20px;padding:24px;box-shadow:0 4px 24px rgba(27,58,107,0.08);margin-bottom:12px;">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
            <div style="width:44px;height:44px;border-radius:50%;border:2px solid #D4AF37;background:#1B3A6B;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#fff;flex-shrink:0;letter-spacing:-0.5px;">
              {name.split(' ').map((w: string) => w[0]).join('').slice(0,2).toUpperCase()}
            </div>
            <div>
              <div style="font-size:14px;font-weight:700;color:#0f172a;">{name}</div>
              <div style="font-size:11px;color:#64748b;">📍 {city}</div>
            </div>
          </div>

          <div style="display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;">
            <span style="font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;">✓ ශිල්පය සත්‍යාපිත</span>
            {tiler.featured && <span style="font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;background:#fffbeb;color:#a16207;border:1px solid #fde68a;">⭐ ප්‍රමුඛ</span>}
          </div>

          {phone && (
            <a href={waLink(phone, name)} target="_blank" rel="noopener noreferrer"
              style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:#25D366;color:#fff;border-radius:12px;padding:14px;font-size:14px;font-weight:700;text-decoration:none;margin-bottom:10px;box-shadow:0 4px 14px rgba(37,211,102,0.25);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          )}
          {altPhone && (
            <a href={waLink(altPhone, name)} target="_blank" rel="noopener noreferrer"
              style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:#f0fdf4;color:#16a34a;border:1.5px solid #bbf7d0;border-radius:12px;padding:12px;font-size:13px;font-weight:700;text-decoration:none;margin-bottom:10px;">
              💬 වෙනත් අංකය
            </a>
          )}
          <div style="height:1px;background:#e2e8f0;margin-bottom:14px;"></div>
          <div style="font-size:12px;color:#64748b;line-height:1.8;">
            <div>📍 පිහිටා ඇත: <strong style="color:#374151;">{city}</strong></div>
            {tiler.district && tiler.district !== tiler.city && (
              <div>🗺️ {tiler.district} දිස්ත්‍රික්කය</div>
            )}
            <div>🛠️ {tiler.experience_years}+ වසර අත්දැකීම</div>
            {rating > 0 && <div>⭐ {rating.toFixed(1)} ශ්‍රේණිය</div>}
          </div>
        </div>

        <button id="sidebar-review-btn"
          style="display:flex;align-items:center;justify-content:center;gap:7px;width:100%;background:#fff;color:#1B3A6B;border:2px solid #1B3A6B;border-radius:12px;padding:13px;font-size:13px;font-weight:700;cursor:pointer;margin-bottom:10px;">
          ⭐ ශ්‍රේණිය දෙන්න
        </button>

        <a href="/post-project"
          style="display:flex;align-items:center;justify-content:center;gap:6px;background:#E05A2B;color:#fff;border-radius:12px;padding:13px;font-size:13px;font-weight:700;text-decoration:none;text-align:center;">
          📋 නොමිලේ ව්‍යාපෘතිය ලිය කරන්න
        </a>

        <button
          id="share-profile-btn"
          style="display:flex;align-items:center;justify-content:center;gap:6px;width:100%;background:#f1f5f9;color:#374151;border:1px solid #e2e8f0;border-radius:12px;padding:11px;font-size:12px;font-weight:700;cursor:pointer;margin-top:10px;">
          🔗 පැතිකඩ බෙදාගන්න
        </button>

        <EditProfileButton
          client:load
          ownerId={tiler.user_id}
          profileType="tiler"
          profileSlug={tiler.slug}
        />

        <ClaimProfile
          client:load
          profileId={tiler.id}
          profileType="tiler"
          profileName={name}
          isClaimed={!!tiler.user_id}
        />
      </div>

    </div>
  </section>

  <style>
    @media (max-width: 660px) {
      section > div { grid-template-columns: 1fr !important; }
    }
  </style>

  <script define:vars={{ profileName: name, profileUrl: Astro.url.href }}>
    function openReview() {
      window.dispatchEvent(new CustomEvent('tilershub:openreview'))
    }
    document.getElementById('hero-review-btn')?.addEventListener('click', openReview)
    document.getElementById('sidebar-review-btn')?.addEventListener('click', openReview)

    const btn = document.getElementById('share-profile-btn')
    if (btn) {
      btn.addEventListener('click', async () => {
        const title = `${profileName} — Verified Tiler on TilersHub`
        const url = profileUrl
        if (navigator.share) {
          try { await navigator.share({ title, url }) } catch (_) {}
        } else {
          await navigator.clipboard.writeText(url)
          btn.textContent = '✓ සබැඳිය පිටපත් විය!'
          setTimeout(() => { btn.textContent = '🔗 පැතිකඩ බෙදාගන්න' }, 2000)
        }
      })
    }
  </script>

</Layout>
