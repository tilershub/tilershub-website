        )}

        <!-- Stats -->
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:26px;margin-bottom:20px;">
          <h2 style="font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:16px;">Experience</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:12px;">
            <div style="background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;padding:16px;text-align:center;">
              <div style="font-size:24px;font-weight:700;color:#1B3A6B;">{tiler.experience_years}+</div>
              <div style="font-size:10px;color:#94a3b8;margin-top:3px;font-weight:600;">Years Exp.</div>
            </div>
            {tiler.total_jobs > 0 && (
              <div style="background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;padding:16px;text-align:center;">
                <div style="font-size:24px;font-weight:700;color:#1B3A6B;">{tiler.total_jobs}</div>
                <div style="font-size:10px;color:#94a3b8;margin-top:3px;font-weight:600;">Jobs Done</div>
              </div>
            )}
            {rating > 0 && (
              <div style="background:#fffbeb;border-radius:12px;border:1px solid #fde68a;padding:16px;text-align:center;">
                <div style="font-size:24px;font-weight:700;color:#92400e;">⭐ {rating.toFixed(1)}</div>
                <div style="font-size:10px;color:#94a3b8;margin-top:3px;font-weight:600;">{tiler.review_count || 0} reviews</div>
              </div>
            )}
            {tiler.daily_rate_min && (
