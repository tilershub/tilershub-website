    </div>
  </div>

  <!-- Content -->
  <section style="background:#f8fafc;padding:40px 24px 72px;">
    <div style="max-width:860px;margin:0 auto;display:grid;grid-template-columns:1fr 280px;gap:28px;align-items:start;">

      <!-- Left column -->
