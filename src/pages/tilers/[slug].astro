        <!-- About -->
        {tiler.bio && (
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:26px;margin-bottom:20px;">
            <h2 style="font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px;">About</h2>
            <p style="font-size:14px;color:#374151;line-height:1.85;">{tiler.bio}</p>
