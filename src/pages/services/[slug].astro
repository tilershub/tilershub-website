---
export const prerender = false
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { SERVICES } from '../../lib/services.js'
import { DISTRICT_INFO, LOCATION_SERVICE_SLUGS, serviceDistrictPath } from '../../lib/locations.js'
import { LABOUR, typicalCostPerSqft } from '../../lib/costData.js'

const { slug } = Astro.params
const service = SERVICES.find(s => s.slug === slug)
if (!service) return Astro.redirect('/providers')
if (service.externalUrl) return Astro.redirect(service.externalUrl, 302)

const supabase = Astro.locals.supabase

const [{ data: providersRaw }, { data: recentProjectsRaw }] = await Promise.all([
  supabase
    .from('providers')
    .select('id,name,city,district,verification_status,slug,services,provider_type,whatsapp,phone,description,profile_image,avg_rating,experience_years,cover_image,daily_rate_min,review_count')
    .eq('status', 'active')
    .limit(200),
  supabase
    .from('projects')
    .select('id,project_type,district,created_at,budget_range,description')
    .eq('status', 'active')
    .ilike('project_type', `%${service.terms[0]}%`)
    .order('created_at', { ascending: false })
    .limit(3),
])

const providers = (providersRaw || []).filter(p =>
  (p.services || []).some(s =>
    service.terms.some(t => String(s).toLowerCase().includes(t.toLowerCase()))
  ) || service.terms.some(t => (p.description || '').toLowerCase().includes(t.toLowerCase()))
).slice(0, 30)

const recentProjects = recentProjectsRaw || []

function timeAgoStr(ts) {
  if (!ts) return ''
  const mins = Math.floor((Date.now() - new Date(ts)) / 60000)
  if (mins < 60) return `${mins}m ago`
  const hrs = Math.floor(mins / 60)
  if (hrs < 24) return `${hrs}h ago`
  const days = Math.floor(hrs / 24)
  return `${days}d ago`
}

function budgetStr(min, max) {
  if (!min && !max) return null
  if (min && max) return `Rs. ${Number(min).toLocaleString()} – ${Number(max).toLocaleString()}`
  if (min) return `From Rs. ${Number(min).toLocaleString()}`
  return `Up to Rs. ${Number(max).toLocaleString()}`
}

const AVATAR_COLORS = ['#2563EB','#2563EB','#7c3aed','#2563EB','#0369a1','#2563EB','#15803d','#be185d']
function avatarColor(name) {
  let h = 0
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function initials(name) {
  return name.split(' ').slice(0,2).map(w => w[0] || '').join('').toUpperCase() || '?'
}
function waLink(phone, name) {
  const cleaned = phone.replace(/\D/g, '')
  const intl = cleaned.startsWith('0') ? '94' + cleaned.slice(1) : cleaned
  return `https://wa.me/${intl}?text=${encodeURIComponent(`Hi, I found you on TilersHub. I'm looking for ${name}.`)}`
}

const pageTitle = `${service.label} in Sri Lanka — Verified Specialists | TilersHub`
const pageDesc  = `Find verified ${service.label} professionals across Sri Lanka. Compare quotes, read reviews, and contact directly on WhatsApp. Free on TilersHub.`
const postUrl   = `/post-project?type=${encodeURIComponent(service.label)}`
const total     = providers.length

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.label,
  description: pageDesc,
  provider: { '@type': 'Organization', name: 'TilersHub', url: 'https://www.tilershub.lk' },
  areaServed: { '@type': 'Country', name: 'Sri Lanka' },
  url: `https://www.tilershub.lk/services/${service.slug}`,
})

const hasDistrictPages = LOCATION_SERVICE_SLUGS.includes(service.slug)
const topDistricts = DISTRICT_INFO.filter(d => ['colombo','gampaha','kandy','galle','kurunegala','kalutara','matara','puttalam'].includes(d.slug))
const cost = typicalCostPerSqft()

const SERVICE_FAQS = [
  { q: `How much does ${service.label.toLowerCase()} cost in Sri Lanka?`,
    a: `Labour for ${service.label.toLowerCase()} typically runs Rs. ${LABOUR.min}–${LABOUR.max} per sq.ft; with materials expect roughly Rs. ${cost.low}–${cost.high}/sq.ft before tiles or fittings. Use the free TilersHub calculator for an itemised estimate.` },
  { q: `How do I get quotes for ${service.label.toLowerCase()}?`,
    a: 'Post your project free on TilersHub with the area size and location. Verified professionals send quotes straight to your WhatsApp — compare and choose with no commission or obligation.' },
  { q: 'Are the professionals on TilersHub verified?',
    a: 'Every provider application is reviewed before the profile goes live, and verified badges are shown on profiles that completed identity checks. Reviews from past customers appear on each profile.' },
]

const serviceFaqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SERVICE_FAQS.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})
---

<Layout title={pageTitle} description={pageDesc}>
  <script slot="head" type="application/ld+json" set:html={serviceSchema} />
  <script slot="head" type="application/ld+json" set:html={serviceFaqSchema} />

  <!-- Service header -->
  <div style="background:linear-gradient(135deg,#0F172A 0%,#0F172A 100%);padding:28px 20px 24px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;">
      <div style="text-align:left;max-width:960px;margin:0 auto;"><Breadcrumbs items={[{ name: 'Services', href: '/categories' }, { name: service.label }]} light /></div>
      <div style="font-size:48px;margin-bottom:10px;">{service.icon}</div>
      <h1 style="font-family: 'Inter', sans-serif;font-size:clamp(20px,4.5vw,30px);font-weight:700;color:#fff;margin:0 0 8px;">{service.label}</h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.55);margin:0 0 20px;line-height:1.6;">
        Find verified {service.label} professionals across Sri Lanka
      </p>
      <a href={postUrl}
        style="display:inline-flex;align-items:center;gap:8px;background:#2563EB;color:#fff;border-radius:24px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(37,99,235,0.4);">
        📋 Post a {service.label} Project
      </a>
    </div>
  </div>

  <!-- Provider list -->
  <div style="background:#F8FAFC;min-height:300px;padding:20px 16px 80px;">

    {total === 0 ? (

      <div style="text-align:center;padding:48px 20px;">
        <div style="font-size:40px;margin-bottom:12px;">{service.icon}</div>
        <h2 style="font-family: 'Inter', sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin:0 0 8px;">No providers listed yet</h2>
        <p style="font-size:13px;color:#64748B;margin:0 0 20px;line-height:1.7;">
          Be the first {service.label} specialist on TilersHub, or post a project to receive bids.
        </p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
          <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:6px;background:#2563EB;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            ✅ Join as Provider
          </a>
          <a href={postUrl} style="display:inline-flex;align-items:center;gap:6px;background:#2563EB;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            📋 Post a Project
          </a>
        </div>
      </div>

    ) : (

      <div style="max-width:960px;margin:0 auto;">

        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <span style="font-size:13px;font-weight:700;color:#334155;">{total} provider{total !== 1 ? 's' : ''} found</span>
          <a href="/providers" style="font-size:12px;color:#2563EB;font-weight:600;text-decoration:none;">Browse all ›</a>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
        {providers.map(p => {
          const color = avatarColor(p.name || 'P')
          const inits = initials(p.name || 'P')
          const phone = p.whatsapp || p.phone
          const isVerified = ['th_master','th_certified_pro','th_verified'].includes(p.verification_status)
          const coverSrc = p.cover_image || p.profile_image
          const cardHref = p.slug ? `/providers/${p.slug}` : null
          return (
            <div onclick={cardHref ? `location.href='${cardHref}'` : undefined} style={`display:flex;flex-direction:column;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,0.08);${cardHref ? 'cursor:pointer;' : ''}`}>
              <div style="position:relative;height:200px;flex-shrink:0;">
                {coverSrc
                  ? <img src={coverSrc} alt={p.name} style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                  : <div style={`width:100%;height:100%;background:${color};display:flex;align-items:center;justify-content:center;`}>
                      <span style="font-size:48px;font-weight:800;color:rgba(255,255,255,0.85);">{inits}</span>
                    </div>
                }
                {isVerified && (
                  <span style="position:absolute;top:10px;right:10px;background:#16a34a;color:#fff;font-size:10px;font-weight:700;border-radius:20px;padding:3px 9px;">✓ Verified</span>
                )}
              </div>
              <div style="padding:14px 16px;display:flex;flex-direction:column;flex:1;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:5px;">
                  <span style="font-size:16px;font-weight:700;color:#0F172A;line-height:1.25;">{p.name}</span>
                  {p.daily_rate_min && (
                    <span style="font-size:12px;font-weight:700;color:#2563EB;white-space:nowrap;flex-shrink:0;">From Rs. {Number(p.daily_rate_min).toLocaleString()}/day</span>
                  )}
                </div>
                <div style="font-size:12px;margin-bottom:8px;">
                  {p.avg_rating > 0
                    ? <span style="color:#f59e0b;">⭐ {Number(p.avg_rating).toFixed(1)}{p.review_count ? ` (${p.review_count} reviews)` : ''}</span>
                    : <span style="color:#94A3B8;">New · No reviews yet</span>
                  }
                </div>
                {p.description && (
                  <div style="font-size:12px;color:#64748B;margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.5;">{p.description}</div>
                )}
                <div style="border-top:1px solid #F1F5F9;margin-top:auto;padding-top:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                  {p.experience_years > 0 && (
                    <span style="font-size:11px;font-weight:600;color:#16a34a;">🛡 {p.experience_years}+ yrs</span>
                  )}
                  {(p.city || p.district) && (
                    <span style="font-size:11px;color:#64748B;">📍 {p.city || p.district}</span>
                  )}
                  <div style="margin-left:auto;display:flex;gap:6px;">
                    {phone && (
                      <a href={waLink(phone, p.name)} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()"
                        style="display:inline-flex;align-items:center;gap:4px;background:#25D366;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">
                        💬
                      </a>
                    )}
                    {cardHref && (
                      <a href={cardHref} onclick="event.stopPropagation()"
                        style="display:inline-flex;align-items:center;gap:4px;background:#2563EB;color:#fff;border-radius:10px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;">
                        View ›
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )
        })}
        </div>

      </div>
    )}
  </div>

  <!-- Recent Projects on this service -->
  {recentProjects.length > 0 && (
    <div style="background:#fff;padding:28px 16px 32px;border-top:1px solid #F1F5F9;">
      <div style="max-width:640px;margin:0 auto;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h2 style="font-family: 'Inter', sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin:0;">
            <span class="en-text">Recent Projects</span>
            <span class="si-text">මෑත ව්‍යාපෘති</span>
          </h2>
          <a href="/jobs" style="font-size:12px;color:#2563EB;font-weight:600;text-decoration:none;">
            <span class="en-text">View all ›</span>
            <span class="si-text">සියල්ල බලන්න ›</span>
          </a>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {recentProjects.map(proj => {
            const budget = proj.budget_range || null
            return (
              <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:14px;padding:14px 16px;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:6px;">
                  <span style="font-size:13px;font-weight:700;color:#0F172A;">{proj.project_type}</span>
                  <span style="font-size:10px;color:#94A3B8;white-space:nowrap;flex-shrink:0;">{timeAgoStr(proj.created_at)}</span>
                </div>
                {proj.district && <div style="font-size:11px;color:#64748B;margin-bottom:4px;">📍 {proj.district}</div>}
                {proj.description && <p style="font-size:12px;color:#64748B;margin:0 0 6px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{proj.description}</p>}
                {budget && <div style="font-size:11px;font-weight:600;color:#334155;">💰 {budget}</div>}
              </div>
            )
          })}
        </div>
      </div>
    </div>
  )}

  <!-- FAQ + district links -->
  <div style="background:#F8FAFC;padding:28px 16px 36px;border-top:1px solid #F1F5F9;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:20px;">
      <div>
        <h2 style="font-size:15px;font-weight:800;color:#0F172A;margin:0 0 12px;">{service.label} — FAQ</h2>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {SERVICE_FAQS.map(f => (
            <details style="background:#fff;border:1px solid #E2E8F0;border-radius:12px;padding:14px 16px;">
              <summary style="font-size:13px;font-weight:700;color:#0F172A;cursor:pointer;">{f.q}</summary>
              <p style="font-size:13px;color:#334155;line-height:1.8;margin:10px 0 0;">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
      {hasDistrictPages && (
        <div>
          <h2 style="font-size:14px;font-weight:800;color:#0F172A;margin:0 0 10px;">{service.label} by district</h2>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            {topDistricts.map(d => (
              <a href={serviceDistrictPath(service.slug, d)} style="font-size:12px;font-weight:700;color:#2563EB;background:#fff;border:1px solid #BFDBFE;border-radius:20px;padding:7px 14px;text-decoration:none;">{service.label} in {d.name}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Post Project CTA -->
  <div style="background:linear-gradient(135deg,#0F172A 0%,#0F172A 100%);padding:40px 20px;text-align:center;">
    <h2 style="font-family: 'Inter', sans-serif;font-size:clamp(18px,4vw,24px);font-weight:700;color:#fff;margin:0 0 10px;">
      <span class="en-text">Need {service.label} done?</span>
      <span class="si-text">{service.label} සේවාවක් අවශ්‍යද?</span>
    </h2>
    <p style="font-size:14px;color:rgba(255,255,255,0.65);margin:0 0 22px;line-height:1.7;">
      <span class="en-text">Post your project free — get quotes from verified specialists</span>
      <span class="si-text">ඔබේ ව්‍යාපෘතිය නොමිලේ පළ කර සත්‍යාපිත ශිල්පීන්ගේ ලංසු ලබා ගන්න</span>
    </p>
    <a href={postUrl}
      style="display:inline-flex;align-items:center;gap:8px;background:#2563EB;color:#fff;border-radius:24px;padding:13px 28px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(37,99,235,0.45);">
      📋
      <span class="en-text">Post Your Project →</span>
      <span class="si-text">ව්‍යාපෘතිය පලකරන්න →</span>
    </a>
  </div>

</Layout>
