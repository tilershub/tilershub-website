---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase.js'
import { SERVICES } from '../../lib/services.js'

export function getStaticPaths() {
  return SERVICES.map(s => ({ params: { slug: s.slug }, props: { service: s } }))
}

const { service } = Astro.props

const { data: providersRaw } = await supabase
  .from('providers')
  .select('id,name,city,district,verification_status,slug,services,provider_type,whatsapp,phone,description,profile_image,avg_rating,experience_years')
  .eq('status', 'active')
  .limit(200)

const providers = (providersRaw || []).filter(p =>
  (p.services || []).some(s =>
    service.terms.some(t => String(s).toLowerCase().includes(t.toLowerCase()))
  ) || service.terms.some(t => (p.description || '').toLowerCase().includes(t.toLowerCase()))
).slice(0, 30)

const AVATAR_COLORS = ['#1B3A6B','#0f766e','#7c3aed','#b45309','#0369a1','#E05A2B','#15803d','#be185d']
function avatarColor(name) {
  let h = 0
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function initials(name) {
  return name.split(' ').slice(0,2).map(w => w[0] || '').join('').toUpperCase() || '?'
}
function waLink(phone, name) {
  const cleaned = phone.replace(/\D/g, '')
  const intl = cleaned.startsWith('0') ? '94' + cleaned.slice(1) : cleaned
  return `https://wa.me/${intl}?text=${encodeURIComponent(`Hi, I found you on TilersHub. I'm looking for ${name}.`)}`
}

const pageTitle = `${service.label} in Sri Lanka — Verified Specialists | TilersHub`
const pageDesc  = `Find verified ${service.label} professionals across Sri Lanka. Compare quotes, read reviews, and contact directly on WhatsApp. Free on TilersHub.`
const postUrl   = `/post-project?type=${encodeURIComponent(service.label)}`
const total     = providers.length

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.label,
  description: pageDesc,
  provider: { '@type': 'Organization', name: 'TilersHub', url: 'https://www.tilershub.lk' },
  areaServed: { '@type': 'Country', name: 'Sri Lanka' },
  url: `https://www.tilershub.lk/services/${service.slug}`,
})
---

<Layout title={pageTitle} description={pageDesc}>
  <script slot="head" type="application/ld+json" set:html={serviceSchema} />

  <!-- Service header -->
  <div style="background:linear-gradient(135deg,#0F1E35 0%,#1A2B4A 100%);padding:28px 20px 24px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;">
      <div style="font-size:48px;margin-bottom:10px;">{service.icon}</div>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(20px,4.5vw,30px);font-weight:700;color:#fff;margin:0 0 8px;">{service.label}</h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.55);margin:0 0 20px;line-height:1.6;">
        Find verified {service.label} professionals across Sri Lanka
      </p>
      <a href={postUrl}
        style="display:inline-flex;align-items:center;gap:8px;background:#E05A2B;color:#fff;border-radius:24px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(224,90,43,0.4);">
        📋 Post a {service.label} Project
      </a>
    </div>
  </div>

  <!-- Provider list -->
  <div style="background:#f8fafc;min-height:300px;padding:20px 16px 80px;">

    {total === 0 ? (

      <div style="text-align:center;padding:48px 20px;">
        <div style="font-size:40px;margin-bottom:12px;">{service.icon}</div>
        <h2 style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:#0f172a;margin:0 0 8px;">No providers listed yet</h2>
        <p style="font-size:13px;color:#64748b;margin:0 0 20px;line-height:1.7;">
          Be the first {service.label} specialist on TilersHub, or post a project to receive bids.
        </p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
          <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:6px;background:#1B3A6B;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            ✅ Join as Provider
          </a>
          <a href={postUrl} style="display:inline-flex;align-items:center;gap:6px;background:#E05A2B;color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            📋 Post a Project
          </a>
        </div>
      </div>

    ) : (

      <div style="display:flex;flex-direction:column;gap:12px;max-width:640px;margin:0 auto;">

        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2px;">
          <span style="font-size:13px;font-weight:700;color:#374151;">{total} provider{total !== 1 ? 's' : ''} found</span>
          <a href="/providers" style="font-size:12px;color:#E05A2B;font-weight:600;text-decoration:none;">Browse all ›</a>
        </div>

        {providers.map(p => {
          const color = avatarColor(p.name || 'P')
          const inits = initials(p.name || 'P')
          const phone = p.whatsapp || p.phone
          const chips = (p.services || []).slice(0, 3)
          const isVerified = ['th_master','th_certified_pro','th_verified'].includes(p.verification_status)
          return (
            <div style="background:#fff;border-radius:20px;border:1px solid #e8edf5;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06);display:flex;">
              <div style={`width:100px;flex-shrink:0;background:${color};display:flex;align-items:center;justify-content:center;min-height:130px;overflow:hidden;`}>
                {p.profile_image
                  ? <img src={p.profile_image} alt={p.name} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                  : <span style="font-size:32px;font-weight:800;color:rgba(255,255,255,0.85);">{inits}</span>
                }
              </div>
              <div style="flex:1;padding:14px 16px;display:flex;flex-direction:column;min-width:0;">
                <div style="display:flex;align-items:flex-start;gap:7px;margin-bottom:4px;flex-wrap:wrap;">
                  <span style="font-size:15px;font-weight:700;color:#0f172a;line-height:1.25;">{p.name}</span>
                  {isVerified && <span style="font-size:8px;font-weight:700;color:#16a34a;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:20px;padding:2px 7px;flex-shrink:0;margin-top:2px;">✓ Pro</span>}
                </div>
                {(p.city || p.district) && <div style="font-size:11px;color:#64748b;margin-bottom:6px;">📍 {p.city || p.district}</div>}
                {p.description && <div style="font-size:12px;color:#64748b;margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.5;">{p.description}</div>}
                {chips.length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px;">
                    {chips.map(s => <span style="font-size:9px;font-weight:600;padding:2px 7px;border-radius:20px;background:#eef3fb;color:#1B3A6B;border:1px solid #d5e2f5;">{s}</span>)}
                  </div>
                )}
                {p.avg_rating > 0 && <div style="font-size:11px;color:#f59e0b;margin-bottom:8px;">⭐ {Number(p.avg_rating).toFixed(1)}</div>}
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:auto;">
                  {phone
                    ? <a href={waLink(phone, p.name)} target="_blank" rel="noopener noreferrer"
                        style="display:inline-flex;align-items:center;gap:5px;background:#25D366;color:#fff;border-radius:10px;padding:8px 14px;font-size:12px;font-weight:700;text-decoration:none;">
                        💬 WhatsApp
                      </a>
                    : p.slug
                      ? <a href={`/providers/${p.slug}`}
                          style="display:inline-flex;align-items:center;gap:5px;background:#1B3A6B;color:#fff;border-radius:10px;padding:8px 14px;font-size:12px;font-weight:700;text-decoration:none;">
                          View Profile ›
                        </a>
                      : null
                  }
                </div>
              </div>
            </div>
          )
        })}

      </div>
    )}
  </div>

</Layout>
