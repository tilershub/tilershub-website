---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase.js'

const { data: shopData } = await supabase
  .from('providers')
  .select('id,name,city,district,services,whatsapp,phone,description,verification_status,is_featured')
  .eq('provider_type', 'bathroom_shop')
  .eq('status', 'active')
  .order('is_featured', { ascending: false })

const shops = shopData || []

const PRODUCT_CATEGORIES = [
  { icon: '🚽', name: 'Sanitary Ware', desc: 'Toilets, basins, bidets and urinals from leading brands.' },
  { icon: '🚿', name: 'Showers & Enclosures', desc: 'Rain showers, handheld showers, shower screens and enclosures.' },
  { icon: '🛁', name: 'Bathtubs', desc: 'Freestanding, built-in and corner bathtubs for every bathroom size.' },
  { icon: '🔩', name: 'Faucets & Mixers', desc: 'Basin mixers, bath mixers, kitchen taps and deck-mounted faucets.' },
  { icon: '🪞', name: 'Mirrors & Cabinets', desc: 'Bathroom mirrors, vanity units and storage cabinets.' },
  { icon: '🧻', name: 'Accessories & Rails', desc: 'Towel rails, toilet paper holders, soap dispensers and hooks.' },
  { icon: '💡', name: 'Bathroom Lighting', desc: 'IP-rated ceiling lights, mirror lights and downlights.' },
  { icon: '🪣', name: 'Waterproofing & Drainage', desc: 'Floor traps, linear drains, waterproof membranes and seals.' },
]
---

<Layout
  title="Bathroom Products, Brands & Shops in Sri Lanka · TilersHub"
  description="Find bathroom product shops, sanitary ware brands, faucets, showers and bathroom fittings in Sri Lanka on TilersHub."
>

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#0f2444,#1B3A6B);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:700px;height:400px;background:radial-gradient(ellipse,rgba(255,255,255,0.04) 0%,transparent 70%);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span style="font-size:9px;font-weight:700;color:rgba(224,90,43,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:14px;">🚿 Bathroom Products</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:0 0 12px;line-height:1.2;">
        Bathroom <span style="color:var(--terra);">Products &amp; Fittings</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:480px;margin:0 auto 28px;line-height:1.8;">
        Discover bathroom product showrooms, sanitary ware brands, faucets, showers and fittings across Sri Lanka.
      </p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:7px;background:#E05A2B;color:#fff;border-radius:11px;padding:12px 22px;font-size:13px;font-weight:800;text-decoration:none;">
          🚿 List Your Shop
        </a>
        <a href="/brands" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.15);border-radius:11px;padding:12px 20px;font-size:13px;font-weight:600;text-decoration:none;">
          🏷️ Browse Brands →
        </a>
      </div>
    </div>
  </div>

  <!-- Product Categories -->
  <section style="background:var(--surface);padding:52px 20px 56px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:36px;">
        <span class="section-label">What You'll Find</span>
        <h2 style="font-family:'Playfair Display',serif;font-size:clamp(22px,3vw,32px);font-weight:700;color:var(--text);margin:8px 0 8px;">Product <em style="color:var(--terra);font-style:normal;">Categories</em></h2>
        <p style="font-size:13px;color:var(--text-3);">All the bathroom product categories available from registered shops</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;">
        {PRODUCT_CATEGORIES.map(cat => (
          <div style="background:#fff;border-radius:14px;border:1px solid var(--border);padding:20px;display:flex;gap:14px;align-items:flex-start;">
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#EFF6FF,#DBEAFE);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">{cat.icon}</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:4px;">{cat.name}</div>
              <div style="font-size:11px;color:var(--text-3);line-height:1.6;">{cat.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Shops Directory -->
  <section style="background:var(--surface-2);padding:48px 20px 64px;border-top:1px solid var(--border);">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:28px;">
        <div>
          <h2 style="font-family:'Playfair Display',serif;font-size:clamp(20px,3vw,28px);font-weight:700;color:var(--text);margin:0 0 4px;">Bathroom Product Showrooms</h2>
          <p style="font-size:13px;color:var(--text-3);margin:0;">
            {shops.length > 0 ? `${shops.length} shop${shops.length > 1 ? 's' : ''} listed` : 'Be the first to list your showroom'}
          </p>
        </div>
        <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;border-radius:11px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
          + List Your Showroom
        </a>
      </div>

      {shops.length > 0 ? (
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:16px;">
          {shops.map(s => (
            <div style="background:#fff;border-radius:16px;border:1px solid var(--border);overflow:hidden;">
              <div style="background:linear-gradient(135deg,#0f2444,#1B3A6B);padding:16px 18px;display:flex;align-items:center;gap:12px;">
                <div style="width:42px;height:42px;border-radius:11px;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🚿</div>
                <div style="flex:1;min-width:0;">
                  <div style="font-weight:700;font-size:14px;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{s.name}</div>
                  <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-top:1px;">📍 {s.city}{s.district ? `, ${s.district}` : ''}</div>
                </div>
              </div>
              <div style="padding:14px 18px 16px;">
                {s.description && <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:12px;">{s.description}</p>}
                {(s.services || []).length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(s.services || []).map(sv => (
                      <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:#EFF6FF;color:#1d4ed8;border:1px solid #BFDBFE;font-weight:600;">{sv}</span>
                    ))}
                  </div>
                )}
                <div style="display:flex;gap:8px;">
                  {s.whatsapp && (
                    <a href={`https://wa.me/${s.whatsapp.replace(/\D/g,'').replace(/^0/,'94')}?text=${encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *TilersHub* (www.tilershub.lk) හරහා *${s.name}* සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *TilersHub.lk* Lead\nස්තූතියි! 🏠`)}`} target="_blank" rel="noopener noreferrer"
                      style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#25D366;color:#fff;border-radius:10px;padding:8px;font-size:12px;font-weight:700;text-decoration:none;">
                      💬 WhatsApp
                    </a>
                  )}
                  {s.phone && (
                    <a href={`tel:${s.phone}`}
                      style="display:flex;align-items:center;justify-content:center;gap:5px;background:#eef3fb;color:var(--navy);border-radius:10px;padding:8px 12px;font-size:12px;font-weight:700;text-decoration:none;border:1px solid #d5e2f5;">
                      📞 Call
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div style="background:#fff;border-radius:20px;border:2px dashed var(--border);padding:56px 24px;text-align:center;max-width:540px;margin:0 auto;">
          <div style="font-size:52px;margin-bottom:16px;">🚿</div>
          <h3 style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:8px;">No bathroom showrooms listed yet</h3>
          <p style="font-size:13px;color:var(--text-3);line-height:1.8;margin-bottom:24px;max-width:380px;margin-left:auto;margin-right:auto;">
            Do you sell bathroom products, sanitary ware or fittings? Reach homeowners and contractors planning bathroom renovations — completely free.
          </p>
          <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
            🚿 List My Showroom Free
          </a>
          <p style="font-size:11px;color:var(--text-4);margin-top:14px;">Free listing · Direct WhatsApp leads · No commission</p>
        </div>
      )}
    </div>
  </section>

  <!-- LUXEhome Feature -->
  <section style="background:linear-gradient(135deg,#0c0804,#1a1008);padding:52px 20px;border-top:1px solid rgba(212,175,55,0.15);text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.025;background-image:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(212,175,55,0.8) 20px,rgba(212,175,55,0.8) 21px);pointer-events:none;"></div>
    <div style="position:relative;max-width:620px;margin:0 auto;">
      <div style="font-size:9px;font-weight:700;color:rgba(212,175,55,0.55);letter-spacing:3px;text-transform:uppercase;margin-bottom:14px;">◆ Premium Partner</div>
      <div style="font-family:'Playfair Display',serif;font-size:36px;font-weight:700;line-height:1;margin-bottom:10px;">
        <span style="color:#D4AF37;">LUXE</span><span style="color:rgba(255,255,255,0.88);">home</span>
      </div>
      <p style="font-size:14px;color:rgba(255,255,255,0.45);line-height:1.9;margin-bottom:28px;max-width:460px;margin-left:auto;margin-right:auto;">
        Sri Lanka's premium bathroom renovation and construction company. Complete design, supply and installation packages.
      </p>
      <a href="/sponsor/luxehome" style="display:inline-flex;align-items:center;gap:10px;background:#D4AF37;color:#0c0804;border-radius:12px;padding:14px 32px;font-size:14px;font-weight:800;text-decoration:none;box-shadow:0 6px 24px rgba(212,175,55,0.3);">
        🛁 View Renovation Packages
      </a>
    </div>
  </section>

  <!-- CTA for homeowners -->
  <section style="background:var(--surface);padding:44px 20px;border-top:1px solid var(--border);text-align:center;">
    <div style="max-width:560px;margin:0 auto;">
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(20px,3vw,28px);font-weight:700;color:var(--text);margin-bottom:10px;">Planning a bathroom renovation?</h2>
      <p style="font-size:13px;color:var(--text-3);margin-bottom:24px;line-height:1.8;">Post your project and get contacted by verified tilers, contractors and bathroom specialists near you.</p>
      <a href="/post-project" style="display:inline-flex;align-items:center;gap:8px;background:var(--terra);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
        📋 Post My Bathroom Project
      </a>
    </div>
  </section>

</Layout>
