---
export const prerender = false

const supabase = Astro.locals.supabase

// Exchange PKCE code for session (sets auth cookie via middleware's setAll handler)
const code = Astro.url.searchParams.get('code')
if (code) {
  await supabase.auth.exchangeCodeForSession(code)
}

const { data: { user } } = await supabase.auth.getUser()

if (!user) {
  return Astro.redirect('/login')
}

// Return to profile page if user was in the middle of a claim flow
const claimReturn = Astro.url.searchParams.get('claim_return')
if (claimReturn && claimReturn.startsWith('/providers/')) {
  return Astro.redirect(claimReturn)
}

const joinReturn = Astro.url.searchParams.get('join_return')
if (joinReturn === '/join-tilershub') {
  return Astro.redirect('/join-tilershub')
}

const verifyReturn = Astro.url.searchParams.get('verify_return')
if (verifyReturn?.startsWith('/verify-claim')) {
  return Astro.redirect(verifyReturn)
}

const ADMIN_EMAILS = ['tilershub@gmail.com']
if (ADMIN_EMAILS.includes(user.email ?? '')) {
  return Astro.redirect('/admin')
}

const [{ data: provider }, { data: sub }] = await Promise.all([
  supabase.from('providers').select('id').eq('user_id', user.id).maybeSingle(),
  supabase.from('provider_submissions').select('status').eq('user_id', user.id).maybeSingle(),
])

const isProvider =
  !!provider ||
  (sub && ['pending_review', 'approved', 'listed'].includes(sub.status))

return Astro.redirect(isProvider ? '/provider' : '/account')
---
