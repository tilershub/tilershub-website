---
import Layout from '../layouts/Layout.astro'

const posts = [
  {
    slug: 'how-to-choose-a-tiler',
    title: 'ව්‍යාපෘතිය සඳහා සුදුසු ටයිලර් තෝරා ගන්නේ කෙසේද',
    excerpt: 'සියලු ටයිලර් සමාන නොවේ. කුලී දීමට පෙර අත්දැකීම, references, ජල නිරෝධ දැනුම — කෙරෙහි අවධානය යොමු කරන්න.',
    category: 'බඳවා ගැනීමේ උපදෙස්',
    readTime: 'මිනිත්තු 4',
    icon: '👷',
    color: '#2563EB',
  },
  {
    slug: 'bathroom-renovation-cost-sri-lanka',
    title: 'ශ්‍රී ලංකාවේ නාන කාමර ප්‍රතිසංස්කරණ ගාස්තු (2025 මාර්ගෝපදේශය)',
    excerpt: 'සම්පූර්ණ නාන කාමර ප්‍රතිසංස්කරණයකට කොපමණ වැය වේද — ටයිල්, කම්කරු, නළ, fittings — විවිධ අයවැය සඳහා.',
    category: 'ගාස්තු මාර්ගෝපදේශය',
    readTime: 'මිනිත්තු 6',
    icon: '💰',
    color: '#2563EB',
  },
  {
    slug: 'best-tiles-for-bathroom-floor',
    title: 'ශ්‍රී ලංකාවේ නාන කාමර බිම සඳහා හොඳම ටයිල්',
    excerpt: 'Porcelain vs ceramic vs ස්වාභාවික ගල් — ශ්‍රී ලංකාවේ දේශගුණයට ගැළපෙන, කල් පවතින ටයිලය කුමක්ද.',
    category: 'ටයිල් මාර්ගෝපදේශය',
    readTime: 'මිනිත්තු 5',
    icon: '🪨',
    color: '#7c3aed',
  },
  {
    slug: 'waterproofing-bathroom-guide',
    title: 'ජල නිරෝධය ඕනෑම නාන කාමර ප්‍රතිසංස්කරණයේ වැදගත්ම පියවර ඇයි',
    excerpt: 'ජල නිරෝධය නොකිරීම හෝ ඉතිරි කිරීම — වසර 2–3ක් ඇතුළත නාන කාමර අසාර්ථක වීමේ #1 හේතුව. නිවැරදිව කරන ආකාරය.',
    category: 'ක්‍රම මාර්ගෝපදේශය',
    readTime: 'මිනිත්තු 5',
    icon: '💧',
    color: '#0369a1',
  },
  {
    slug: 'large-format-tiles-guide',
    title: 'විශාල ටයිල්: වාසි, අවාසි සහ සවි කිරීමේ උපදෙස්',
    excerpt: 'ශ්‍රී ලංකාවේ විශාල ටයිල් ජනප්‍රිය වෙමින් ඇත — නමුත් විශේෂ installers සහ ඝන ඇලවුම් අවශ්‍ය. මිලදී ගැනීමට පෙර දැනගත යුතු දේ.',
    category: 'ටයිල් මාර්ගෝපදේශය',
    readTime: 'මිනිත්තු 4',
    icon: '📏',
    color: '#2563EB',
  },
  {
    slug: 'post-tiling-project-tilershub',
    title: 'TilersHub හිදී ටයිලිං ව්‍යාපෘතිය ලිය කර හොඳම ලංසු ලබා ගන්නේ කෙසේද',
    excerpt: 'නිවැරදි ටයිලර්ලා ආකර්ෂණය කර නිවැරදි quotes ලැබෙන ව්‍යාපෘති විස්තරයක් ලිවීමේ පියවරෙන් පියවර මාර්ගෝපදේශය.',
    category: 'TilersHub මාර්ගෝපදේශය',
    readTime: 'මිනිත්තු 3',
    icon: '📋',
    color: '#2563EB',
  },
  {
    slug: 'tile-selection-guide-sri-lanka',
    title: 'නිවැරදි ටයිල් එක තෝරාගන්නේ කොහොමද? — Material, Surface සහ ලංකාවේ Market එක ගැන Expert මතය',
    excerpt: 'ලංකාවේ ඉදිකිරීම් ක්ෂේත්‍රයේ අවුරුදු 10ක් ගිය ශිල්පියෙකු ලෙස — Ceramic, Porcelain, Vitrified, Polished, Matte, Rocell, Mega Tiles, C2 Adhesive — ඔක්කොම ගැන honest breakdown.',
    category: 'ටයිල් මාර්ගෝපදේශය',
    readTime: 'මිනිත්තු 8',
    icon: '🧱',
    color: '#2563EB',
  },
]
---

<Layout
  title="Blog & Tips · TilersHub"
  description="Tiling guides, cost breakdowns, hiring tips and home improvement advice for Sri Lankan homeowners."
>
  <!-- Header -->
  <div style="background:linear-gradient(135deg,#0F172A 0%,#0F172A 100%);padding:32px 20px 28px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;">
      <span style="font-size:9px;font-weight:700;color:rgba(37,99,235,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:10px;">සම්පත්</span>
      <h1 style="font-family: 'Inter', sans-serif;font-size:clamp(22px,4vw,32px);font-weight:700;color:#fff;margin:0 0 8px;">බ්ලොග් සහ උපදෙස්</h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.5);margin:0;max-width:400px;margin:0 auto;">ශ්‍රී ලාංකික ගෙදර හිමිකරුවන් සඳහා ටයිලිං මාර්ගෝපදේශ, ගාස්තු සහ බඳවා ගැනීමේ උපදෙස්.</p>
    </div>
  </div>

  <!-- Post grid -->
  <div style="background:#F8FAFC;min-height:400px;padding:24px 16px 80px;overflow-x:hidden;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:12px;">
      {posts.slice(0,2).map(post => (
        <a href={`/blog/${post.slug}`}
          style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #E2E8F0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);transition:box-shadow 0.15s,border-color 0.15s;"
          onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.09)';this.style.borderColor='#CBD5E1'"
          onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.04)';this.style.borderColor='#E2E8F0'"
        >
          <div style={`width:82px;height:88px;background:${post.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:30px;`}>
            {post.icon}
          </div>
          <div style="flex:1;padding:14px 16px;min-width:0;">
            <div style="display:flex;align-items:center;gap:7px;margin-bottom:4px;">
              <span style="font-size:9px;font-weight:700;color:#2563EB;background:#EFF6FF;border:1px solid #BFDBFE;border-radius:20px;padding:1px 7px;">{post.category}</span>
              <span style="font-size:10px;color:#94A3B8;">{post.readTime}</span>
            </div>
            <div style="font-size:13px;font-weight:700;color:#0F172A;line-height:1.35;margin-bottom:4px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">{post.title}</div>
            <div style="font-size:11px;color:#64748B;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{post.excerpt}</div>
          </div>
          <div style="padding:0 14px;font-size:20px;color:#CBD5E1;flex-shrink:0;">›</div>
        </a>
      ))}

      <!-- Post project CTA card -->
      <a href="/post-project"
        style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:#2563EB;border-radius:14px;padding:16px 18px;text-decoration:none;box-shadow:0 4px 18px rgba(37,99,235,0.25);">
        <div style="font-size:28px;flex-shrink:0;">🏠</div>
        <div style="flex:1;min-width:160px;">
          <div style="font-size:13px;font-weight:800;color:#fff;margin-bottom:3px;">ව්‍යාපෘතිය ආරම්භ කිරීමට සූදානම්ද?</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.78);line-height:1.5;">නොමිලේ පලකරන්න, WhatsApp හරහා සත්‍යාපිත වෘත්තිකයන්ගේ ලංසු ලබා ගන්න.</div>
        </div>
        <div style="background:rgba(255,255,255,0.18);color:#fff;border-radius:10px;padding:9px 16px;font-size:12px;font-weight:800;white-space:nowrap;flex-shrink:0;">
          නොමිලේ පලකරන්න →
        </div>
      </a>

      {posts.slice(2).map(post => (
        <a href={`/blog/${post.slug}`}
          style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #E2E8F0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);transition:box-shadow 0.15s,border-color 0.15s;"
          onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.09)';this.style.borderColor='#CBD5E1'"
          onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.04)';this.style.borderColor='#E2E8F0'"
        >
          <div style={`width:82px;height:88px;background:${post.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:30px;`}>
            {post.icon}
          </div>
          <div style="flex:1;padding:14px 16px;min-width:0;">
            <div style="display:flex;align-items:center;gap:7px;margin-bottom:4px;">
              <span style="font-size:9px;font-weight:700;color:#2563EB;background:#EFF6FF;border:1px solid #BFDBFE;border-radius:20px;padding:1px 7px;">{post.category}</span>
              <span style="font-size:10px;color:#94A3B8;">{post.readTime}</span>
            </div>
            <div style="font-size:13px;font-weight:700;color:#0F172A;line-height:1.35;margin-bottom:4px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">{post.title}</div>
            <div style="font-size:11px;color:#64748B;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{post.excerpt}</div>
          </div>
          <div style="padding:0 14px;font-size:20px;color:#CBD5E1;flex-shrink:0;">›</div>
        </a>
      ))}

      <!-- Coming soon card -->
      <div style="text-align:center;padding:28px 20px;background:#fff;border-radius:14px;border:1.5px dashed #E2E8F0;margin-top:4px;">
        <div style="font-size:32px;margin-bottom:10px;">✍️</div>
        <div style="font-size:13px;font-weight:700;color:#334155;margin-bottom:4px;">තවත් ලිපි ළඟදීම</div>
        <div style="font-size:12px;color:#94A3B8;">මහල, ජල නිරෝධ, ගාස්තු ගණනය සහ තවත් — ලිපි ළඟදීම.</div>
      </div>
    </div>
  </div>

</Layout>
