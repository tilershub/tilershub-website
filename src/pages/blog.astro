---
import Layout from '../layouts/Layout.astro'

const posts = [
  {
    slug: 'how-to-choose-a-tiler',
    title: 'How to Choose the Right Tiler for Your Project',
    excerpt: 'Not all tilers are equal. Learn what to look for — experience, references, waterproofing knowledge — before hiring.',
    category: 'Hiring Tips',
    readTime: '4 min read',
    icon: '👷',
    color: '#1B3A6B',
  },
  {
    slug: 'bathroom-renovation-cost-sri-lanka',
    title: 'Bathroom Renovation Costs in Sri Lanka (2025 Guide)',
    excerpt: 'A realistic breakdown of what a full bathroom renovation costs — tiles, labour, plumbing, fittings — across different budgets.',
    category: 'Cost Guide',
    readTime: '6 min read',
    icon: '💰',
    color: '#0f766e',
  },
  {
    slug: 'best-tiles-for-bathroom-floor',
    title: 'Best Tiles for Bathroom Floors in Sri Lanka',
    excerpt: 'Porcelain vs ceramic vs natural stone — which tile works best in Sri Lanka\'s climate and which holds up over time.',
    category: 'Tile Guide',
    readTime: '5 min read',
    icon: '🪨',
    color: '#7c3aed',
  },
  {
    slug: 'waterproofing-bathroom-guide',
    title: 'Why Waterproofing Is the Most Important Step in Any Bathroom Reno',
    excerpt: 'Skipping or cutting corners on waterproofing is the #1 reason bathrooms fail within 2–3 years. Here\'s how to do it right.',
    category: 'How-To',
    readTime: '5 min read',
    icon: '💧',
    color: '#0369a1',
  },
  {
    slug: 'large-format-tiles-guide',
    title: 'Large Format Tiles: Pros, Cons & Installation Tips',
    excerpt: 'Big tiles are trending in Sri Lanka — but they need specialist installers and thicker adhesive. What to know before you buy.',
    category: 'Tile Guide',
    readTime: '4 min read',
    icon: '📏',
    color: '#b45309',
  },
  {
    slug: 'post-tiling-project-tilershub',
    title: 'How to Post a Tiling Project on TilersHub and Get the Best Bids',
    excerpt: 'Step-by-step guide to writing a project description that attracts the right tilers and gets you accurate quotes.',
    category: 'TilersHub Guide',
    readTime: '3 min read',
    icon: '📋',
    color: '#E05A2B',
  },
]
---

<Layout
  title="Blog & Tips · TilersHub"
  description="Tiling guides, cost breakdowns, hiring tips and home improvement advice for Sri Lankan homeowners."
>
  <!-- Header -->
  <div style="background:linear-gradient(135deg,#0F1E35 0%,#1A2B4A 100%);padding:32px 20px 28px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;">
      <span style="font-size:9px;font-weight:700;color:rgba(224,90,43,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:10px;">Resources</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(22px,4vw,32px);font-weight:700;color:#fff;margin:0 0 8px;">Blog &amp; Tips</h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.5);margin:0;max-width:400px;margin:0 auto;">Tiling guides, cost breakdowns and hiring advice for Sri Lankan homeowners.</p>
    </div>
  </div>

  <!-- Post grid -->
  <div style="background:#f8fafc;min-height:400px;padding:24px 16px 80px;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:12px;">
      {posts.slice(0,2).map(post => (
        <a href={`/blog/${post.slug}`}
          style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);transition:box-shadow 0.15s,border-color 0.15s;"
          onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.09)';this.style.borderColor='#cbd5e1'"
          onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.04)';this.style.borderColor='#e2e8f0'"
        >
          <div style={`width:82px;height:88px;background:${post.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:30px;`}>
            {post.icon}
          </div>
          <div style="flex:1;padding:14px 16px;min-width:0;">
            <div style="display:flex;align-items:center;gap:7px;margin-bottom:4px;">
              <span style="font-size:9px;font-weight:700;color:#E05A2B;background:#fff4f0;border:1px solid #fcd5c0;border-radius:20px;padding:1px 7px;">{post.category}</span>
              <span style="font-size:10px;color:#94a3b8;">{post.readTime}</span>
            </div>
            <div style="font-size:13px;font-weight:700;color:#111827;line-height:1.35;margin-bottom:4px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">{post.title}</div>
            <div style="font-size:11px;color:#64748b;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{post.excerpt}</div>
          </div>
          <div style="padding:0 14px;font-size:20px;color:#cbd5e1;flex-shrink:0;">›</div>
        </a>
      ))}

      <!-- Post project CTA card -->
      <a href="/post-project"
        style="display:flex;align-items:center;gap:16px;background:#E05A2B;border-radius:14px;padding:18px 20px;text-decoration:none;box-shadow:0 4px 18px rgba(224,90,43,0.25);">
        <div style="font-size:32px;flex-shrink:0;">🏠</div>
        <div style="flex:1;">
          <div style="font-size:14px;font-weight:800;color:#fff;margin-bottom:3px;">Ready to Start Your Project?</div>
          <div style="font-size:12px;color:rgba(255,255,255,0.78);line-height:1.5;">Post free and get bids from verified pros on WhatsApp. No login required.</div>
        </div>
        <div style="flex-shrink:0;background:rgba(255,255,255,0.15);color:#fff;border-radius:10px;padding:10px 18px;font-size:13px;font-weight:800;white-space:nowrap;">
          Post Free →
        </div>
      </a>

      {posts.slice(2).map(post => (
        <a href={`/blog/${post.slug}`}
          style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);transition:box-shadow 0.15s,border-color 0.15s;"
          onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.09)';this.style.borderColor='#cbd5e1'"
          onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.04)';this.style.borderColor='#e2e8f0'"
        >
          <div style={`width:82px;height:88px;background:${post.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:30px;`}>
            {post.icon}
          </div>
          <div style="flex:1;padding:14px 16px;min-width:0;">
            <div style="display:flex;align-items:center;gap:7px;margin-bottom:4px;">
              <span style="font-size:9px;font-weight:700;color:#E05A2B;background:#fff4f0;border:1px solid #fcd5c0;border-radius:20px;padding:1px 7px;">{post.category}</span>
              <span style="font-size:10px;color:#94a3b8;">{post.readTime}</span>
            </div>
            <div style="font-size:13px;font-weight:700;color:#111827;line-height:1.35;margin-bottom:4px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">{post.title}</div>
            <div style="font-size:11px;color:#64748b;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{post.excerpt}</div>
          </div>
          <div style="padding:0 14px;font-size:20px;color:#cbd5e1;flex-shrink:0;">›</div>
        </a>
      ))}

      <!-- Coming soon card -->
      <div style="text-align:center;padding:28px 20px;background:#fff;border-radius:14px;border:1.5px dashed #e2e8f0;margin-top:4px;">
        <div style="font-size:32px;margin-bottom:10px;">✍️</div>
        <div style="font-size:13px;font-weight:700;color:#374151;margin-bottom:4px;">More articles coming soon</div>
        <div style="font-size:12px;color:#94a3b8;">Guides on flooring, waterproofing, cost estimates &amp; more.</div>
      </div>
    </div>
  </div>

</Layout>
