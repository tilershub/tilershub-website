---
import Layout from '../../layouts/Layout.astro'
import ProviderDirectory from '../../components/ProviderDirectory.jsx'

const rawType = Astro.url.searchParams.get('type') || ''
const type = rawType  // keep empty for "all" but default label is Tilers
const q = Astro.url.searchParams.get('q') || ''

const TYPE_LABELS = {
  tiler: 'Tilers', workshop: 'Workshops', supplier: 'Suppliers',
  contractor: 'Contractors', tile_shop: 'Tile Shops', brand_dealer: 'Brand Dealers'
}
const pageTitle = type ? `${TYPE_LABELS[type] || 'Providers'} in Sri Lanka` : 'Find Tiling Providers in Sri Lanka'
---

<Layout
  title={`${pageTitle} · TilersHub`}
  description="Find verified tilers, workshops, suppliers, contractors and tile shops across Sri Lanka. Contact directly via WhatsApp."
>

  <!-- Page Header -->
  <div style="background:var(--navy);padding:40px 20px 36px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="max-width:1100px;margin:0 auto;position:relative;text-align:center;">
      <span style="font-size:9px;font-weight:700;color:rgba(224,90,43,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:12px;">Provider Directory</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(24px,4vw,40px);font-weight:700;color:#fff;margin-bottom:10px;line-height:1.2;">
        {type ? TYPE_LABELS[type] || 'Providers' : 'Tiling'} <span style="color:var(--terra);">Professionals</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:440px;margin:0 auto;">
        Connect directly via WhatsApp — no middlemen, no fees
      </p>
    </div>
  </div>

  <ProviderDirectory client:only="react" initialType={type} initialSearch={q} />

</Layout>
