---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase.js'
import ReviewsSection from '../../components/ReviewsSection.jsx'
import ClaimProfile from '../../components/ClaimProfile.jsx'
import EditProfileButton from '../../components/EditProfileButton.jsx'

export async function getStaticPaths() {
  const [{ data: providers }, { data: tilers }] = await Promise.all([
    supabase.from('providers').select('slug,id').not('slug', 'is', null),
    supabase.from('tilers').select('id,slug'),
  ])
  const paths = []
  for (const p of providers || []) {
    if (p.slug) paths.push({ params: { slug: p.slug }, props: { type: 'provider', lookupKey: p.slug } })
  }
  for (const t of tilers || []) {
    if (t.slug) {
      // SEO-friendly slug path (primary)
      paths.push({ params: { slug: t.slug }, props: { type: 'tiler', lookupKey: t.slug } })
      // UUID path for backward compat
      paths.push({ params: { slug: String(t.id) }, props: { type: 'tiler', lookupKey: t.slug } })
    } else {
      paths.push({ params: { slug: String(t.id) }, props: { type: 'tiler', lookupKey: String(t.id) } })
    }
  }
  return paths
}

const { slug } = Astro.params
const { type, lookupKey } = Astro.props

let provider = null
let tiler = null

if (type === 'provider') {
  const { data } = await supabase.from('providers').select('*').eq('slug', lookupKey).single()
  provider = data
} else {
  const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(lookupKey)
  const { data } = isUuid
    ? await supabase.from('tilers').select('*').eq('id', lookupKey).single()
    : await supabase.from('tilers').select('*').eq('slug', lookupKey).single()
  tiler = data
}

if (!provider && !tiler) return Astro.redirect('/providers')

const item = provider || tiler
const isTiler = !!tiler
const name = isTiler ? item.full_name : item.name
const phone = item.whatsapp || item.phone
const altPhone = (isTiler && item.whatsapp && item.phone && item.whatsapp !== item.phone) ? item.phone : null
const city = item.city || item.district

function waLink(p, n) {
  const digits = (p || '').replace(/\D/g, '')
  const normalized = digits.startsWith('94') ? digits : '94' + digits.replace(/^0/, '')
  const who = n ? `*${n}*` : 'ඔබව'
  const msg = encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *TilersHub* (www.tilershub.lk) හරහා ${who} සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *TilersHub.lk* Lead\nස්තූතියි! 🏠`)
  return `https://wa.me/${normalized}?text=${msg}`
}

const PROVIDER_TYPE_LABELS = {
  tiler: 'Tiler', workshop: 'Workshop', supplier: 'Supplier',
  contractor: 'Contractor', tile_shop: 'Tile Shop', brand_dealer: 'Brand Dealer'
}

const typeLabel = isTiler ? 'Tiler' : (PROVIDER_TYPE_LABELS[item.provider_type] || 'Provider')

const coverBg = isTiler
  ? 'linear-gradient(135deg,#0F2444 0%,#1B3A6B 100%)'
  : 'linear-gradient(135deg,#0f2444 0%,#1B3A6B 100%)'

const isUnverified = isTiler && !item.is_verified
const metaDesc = isUnverified
  ? `${name} is a tiling professional based in ${city}, Sri Lanka. Find contact details on TilersHub.`
  : `Contact ${name}, a verified ${typeLabel.toLowerCase()} based in ${city}, Sri Lanka. Direct WhatsApp contact on TilersHub.`
---

<Layout
  title={`${name} · ${typeLabel} in ${city} · TilersHub`}
  description={metaDesc}
>

  <!-- Hero -->
  <div style={`background:${coverBg};padding:48px 20px 40px;position:relative;overflow:hidden;`}>
    <div style="position:absolute;inset:0;opacity:0.05;background-image:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(255,255,255,0.8) 20px,rgba(255,255,255,0.8) 21px);pointer-events:none;"></div>
    <div style="max-width:800px;margin:0 auto;position:relative;">
      <a href="/providers" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:rgba(255,255,255,0.45);letter-spacing:1px;font-weight:600;margin-bottom:24px;text-decoration:none;">← All Providers</a>
      <div style="display:flex;align-items:flex-start;gap:20px;flex-wrap:wrap;">
        <div style="width:72px;height:72px;border-radius:18px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:#fff;flex-shrink:0;overflow:hidden;">
          {(isTiler ? item.avatar_url : item.profile_image)
            ? <img src={isTiler ? item.avatar_url : item.profile_image} alt={name} style="width:100%;height:100%;object-fit:cover;" />
            : name.split(' ').map((w: string) => w[0]).join('').slice(0,2).toUpperCase()
          }
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.5);letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;">{typeLabel}</div>
          <h1 style="font-family:'Playfair Display',serif;font-size:clamp(22px,4vw,36px);font-weight:700;color:#fff;margin-bottom:6px;line-height:1.2;">{name}</h1>
          <div style="font-size:14px;color:rgba(255,255,255,0.6);">📍 {city}</div>
          {isTiler && item.is_verified && (
            <span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(22,163,74,0.2);color:#4ade80;border:1px solid rgba(74,222,128,0.3);margin-top:8px;">✓ Skilled</span>
          )}
          {isTiler && !item.is_verified && (
            <span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(0,0,0,0.3);color:rgba(255,255,255,0.65);border:1px solid rgba(255,255,255,0.2);margin-top:8px;">Unverified</span>
          )}
          {!isTiler && item.verification_status === 'th_verified' && (
            <span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(22,163,74,0.2);color:#4ade80;border:1px solid rgba(74,222,128,0.3);margin-top:8px;">✓ TH Verified</span>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <section style="background:var(--surface);padding:36px 20px 64px;">
    <div style="max-width:800px;margin:0 auto;display:grid;grid-template-columns:1fr min(280px,100%);gap:24px;align-items:start;flex-wrap:wrap;">

      <!-- Left: details -->
      <div>

        {isUnverified && (
          <div style="background:#fef9f0;border:1px solid #fde68a;border-radius:12px;padding:14px 18px;margin-bottom:20px;font-size:13px;color:#78716c;line-height:1.7;">
            ℹ️ This profile was added from community-submitted information and has not yet been verified by TILERSHUB.
          </div>
        )}

        {(isTiler ? item.bio : item.description) && (
          <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:22px;margin-bottom:20px;">
            <h2 style="font-size:13px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;">About</h2>
            <p style="font-size:14px;color:var(--text-2);line-height:1.8;">{isTiler ? item.bio : item.description}</p>
          </div>
        )}

        {(item.services || []).length > 0 && (
          <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:22px;margin-bottom:20px;">
            <h2 style="font-size:13px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;">Services</h2>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {(item.services || []).map((s: string) => (
                <span class="chip chip-navy">{s}</span>
              ))}
            </div>
          </div>
        )}

        {isTiler && item.experience_years > 0 && (item.total_jobs > 0 || item.daily_rate_min) && (
          <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:22px;margin-bottom:20px;">
            <h2 style="font-size:13px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;">Experience</h2>
            <div style="display:flex;gap:12px;flex-wrap:wrap;">
              {item.experience_years > 0 && (
                <div style="padding:12px 20px;background:#fff;border-radius:12px;border:1px solid var(--border);text-align:center;min-width:80px;">
                  <div style="font-size:20px;font-weight:700;color:var(--navy);">{item.experience_years}+</div>
                  <div style="font-size:10px;color:var(--text-4);margin-top:2px;">Years Exp.</div>
                </div>
              )}
              {item.total_jobs > 0 && (
                <div style="padding:12px 20px;background:#fff;border-radius:12px;border:1px solid var(--border);text-align:center;min-width:80px;">
                  <div style="font-size:20px;font-weight:700;color:var(--navy);">{item.total_jobs}</div>
                  <div style="font-size:10px;color:var(--text-4);margin-top:2px;">Jobs Done</div>
                </div>
              )}
              {item.daily_rate_min && (
                <div style="padding:12px 20px;background:#fff;border-radius:12px;border:1px solid var(--border);text-align:center;">
                  <div style="font-size:16px;font-weight:700;color:var(--navy);">Rs.{item.daily_rate_min}–{item.daily_rate_max}/sqft</div>
                  <div style="font-size:10px;color:var(--text-4);margin-top:2px;">Rate per sq.ft</div>
                </div>
              )}
            </div>
          </div>
        )}

        {(item.gallery || []).length > 0 && (
          <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:22px;margin-bottom:20px;">
            <h2 style="font-size:13px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;">📸 Portfolio</h2>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px;">
              {(item.gallery || []).map((img: string, i: number) => (
                <img src={img} alt={`Work photo ${i + 1}`}
                  style="width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;border:1px solid var(--border);" />
              ))}
            </div>
          </div>
        )}

        {!isTiler && (item.service_areas || []).length > 0 && (
          <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:22px;margin-bottom:20px;">
            <h2 style="font-size:13px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;">Service Areas</h2>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {(item.service_areas || []).map((area: string) => (
                <span class="chip chip-gray">📍 {area}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Reviews -->
        {isTiler
          ? <ReviewsSection client:load tilerId={tiler.id} />
          : <ReviewsSection client:load providerId={provider.id} />
        }

      </div>

      <!-- Right: contact card -->
      <div style="position:sticky;top:80px;">
        <div style="background:#fff;border:1.5px solid var(--border);border-radius:20px;padding:24px;box-shadow:var(--shadow);">
          <div style="font-size:12px;font-weight:700;color:var(--text-4);text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;">Contact {isTiler ? 'Tiler' : typeLabel}</div>

          {phone && (
            <a href={waLink(phone, name)} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:#25D366;color:#fff;border-radius:12px;padding:14px;font-size:14px;font-weight:700;text-decoration:none;margin-bottom:10px;box-shadow:0 4px 14px rgba(37,211,102,0.25);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          )}

          {altPhone && (
            <a href={waLink(altPhone, name)} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:#f0fdf4;color:#16a34a;border:1.5px solid #bbf7d0;border-radius:12px;padding:12px;font-size:13px;font-weight:700;text-decoration:none;margin-bottom:10px;">
              💬 Alt. Number
            </a>
          )}
          <div style="height:1px;background:var(--border);margin-bottom:16px;"></div>
          <div style="font-size:12px;color:var(--text-3);line-height:1.7;">
            📍 Based in <strong style="color:var(--text-2);">{city}</strong>
          </div>
          {item.district && item.district !== item.city && (
            <div style="font-size:12px;color:var(--text-3);margin-top:4px;">🗺️ {item.district} District</div>
          )}
          {!isTiler && item.website_url && (
            <a href={item.website_url} target="_blank" rel="noopener" style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--navy);margin-top:12px;text-decoration:none;">🌐 Visit Website →</a>
          )}
        </div>

        <a href="/post-project" style="display:flex;align-items:center;justify-content:center;gap:6px;background:var(--terra);color:#fff;border-radius:12px;padding:12px;margin-top:12px;font-size:13px;font-weight:700;text-decoration:none;text-align:center;">
          📋 Post Your Project Free
        </a>

        <button
          id="share-profile-btn"
          style="display:flex;align-items:center;justify-content:center;gap:6px;width:100%;background:#f1f5f9;color:#374151;border:1px solid #e2e8f0;border-radius:12px;padding:10px;font-size:12px;font-weight:700;cursor:pointer;margin-top:10px;">
          🔗 Share Profile
        </button>

        <EditProfileButton
          client:load
          ownerId={isTiler ? tiler.user_id : provider.user_id}
          profileType={isTiler ? 'tiler' : 'provider'}
          profileSlug={item.slug}
        />

        <ClaimProfile
          client:load
          profileId={isTiler ? tiler.id : provider.id}
          profileType={isTiler ? 'tiler' : 'provider'}
          profileName={name}
          isClaimed={!!(isTiler ? tiler.user_id : provider.user_id)}
        />
      </div>

    </div>
  </section>

  <style>
    @media (max-width: 600px) {
      section > div { grid-template-columns: 1fr !important; }
    }
  </style>

  <script define:vars={{ profileName: name, profileUrl: Astro.url.href }}>
    const btn = document.getElementById('share-profile-btn')
    if (btn) {
      btn.addEventListener('click', async () => {
        const title = `${profileName} on TilersHub`
        const url = profileUrl
        if (navigator.share) {
          try { await navigator.share({ title, url }) } catch (_) {}
        } else {
          await navigator.clipboard.writeText(url)
          btn.textContent = '✓ Link Copied!'
          setTimeout(() => { btn.textContent = '🔗 Share Profile' }, 2000)
        }
      })
    }
  </script>

</Layout>
