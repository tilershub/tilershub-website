---
import Layout from '../layouts/Layout.astro'

const supabase = Astro.locals.supabase

const { data: allBrands } = await supabase
  .from('brands').select('*').eq('status', 'active')
  .order('is_featured', { ascending: false }).order('name')
const brands = allBrands || []

// All active brands in one carousel

const { data: shopData } = await supabase
  .from('providers')
  .select('id,name,city,district,services,whatsapp,phone,description,verification_status,is_featured')
  .eq('provider_type', 'tile_shop')
  .eq('status', 'active')
  .order('is_featured', { ascending: false })
const shops = shopData || []

// Verified tilers for interleaving into shop list
const { data: tilerData } = await supabase
  .from('tilers')
  .select('id,full_name,slug,city,district,services,experience_years,phone,whatsapp')
  .eq('is_verified', true)
  .not('slug', 'is', null)
  .order('experience_years', { ascending: false })
  .limit(12)
const verifiedTilers = tilerData || []

function normPhone(phone) {
  const raw = (phone || '').replace(/\D/g, '')
  return raw.startsWith('94') ? raw : '94' + raw.replace(/^0/, '')
}
function initials(name) {
  return (name || '').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()
}

// Build interleaved list: insert a verified tiler card after every 5th shop
const interleaved = []
let tilerIdx = 0
shops.forEach((shop, i) => {
  interleaved.push({
    type: 'shop',
    id: shop.id,
    name: shop.name,
    city: shop.city,
    district: shop.district,
    description: shop.description,
    services: shop.services || [],
    waLink: (shop.whatsapp || shop.phone)
      ? `https://wa.me/${normPhone(shop.whatsapp || shop.phone)}?text=${encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම TilersHub හරහා ${shop.name} සොයාගතිමි.\nස්තූතියි!`)}`
      : null,
    phone: shop.phone,
    isFeatured: shop.is_featured,
  })
  if ((i + 1) % 5 === 0 && tilerIdx < verifiedTilers.length) {
    const t = verifiedTilers[tilerIdx++]
    interleaved.push({
      type: 'tiler',
      id: t.id,
      name: t.full_name,
      slug: t.slug,
      city: t.city,
      district: t.district,
      services: t.services || [],
      experience_years: t.experience_years,
      initials: initials(t.full_name),
      waLink: `https://wa.me/${normPhone(t.whatsapp || t.phone)}?text=${encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම TilersHub හරහා ${t.full_name} සොයාගතිමි.\nTiling සේවාව ගැන කතා කිරීමට කැමැත්තෙමි.\nස්තූතියි!`)}`,
    })
  }
})

const BRAND_META = {
  'rocell':      { color: '#FFFFFF', bg: '#002B5B' },
  'lanka-tile':  { color: '#FFFFFF', bg: '#CC2229' },
  'macktiles':   { color: '#FFFFFF', bg: '#2E7D32' },
  'megatile':    { color: '#FFFFFF', bg: '#5D4037' },
  'swisstek':    { color: '#FFFFFF', bg: '#1565C0' },
  'tokyo-super': { color: '#FFFFFF', bg: '#C62828' },
  'dr-fixit':    { color: '#FFFFFF', bg: '#E65100' },
  'sika':        { color: '#FFFFFF', bg: '#B71C1C' },
  'finex':       { color: '#FFFFFF', bg: '#1A237E' },
}
function meta(brand) { return BRAND_META[brand.slug] || { color: '#fff', bg: '#0F766E' } }
function logoText(name) { return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() }
---

<Layout
  title="Tile Shops, Tile Brands & Adhesives in Sri Lanka · TilersHub"
  description="Find tile shops, tile brands (Rocell, Lanka Tile, Megatile) and adhesive brands (Swisstek, Tokyo Super) in Sri Lanka — plus verified tile experts."
>

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#1a0a00,#2B1800,#3D2200);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span style="font-size:9px;font-weight:700;color:rgba(217,119,6,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:14px;">🪨 Tile</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:0 0 12px;line-height:1.2;">
        Tiles, Shops <span style="color:var(--terra);">&amp; Brands</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:480px;margin:0 auto 28px;line-height:1.8;">
        Browse tile shops, leading tile brands, adhesives and grouts — and connect with expert tilers across Sri Lanka.
      </p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:7px;background:#D97706;color:#fff;border-radius:11px;padding:12px 22px;font-size:13px;font-weight:800;text-decoration:none;">
          🪨 List Your Tile Shop
        </a>
        <a href="/providers" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.15);border-radius:11px;padding:12px 20px;font-size:13px;font-weight:600;text-decoration:none;">
          👷 Find a Tiler →
        </a>
      </div>
    </div>
  </div>

  <section style="background:var(--surface);padding:52px 0 64px;">
    <div style="max-width:1100px;margin:0 auto;padding:0 20px;">

      <!-- ── All Brands — horizontal scroll carousel ── -->
      {brands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;">
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="width:36px;height:36px;background:linear-gradient(135deg,var(--navy),#0D9488);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🪨</div>
              <div>
                <div style="font-size:18px;font-weight:700;color:var(--text);">Brands</div>
                <div style="font-size:12px;color:var(--text-4);">Tiles, adhesives, grouts, waterproofing &amp; more</div>
              </div>
            </div>
            <span style="font-size:11px;color:var(--text-4);white-space:nowrap;">← swipe →</span>
          </div>

          <div style="position:relative;">
            <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;padding:4px 0 14px;margin:0 -20px;padding-left:20px;padding-right:20px;" class="tile-brands-scroll">
              <div style="display:flex;gap:16px;width:max-content;">
                {brands.map(brand => {
                  const m = meta(brand)
                  const href = brand.dedicated_page_url || `/brands/${brand.slug}`
                  const isFeaturedPage = !!brand.dedicated_page_url
                  return (
                    <a href={href}
                      style={`display:block;width:240px;flex-shrink:0;background:#fff;border-radius:16px;border:${isFeaturedPage ? '2px solid var(--gold)' : '1px solid #e2e8f0'};padding:20px;text-decoration:none;color:inherit;scroll-snap-align:start;position:relative;overflow:hidden;`}>
                      {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0d0b08;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 10px;border-bottom-left-radius:10px;">Sponsored</div>}
                      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                        <div style={`width:52px;height:52px;border-radius:13px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family:'Playfair Display',serif;`}>{logoText(brand.name)}</div>
                        <div>
                          <div style="font-size:15px;font-weight:700;color:var(--text);line-height:1.2;">{brand.name}</div>
                          {isFeaturedPage
                            ? <span style="font-size:10px;color:#92762a;font-weight:700;">⭐ Featured</span>
                            : brand.is_featured && <span style="font-size:10px;color:var(--navy);font-weight:700;">✓ Verified</span>
                          }
                        </div>
                      </div>
                      <p style="font-size:11px;color:var(--text-3);line-height:1.6;margin:0 0 12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{brand.description}</p>
                      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:12px;">
                        {(brand.categories || []).slice(0, 2).map(c => (
                          <span style={`font-size:9px;padding:2px 8px;border-radius:20px;background:${m.bg}14;color:${m.bg === '#FFFFFF' ? '#0F766E' : m.bg};border:1px solid ${m.bg}28;font-weight:600;`}>{c}</span>
                        ))}
                      </div>
                      <div style="font-size:11px;font-weight:700;color:var(--navy);">{isFeaturedPage ? 'View Sponsor Page →' : 'View Brand →'}</div>
                    </a>
                  )
                })}
              </div>
            </div>
            <!-- Right fade hint -->
            <div style="position:absolute;top:0;right:0;width:48px;height:calc(100% - 14px);background:linear-gradient(to left,var(--surface),transparent);pointer-events:none;"></div>
          </div>
        </div>
      )}

      <!-- ── Tile Shops + Verified Tiler cards every 5 shops ── -->
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#2E7D32,#1B5E20);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🏪</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Tile Shops</div>
              <div style="font-size:12px;color:var(--text-4);">
                {shops.length > 0 ? `${shops.length} shop${shops.length > 1 ? 's' : ''} listed islandwide` : 'Be the first to list your tile shop'}
              </div>
            </div>
          </div>
          <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;border-radius:11px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            + List Your Shop
          </a>
        </div>

        {shops.length > 0 ? (
          <div style="display:flex;flex-direction:column;gap:12px;max-width:740px;">
            {interleaved.map(item => item.type === 'tiler' ? (
              /* ── Verified Tiler interleave card ── */
              <div style="background:linear-gradient(135deg,#F0FDFA,#E8F0FF);border-radius:18px;border:2px solid var(--navy);padding:16px 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;position:relative;">
                <div style="position:absolute;top:0;left:0;background:var(--navy);color:#fff;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-right-radius:10px;border-top-left-radius:16px;">✓ Skill Verified Tiler</div>
                <div style="padding-top:18px;display:flex;align-items:center;gap:14px;flex:1;min-width:220px;flex-wrap:wrap;">
                  <div style="width:52px;height:52px;border-radius:50%;background:var(--navy);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:#fff;flex-shrink:0;border:3px solid var(--gold);">
                    {item.initials}
                  </div>
                  <div style="flex:1;min-width:140px;">
                    <div style="font-size:15px;font-weight:800;color:var(--text);">{item.name}</div>
                    {(item.city || item.district) && (
                      <div style="font-size:12px;color:var(--text-3);">📍 {item.city}{item.district ? `, ${item.district}` : ''}</div>
                    )}
                    <div style="font-size:11px;color:#1e40af;font-weight:700;margin-top:2px;">
                      {item.experience_years ? `${item.experience_years}+ yrs experience` : 'Skilled Tiler'}
                    </div>
                    {(item.services || []).length > 0 && (
                      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;">
                        {(item.services || []).slice(0, 3).map(sv => (
                          <span style="font-size:9px;padding:2px 7px;border-radius:20px;background:#DBEAFE;color:#1e40af;border:1px solid #BFDBFE;font-weight:600;">{sv}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
                <div style="display:flex;gap:7px;align-items:center;">
                  <a href={item.waLink} target="_blank" rel="noopener noreferrer"
                    style="display:inline-flex;align-items:center;gap:6px;background:#25D366;color:#fff;border-radius:10px;padding:9px 14px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;">
                    💬 WhatsApp
                  </a>
                  <a href={`/tilers/${item.slug}`}
                    style="display:inline-flex;align-items:center;gap:5px;background:var(--navy);color:#fff;border-radius:10px;padding:9px 14px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;">
                    View Profile →
                  </a>
                </div>
              </div>
            ) : (
              /* ── Tile Shop card ── */
              <div style={`background:#fff;border-radius:16px;border:${item.isFeatured ? '2px solid var(--gold)' : '1px solid #e2e8f0'};padding:16px 20px;display:flex;align-items:flex-start;gap:14px;box-shadow:0 2px 8px rgba(0,0,0,0.04);`}>
                <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#2E7D32,#1B5E20);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">🏪</div>
                <div style="flex:1;min-width:0;">
                  <div style="font-size:15px;font-weight:800;color:var(--text);line-height:1.2;">{item.name}</div>
                  {(item.city || item.district) && (
                    <div style="font-size:12px;color:var(--text-3);margin-top:2px;">📍 {item.city}{item.district ? `, ${item.district}` : ''}</div>
                  )}
                  {item.description && (
                    <p style="font-size:11px;color:var(--text-3);line-height:1.6;margin:6px 0 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{item.description}</p>
                  )}
                  {(item.services || []).length > 0 && (
                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;">
                      {(item.services || []).slice(0, 4).map(sv => (
                        <span style="font-size:9px;padding:2px 7px;border-radius:20px;background:#DCFCE7;color:#166534;border:1px solid #BBF7D0;font-weight:600;">{sv}</span>
                      ))}
                    </div>
                  )}
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
                  {item.waLink && (
                    <a href={item.waLink} target="_blank" rel="noopener noreferrer"
                      style="display:inline-flex;align-items:center;gap:5px;background:#25D366;color:#fff;border-radius:8px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;white-space:nowrap;">
                      💬 WhatsApp
                    </a>
                  )}
                </div>
              </div>
            ))}

            <!-- Always show a "list your shop" invite card -->
            <div style="background:#fff;border-radius:16px;border:2px dashed var(--border);padding:24px 20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
              <div style="font-size:32px;">🏪</div>
              <div style="flex:1;min-width:180px;">
                <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:4px;">List your tile shop</div>
                <p style="font-size:12px;color:var(--text-3);line-height:1.6;margin:0;">Reach homeowners &amp; builders planning tile projects — completely free.</p>
              </div>
              <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:6px;background:var(--navy);color:#fff;border-radius:10px;padding:9px 18px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;">
                + List My Shop Free
              </a>
            </div>
          </div>
        ) : (
          <div style="background:#fff;border-radius:20px;border:2px dashed var(--border);padding:56px 24px;text-align:center;max-width:540px;margin:0 auto;">
            <div style="font-size:52px;margin-bottom:16px;">🏪</div>
            <h3 style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:8px;">No tile shops listed yet</h3>
            <p style="font-size:13px;color:var(--text-3);line-height:1.8;margin-bottom:24px;max-width:380px;margin-left:auto;margin-right:auto;">
              Do you sell tiles, flooring or wall cladding? Reach homeowners and builders planning their projects — completely free.
            </p>
            <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
              🪨 List My Tile Shop Free
            </a>
            <p style="font-size:11px;color:var(--text-4);margin-top:14px;">Free listing · Direct WhatsApp leads · No commission</p>
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--navy);padding:44px 20px;text-align:center;">
    <div style="max-width:560px;margin:0 auto;">
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(20px,3vw,28px);font-weight:700;color:#fff;margin-bottom:10px;">Ready to start your tiling project?</h2>
      <p style="font-size:13px;color:rgba(255,255,255,0.5);margin-bottom:24px;line-height:1.8;">Post your project free and get contacted by verified tilers near you.</p>
      <a href="/post-project" style="display:inline-flex;align-items:center;gap:8px;background:var(--terra);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
        📋 Post My Tiling Project
      </a>
    </div>
  </section>

</Layout>

<style>
  .tile-brands-scroll::-webkit-scrollbar { height: 4px; }
  .tile-brands-scroll::-webkit-scrollbar-track { background: transparent; }
  .tile-brands-scroll::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
</style>
