---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase.js'

const { data: allBrands } = await supabase
  .from('brands').select('*').eq('status', 'active')
  .order('is_featured', { ascending: false }).order('name')
const brands = allBrands || []

const CHEMICAL_CATS    = ['Tile Adhesive', 'Waterproofing', 'Construction Chemicals', 'Grout', 'Sealants']
const RENO_CATS        = ['Bathroom Renovation', 'Interior Design', 'Construction', 'Premium Partner']
const BATHROOM_CATS    = ['Sanitary Ware', 'Faucets', 'Bathroom Fittings', 'Bathroom Products', 'Showers', 'Bathtubs', 'Bathroom Accessories']

const isChemical = (b) => (b.categories || []).some(c => CHEMICAL_CATS.includes(c))
const isReno     = (b) => (b.categories || []).some(c => RENO_CATS.includes(c))
const isBathroom = (b) => (b.categories || []).some(c => BATHROOM_CATS.includes(c))

const tileBrands    = brands.filter(b => !isChemical(b) && !isReno(b) && !isBathroom(b))
const adhesiveBrands = brands.filter(b => isChemical(b))

const { data: shopData } = await supabase
  .from('providers')
  .select('id,name,city,district,services,whatsapp,phone,description,verification_status,is_featured')
  .eq('provider_type', 'tile_shop')
  .eq('status', 'active')
  .order('is_featured', { ascending: false })
const shops = shopData || []

const { data: tilerData } = await supabase
  .from('tilers')
  .select('id,full_name,slug,city,district,services,experience_years,avatar_url,phone,whatsapp')
  .eq('featured', true)
  .in('slug', ['mathara-tile-malli', 'thushara'])
const featuredTilers = tilerData || []

const BRAND_META = {
  'rocell':      { color: '#FFFFFF', bg: '#002B5B' },
  'lanka-tile':  { color: '#FFFFFF', bg: '#CC2229' },
  'macktiles':   { color: '#FFFFFF', bg: '#2E7D32' },
  'megatile':    { color: '#FFFFFF', bg: '#5D4037' },
  'luxehome':    { color: '#0c0804', bg: '#D4AF37' },
  'swisstek':    { color: '#FFFFFF', bg: '#1565C0' },
  'tokyo-super': { color: '#FFFFFF', bg: '#C62828' },
  'dr-fixit':    { color: '#FFFFFF', bg: '#E65100' },
  'sika':        { color: '#FFFFFF', bg: '#B71C1C' },
  'finex':       { color: '#FFFFFF', bg: '#1A237E' },
}
function meta(brand) { return BRAND_META[brand.slug] || { color: '#fff', bg: '#1B3A6B' } }
function logoText(name) { return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() }
---

<Layout
  title="Tile Shops, Tile Brands & Adhesives in Sri Lanka · TilersHub"
  description="Find tile shops, tile brands (Rocell, Lanka Tile, Megatile) and adhesive brands (Sika, Dr. Fixit, Swisstek) in Sri Lanka — plus featured tile experts."
>

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#1a0a00,#2B1800,#3D2200);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span style="font-size:9px;font-weight:700;color:rgba(224,90,43,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:14px;">🪨 Tile</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:0 0 12px;line-height:1.2;">
        Tiles, Shops <span style="color:var(--terra);">&amp; Brands</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:480px;margin:0 auto 28px;line-height:1.8;">
        Browse tile shops, leading tile brands, adhesives and grouts — and connect with expert tilers across Sri Lanka.
      </p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:7px;background:#E05A2B;color:#fff;border-radius:11px;padding:12px 22px;font-size:13px;font-weight:800;text-decoration:none;">
          🪨 List Your Tile Shop
        </a>
        <a href="/providers" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.15);border-radius:11px;padding:12px 20px;font-size:13px;font-weight:600;text-decoration:none;">
          👷 Find a Tiler →
        </a>
      </div>
    </div>
  </div>

  <section style="background:var(--surface);padding:52px 20px 64px;">
    <div style="max-width:1100px;margin:0 auto;">

      <!-- ── Tile Brands ── -->
      {tileBrands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,var(--navy),#2B5299);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🪨</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Tile Brands</div>
              <div style="font-size:12px;color:var(--text-4);">Floor tiles, wall tiles, porcelain &amp; ceramic collections</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {tileBrands.map(brand => {
              const m = meta(brand)
              const href = brand.dedicated_page_url || `/brands/${brand.slug}`
              const isFeaturedPage = !!brand.dedicated_page_url
              return (
                <a href={href} style={`background:#fff;border-radius:16px;border:${isFeaturedPage ? '2px solid var(--gold)' : '1px solid #e2e8f0'};padding:22px;display:block;text-decoration:none;color:inherit;position:relative;overflow:hidden;transition:box-shadow 0.2s,transform 0.2s;`}
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(27,58,107,0.12)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0d0b08;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">Sponsored</div>}
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family:'Playfair Display',serif;`}>{logoText(brand.name)}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{brand.name}</div>
                      {isFeaturedPage
                        ? <span style="font-size:10px;color:#92762a;font-weight:700;">⭐ Featured Brand</span>
                        : brand.is_featured && <span style="font-size:10px;color:var(--navy);font-weight:700;">✓ Verified Brand</span>
                      }
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{brand.description}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).slice(0,3).map(c => (
                      <span style={`font-size:10px;padding:2px 9px;border-radius:20px;background:${m.bg}18;color:${m.bg === '#FFFFFF' ? '#1B3A6B' : m.bg};border:1px solid ${m.bg}30;font-weight:600;`}>{c}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:var(--navy);">{isFeaturedPage ? 'View Sponsor Page →' : 'View Brand →'}</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

      <!-- ── Adhesives & Grouts ── -->
      {adhesiveBrands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#0369a1,#075985);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">💧</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Adhesives &amp; Grouts</div>
              <div style="font-size:12px;color:var(--text-4);">Tile adhesives, grouts, waterproofing &amp; construction chemicals</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {adhesiveBrands.map(brand => {
              const m = meta(brand)
              return (
                <a href={`/brands/${brand.slug}`} style="background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:22px;display:block;text-decoration:none;color:inherit;transition:box-shadow 0.2s,transform 0.2s;"
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(27,58,107,0.10)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family:'Playfair Display',serif;`}>{logoText(brand.name)}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{brand.name}</div>
                      <span style="font-size:10px;color:#0369a1;font-weight:700;">💧 Construction Chemicals</span>
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{brand.description}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).slice(0,3).map(c => (
                      <span style={`font-size:10px;padding:2px 9px;border-radius:20px;background:${m.bg}18;color:${m.bg};border:1px solid ${m.bg}28;font-weight:600;`}>{c}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:var(--navy);">View Brand →</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

      <!-- ── Featured Tile Experts ── -->
      {featuredTilers.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#E05A2B,#c44a1f);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">⭐</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Featured Tile Experts</div>
              <div style="font-size:12px;color:var(--text-4);">Verified, experienced tile specialists across Sri Lanka</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {featuredTilers.map(tiler => {
              const rawPhone = (tiler.phone || '').replace(/\D/g, '')
              const waPhone = rawPhone.startsWith('94') ? rawPhone : '94' + rawPhone.replace(/^0/, '')
              const waMsg = encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *TilersHub* හරහා *${tiler.full_name}* සොයාගතිමි.\nඔබගේ tiling සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\nස්තූතියි! 🏠`)
              return (
                <div style="background:#fff;border-radius:18px;border:2px solid var(--gold);overflow:hidden;box-shadow:0 4px 20px rgba(212,175,55,0.1);position:relative;">
                  <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0d0b08;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">⭐ TilersHub Featured</div>
                  <div style="padding:22px 20px 20px;">
                    <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                      {tiler.avatar_url
                        ? <img src={tiler.avatar_url} alt={tiler.full_name} loading="lazy" style="width:60px;height:60px;border-radius:50%;object-fit:cover;border:2px solid var(--gold);flex-shrink:0;" />
                        : <div style="width:60px;height:60px;border-radius:50%;background:var(--navy);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#fff;flex-shrink:0;">{tiler.full_name[0]}</div>
                      }
                      <div>
                        <div style="font-size:16px;font-weight:800;color:var(--text);">{tiler.full_name}</div>
                        {(tiler.city || tiler.district) && <div style="font-size:12px;color:var(--text-3);">📍 {tiler.city}{tiler.district ? `, ${tiler.district}` : ''}</div>}
                        <div style="font-size:11px;color:#92762a;font-weight:700;margin-top:2px;">✓ Skilled · {tiler.experience_years}+ yrs</div>
                      </div>
                    </div>
                    {(tiler.services || []).length > 0 && (
                      <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                        {(tiler.services || []).slice(0,4).map(sv => (
                          <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:#EFF6FF;color:#1d4ed8;border:1px solid #BFDBFE;font-weight:600;">{sv}</span>
                        ))}
                      </div>
                    )}
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                      <a href={`https://wa.me/${waPhone}?text=${waMsg}`} target="_blank" rel="noopener noreferrer"
                        style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#25D366;color:#fff;border-radius:10px;padding:9px 12px;font-size:12px;font-weight:700;text-decoration:none;">
                        💬 WhatsApp
                      </a>
                      <a href={`/tilers/${tiler.slug}`}
                        style="display:flex;align-items:center;justify-content:center;gap:5px;background:#eef3fb;color:var(--navy);border-radius:10px;padding:9px 14px;font-size:12px;font-weight:700;text-decoration:none;border:1px solid #d5e2f5;">
                        View Profile →
                      </a>
                    </div>
                  </div>
                </div>
              )
            })}
          </div>
          <div style="text-align:center;margin-top:20px;">
            <a href="/providers" style="font-size:13px;font-weight:700;color:var(--navy);text-decoration:none;">Browse all tilers →</a>
          </div>
        </div>
      )}

      <!-- ── Tile Shops Directory ── -->
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#2E7D32,#1B5E20);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🏪</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Tile Shops</div>
              <div style="font-size:12px;color:var(--text-4);">
                {shops.length > 0 ? `${shops.length} shop${shops.length > 1 ? 's' : ''} listed` : 'Be the first to list your tile shop'}
              </div>
            </div>
          </div>
          <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;border-radius:11px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;">
            + List Your Shop
          </a>
        </div>

        {shops.length > 0 ? (
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:18px;">
            {shops.map(shop => (
              <div style="background:#fff;border-radius:18px;border:1px solid #e2e8f0;padding:20px;box-shadow:0 2px 12px rgba(0,0,0,0.05);">
                <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:12px;">
                  <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#2E7D32,#1B5E20);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🏪</div>
                  <div>
                    <div style="font-size:15px;font-weight:800;color:var(--text);line-height:1.2;">{shop.name}</div>
                    {(shop.city || shop.district) && <div style="font-size:12px;color:var(--text-3);margin-top:2px;">📍 {shop.city}{shop.district ? `, ${shop.district}` : ''}</div>}
                    <span style="font-size:10px;padding:2px 8px;border-radius:10px;background:#DCFCE7;color:#166534;font-weight:700;display:inline-block;margin-top:4px;">🪨 Tile Shop</span>
                  </div>
                </div>
                {shop.description && (
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin:0 0 12px;">{shop.description}</p>
                )}
                {(shop.services || []).length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(shop.services || []).slice(0,4).map(sv => (
                      <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:#EFF6FF;color:#1d4ed8;border:1px solid #BFDBFE;font-weight:600;">{sv}</span>
                    ))}
                  </div>
                )}
                <div style="display:flex;gap:8px;">
                  {(shop.whatsapp || shop.phone) && (
                    <a href={`https://wa.me/${(shop.whatsapp || shop.phone).replace(/\D/g,'').replace(/^(?!94)0?/,'94')}?text=${encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම TilersHub හරහා ${shop.name} සොයාගතිමි.\nස්තූතියි!`)}`}
                      target="_blank" rel="noopener noreferrer"
                      style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#25D366;color:#fff;border-radius:10px;padding:9px 12px;font-size:12px;font-weight:700;text-decoration:none;">
                      💬 WhatsApp
                    </a>
                  )}
                  {shop.phone && (
                    <a href={`tel:${shop.phone}`}
                      style="display:flex;align-items:center;justify-content:center;gap:5px;background:#eef3fb;color:var(--navy);border-radius:10px;padding:9px 12px;font-size:12px;font-weight:700;text-decoration:none;border:1px solid #d5e2f5;">
                      📞 Call
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div style="background:#fff;border-radius:20px;border:2px dashed var(--border);padding:56px 24px;text-align:center;max-width:540px;margin:0 auto;">
            <div style="font-size:52px;margin-bottom:16px;">🏪</div>
            <h3 style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:8px;">No tile shops listed yet</h3>
            <p style="font-size:13px;color:var(--text-3);line-height:1.8;margin-bottom:24px;max-width:380px;margin-left:auto;margin-right:auto;">
              Do you sell tiles, flooring or wall cladding? Reach homeowners and builders planning their projects — completely free.
            </p>
            <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
              🪨 List My Tile Shop Free
            </a>
            <p style="font-size:11px;color:var(--text-4);margin-top:14px;">Free listing · Direct WhatsApp leads · No commission</p>
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--navy);padding:44px 20px;text-align:center;">
    <div style="max-width:560px;margin:0 auto;">
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(20px,3vw,28px);font-weight:700;color:#fff;margin-bottom:10px;">Ready to start your tiling project?</h2>
      <p style="font-size:13px;color:rgba(255,255,255,0.5);margin-bottom:24px;line-height:1.8;">Post your project free and get contacted by verified tilers near you.</p>
      <a href="/post-project" style="display:inline-flex;align-items:center;gap:8px;background:var(--terra);color:#fff;border-radius:12px;padding:12px 26px;font-size:14px;font-weight:700;text-decoration:none;">
        📋 Post My Tiling Project
      </a>
    </div>
  </section>

</Layout>
