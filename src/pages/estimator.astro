  <script>
    const tileSizeEl   = document.getElementById('tile-size')
    const adhLabelEl   = document.getElementById('adhesive-label')
    const adhRateLblEl = document.getElementById('adhesive-rate-lbl')
    const adhSubEl     = document.getElementById('adhesive-sub')
    const adhHintEl    = document.getElementById('adhesive-hint')
    const adhResLabel  = document.getElementById('res-adhesive-label')
    const screedCb     = document.getElementById('inc-screed')
    const screedRow    = document.getElementById('screed-rate-row')

    // Returns 'c1' | 'c2' | 'c2te'
    function adhesiveTier() {
      const v = parseFloat(tileSizeEl.value)
      if (v <= 3.875)  return 'c1'   // up to 60×60 cm
      if (v <= 10.333) return 'c2'   // up to 120×80 cm
      return 'c2te'                   // above 120×80 cm
    }

    const ADHESIVE = {
      c1:   { label: 'Adhesive (C1)',       rate: 50,  bagSqft: 35, rateLabel: 'රු. 50 / sq.ft',  sub: 'C1 adhesive — 60×60 cm දක්වා ටයිල්',              hint: '✓ C1 Adhesive අදාළ වේ — 60×60 cm දක්වා' },
      c2:   { label: 'Adhesive (C2)',       rate: 80,  bagSqft: 35, rateLabel: 'රු. 80 / sq.ft',  sub: 'C2 adhesive — 90×45 cm සිට 120×80 cm දක්වා ටයිල්', hint: '✓ C2 Adhesive අදාළ වේ — 90×45 cm සිට 120×80 cm දක්වා' },
      c2te: { label: 'Adhesive (C2TE S1)', rate: 120, bagSqft: 30, rateLabel: 'රු. 120 / sq.ft', sub: 'C2TE S1 adhesive — 120×80 cm ඉක්මවූ විශාල ටයිල්', hint: '✓ C2TE S1 Adhesive අදාළ වේ — 120×80 cm ඉක්මවූ විශාල ටයිල්' },
    }

    // Levelling clips per tile depend on tile size (wedges reusable)
    function clipsPerTile(tileSqft) {
      if (tileSqft <= 2) return 3
      if (tileSqft <= 4) return 4
      if (tileSqft <= 11) return 6
      return 8
    }

    function updateAdhesive() {
      const tier = ADHESIVE[adhesiveTier()]
      adhLabelEl.textContent   = tier.label
      adhRateLblEl.textContent = tier.rateLabel
      adhSubEl.textContent     = tier.sub
      adhHintEl.textContent    = tier.hint
      if (adhResLabel) adhResLabel.textContent = '🧱 ' + tier.label
    }

    tileSizeEl.addEventListener('change', updateAdhesive)
    updateAdhesive()

    screedCb.addEventListener('change', function () {
      screedRow.style.display = this.checked ? 'block' : 'none'
    })

    document.getElementById('calc-btn').addEventListener('click', () => {
      const area         = parseFloat(document.getElementById('area').value)
      const tileSqft     = parseFloat(tileSizeEl.value)
      const pricePerTile = parseFloat(document.getElementById('price-per-tile').value) || 0
      const labourRate   = parseFloat(document.getElementById('labour-rate').value) || 150
      const incAdhesive  = document.getElementById('inc-adhesive').checked
      const incClips     = document.getElementById('inc-clips').checked
      const incGrout     = document.getElementById('inc-grout').checked
      const incScreed    = screedCb.checked
      const screedRate   = parseFloat(document.getElementById('screed-rate').value) || 110

      if (!area || area <= 0) { alert('කරුණාකර sq.ft වලින් ඵල ප්‍රදේශය ඇතුළු කරන්න.'); return }

      const tilesNeeded   = Math.ceil((area / tileSqft) * 1.12)
      const tileCost      = pricePerTile > 0 ? tilesNeeded * pricePerTile : null
      const labourCost    = area * labourRate
      const tier          = ADHESIVE[adhesiveTier()]
      const adhesiveCost  = incAdhesive ? area * tier.rate : 0
      const clipsCost     = incClips    ? area * 20 : 0
      const groutCost     = incGrout    ? area * 10 : 0
      const screedCost    = incScreed   ? area * screedRate : 0

      // Material quantities
      const adhesiveBags    = Math.ceil(area / tier.bagSqft)        // 25kg bags (~3 per 100 sq.ft; 3–4 large format)
      const groutKg         = Math.ceil(area / 35)                  // 2–4 kg per 100 sq.ft
      const clipsCount      = tilesNeeded * clipsPerTile(tileSqft)  // depends on tile size
      const isPremiumScreed = screedRate >= 115                     // premium screed uses more cement
      const cementBags      = Math.ceil(area * (isPremiumScreed ? 0.03 : 0.02)) // 2–3 bags per 100 sq.ft
      const sandCuft        = Math.ceil(area * 0.20)                // 20 cu.ft per 100 sq.ft

      const extrasCost    = labourCost + adhesiveCost + clipsCost + groutCost + screedCost
      const total         = (tileCost || 0) + extrasCost

      const fmt = n => 'රු. ' + Math.round(n).toLocaleString('si-LK')

      document.getElementById('res-area').textContent      = area.toLocaleString('si-LK') + ' sq.ft'
      document.getElementById('res-tiles').textContent     = tilesNeeded + ' ටයිල්'
      document.getElementById('res-tile-cost').textContent = tileCost ? fmt(tileCost) : '— (ටයිල් මිල ඇතුළු කරන්න)'
      document.getElementById('res-labour').textContent    = fmt(labourCost)

      document.getElementById('row-adhesive').style.display = incAdhesive ? 'flex' : 'none'
      document.getElementById('res-adhesive').textContent   = fmt(adhesiveCost)
      document.getElementById('res-adhesive-qty').textContent = incAdhesive ? `25kg bags × ${adhesiveBags}` : ''

      document.getElementById('row-clips').style.display = incClips ? 'flex' : 'none'
      document.getElementById('res-clips').textContent   = fmt(clipsCost)
      document.getElementById('res-clips-qty').textContent = incClips ? `clips × ${clipsCount.toLocaleString('si-LK')} (+ wedges)` : ''

      document.getElementById('row-grout').style.display = incGrout ? 'flex' : 'none'
      document.getElementById('res-grout').textContent   = fmt(groutCost)
      document.getElementById('res-grout-qty').textContent = incGrout ? `~${groutKg} kg` : ''

      document.getElementById('row-screed').style.display = incScreed ? 'flex' : 'none'
      document.getElementById('res-screed').textContent   = fmt(screedCost)
      document.getElementById('res-screed-qty').textContent = incScreed ? `${isPremiumScreed ? 'premium' : 'standard'} · cement 50kg × ${cementBags} · වැලි ${sandCuft} cu.ft` : ''

      document.getElementById('res-total').textContent     = tileCost ? fmt(total) : fmt(extrasCost)
      document.getElementById('res-total-note').textContent = tileCost
        ? 'ටයිල් + කම්කරු + තෝරාගත් අතිරේකය'
        : 'කම්කරු + අතිරේකය (ටයිල් මිල නොමැත)'

      document.getElementById('result').style.display = 'block'
      document.getElementById('result').scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    })

    document.getElementById('share-estimate-btn').addEventListener('click', async function () {
      const url = window.location.href
      const title = 'ටයිලිං ගාස්තු ගාස්තු ගණනය — TilersHub'
      if (navigator.share) {
        try { await navigator.share({ title, url }) } catch (_) {}
      } else {
        await navigator.clipboard.writeText(url)
        this.textContent = '✓ පිටපත් විය!'
        setTimeout(() => { this.textContent = '🔗 ගාස්තු බෙදාගන්න' }, 2000)
      }
    })
  </script>

</Layout>
