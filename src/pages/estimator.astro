---
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { LABOUR, ADHESIVE_TIERS, EXTRAS, TILE_SIZES, TILE_PRICE_RANGES, WASTE_FACTOR, COVERAGE, tilesNeeded } from '../lib/costData.js'
import { DISTRICT_INFO, districtPath } from '../lib/locations.js'

const year = new Date().getFullYear()

const FAQS = [
  { q: `How much does tiling cost per square foot in Sri Lanka (${year})?`,
    a: `Tiling labour costs Rs. ${LABOUR.min}–${LABOUR.max} per sq.ft depending on tile size and pattern complexity. Adding adhesive (Rs. ${ADHESIVE_TIERS[0].rate}–${ADHESIVE_TIERS[2].rate}/sq.ft), grout (Rs. ${EXTRAS.grout}/sq.ft) and level clips (Rs. ${EXTRAS.levelClips}/sq.ft), expect roughly Rs. 160–400 per sq.ft excluding the tiles themselves. Tile material adds Rs. 90–4,500+ per tile depending on size and brand.` },
  { q: 'What is the labour rate for tiling in Sri Lanka?',
    a: `Standard floor tiling labour is around Rs. ${LABOUR.default}/sq.ft. Simple ceramic work in regional areas can be Rs. ${LABOUR.min}/sq.ft, while large-format tiles, diagonal patterns or wall tiling in Colombo can reach Rs. ${LABOUR.max}/sq.ft or more.` },
  { q: 'How many tiles do I need for 100 square feet?',
    a: `With standard 60×60 cm tiles (3.875 sq.ft each), 100 sq.ft needs ${tilesNeeded(100, 3.875)} tiles including the recommended 12% wastage allowance for cuts and breakage. Smaller 30×30 cm tiles need ${tilesNeeded(100, 0.969)} tiles for the same area.` },
  { q: 'Why do I need to add 12% wastage to tile quantity?',
    a: 'Tiles get cut at walls, corners and around fittings, and some break during transport and installation. The industry-standard allowance in Sri Lanka is 10–15%; our calculator uses 12%. Complex diagonal patterns may need 15–20%.' },
  { q: 'Which tile adhesive should I use — C1, C2 or C2TE?',
    a: `C1 (Rs. ${ADHESIVE_TIERS[0].rate}/sq.ft) suits ceramic and porcelain tiles up to 60×60 cm. C2 (Rs. ${ADHESIVE_TIERS[1].rate}/sq.ft) is needed for 60×60 cm to 120×80 cm. Large-format tiles above 120×80 cm require deformable C2TE S1 adhesive (Rs. ${ADHESIVE_TIERS[2].rate}/sq.ft). Using the wrong class causes tiles to debond.` },
  { q: 'Do I need a screed layer before tiling?',
    a: `A cement-sand screed (Rs. ${EXTRAS.screed.min}–${EXTRAS.screed.max}/sq.ft) is needed when the floor slab is uneven or at the wrong level. New concrete slabs finished to level may be tiled directly with adhesive. Your tiler can confirm after inspecting the floor.` },
  { q: 'How much do tiles cost in Sri Lanka?',
    a: 'Ceramic 30×30 cm tiles start around Rs. 90–250 per tile. Porcelain 60×60 cm runs Rs. 550–1,800 per tile. Large-format 120×120 cm porcelain ranges Rs. 4,500–12,000 per tile depending on brand (Rocell, Lanka Tiles, Megatile and imported brands).' },
  { q: 'How much does it cost to tile a bathroom in Sri Lanka?',
    a: 'A typical 40 sq.ft bathroom floor plus 180 sq.ft of wall tiling costs roughly Rs. 60,000–150,000 in labour and materials (excluding tiles), including waterproofing. With mid-range tiles the total is usually Rs. 120,000–300,000. Post your project free on TilersHub to get exact quotes.' },
]

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})

const howToSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to calculate tiling cost in Sri Lanka',
  description: 'Estimate the total cost of a tiling project including tiles, labour, adhesive, grout and screed.',
  step: [
    { '@type': 'HowToStep', name: 'Measure the area', text: 'Measure the length and width of each room or wall in feet and multiply to get total square feet.' },
    { '@type': 'HowToStep', name: 'Choose a tile size', text: 'Select your tile size — larger tiles need fewer pieces but stronger (more expensive) adhesive.' },
    { '@type': 'HowToStep', name: 'Add 12% wastage', text: 'Multiply the tile count by 1.12 to cover cutting waste and breakage.' },
    { '@type': 'HowToStep', name: 'Apply labour and material rates', text: `Multiply the area by the labour rate (Rs. ${LABOUR.min}–${LABOUR.max}/sq.ft) and add adhesive, grout, level clips and screed if needed.` },
    { '@type': 'HowToStep', name: 'Get real quotes', text: 'Post your project free on TilersHub to compare bids from verified tilers in your district.' },
  ],
})

const appSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'TilersHub Tile Calculator Sri Lanka',
  url: 'https://www.tilershub.lk/estimator',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'LKR' },
  description: 'Free tiling cost and tile quantity calculator for Sri Lanka with current labour and material rates.',
})

const topDistricts = DISTRICT_INFO.filter(d => ['colombo','gampaha','kandy','galle','kurunegala','kalutara','matara','puttalam'].includes(d.slug))
---

<Layout
  title={`Tile Calculator Sri Lanka — Tiling Cost & Quantity Estimator (${year}) | TilersHub`}
  description={`Free tile calculator for Sri Lanka: tiles needed with 12% waste, labour (Rs. ${LABOUR.min}–${LABOUR.max}/sq.ft), C1/C2/C2TE adhesive, grout & screed costs. ${year} rates.`}
>
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <script slot="head" type="application/ld+json" set:html={howToSchema} />
  <script slot="head" type="application/ld+json" set:html={appSchema} />

  <div style="background:var(--navy);padding:36px 20px 40px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:relative;max-width:560px;margin:0 auto;">
      <div style="text-align:left;"><Breadcrumbs items={[{ name: 'Tile Calculator' }]} light /></div>
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">📐 <span class="si-text">ගාස්තු ගණනය</span><span class="en-text">Cost Calculator</span></span>
      <h1 style="font-family: var(--th-display);font-size:clamp(26px,4vw,40px);font-weight:700;color:#fff;margin:12px 0 10px;">
        <span class="si-text">ටයිලිං ගාස්තු <span style="color:var(--terra);">ගණනය කිරීම</span></span>
        <span class="en-text">Tile Calculator <span style="color:var(--terra);">Sri Lanka</span></span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);">
        <span class="si-text">අවශ්‍ය ටයිල් ගණන සහ සම්පූර්ණ ව්‍යාපෘති ගාස්තු ගණනය කරන්න</span>
        <span class="en-text">Calculate tiles needed, labour and total tiling cost with current {year} Sri Lankan rates</span>
      </p>
    </div>
  </div>

  <!-- Top CTA strip -->
  <div style="background:#FBFAF8;padding:12px 20px;border-bottom:1px solid #E4E0D9;">
    <div style="max-width:580px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <span style="font-size:13px;color:#6B7076;">අයවැය දැනටමත් දන්නවාද? ගණනය ඉක්මවා යන්න.</span>
      <a href="/post-project" style="display:inline-flex;align-items:center;gap:6px;background:#C2542B;color:#fff;border-radius:10px;padding:8px 16px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;">
        📋 නොමිලේ ව්‍යාපෘතිය පලකරන්න →
      </a>
    </div>
  </div>

  <section style="background:var(--surface);padding:48px 20px 64px;">
    <div style="max-width:580px;margin:0 auto;" id="estimator-app">

      <!-- ── Form Card ── -->
      <div style="background:#fff;border:1px solid var(--border);border-radius:20px;padding:28px 28px 24px;">
        <h2 style="font-size:17px;font-weight:700;color:var(--text);margin-bottom:24px;">ව්‍යාපෘති විස්තර</h2>

        <!-- Area in sq.ft -->
        <div class="form-group">
          <label class="form-label">කාමර / ප්‍රදේශ ප්‍රමාණය <span style="color:var(--terra);">*</span></label>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="number" id="area" min="1" step="1" placeholder="උදා: 120" class="form-input" style="flex:1;" />
            <span style="font-size:13px;font-weight:600;color:var(--text-3);white-space:nowrap;background:var(--surface);padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;">sq.ft</span>
          </div>
          <p class="form-hint">ටයිල් කිරීමට අවශ්‍ය සම්පූර්ණ ප්‍රදේශය sq.ft වලින් ඇතුළු කරන්න</p>
        </div>

        <!-- Tile Size -->
        <div class="form-group">
          <label class="form-label">ටයිල් ප්‍රමාණය</label>
          <select id="tile-size" class="form-select">
            <option value="0.969">30×30 cm &nbsp;·&nbsp; 1×1 ft</option>
            <option value="1.938">60×30 cm &nbsp;·&nbsp; 2×1 ft</option>
            <option value="1.722">40×40 cm &nbsp;·&nbsp; 1.3×1.3 ft</option>
            <option value="3.875" selected>60×60 cm &nbsp;·&nbsp; 2×2 ft</option>
            <option value="4.359">90×45 cm &nbsp;·&nbsp; 3×1.5 ft</option>
            <option value="6.889">80×80 cm &nbsp;·&nbsp; 2.6×2.6 ft</option>
            <option value="7.750">120×60 cm &nbsp;·&nbsp; 4×2 ft</option>
            <option value="10.333">120×80 cm &nbsp;·&nbsp; 4×2.6 ft</option>
            <option value="10.764">100×100 cm &nbsp;·&nbsp; 3.3×3.3 ft</option>
            <option value="12.109">150×75 cm &nbsp;·&nbsp; 5×2.5 ft</option>
            <option value="13.778">160×80 cm &nbsp;·&nbsp; 5.2×2.6 ft</option>
            <option value="23.250">180×120 cm &nbsp;·&nbsp; 6×4 ft</option>
            <option value="31.000">240×120 cm &nbsp;·&nbsp; 8×4 ft</option>
          </select>
          <p class="form-hint" id="adhesive-hint" style="color:var(--navy);font-weight:600;">✓ C1 Adhesive අදාළ වේ — 60×60 cm දක්වා</p>
        </div>

        <!-- Tile Price per tile -->
        <div class="form-group">
          <label class="form-label">ටයිල් මිල <span style="font-size:11px;font-weight:400;color:var(--text-3);">(ටයිලයකට)</span></label>
          <div style="display:flex;gap:8px;align-items:center;">
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">රු.</span>
            <input type="number" id="price-per-tile" min="0" placeholder="උදා: 450" class="form-input" style="flex:1;" />
          </div>
          <p class="form-hint">තනි ටයිලයකට මිල — box එකකට නොවේ</p>
        </div>

        <!-- Labour Rate -->
        <div class="form-group">
          <label class="form-label">කම්කරු ගාස්තු</label>
          <div style="display:flex;gap:8px;align-items:center;">
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">රු.</span>
            <input type="number" id="labour-rate" min="0" value="150" class="form-input" style="flex:1;" />
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">/ sq.ft</span>
          </div>
          <p class="form-hint">සාමාන්‍ය පරාසය: රු. 100–250 sq.ft ට — ටයිල් ප්‍රමාණය සහ රටාව අනුව</p>
        </div>

        <!-- Additional Costs -->
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label" style="margin-bottom:10px;">අතිරේක ගාස්තු ඇතුළත් කරන්න</label>
          <div style="display:flex;flex-direction:column;gap:8px;">

            <!-- Adhesive (auto C1/C2) -->
            <label id="adhesive-toggle" style="display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color 0.2s;">
              <input type="checkbox" id="inc-adhesive" checked style="margin-top:2px;flex-shrink:0;accent-color:var(--navy);width:15px;height:15px;" />
              <div style="flex:1;min-width:0;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:600;color:var(--text);" id="adhesive-label">Adhesive (C1)</span>
                  <span style="font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap;" id="adhesive-rate-lbl">රු. 50 / sq.ft</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:2px;" id="adhesive-sub">C1 adhesive — 60×60 cm දක්වා ටයිල්</div>
              </div>
            </label>

            <!-- Level Clips -->
            <label style="display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color 0.2s;">
              <input type="checkbox" id="inc-clips" checked style="margin-top:2px;flex-shrink:0;accent-color:var(--navy);width:15px;height:15px;" />
              <div style="flex:1;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:600;color:var(--text);">Level Clip පද්ධතිය</span>
                  <span style="font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap;">රු. 20 / sq.ft</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:2px;">ටයිල් leveling clips සහ wedges — සමතල finish සඳහා</div>
              </div>
            </label>

            <!-- Grout -->
            <label style="display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color 0.2s;">
              <input type="checkbox" id="inc-grout" checked style="margin-top:2px;flex-shrink:0;accent-color:var(--navy);width:15px;height:15px;" />
              <div style="flex:1;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:600;color:var(--text);">Grout</span>
                  <span style="font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap;">රු. 10 / sq.ft</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:2px;">සියලු ටයිල් සන්ධි සඳහා grout ද්‍රව්‍ය</div>
              </div>
            </label>

            <!-- Screed -->
            <label style="display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color 0.2s;">
              <input type="checkbox" id="inc-screed" style="margin-top:2px;flex-shrink:0;accent-color:var(--navy);width:15px;height:15px;" />
              <div style="flex:1;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:600;color:var(--text);">Screed (සිමෙන්ති සහ වැලි)</span>
                  <span style="font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap;">රු. 100–120 / sq.ft</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:2px;">ටයිල් කිරීමට පෙර බිම සමතල කිරීම සඳහා base screed ස්තරය</div>
                <div id="screed-rate-row" style="display:none;margin-top:8px;display:none;">
                  <div style="display:flex;align-items:center;gap:6px;">
                    <span style="font-size:11px;color:var(--text-3);">ගාස්තු:</span>
                    <span style="font-size:11px;color:var(--text-3);">Rs.</span>
                    <input type="number" id="screed-rate" value="110" min="100" max="120" step="5"
                      class="form-input" style="width:80px;padding:5px 8px;font-size:12px;"
                      onclick="event.stopPropagation()" />
                    <span style="font-size:11px;color:var(--text-3);">/ sq.ft</span>
                  </div>
                </div>
              </div>
            </label>

          </div>
        </div>

        <button id="calc-btn" class="btn btn-navy btn-full" style="margin-top:20px;font-size:15px;padding:13px;">📐 ගාස්තු ගණනය කරන්න</button>
      </div>

      <!-- ── Result Card ── -->
      <div id="result" style="display:none;background:var(--navy);border-radius:20px;padding:28px;margin-top:20px;color:#fff;">
        <h3 style="font-size:13px;font-weight:700;color:rgba(255,255,255,0.5);margin-bottom:20px;letter-spacing:1.5px;text-transform:uppercase;">ඔබේ ගාස්තු ගණනය</h3>

        <!-- Area + tiles row -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
          <div style="background:rgba(255,255,255,0.06);border-radius:12px;padding:14px 16px;border:1px solid rgba(255,255,255,0.08);">
            <div id="res-area" style="font-size:20px;font-weight:700;color:var(--terra);">—</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">ප්‍රදේශය</div>
          </div>
          <div style="background:rgba(255,255,255,0.06);border-radius:12px;padding:14px 16px;border:1px solid rgba(255,255,255,0.08);">
            <div id="res-tiles" style="font-size:20px;font-weight:700;color:var(--terra);">—</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">අවශ්‍ය ටයිල් (+12% waste)</div>
          </div>
        </div>

        <!-- Breakdown list -->
        <div style="background:rgba(255,255,255,0.04);border-radius:12px;border:1px solid rgba(255,255,255,0.07);overflow:hidden;margin-bottom:12px;">
          <div id="row-tiles" style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:13px;color:rgba(255,255,255,0.6);">🪨 ටයිල් ද්‍රව්‍ය</span>
            <span id="res-tile-cost" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:13px;color:rgba(255,255,255,0.6);">👷 කම්කරු</span>
            <span id="res-labour" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
          <div id="row-adhesive" style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="display:flex;flex-direction:column;">
              <span id="res-adhesive-label" style="font-size:13px;color:rgba(255,255,255,0.6);">🧱 ඇලවුම (C1)</span>
              <span id="res-adhesive-qty" style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:2px;"></span>
            </span>
            <span id="res-adhesive" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
          <div id="row-clips" style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
