---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Tiling Cost Estimator · TilersHub"
  description="Calculate the cost of your tiling project in Sri Lanka. Estimate tiles needed, material costs and labour charges free on TilersHub."
>

  <div style="background:var(--navy);padding:44px 20px 40px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:relative;max-width:560px;margin:0 auto;">
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">📐 Estimator</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,40px);font-weight:700;color:#fff;margin:12px 0 10px;">
        Tiling Cost <span style="color:var(--terra);">Estimator</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);">Calculate tiles needed and estimate project cost</p>
    </div>
  </div>

  <section style="background:var(--surface);padding:48px 20px 64px;">
    <div style="max-width:560px;margin:0 auto;" id="estimator-app">

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:28px;">
        <h2 style="font-size:17px;font-weight:700;color:var(--text);margin-bottom:24px;">Project Details</h2>

        <div class="form-group">
          <label class="form-label">Room / Area Length <span style="color:var(--terra);">*</span></label>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="number" id="length" min="0.1" step="0.1" placeholder="e.g. 4.5" class="form-input" style="flex:1;" />
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">metres</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Room / Area Width <span style="color:var(--terra);">*</span></label>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="number" id="width" min="0.1" step="0.1" placeholder="e.g. 3.2" class="form-input" style="flex:1;" />
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">metres</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Tile Size</label>
          <select id="tile-size" class="form-select">
            <option value="0.09">30×30 cm (0.09 m²)</option>
            <option value="0.16" selected>40×40 cm (0.16 m²)</option>
            <option value="0.25">50×50 cm (0.25 m²)</option>
            <option value="0.36">60×60 cm (0.36 m²)</option>
            <option value="0.64">80×80 cm (0.64 m²)</option>
            <option value="1.44">120×120 cm (1.44 m²)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Tile Price per Box</label>
          <div style="display:flex;gap:8px;align-items:center;">
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">Rs.</span>
            <input type="number" id="price-per-box" min="0" placeholder="e.g. 4500" class="form-input" style="flex:1;" />
            <div style="text-align:right;min-width:80px;">
              <span style="font-size:11px;color:var(--text-4);">per box</span>
            </div>
          </div>
          <p class="form-hint">Tiles per box (approx): 6–10 tiles depending on size</p>
        </div>

        <div class="form-group">
          <label class="form-label">Labour Rate (per sq.ft)</label>
          <div style="display:flex;gap:8px;align-items:center;">
            <span style="font-size:13px;color:var(--text-3);">Rs.</span>
            <input type="number" id="labour-rate" min="0" value="150" class="form-input" style="flex:1;" />
            <span style="font-size:11px;color:var(--text-4);white-space:nowrap;">per sq.ft</span>
          </div>
          <p class="form-hint">Typical range: Rs. 100–250 per sq.ft depending on complexity</p>
        </div>

        <button id="calc-btn" class="btn btn-navy btn-full" style="margin-top:8px;font-size:15px;padding:13px;">📐 Calculate Estimate</button>
      </div>

      <!-- Result -->
      <div id="result" style="display:none;background:var(--navy);border-radius:20px;padding:28px;margin-top:20px;color:#fff;">
        <h3 style="font-size:16px;font-weight:700;color:rgba(255,255,255,0.7);margin-bottom:20px;letter-spacing:1px;text-transform:uppercase;">Your Estimate</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;">
          <div style="background:rgba(255,255,255,0.06);border-radius:12px;padding:16px;border:1px solid rgba(255,255,255,0.08);">
            <div id="res-area" style="font-size:22px;font-weight:700;color:var(--terra);">—</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">Total Area (m²)</div>
          </div>
          <div style="background:rgba(255,255,255,0.06);border-radius:12px;padding:16px;border:1px solid rgba(255,255,255,0.08);">
            <div id="res-tiles" style="font-size:22px;font-weight:700;color:var(--terra);">—</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">Tiles Required (with 12% extra)</div>
          </div>
          <div style="background:rgba(255,255,255,0.06);border-radius:12px;padding:16px;border:1px solid rgba(255,255,255,0.08);">
            <div id="res-material" style="font-size:18px;font-weight:700;color:#fff;">—</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">Material Cost (est.)</div>
          </div>
          <div style="background:rgba(255,255,255,0.06);border-radius:12px;padding:16px;border:1px solid rgba(255,255,255,0.08);">
            <div id="res-labour" style="font-size:18px;font-weight:700;color:#fff;">—</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">Labour Cost (est.)</div>
          </div>
        </div>
        <div style="background:rgba(224,90,43,0.15);border:1px solid rgba(224,90,43,0.3);border-radius:12px;padding:16px;text-align:center;">
          <div style="font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:4px;">Estimated Total</div>
          <div id="res-total" style="font-size:28px;font-weight:700;color:var(--terra);">—</div>
          <div style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:4px;">Material + Labour (approximate)</div>
        </div>
        <p style="font-size:11px;color:rgba(255,255,255,0.3);text-align:center;margin-top:14px;">
          This is an estimate only. Actual costs depend on tile brand, pattern complexity, and site conditions.
        </p>
        <a href="/post-project" style="display:flex;align-items:center;justify-content:center;gap:8px;background:var(--terra);color:#fff;border-radius:12px;padding:12px;margin-top:14px;font-size:13px;font-weight:700;text-decoration:none;">
          📋 Post Your Project to Get Quotes
        </a>
      </div>

    </div>
  </section>

  <script>
    const btn = document.getElementById('calc-btn')
    btn?.addEventListener('click', () => {
      const L = parseFloat(document.getElementById('length').value)
      const W = parseFloat(document.getElementById('width').value)
      const tileM2 = parseFloat(document.getElementById('tile-size').value)
      const pricePerBox = parseFloat(document.getElementById('price-per-box').value) || 0
      const labourPerSqft = parseFloat(document.getElementById('labour-rate').value) || 150

      if (!L || !W || L <= 0 || W <= 0) { alert('Please enter valid dimensions.'); return }

      const areaM2 = L * W
      const areaSqft = areaM2 * 10.764
      const tilesNeeded = Math.ceil((areaM2 / tileM2) * 1.12)

      // Estimate boxes (assume ~8 tiles per box average)
      const tilesPerBox = Math.max(1, Math.round(1 / tileM2 * 0.5)) || 6
      const boxesNeeded = Math.ceil(tilesNeeded / tilesPerBox)
      const materialCost = pricePerBox > 0 ? boxesNeeded * pricePerBox : null
      const labourCost = areaSqft * labourPerSqft

      const fmt = n => 'Rs. ' + Math.round(n).toLocaleString()

      document.getElementById('res-area').textContent = areaM2.toFixed(2) + ' m²'
      document.getElementById('res-tiles').textContent = tilesNeeded + ' tiles'
      document.getElementById('res-material').textContent = materialCost ? fmt(materialCost) + ' (est.)' : 'Enter price above'
      document.getElementById('res-labour').textContent = fmt(labourCost) + ' (est.)'
      document.getElementById('res-total').textContent = materialCost ? fmt(materialCost + labourCost) : fmt(labourCost) + ' (labour only)'
      document.getElementById('result').style.display = 'block'
      document.getElementById('result').scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    })
  </script>

</Layout>
