---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase.js'
import HomeHero from '../components/HomeHero.jsx'
import ServiceTabs from '../components/ServiceTabs.jsx'

const HERO_IMG = 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?auto=format&fit=crop&w=1400&q=75'

const { data: featuredTilers } = await supabase
  .from('tilers')
  .select('id,full_name,district,city,is_verified,slug,avg_rating,avatar_url,speciality,services,whatsapp,phone')
  .eq('is_verified', true)
  .order('avg_rating', { ascending: false })
  .limit(8)

const { data: projectsData } = await supabase
  .from('projects')
  .select('id,project_type,district,city,created_at,budget_range,description')
  .eq('status', 'active')
  .order('created_at', { ascending: false })
  .limit(6)

const { data: bidCountData } = (projectsData || []).length
  ? await supabase
      .from('bids')
      .select('project_id')
      .in('project_id', (projectsData || []).map((p: any) => p.id))
  : { data: [] }

const bidsByProject: Record<string, number> = {}
;(bidCountData || []).forEach((b: any) => {
  bidsByProject[b.project_id] = (bidsByProject[b.project_id] || 0) + 1
})

const FALLBACK_TILERS = [
  { id:'p1', full_name:'Lakmal Perera',  city:'Colombo 7',  is_verified:true,  avg_rating:4.9, slug:'lakmal',  avatar_url:null, speciality:'Bathroom Tiling & Reno', whatsapp:null, phone:null },
  { id:'p2', full_name:'Chamara Silva',  city:'Kandy',      is_verified:true,  avg_rating:4.7, slug:null,      avatar_url:null, speciality:'Floor Tiling Specialist', whatsapp:null, phone:null },
  { id:'p3', full_name:'Kelum Prasad',   city:'Negombo',    is_verified:true,  avg_rating:4.8, slug:'kelum',   avatar_url:null, speciality:'Waterproofing & Tiling',  whatsapp:null, phone:null },
  { id:'p4', full_name:'Nuwan Bandara',  city:'Kurunegala', is_verified:true,  avg_rating:4.6, slug:null,      avatar_url:null, speciality:'Granite & Large Format',  whatsapp:null, phone:null },
]

const FALLBACK_PROJECTS = [
  { id:'d1', project_type:'Bathroom Renovation', city:'Colombo',  district:'Colombo', budget_range:'Rs. 850,000', created_at: new Date().toISOString() },
  { id:'d2', project_type:'Floor Tiling',        city:'Kandy',    district:'Kandy',   budget_range:'Rs. 250,000', created_at: new Date().toISOString() },
  { id:'d3', project_type:'Large Format Tiling', city:'Galle',    district:'Galle',   budget_range:'Rs. 320,000', created_at: new Date().toISOString() },
  { id:'d4', project_type:'Waterproofing',       city:'Negombo',  district:'Gampaha', budget_range:'Rs. 95,000',  created_at: new Date().toISOString() },
]

const tilers   = (featuredTilers || []).length > 0 ? (featuredTilers || []) : FALLBACK_TILERS
const projects = (projectsData  || []).length > 0 ? (projectsData  || []) : FALLBACK_PROJECTS

function initials(name: string) {
  return name.split(' ').slice(0,2).map((w:string) => w[0]||'').join('').toUpperCase() || '?'
}
const AVATAR_COLORS = ['#1B3A6B','#0f766e','#7c3aed','#b45309','#0369a1','#E05A2B','#15803d','#be185d']
function avatarColor(name: string) {
  let h = 0
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function waLink(phone: string, name: string) {
  const cleaned = (phone||'').replace(/\D/g,'')
  const intl = cleaned.startsWith('0') ? '94'+cleaned.slice(1) : cleaned
  return `https://wa.me/${intl}?text=${encodeURIComponent(`Hi ${name}, I found you on TilersHub.`)}`
}
function timeAgo(ts: string) {
  const days = Math.floor((Date.now() - new Date(ts).getTime()) / 86400000)
  if (days === 0) return 'Today'
  if (days === 1) return '1d ago'
  if (days < 30)  return `${days}d ago`
  return `${Math.floor(days/30)}mo ago`
}
const TYPE_ICON: Record<string,string> = {
  'Floor Tiling':'⬜','Bathroom Tiling':'🚿','Bathroom Renovation':'🚿',
  'Granite Works':'🪨','Tile Cutting':'🧱','Tile Cutting & Routering':'🧱',
  'Waterproofing':'💧','Large Format Tiling':'📏','Mosaic Tiling':'🎨',
  'Kitchen Renovation':'🍳','Kitchen Tiling':'🍳','House Painting':'🎨',
  'Roofing':'🏚️','Air Conditioning':'❄️','Solar Panels':'☀️',
  'Epoxy Flooring':'🟤','Vinyl Flooring':'🟦','Carpentry Works':'🪵',
  'Gypsum Ceiling':'🏛️','Swimming Pool Construction':'🏊',
}
---

<Layout
  title="TilersHub · Sri Lanka's Tile & Bathroom Marketplace"
  description="Post your tiling project free, get bids from verified tilers and contractors. Browse profiles, reviews and prices across Sri Lanka."
>
  <meta slot="head" name="keywords" content="tilers Sri Lanka, tiling services, bathroom renovation Sri Lanka, floor tiling, tile contractor Colombo, waterproofing, TilersHub" />
  <link slot="head" rel="preload" as="image" href={HERO_IMG} fetchpriority="high" />

  <!-- ═══ 1. HERO (role-aware) ═══ -->
  <HomeHero client:load heroImg={HERO_IMG} />

  <!-- ═══ 2. TRUST BAR ═══ -->
  <div style="background:#0F1E35;padding:10px 16px;">
    <div style="display:flex;gap:7px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;">
      {['✓ 500+ Verified Pros','✓ 47 Services','✓ Free to Post','✓ WhatsApp Direct','✓ Sri Lanka Wide'].map(t => (
        <span style="font-size:10px;font-weight:600;color:rgba(255,255,255,0.65);white-space:nowrap;padding:5px 12px;background:rgba(255,255,255,0.07);border-radius:20px;border:1px solid rgba(255,255,255,0.1);flex-shrink:0;">{t}</span>
      ))}
    </div>
  </div>

  <!-- ═══ 3. FEATURED PROVIDERS (horizontal scroll) ═══ -->
  <section style="background:#fff;padding:20px 0 16px;border-bottom:1px solid #f1f5f9;">
    <div style="padding:0 16px 12px;display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:baseline;gap:8px;">
        <span style="font-size:15px;font-weight:700;color:#111827;">Top Providers</span>
        <span style="font-size:11px;color:#94a3b8;">Verified &amp; rated</span>
      </div>
      <a href="/providers" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View All ›</a>
    </div>

    <div style="display:flex;gap:10px;overflow-x:auto;padding:0 16px 8px;scrollbar-width:none;-webkit-overflow-scrolling:touch;msOverflowStyle:none;">

      <!-- LUXEhome sponsored card -->
      <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer"
        style="flex-shrink:0;width:280px;display:flex;background:#fff;border-radius:20px;border:1.5px solid #D4AF37;overflow:hidden;text-decoration:none;box-shadow:0 4px 18px rgba(212,175,55,0.22);">
        <div style="width:90px;flex-shrink:0;background:linear-gradient(160deg,#0c0804,#1a120a);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-height:130px;position:relative;">
          <div style="position:absolute;inset:0;background:radial-gradient(ellipse at top,rgba(212,175,55,0.14) 0%,transparent 70%);"></div>
          <span style="font-family:'Playfair Display',serif;font-size:13px;font-weight:800;color:#D4AF37;position:relative;">LUXE</span>
          <span style="font-size:8px;color:rgba(255,255,255,0.45);letter-spacing:1.5px;position:relative;">HOME</span>
          <span style="font-size:8px;color:#D4AF37;background:rgba(212,175,55,0.15);border:1px solid rgba(212,175,55,0.3);border-radius:20px;padding:2px 6px;position:relative;margin-top:2px;">🛡️ Master</span>
        </div>
        <div style="flex:1;padding:12px 14px;display:flex;flex-direction:column;min-width:0;">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;flex-wrap:wrap;">
            <span style="font-size:14px;font-weight:700;color:#0f172a;">LUXEhome</span>
            <span style="font-size:8px;font-weight:700;color:#b45309;background:#fef3c7;border:1px solid #fde68a;border-radius:20px;padding:2px 6px;flex-shrink:0;">Sponsor</span>
          </div>
          <div style="font-size:11px;color:#64748b;margin-bottom:3px;">📍 Colombo</div>
          <div style="font-size:11px;color:#64748b;margin-bottom:5px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">Bathroom Reno · Tile Works · 12+ Yrs</div>
          <div style="font-size:11px;color:#f59e0b;margin-bottom:10px;">⭐ 4.9 &nbsp;·&nbsp; 47 reviews</div>
          <div style="margin-top:auto;">
            <span style="display:inline-flex;align-items:center;gap:4px;background:#D4AF37;color:#0c0804;border-radius:10px;padding:6px 14px;font-size:10px;font-weight:800;">Visit Site ›</span>
          </div>
        </div>
      </a>

      <!-- Tiler cards -->
      {tilers.map((t: any) => {
        const color = avatarColor(t.full_name)
        const phone = t.whatsapp || t.phone
        return (
          <div style={`flex-shrink:0;width:280px;display:flex;background:#fff;border-radius:20px;border:1px solid #e8edf5;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06);`}>
            <div style={`width:90px;flex-shrink:0;background:${color};display:flex;align-items:center;justify-content:center;min-height:130px;overflow:hidden;`}>
              {t.avatar_url
                ? <img src={t.avatar_url} alt={t.full_name} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                : <span style="font-size:30px;font-weight:800;color:rgba(255,255,255,0.85);">{initials(t.full_name)}</span>
              }
            </div>
            <div style="flex:1;padding:12px 14px;display:flex;flex-direction:column;min-width:0;">
              <div style="display:flex;align-items:flex-start;gap:6px;margin-bottom:3px;flex-wrap:wrap;">
                <span style="font-size:14px;font-weight:700;color:#0f172a;line-height:1.25;">{t.full_name}</span>
                {t.is_verified && <span style="font-size:8px;font-weight:700;color:#16a34a;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:20px;padding:2px 7px;flex-shrink:0;margin-top:2px;">✓ Pro</span>}
              </div>
              {(t.city || t.district) && <div style="font-size:11px;color:#64748b;margin-bottom:4px;">📍 {t.city || t.district}</div>}
              {t.speciality && <div style="font-size:11px;color:#64748b;margin-bottom:6px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.5;">{t.speciality}</div>}
              {t.avg_rating > 0 && <div style="font-size:11px;color:#f59e0b;margin-bottom:8px;">⭐ {t.avg_rating.toFixed(1)}</div>}
              <div style="margin-top:auto;">
                {phone
                  ? <a href={waLink(phone, t.full_name)} target="_blank" rel="noopener noreferrer"
                      style="display:inline-flex;align-items:center;gap:5px;background:#25D366;color:#fff;border-radius:10px;padding:7px 14px;font-size:11px;font-weight:700;text-decoration:none;">
                      💬 WhatsApp
                    </a>
                  : t.slug
                    ? <a href={`/tilers/${t.slug}`}
                        style="display:inline-flex;align-items:center;gap:5px;background:#1B3A6B;color:#fff;border-radius:10px;padding:7px 14px;font-size:11px;font-weight:700;text-decoration:none;">
                        View Profile ›
                      </a>
                    : null
                }
              </div>
            </div>
          </div>
        )
      })}

    </div>
  </section>

  <!-- ═══ 4. POST PROJECT BANNER ═══ -->
  <div style="padding:12px 16px;background:#f8fafc;">
    <a href="/post-project"
      style="display:flex;align-items:center;justify-content:space-between;gap:12px;background:linear-gradient(120deg,#1B3A6B 0%,#2B4A8A 100%);border-radius:18px;padding:16px 20px;text-decoration:none;box-shadow:0 4px 20px rgba(27,58,107,0.3);">
      <div>
        <div style="font-size:14px;font-weight:800;color:#fff;margin-bottom:3px;">Post your project — it's free</div>
        <div style="font-size:11px;color:rgba(255,255,255,0.65);line-height:1.5;">Get multiple bids from verified pros in Sri Lanka</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:4px;flex-shrink:0;">
        <div style="background:#E05A2B;color:#fff;border-radius:12px;padding:10px 18px;font-size:12px;font-weight:800;white-space:nowrap;">📋 Post Free</div>
        <div style="font-size:9px;color:rgba(255,255,255,0.45);">No login needed</div>
      </div>
    </a>
  </div>

  <!-- ═══ 5. OPEN PROJECTS ═══ -->
  <section style="background:#f8fafc;padding:8px 0 20px;">
    <div style="padding:0 16px 12px;display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-size:15px;font-weight:700;color:#111827;">Open Projects</span>
        <span style="font-size:10px;font-weight:700;color:#E05A2B;background:#fff4f0;border:1px solid #fcd5c0;border-radius:20px;padding:2px 8px;">Bid Now</span>
      </div>
      <a href="/jobs" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View All ›</a>
    </div>

    <div style="display:flex;flex-direction:column;gap:8px;padding:0 16px;">
      {projects.slice(0,4).map((job: any) => {
        const bids = bidsByProject[job.id] || 0
        const icon = TYPE_ICON[job.project_type] || '📋'
        return (
          <a href={`/job?id=${job.id}`}
            style="display:flex;align-items:stretch;gap:0;background:#fff;border-radius:16px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;box-shadow:0 1px 6px rgba(0,0,0,0.05);">
            <div style="width:68px;flex-shrink:0;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:28px;">
              {icon}
            </div>
            <div style="flex:1;padding:11px 14px;min-width:0;">
              <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:4px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{job.project_type}</div>
              <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                <span style="font-size:11px;color:#64748b;">📍 {job.city || job.district}</span>
                {job.budget_range && <span style="font-size:10px;font-weight:600;color:#15803d;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:20px;padding:1px 7px;">{job.budget_range}</span>}
              </div>
              <div style="display:flex;align-items:center;gap:6px;margin-top:4px;">
                <span style="font-size:9px;color:#94a3b8;">{timeAgo(job.created_at)}</span>
                {bids > 0 && <span style="font-size:9px;font-weight:600;color:#1d4ed8;background:#eff6ff;border:1px solid #bfdbfe;border-radius:20px;padding:1px 6px;">💬 {bids} bid{bids!==1?'s':''}</span>}
              </div>
            </div>
            <div style="display:flex;align-items:center;padding:0 14px;flex-shrink:0;">
              <div style="background:#E05A2B;color:#fff;border-radius:10px;padding:8px 14px;font-size:11px;font-weight:700;">Bid →</div>
            </div>
          </a>
        )
      })}
    </div>
  </section>

  <!-- ═══ 6. BROWSE SERVICES (category rows) ═══ -->
  <ServiceTabs client:load />

  <!-- ═══ 7. HOW IT WORKS ═══ -->
  <section style="background:linear-gradient(135deg,#0F1E35 0%,#1A2B4A 100%);padding:32px 16px 28px;">
    <div style="max-width:480px;margin:0 auto;">
      <p style="font-size:9px;font-weight:700;color:rgba(255,255,255,0.4);letter-spacing:3px;text-transform:uppercase;text-align:center;margin:0 0 20px;">How It Works</p>
      <div style="display:flex;flex-direction:column;gap:0;">
        {[
          { num:'1', icon:'📋', title:'Post Your Project', desc:'Free — no login needed. Takes 2 minutes.', color:'#E05A2B' },
          { num:'2', icon:'💬', title:'Providers Bid',     desc:'Verified tilers send quotes to your WhatsApp.', color:'#D4AF37' },
          { num:'3', icon:'✅', title:'You Choose',        desc:'Compare bids, chat directly, hire the best.', color:'#25D366' },
        ].map((s, i) => (
          <div style={`display:flex;align-items:flex-start;gap:16px;padding:16px 0;${i < 2 ? 'border-bottom:1px solid rgba(255,255,255,0.07);' : ''}`}>
            <div style={`width:40px;height:40px;border-radius:50%;background:${s.color};display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;color:#fff;flex-shrink:0;box-shadow:0 4px 14px ${s.color}50;`}>{s.num}</div>
            <div style="padding-top:4px;">
              <div style="font-size:14px;font-weight:700;color:#fff;margin-bottom:4px;">{s.title}</div>
              <div style="font-size:12px;color:rgba(255,255,255,0.48);line-height:1.6;">{s.desc}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:20px;">
        <a href="/post-project" style="display:inline-flex;align-items:center;gap:7px;background:#E05A2B;color:#fff;border-radius:24px;padding:13px 28px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(224,90,43,0.45);">
          📋 Post a Project Free
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 8. JOIN AS PROVIDER CTA ═══ -->
  <section style="background:#fff;padding:28px 20px;border-top:1px solid #f1f5f9;">
    <div style="max-width:480px;margin:0 auto;text-align:center;">
      <div style="font-size:30px;margin-bottom:12px;">🔨</div>
      <div style="font-size:9px;font-weight:700;color:#E05A2B;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;">For Professionals</div>
      <h2 style="font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:#0f172a;margin:0 0 10px;line-height:1.3;">Are you a tiler or contractor?</h2>
      <p style="font-size:13px;color:#64748b;line-height:1.7;margin:0 0 20px;">Join TilersHub free — homeowners find and contact you directly via WhatsApp. No middlemen, no commission.</p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/join-tilershub" style="display:inline-flex;align-items:center;gap:7px;background:#E05A2B;color:#fff;border-radius:14px;padding:13px 24px;font-size:13px;font-weight:800;text-decoration:none;box-shadow:0 4px 18px rgba(224,90,43,0.3);">
          ✅ Join Free
        </a>
        <a href="/providers" style="display:inline-flex;align-items:center;gap:7px;background:#f8fafc;color:#374151;border:1.5px solid #e2e8f0;border-radius:14px;padding:13px 20px;font-size:13px;font-weight:600;text-decoration:none;">
          Browse Providers
        </a>
      </div>
    </div>
  </section>

</Layout>
