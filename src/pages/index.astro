---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase.js'

const { data: featuredTilers } = await supabase
  .from('tilers')
  .select('id,full_name,district,city,is_verified,slug,avg_rating,phone,whatsapp,experience_years')
  .eq('featured', true)
  .order('experience_years', { ascending: false })
  .limit(8)

const { data: brandsData } = await supabase
  .from('brands')
  .select('id,name,slug,categories,logo_url')
  .eq('status', 'active')
  .limit(10)

const { data: jobsData } = await supabase
  .from('jobs')
  .select('id,title,district,city,created_at,budget_min,budget_max')
  .eq('status', 'open')
  .order('created_at', { ascending: false })
  .limit(3)

const tilers = featuredTilers || []
const brands = brandsData     || []
const jobs   = jobsData       || []

function waLink(phone, name) {
  const n = (phone||'').replace(/\D/g,'')
  const num = n.startsWith('94') ? n : '94'+n.replace(/^0/,'')
  const msg = encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *TilersHub* (www.tilershub.lk) හරහා *${name}* සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *TilersHub.lk* Lead\nස්තූතියි! 🏠`)
  return `https://wa.me/${num}?text=${msg}`
}

function timeAgo(dateStr) {
  if (!dateStr) return ''
  const diff = Math.floor((Date.now() - new Date(dateStr)) / 86400000)
  if (diff === 0) return 'Today'
  if (diff === 1) return 'Yesterday'
  if (diff < 7)  return `${diff}d ago`
  if (diff < 30) return `${Math.floor(diff/7)}w ago`
  return `${Math.floor(diff/30)}mo ago`
}

function initials(name) {
  return name?.split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase() || 'TH'
}

const QUICK_ACTIONS = [
  { icon: '👷', label: 'Find Tiler',  href: '/providers?type=tiler', bg: '#EEF2FB' },
  { icon: '📐', label: 'Calculator', href: '/estimator',              bg: '#F5F3FF' },
]

const BRAND_COL = ['#1A2B4A','#C1603A','#D4AF37','#1e3a5f','#7c3aed','#166534','#92400e','#374151']

const EXPLORE_PROS = [
  { label:'👷 Find Tilers',    href:'/providers?type=tiler'      },
  { label:'🚿 Contractors',    href:'/providers?type=contractor' },
  { label:'🏪 Tile Shops',     href:'/providers?type=tile_shop'  },
  { label:'🏭 Workshops',      href:'/providers?type=workshop'   },
  { label:'📦 Suppliers',      href:'/providers?type=supplier'   },
  { label:'🪟 Glass Works',    href:'/providers'                 },
  { label:'🔩 Plumbing',       href:'/providers'                 },
  { label:'⚡ Electrical',     href:'/providers'                 },
  { label:'✂️ Tile Cutting',   href:'/providers?type=workshop'   },
  { label:'🏗️ Ceiling Works',  href:'/providers'                 },
  { label:'🪨 Granite Works',  href:'/providers?type=workshop'   },
]

const EXPLORE_MORE = [
  { label:'🪨 Tiles',          href:'/tile'        },
  { label:'🚿 Bathware',       href:'/bathrooms'   },
  { label:'💧 Waterproofing',  href:'/bathrooms'   },
  { label:'🏷️ Brands',         href:'/tile'        },
  { label:'📐 Estimator',      href:'/estimator'   },
  { label:'📚 Guides',         href:'/guides'      },
  { label:'☰ All Categories', href:'/categories'  },
]
---

<Layout
  title="TilersHub · Sri Lanka's Tile & Bathroom Marketplace"
  description="Find tilers, contractors, tile shops, brands and products for your tile and bathroom project across Sri Lanka. Free quotes — no login required."
>

<!-- ① HERO ─────────────────────────────────────────────── -->
<div style="position:relative;min-height:360px;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:56px 20px 48px;background:#0a121f;">
  <img
    src="https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?auto=format&fit=crop&w=1400&q=75"
    alt=""
    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:0.22;"
    loading="eager"
    fetchpriority="high"
  />
  <div style="position:absolute;inset:0;background:linear-gradient(160deg,rgba(10,18,31,0.7) 0%,rgba(26,43,74,0.55) 100%);pointer-events:none;"></div>
  <div style="position:absolute;inset:0;opacity:0.035;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>

  <div style="position:relative;text-align:center;max-width:620px;width:100%;">
    <div style="display:inline-flex;align-items:center;gap:6px;background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.25);border-radius:20px;padding:5px 16px;margin-bottom:18px;">
      <span style="font-size:9px;font-weight:700;color:var(--gold);letter-spacing:2.5px;text-transform:uppercase;">🇱🇰 Sri Lanka's Tile & Bathroom Marketplace</span>
    </div>
    <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,5vw,48px);font-weight:700;color:#fff;line-height:1.15;margin-bottom:14px;">
      Everything for Your<br/><span style="color:var(--gold);">Tile &amp; Bathroom Project</span>
    </h1>
    <p style="font-size:clamp(13px,1.8vw,15px);color:rgba(255,255,255,0.6);margin-bottom:26px;line-height:1.8;">
      Find trusted professionals, quality products, leading brands and the best prices.
    </p>

    <!-- Search bar -->
    <div style="position:relative;max-width:500px;margin:0 auto 18px;">
      <span style="position:absolute;left:16px;top:50%;transform:translateY(-50%);font-size:18px;pointer-events:none;">🔍</span>
      <input
        type="text"
        id="hero-search"
        placeholder="Search tilers, shops, brands…"
        style="width:100%;height:50px;padding:0 120px 0 48px;border:none;border-radius:14px;font-size:13px;font-family:inherit;outline:none;background:rgba(255,255,255,0.96);color:#0f172a;box-shadow:0 8px 32px rgba(0,0,0,0.3);"
      />
      <button
        onclick="document.location='/providers?q='+encodeURIComponent(document.getElementById('hero-search').value)"
        style="position:absolute;right:6px;top:6px;bottom:6px;padding:0 18px;background:var(--terra);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;">
        Search
      </button>
    </div>

    <!-- CTAs -->
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
      <a href="/providers?type=tiler"
        style="display:inline-flex;align-items:center;gap:7px;background:var(--terra);color:#fff;border-radius:12px;padding:12px 22px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(224,90,43,0.4);">
        👷 Find Tiler
      </a>
      <a href="/post-project"
        style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.1);color:#fff;border:1.5px solid rgba(255,255,255,0.3);border-radius:12px;padding:12px 22px;font-size:13px;font-weight:600;text-decoration:none;">
        📋 Post a Project
      </a>
      <a href="/jobs"
        style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.1);color:#fff;border:1.5px solid rgba(255,255,255,0.3);border-radius:12px;padding:12px 22px;font-size:13px;font-weight:600;text-decoration:none;">
        💼 Browse Jobs
      </a>
    </div>
  </div>
</div>

<!-- ② QUICK ACTIONS ──────────────────────────────────────── -->
<section style="background:#fff;padding:20px 0 18px;border-bottom:1px solid var(--border);">
  <div class="quick-grid">
    {QUICK_ACTIONS.map(a => (
      <a href={a.href} class="quick-card">
        <div class="qc-icon" style={`background:${a.bg};`}>{a.icon}</div>
        <span class="qc-label">{a.label}</span>
      </a>
    ))}
  </div>
</section>

<!-- ③ STATS BAR ───────────────────────────────────────────── -->
<div style="background:var(--navy);padding:12px 0;">
  <div style="display:flex;justify-content:center;flex-wrap:wrap;">
    {[
      { n: '500+', l: 'Professionals' },
      { n: '25',   l: 'Districts' },
      { n: 'Free', l: 'Always' },
      { n: '100%', l: 'WhatsApp Direct' },
    ].map((s, i, arr) => (
      <div style={`text-align:center;padding:6px 20px;border-right:${i < arr.length-1 ? '1px solid rgba(255,255,255,0.1)' : 'none'}`}>
        <div style="font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:var(--gold);">{s.n}</div>
        <div style="font-size:10px;color:rgba(255,255,255,0.45);margin-top:1px;">{s.l}</div>
      </div>
    ))}
  </div>
</div>

<!-- ④ FEATURED TILERS ────────────────────────────────────── -->
<section class="section" style="background:#fff;">
  <div class="section-head">
    <div>
      <div class="section-eyebrow">⭐ Featured</div>
      <div class="section-title-sm">Verified Tiling <span>Professionals</span></div>
    </div>
    <a href="/providers?type=tiler" class="see-all">View all →</a>
  </div>

  <div class="shelf">
    {(tilers.length > 0 ? tilers : [
      { id:'p1', full_name:'Lakmal Perera',   city:'Colombo 7', is_verified:true,  avg_rating:4.9, experience_years:12, slug:'lakmal'  },
      { id:'p2', full_name:'Chamara Silva',   city:'Kandy',     is_verified:true,  avg_rating:4.7, experience_years:8,  slug:'chamara' },
      { id:'p3', full_name:'Saman Jayantha',  city:'Galle',     is_verified:false, avg_rating:0,   experience_years:5,  slug:null      },
      { id:'p4', full_name:'Kelum Prasad',    city:'Negombo',   is_verified:true,  avg_rating:4.8, experience_years:10, slug:'kelum'   },
      { id:'p5', full_name:'Nuwan Bandara',   city:'Kurunegala',is_verified:true,  avg_rating:4.6, experience_years:7,  slug:null      },
    ]).map(t => (
      <div class="tiler-card" style="width:200px;flex-shrink:0;">
        <div style="height:120px;background:#f8fafc;background-image:repeating-linear-gradient(0deg,transparent,transparent 19px,#e2e8f0 19px,#e2e8f0 20px),repeating-linear-gradient(90deg,transparent,transparent 19px,#e2e8f0 19px,#e2e8f0 20px);display:flex;align-items:center;justify-content:center;position:relative;">
          <span style="font-size:36px;opacity:0.1;">🪨</span>
          {t.is_verified
            ? <span class="verified-badge">✓ Skilled</span>
            : <span class="verified-badge" style="background:#f8fafc;color:#94a3b8;border-color:#e2e8f0;">Community</span>
          }
        </div>
        <div class="tiler-body">
          {t.avg_rating > 0 && <div class="rating">⭐ {t.avg_rating.toFixed(1)}</div>}
          <div class="tiler-name">{t.full_name}</div>
          <div class="tiler-meta">
            {t.experience_years > 0 ? `🛡️ ${t.experience_years}+ Yrs · ` : ''}📍 {t.city || t.district}
          </div>
          {t.slug ? (
            <a href={`/tilers/${t.slug}`}
              style="display:flex;align-items:center;justify-content:center;width:100%;padding:7px;background:#0f172a;color:#fff;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;margin-top:8px;">
              View Profile →
            </a>
          ) : (t.whatsapp || t.phone) ? (
            <a href={waLink(t.whatsapp || t.phone, t.full_name)} target="_blank" rel="noopener" class="tiler-wa-btn" style="margin-top:8px;">
              💬 WhatsApp
            </a>
          ) : (
            <a href="/providers?type=tiler"
              style="display:flex;align-items:center;justify-content:center;width:100%;padding:7px;background:#f1f5f9;color:#64748b;border-radius:8px;font-size:11px;font-weight:600;text-decoration:none;margin-top:8px;">
              View Profile →
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ⑤ POST + LATEST JOBS ─────────────────────────────────── -->
<section style="background:var(--navy);padding:36px 20px;border-top:1px solid rgba(255,255,255,0.06);">
  <div style="max-width:900px;margin:0 auto;display:grid;grid-template-columns:5fr 7fr;gap:16px;align-items:stretch;">

    <!-- Post CTA card -->
    <div style="background:var(--terra);border-radius:18px;padding:28px 24px;display:flex;flex-direction:column;justify-content:center;">
      <div style="font-size:32px;margin-bottom:12px;">📋</div>
      <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:#fff;margin-bottom:8px;line-height:1.3;">
        Post Your Project
      </div>
      <p style="font-size:12px;color:rgba(255,255,255,0.75);margin-bottom:20px;line-height:1.7;">
        Get free quotes from verified tilers and contractors. No login · 100% free · WhatsApp direct.
      </p>
      <a href="/post-project"
        style="display:inline-flex;align-items:center;justify-content:center;gap:7px;background:#fff;color:var(--terra);border-radius:12px;padding:12px 20px;font-size:13px;font-weight:800;text-decoration:none;">
        Post a Project →
      </a>
    </div>

    <!-- Latest jobs -->
    <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:20px 20px 16px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <div style="font-size:13px;font-weight:700;color:#fff;">💼 Latest Projects</div>
        <a href="/jobs" style="font-size:11px;color:rgba(255,255,255,0.5);text-decoration:none;font-weight:600;">Browse all →</a>
      </div>

      {jobs.length > 0 ? (
        <div style="display:flex;flex-direction:column;gap:8px;">
          {jobs.map(job => (
            <a href={`/jobs/${job.id}`}
              style="display:flex;align-items:center;gap:12px;padding:11px 14px;background:rgba(255,255,255,0.06);border-radius:12px;text-decoration:none;color:inherit;transition:background 0.15s;"
              onmouseover="this.style.background='rgba(255,255,255,0.1)'"
              onmouseout="this.style.background='rgba(255,255,255,0.06)'">
              <div style="flex:1;min-width:0;">
                <div style="font-size:13px;font-weight:700;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{job.title}</div>
                <div style="font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px;">📍 {job.city || job.district} · {timeAgo(job.created_at)}</div>
              </div>
              {job.budget_min && (
                <div style="flex-shrink:0;font-size:12px;font-weight:700;color:var(--gold);">Rs.{job.budget_min}+</div>
              )}
              <div style="font-size:16px;color:rgba(255,255,255,0.3);">›</div>
            </a>
          ))}
        </div>
      ) : (
        <div style="text-align:center;padding:24px 16px;">
          <div style="font-size:36px;margin-bottom:10px;">💼</div>
          <div style="font-size:13px;color:rgba(255,255,255,0.5);line-height:1.65;">
            No open projects yet.<br/>Be the first to post — it's free.
          </div>
        </div>
      )}
    </div>

  </div>
</section>

<!-- ⑥ EXPLORE TILERSHUB ───────────────────────────────────── -->
<section style="background:var(--surface-2);padding:28px 0 24px;border-top:1px solid var(--border);">
  <div style="padding:0 16px 10px;display:flex;align-items:center;justify-content:space-between;">
    <div style="font-size:13px;font-weight:700;color:var(--text);">Explore TilersHub</div>
    <a href="/categories" style="font-size:11px;font-weight:600;color:var(--navy);text-decoration:none;">All categories →</a>
  </div>

  <!-- Row 1: Professionals & Services -->
  <div style="display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding:0 16px 10px;">
    {EXPLORE_PROS.map(c => (
      <a href={c.href}
        style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:8px 14px;border-radius:20px;background:#fff;color:var(--text-2);border:1px solid var(--border);white-space:nowrap;text-decoration:none;flex-shrink:0;transition:all 0.15s;"
        onmouseover="this.style.borderColor='#1A2B4A';this.style.color='#1A2B4A'"
        onmouseout="this.style.borderColor='';this.style.color=''">
        {c.label}
      </a>
    ))}
  </div>

  <!-- Row 2: Products & Tools -->
  <div style="display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding:0 16px 4px;">
    {EXPLORE_MORE.map(c => (
      <a href={c.href}
        style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:8px 14px;border-radius:20px;background:#fff;color:var(--text-2);border:1px solid var(--border);white-space:nowrap;text-decoration:none;flex-shrink:0;transition:all 0.15s;"
        onmouseover="this.style.borderColor='#1A2B4A';this.style.color='#1A2B4A'"
        onmouseout="this.style.borderColor='';this.style.color=''">
        {c.label}
      </a>
    ))}
  </div>
</section>

<!-- ⑦ BRANDS ─────────────────────────────────────────────── -->
<section class="section" style="background:#fff;border-top:1px solid var(--border);">
  <div class="section-head">
    <div>
      <div class="section-eyebrow">🏷️ Brands</div>
      <div class="section-title-sm">Tile &amp; Bath <span>Brands</span></div>
    </div>
    <a href="/tile" class="see-all">All brands →</a>
  </div>
  <div class="shelf">
    {(brands.length > 0 ? brands : [
      { id:'b1', name:'Rocell',      slug:'rocell',      categories:['Porcelain','Wall'] },
      { id:'b2', name:'Lanka Tile',  slug:'lanka-tile',  categories:['Floor','Wall']     },
      { id:'b3', name:'Johnson',     slug:'johnson',     categories:['Ceramic']          },
      { id:'b4', name:'NITCO',       slug:'nitco',       categories:['Floor','Outdoor']  },
      { id:'b5', name:'Swisstek',    slug:'swisstek',    categories:['Adhesive','Grout'] },
      { id:'b6', name:'Tokyo Super', slug:'tokyo-super', categories:['Adhesive']         },
      { id:'b7', name:'ACL',         slug:'acl',         categories:['Bathroom']         },
      { id:'b8', name:'S-Lon',       slug:'s-lon',       categories:['Plumbing']         },
    ]).map((b, idx) => (
      <a href={`/brands/${b.slug}`} class="brand-card">
        <div class="brand-logo" style={`background:${BRAND_COL[idx % BRAND_COL.length]};`}>
          {initials(b.name)}
        </div>
        <div class="brand-name">{b.name}</div>
        <div class="brand-cat">{(b.categories||[]).slice(0,2).join(' · ')}</div>
      </a>
    ))}
  </div>
</section>

<!-- ⑧ COMMUNITY + FINAL CTA ──────────────────────────────── -->
<section style="background:var(--navy);padding:44px 20px;position:relative;overflow:hidden;border-top:3px solid var(--gold);">
  <div style="position:absolute;inset:0;opacity:0.03;background-image:radial-gradient(circle,rgba(255,255,255,0.8) 1px,transparent 1px);background-size:24px 24px;pointer-events:none;"></div>
  <div style="max-width:520px;margin:0 auto;text-align:center;position:relative;">
    <div style="font-size:9px;font-weight:700;color:rgba(245,158,11,0.7);letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;">Join the Community</div>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(20px,4vw,28px);font-weight:700;color:#fff;margin-bottom:10px;line-height:1.25;">
      Connect with Sri Lanka's<br/><span style="color:var(--gold);">Tiling Community</span>
    </h2>
    <p style="font-size:13px;color:rgba(255,255,255,0.5);margin-bottom:22px;line-height:1.8;">Get tips, find work, and share your projects on WhatsApp and Facebook.</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:24px;">
      <a href="https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z?s=cl&p=i&mlu=4&ilr=0" target="_blank" rel="noopener"
        style="display:inline-flex;align-items:center;gap:7px;background:#25D366;color:#fff;border-radius:11px;padding:11px 20px;font-size:13px;font-weight:700;text-decoration:none;">
        💬 WhatsApp Group
      </a>
      <a href="https://www.facebook.com/share/g/1Dsc63BvXS/?mibextid=wwXIfr" target="_blank" rel="noopener"
        style="display:inline-flex;align-items:center;gap:7px;background:#1877F2;color:#fff;border-radius:11px;padding:11px 20px;font-size:13px;font-weight:700;text-decoration:none;">
        👥 Facebook Group
      </a>
    </div>
    <div style="border-top:1px solid rgba(255,255,255,0.1);padding-top:22px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
      <a href="/post-project" class="btn btn-terra">📋 Post a Project</a>
      <a href="/join-tilershub" class="btn btn-outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.8);">✅ Join as Provider</a>
    </div>
  </div>
</section>

</Layout>

<style>
  @media (max-width: 480px) {
    .quick-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 640px) {
    /* Jobs section: stack columns */
    div[style*="grid-template-columns:5fr 7fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
