---
import Layout from '../layouts/Layout.astro'
import HeroBanner from '../components/HeroBanner.jsx'
import AdSlider from '../components/AdSlider.jsx'
import { supabase } from '../lib/supabase.js'

const { data: featuredTilers } = await supabase
  .from('tilers')
  .select('id,full_name,district,city,services,is_verified,avatar_url,experience_years,avg_rating,phone')
  .eq('featured', true)
  .order('experience_years', { ascending: false })
  .limit(6)

const { data: brands } = await supabase
  .from('brands')
  .select('*')
  .eq('status', 'active')
  .eq('is_featured', true)
  .limit(4)

const tilers = featuredTilers || []

function initials(name) {
  return name?.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() || 'TH'
}

const QUICK_ACTIONS = [
  { icon: '👷', label: 'Find Tilers', href: '/providers' },
  { icon: '📋', label: 'Post Project', href: '/post-project' },
  { icon: '📐', label: 'Estimator', href: '/estimator' },
  { icon: '🏭', label: 'Workshops', href: '/providers?type=workshop' },
  { icon: '📦', label: 'Suppliers', href: '/providers?type=supplier' },
  { icon: '🏷️', label: 'Brands', href: '/brands' },
  { icon: '🚿', label: 'Bathroom Ideas', href: '/sponsor/luxehome' },
  { icon: '🏪', label: 'Tile Shops', href: '/providers?type=tile_shop' },
]

const TIPS = [
  { icon: '✅', title: 'Always verify credentials', text: 'Look for TH Verified or Certified Pro badges before hiring.' },
  { icon: '📸', title: 'Ask for past work photos', text: 'A good tiler will have a portfolio of completed projects.' },
  { icon: '📏', title: 'Calculate tiles correctly', text: 'Add 10–15% extra for cuts, breakage and future repairs.' },
  { icon: '💬', title: 'Get quotes via WhatsApp', text: 'Contact multiple tilers and compare quotes before deciding.' },
]
---

<Layout
  title="TilersHub · Sri Lanka's Trusted Tiling Platform"
  description="Find verified tilers, workshops, suppliers and tile brands across Sri Lanka. Post your tiling project free on TilersHub."
>

  <!-- Hero Banner Slider -->
  <HeroBanner client:load />

  <!-- Quick Actions -->
  <section style="background:var(--surface);padding:28px 0 20px;border-bottom:1px solid var(--border);">
    <div class="container">
      <div class="quick-actions-grid">
        {QUICK_ACTIONS.map(a => (
          <a href={a.href} class="quick-action">
            <div class="qa-icon">{a.icon}</div>
            <span class="qa-label">{a.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section style="background:var(--navy);padding:18px 0;">
    <div class="container" style="display:flex;justify-content:center;flex-wrap:wrap;">
      {[
        { n: '500+', l: 'Tiling Professionals' },
        { n: '25', l: 'Districts Covered' },
        { n: 'Free', l: 'Service Always' },
        { n: '100%', l: 'WhatsApp Direct' },
      ].map((s, i, arr) => (
        <div style={`text-align:center;padding:10px 24px;border-right:${i < arr.length-1 ? '1px solid rgba(255,255,255,0.1)' : 'none'};`}>
          <div style="font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:var(--terra);">{s.n}</div>
          <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Tilers -->
  <section class="section" style="background:var(--surface);">
    <div class="container">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:12px;">
        <div>
          <span class="section-label">⭐ Featured</span>
          <h2 class="section-title">Verified Tiling <em>Professionals</em></h2>
          <p class="section-sub">Skilled tilers verified by TilersHub — contact directly via WhatsApp</p>
        </div>
        <a href="/providers" class="btn btn-outline">View All Providers →</a>
      </div>

      {tilers.length > 0 ? (
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;">
          {tilers.map(t => (
            <a href={`/providers/${t.id}`} class="provider-card" style="padding:20px;display:block;text-decoration:none;color:inherit;">
              <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                <div class="provider-avatar">
                  {t.avatar_url
                    ? <img src={t.avatar_url} alt={t.full_name} />
                    : initials(t.full_name)
                  }
                </div>
                <div style="min-width:0;flex:1;">
                  <div style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{t.full_name}</div>
                  <div style="font-size:12px;color:var(--text-3);">📍 {t.city || t.district}</div>
                </div>
                {t.is_verified && <span class="badge badge-verified">✓ Verified</span>}
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;">
                {(t.services || []).slice(0,3).map(s => (
                  <span class="chip chip-navy" style="font-size:10px;">{s}</span>
                ))}
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:12px;color:var(--text-3);">{t.experience_years}+ yrs experience</span>
                <span style="font-size:11px;font-weight:700;color:var(--navy);">Contact →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div style="text-align:center;padding:48px 20px;background:var(--surface-2);border-radius:16px;border:1px solid var(--border);">
          <div style="font-size:36px;margin-bottom:12px;">👷</div>
          <p style="color:var(--text-3);font-size:14px;">Browse our full directory of tiling professionals.</p>
          <a href="/providers" class="btn btn-navy" style="margin-top:16px;display:inline-flex;">Browse All Providers</a>
        </div>
      )}

      <div style="text-align:center;margin-top:32px;">
        <a href="/providers" class="btn btn-navy btn-lg">Browse All Tiling Professionals</a>
      </div>
    </div>
  </section>

  <!-- Sponsor Slider -->
  <section style="background:var(--surface-2);padding:48px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container" style="max-width:900px;">
      <div style="text-align:center;margin-bottom:16px;">
        <span style="font-size:10px;font-weight:700;color:var(--text-4);letter-spacing:2px;text-transform:uppercase;">Sponsored Partner</span>
      </div>
      <AdSlider client:visible />
    </div>
  </section>

  <!-- Post Project CTA -->
  <section style="background:var(--navy);padding:56px 0;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(255,255,255,0.8) 20px,rgba(255,255,255,0.8) 21px);pointer-events:none;"></div>
    <div class="container" style="text-align:center;position:relative;">
      <div style="font-size:10px;font-weight:700;color:rgba(224,90,43,0.7);letter-spacing:3px;text-transform:uppercase;margin-bottom:14px;">Free — No Login Required</div>
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(24px,4vw,38px);font-weight:700;color:#fff;margin-bottom:14px;line-height:1.2;">
        Have a tiling project? <span style="color:var(--terra);">Post it free.</span>
      </h2>
      <p style="font-size:15px;color:rgba(255,255,255,0.55);max-width:480px;margin:0 auto 32px;line-height:1.9;">
        Describe your project, set a budget, and let verified professionals reach out directly on WhatsApp.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="/post-project" class="btn btn-terra btn-lg">📋 Post Your Project</a>
        <a href="/providers" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.2);padding:14px 24px;font-size:14px;border-radius:12px;font-weight:600;display:inline-flex;align-items:center;gap:6px;text-decoration:none;">Browse Providers →</a>
      </div>
    </div>
  </section>

  <!-- Featured Brands -->
  {(brands?.length ?? 0) > 0 && (
    <section class="section" style="background:var(--surface-2);">
      <div class="container">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:12px;">
          <div>
            <span class="section-label">🏷️ Brands</span>
            <h2 class="section-title">Featured Tile <em>Brands</em></h2>
            <p class="section-sub">Discover premium tile brands available in Sri Lanka</p>
          </div>
          <a href="/brands" class="btn btn-outline">All Brands →</a>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;">
          {brands.map(brand => (
            <a href={`/brands/${brand.slug}`} class="card" style="padding:24px;display:block;text-decoration:none;color:inherit;">
              <div style="font-size:32px;margin-bottom:12px;">🏷️</div>
              <div style="font-size:16px;font-weight:700;color:var(--text);margin-bottom:6px;">{brand.name}</div>
              <p style="font-size:12px;color:var(--text-3);line-height:1.6;margin-bottom:14px;">{(brand.description || '').slice(0,80)}...</p>
              <div style="display:flex;flex-wrap:wrap;gap:4px;">
                {(brand.categories || []).slice(0,2).map(c => (
                  <span class="chip chip-navy" style="font-size:10px;">{c}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- How It Works -->
  <section class="section" style="background:var(--surface);">
    <div class="container">
      <div style="text-align:center;margin-bottom:48px;">
        <span class="section-label">Simple Process</span>
        <h2 class="section-title">How <em>TilersHub</em> Works</h2>
        <p class="section-sub" style="margin:0 auto;">Connect with tiling professionals in three easy steps</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;">
        {[
          { step: '01', icon: '🔍', title: 'Search Providers', desc: 'Browse verified tilers, workshops, and suppliers by district and service type.' },
          { step: '02', icon: '💬', title: 'Contact via WhatsApp', desc: 'Connect directly on WhatsApp — no middlemen, no commission, no delays.' },
          { step: '03', icon: '🏠', title: 'Get Work Done', desc: 'Discuss your project, agree on a quote, and get quality tiling done.' },
        ].map(s => (
          <div style="padding:28px;background:var(--surface-2);border-radius:16px;border:1px solid var(--border);">
            <div style="font-size:11px;font-weight:800;color:var(--terra);letter-spacing:2px;margin-bottom:12px;">{s.step}</div>
            <div style="font-size:32px;margin-bottom:14px;">{s.icon}</div>
            <h3 style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:8px;">{s.title}</h3>
            <p style="font-size:13px;color:var(--text-3);line-height:1.7;">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tips -->
  <section class="section" style="background:var(--surface-2);border-top:1px solid var(--border);">
    <div class="container">
      <div style="text-align:center;margin-bottom:36px;">
        <span class="section-label">💡 Tips</span>
        <h2 class="section-title">Tiling <em>Tips & Advice</em></h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;">
        {TIPS.map(t => (
          <div style="padding:22px;background:var(--surface);border-radius:14px;border:1px solid var(--border);">
            <div style="font-size:24px;margin-bottom:10px;">{t.icon}</div>
            <h4 style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:6px;">{t.title}</h4>
            <p style="font-size:12px;color:var(--text-3);line-height:1.7;">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section style="background:var(--surface);padding:56px 0;border-top:1px solid var(--border);">
    <div class="container" style="max-width:680px;text-align:center;">
      <span class="section-label">🛠️ For Professionals</span>
      <h2 class="section-title" style="margin-top:8px;">Are you a tiler or workshop?</h2>
      <p class="section-sub" style="margin:0 auto 32px;">Join TilersHub to get discovered by homeowners across Sri Lanka. Free listing, direct WhatsApp leads, no commission.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="/join-tilershub" class="btn btn-navy btn-lg">✅ Join as Provider</a>
        <a href="/providers" class="btn btn-ghost btn-lg">Browse Directory</a>
      </div>
    </div>
  </section>

</Layout>
