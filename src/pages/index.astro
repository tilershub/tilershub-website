---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase.js'
import HomeHero from '../components/HomeHero.jsx'
import { HOME_GROUPS, SERVICES } from '../lib/services.js'

const HERO_IMG = 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?auto=format&fit=crop&w=1400&q=75'

const serviceBySlug = Object.fromEntries(SERVICES.map(s => [s.slug, s]))

const BLOG_POSTS = [
  { slug: 'how-to-choose-a-tiler',             icon: '👷', color: '#1B3A6B', category: 'Hiring Tips',          titleEn: 'How to Choose the Right Tiler for Your Project',                      titleSi: 'ඔබේ ව්‍යාපෘතිය සඳහා නිවැරදි ටයිලර් කෙනෙකු තෝරා ගන්නේ කෙසේද' },
  { slug: 'bathroom-renovation-cost-sri-lanka', icon: '💰', color: '#0f766e', category: 'Cost Guide',           titleEn: 'Bathroom Renovation Cost in Sri Lanka (2025 Guide)',                    titleSi: 'ශ්‍රී ලංකාවේ නාන කාමර ප්‍රතිසංස්කරණ පිරිවැය (2025 මාර්ගෝපදේශ)' },
  { slug: 'waterproofing-bathroom-guide',       icon: '💧', color: '#0369a1', category: 'How-to Guide',         titleEn: 'Why Waterproofing Is the Most Important Step',                         titleSi: 'ජලනිරෝධය වඩාත්ම වැදගත් පියවර වන්නේ ඇයි' },
  { slug: 'large-format-tiles-guide',           icon: '📏', color: '#b45309', category: 'Tile Guide',           titleEn: 'Large Format Tiles: Pros, Cons & Installation Tips',                   titleSi: 'විශාල ෆෝමැට් ටයිල්: වාසි, අවාසි සහ ස්ථාපන ඉඟි' },
]

const PROJECT_TYPE_ICONS: Record<string,string> = {
  'Floor Tiling':'🪨','Bathroom Tiling':'🚿','Bathroom Renovation':'🛁',
  'Granite Works':'💎','Tile Cutting':'✂️','Routering':'🔧',
  'Waterproofing':'💧','Tile Shop Inquiry':'🏪',
}
const PROJECT_TYPE_COLORS: Record<string,string> = {
  'Floor Tiling':'#1B3A6B','Bathroom Tiling':'#0f766e','Bathroom Renovation':'#0f766e',
  'Granite Works':'#7c3aed','Tile Cutting':'#b45309','Routering':'#b45309',
  'Waterproofing':'#0369a1','Tile Shop Inquiry':'#E05A2B',
}

const { data: recentProjectsRaw } = await supabase
  .from('projects')
  .select('id,project_type,city,district,description,budget_range,created_at')
  .eq('status', 'active')
  .order('created_at', { ascending: false })
  .limit(3)

const recentProjects = recentProjectsRaw || []

function projectTimeAgo(ts: string) {
  const diff = Math.floor((Date.now() - new Date(ts).getTime()) / 1000)
  if (diff < 60)     return 'just now'
  if (diff < 3600)   return `${Math.floor(diff / 60)}m`
  if (diff < 86400)  return `${Math.floor(diff / 3600)}h`
  if (diff < 604800) return `${Math.floor(diff / 86400)}d`
  return new Date(ts).toLocaleDateString('en-LK', { day:'numeric', month:'short' })
}

const WHY_ITEMS = [
  { icon: '✅', en: 'Verified Providers', si: 'සත්‍යාපිත ශිල්පීන්', descEn: 'All professionals are reviewed before listing', descSi: 'සියලු ශිල්පීන් ලැයිස්තු කිරීමට පෙර සමාලෝචනය කෙරේ' },
  { icon: '📊', en: 'Compare Quotations', si: 'ලංසු සංසන්දනය',    descEn: 'Receive multiple quotes and choose the best', descSi: 'ලංසු කිහිපයක් ලබා ගෙන හොඳම එක තෝරා ගන්න' },
  { icon: '⭐', en: 'Reviews & Ratings',  si: 'සමාලෝචන',          descEn: 'Real reviews from verified customers',      descSi: 'සත්‍යාපිත ගනුදෙනුකරුවන්ගේ ඇත්ත සමාලෝචන' },
  { icon: '🗺️', en: 'Islandwide Service', si: 'දිවයිනපුරා',        descEn: 'Covering all 25 districts across Sri Lanka', descSi: 'ශ්‍රී ලංකාවේ සියලු දිස්ත්‍රික්ක 25 ආවරණය' },
]
---

<Layout
  title="TilersHub · Sri Lanka's Home Improvement Marketplace"
  description="Post your home project free and get quotes from verified tilers, contractors and specialists across Sri Lanka."
>
  <meta slot="head" name="keywords" content="tilers Sri Lanka, tiling services, bathroom renovation, floor tiling, tile contractor Colombo, tile shop Sri Lanka, waterproofing Sri Lanka, TilersHub" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: "TilersHub · Sri Lanka's Home Improvement Marketplace",
    description: 'Post your home project free and get quotes from verified specialists across Sri Lanka.',
    url: 'https://www.tilershub.lk',
    isPartOf: { '@id': 'https://www.tilershub.lk/#website' },
    about: { '@type': 'Thing', name: 'Tiling and home improvement services in Sri Lanka' },
  })} />
  <link slot="head" rel="preload" as="image" href={HERO_IMG} fetchpriority="high" />

  <!-- ══ HERO ══ -->
  <div id="guest-hero-static" style="position:relative;min-height:320px;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:44px 20px 40px;background:#0a121f;">
    <img src={HERO_IMG} alt="" width="1400" height="800"
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0.32;"
      loading="eager" fetchpriority="high" decoding="sync" />
    <div style="position:absolute;inset:0;background:linear-gradient(175deg,rgba(8,15,28,0.72) 0%,rgba(20,35,65,0.68) 100%);pointer-events:none;"></div>
    <div style="position:relative;text-align:center;max-width:560px;width:100%;">
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(24px,5vw,40px);font-weight:700;color:#fff;line-height:1.15;margin-bottom:10px;">
        <span class="en-text">Find the Right Professional for Your Home</span>
        <span class="si-text">ඔබේ නිවස සඳහා නිවැරදි ශිල්පියා සොයන්න</span>
      </h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.62);margin-bottom:22px;line-height:1.7;">
        <span class="en-text">Post your project free and get quotes from verified specialists</span>
        <span class="si-text">ව්‍යාපෘතිය නොමිලේ පළ කර සත්‍යාපිත ශිල්පීන්ගේ ලංසු ලබා ගන්න</span>
      </p>
      <!-- Search bar -->
      <form id="hero-search" style="display:flex;gap:8px;margin-bottom:16px;max-width:480px;margin-left:auto;margin-right:auto;">
        <input id="hero-q" type="search"
          style="flex:1;padding:13px 16px;border-radius:24px;border:none;font-size:14px;outline:none;color:#0f172a;"
          aria-label="Search services" />
        <button type="submit"
          style="flex-shrink:0;background:#E05A2B;color:#fff;border:none;border-radius:24px;padding:13px 22px;font-size:14px;font-weight:700;cursor:pointer;white-space:nowrap;">
          <span class="en-text">Search</span>
          <span class="si-text">සොයන්න</span>
        </button>
      </form>
      <div>
        <a href="/post-project" style="display:inline-flex;align-items:center;gap:8px;background:#E05A2B;color:#fff;border-radius:24px;padding:13px 26px;font-size:14px;font-weight:800;text-decoration:none;box-shadow:0 4px 20px rgba(224,90,43,0.45);margin-bottom:14px;">
          📋
          <span class="en-text">Post Your Project Free</span>
          <span class="si-text">ව්‍යාපෘතිය නොමිලේ පලකරන්න</span>
        </a>
      </div>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
        <span style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.78);border-radius:20px;padding:5px 13px;font-size:11px;font-weight:600;border:1px solid rgba(255,255,255,0.15);">
          <span class="en-text">✓ Free to post</span>
          <span class="si-text">✓ නොමිලේ</span>
        </span>
        <span style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.78);border-radius:20px;padding:5px 13px;font-size:11px;font-weight:600;border:1px solid rgba(255,255,255,0.15);">
          <span class="en-text">✓ Multiple quotes</span>
          <span class="si-text">✓ බහු ලංසු</span>
        </span>
        <span style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.78);border-radius:20px;padding:5px 13px;font-size:11px;font-weight:600;border:1px solid rgba(255,255,255,0.15);">
          <span class="en-text">✓ No commitment</span>
          <span class="si-text">✓ බැඳීමක් නැත</span>
        </span>
      </div>
    </div>
  </div>
  <!-- Provider-specific hero — replaces static hero if logged-in provider -->
  <HomeHero client:load heroImg={HERO_IMG} />

  <!-- ══ SERVICE GROUPS ══ -->
  <section style="background:#fff;padding:20px 0 8px;border-bottom:1px solid #f1f5f9;">
    <div style="padding:0 16px 10px;">
      <h2 style="font-size:16px;font-weight:700;color:#111827;margin:0 0 2px;">
        <span class="en-text">Browse by Service</span>
        <span class="si-text">සේවාවෙන් සොයන්න</span>
      </h2>
    </div>

    {HOME_GROUPS.map(group => {
      const groupServices = group.services.map(slug => serviceBySlug[slug]).filter(Boolean)
      return (
        <div style="margin-bottom:20px;">
          <!-- Group header -->
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0 16px 8px;">
            <div style="display:flex;align-items:center;gap:7px;">
              <span style="font-size:16px;">{group.icon}</span>
              <span style="font-size:14px;font-weight:700;color:#111827;">
                <span class="en-text">{group.label}</span>
                <span class="si-text">{group.labelSi}</span>
              </span>
            </div>
            <a href={group.viewAllHref} style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">
              <span class="en-text">View all ›</span>
              <span class="si-text">සියල්ල ›</span>
            </a>
          </div>
          <!-- Scrollable service cards -->
          <div style="display:flex;gap:8px;overflow-x:auto;padding:0 16px 4px;scrollbar-width:none;-webkit-overflow-scrolling:touch;">
            {groupServices.map(svc => (
              <a href={`/services/${svc.slug}`}
                style="flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:6px;width:86px;padding:12px 6px 10px;background:#f8fafc;border-radius:14px;border:1px solid #e2e8f0;text-decoration:none;color:#0f172a;transition:border-color 0.15s;">
                <span style="font-size:26px;line-height:1;">{svc.icon}</span>
                <span style="font-size:10px;font-weight:600;text-align:center;line-height:1.3;color:#374151;">{svc.label}</span>
              </a>
            ))}
          </div>
        </div>
      )
    })}
  </section>

  <!-- ══ HOW IT WORKS ══ -->
  <section style="background:linear-gradient(135deg,#0F1E35,#1A2B4A);padding:28px 16px 24px;">
    <div style="max-width:480px;margin:0 auto;">
      <p style="font-size:9px;font-weight:700;color:rgba(255,255,255,0.4);letter-spacing:3px;text-transform:uppercase;text-align:center;margin:0 0 18px;">
        <span class="en-text">HOW IT WORKS</span>
        <span class="si-text">ක්‍රියාකාරී ආකාරය</span>
      </p>
      {[
        { n:'1', icon:'📋',
          titleEn:'Post Your Project', titleSi:'ව්‍යාපෘතිය පලකරන්න',
          descEn:'Free — no login needed. Takes 2 minutes.', descSi:'නොමිලේ — ලොගිනය අවශ්‍ය නැත. මිනිත්තු 2 ක් ගනී.',
          c:'#E05A2B' },
        { n:'2', icon:'💬',
          titleEn:'Receive Quotes',    titleSi:'ලංසු ලැබේ',
          descEn:'Verified specialists send quotes via WhatsApp.', descSi:'සත්‍යාපිත ශිල්පීවරු WhatsApp ට ලංසු යවති.',
          c:'#D4AF37' },
        { n:'3', icon:'✅',
          titleEn:'Choose the Best',   titleSi:'ඔබ තෝරා ගන්න',
          descEn:'Compare, chat directly, hire the best fit.', descSi:'සසඳන්න, කෙළින්ම කතා කරන්න, හොඳම අය තෝරන්න.',
          c:'#25D366' },
      ].map((s, i) => (
        <div style={`display:flex;align-items:flex-start;gap:16px;padding:13px 0;${i<2?'border-bottom:1px solid rgba(255,255,255,0.07);':''}`}>
          <div style={`width:38px;height:38px;border-radius:50%;background:${s.c};display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#fff;flex-shrink:0;`}>{s.n}</div>
          <div style="padding-top:2px;">
            <div style="font-size:14px;font-weight:700;color:#fff;margin-bottom:2px;">
              <span class="en-text">{s.titleEn}</span>
              <span class="si-text">{s.titleSi}</span>
            </div>
            <div style="font-size:12px;color:rgba(255,255,255,0.45);line-height:1.6;">
              <span class="en-text">{s.descEn}</span>
              <span class="si-text">{s.descSi}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══ RECENT PROJECTS ══ -->
  <section style="background:#fff;padding:22px 0 24px;border-bottom:1px solid #f1f5f9;">
    <div style="padding:0 16px 14px;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:15px;font-weight:700;color:#111827;">
        <span class="en-text">Recent Projects</span>
        <span class="si-text">මෑත ව්‍යාපෘති</span>
      </span>
      <a href="/jobs" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">
        <span class="en-text">View all ›</span>
        <span class="si-text">සියල්ල ›</span>
      </a>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;padding:0 16px;">
      {recentProjects.length === 0
        ? (
          <div style="padding:20px 0;font-size:13px;color:#94a3b8;text-align:center;">
            <span class="en-text">No projects yet — </span>
            <span class="si-text">දැනට ව්‍යාපෘති නොමැත — </span>
            <a href="/post-project" style="color:#E05A2B;font-weight:600;text-decoration:none;">
              <span class="en-text">post yours free →</span>
              <span class="si-text">නොමිලේ පලකරන්න →</span>
            </a>
          </div>
        )
        : recentProjects.map((p: any) => {
          const icon  = PROJECT_TYPE_ICONS[p.project_type]  || '🏠'
          const color = PROJECT_TYPE_COLORS[p.project_type] || '#1B3A6B'
          const excerpt = p.description?.length > 90 ? p.description.slice(0, 90) + '…' : p.description
          return (
            <a href={`/job?id=${p.id}`}
              style="display:flex;align-items:center;gap:12px;background:#f8fafc;border-radius:16px;border:1px solid #e2e8f0;padding:14px 16px;text-decoration:none;color:inherit;">
              <div style={`width:48px;height:48px;border-radius:14px;background:${color}12;border:1.5px solid ${color}22;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;`}>{icon}</div>
              <div style="flex:1;min-width:0;">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
                  <span style="font-size:13px;font-weight:700;color:#0f172a;">{p.project_type}</span>
                  <span style="font-size:11px;color:#94a3b8;margin-left:auto;white-space:nowrap;">{projectTimeAgo(p.created_at)}</span>
                </div>
                {(p.city || p.district) && <div style="font-size:11px;color:#64748b;margin-bottom:4px;">📍 {p.city}{p.district && p.district !== p.city ? `, ${p.district}` : ''}</div>}
                {excerpt && <p style="font-size:12px;color:#64748b;margin:0 0 6px;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{excerpt}</p>}
                {p.budget_range && <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:#f0fdf4;color:#15803d;font-weight:600;border:1px solid #bbf7d0;">💰 {p.budget_range}</span>}
              </div>
              <div style={`flex-shrink:0;background:${color};color:#fff;border-radius:10px;padding:9px 16px;font-size:12px;font-weight:700;white-space:nowrap;`}>
                <span class="en-text">Bid →</span>
                <span class="si-text">ලංසු →</span>
              </div>
            </a>
          )
        })
      }
    </div>
  </section>

  <!-- ══ ESTIMATOR TEASER ══ -->
  <div style="padding:14px 16px;background:#fff;border-top:1px solid #f1f5f9;">
    <a href="/estimator"
      style="display:flex;align-items:center;justify-content:space-between;gap:12px;background:linear-gradient(120deg,#1B3A6B,#2B4A8A);border-radius:18px;padding:16px 20px;text-decoration:none;">
      <div style="display:flex;align-items:center;gap:14px;">
        <div style="font-size:28px;flex-shrink:0;">📐</div>
        <div>
          <div style="font-size:14px;font-weight:800;color:#fff;margin-bottom:2px;">
            <span class="en-text">Calculate Your Project Cost</span>
            <span class="si-text">ඔබේ ව්‍යාපෘති පිරිවැය ගණනය කරන්න</span>
          </div>
          <div style="font-size:11px;color:rgba(255,255,255,0.55);">
            <span class="en-text">Tiles · Labour · Materials — Free</span>
            <span class="si-text">ටයිල් ප්‍රමාණය · කම්කරු · ද්‍රව්‍ය — නොමිලේ</span>
          </div>
        </div>
      </div>
      <div style="background:#fff;color:#1B3A6B;border-radius:12px;padding:9px 16px;font-size:12px;font-weight:800;white-space:nowrap;flex-shrink:0;">
        <span class="en-text">Free ›</span>
