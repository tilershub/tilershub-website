---
import Layout from '../layouts/Layout.astro'
import HomeHero from '../components/HomeHero.jsx'
import NearYou from '../components/NearYou.jsx'
import DistrictPicker from '../components/DistrictPicker.jsx'
import { DEFAULT_DISTRICT } from '../lib/district.js'

const supabase = Astro.locals.supabase

// Server-render the default district so the page is useful before JS runs
// and crawlers see real content. The client re-queries when the user
// changes district.
const SHOP_TYPES = ['tile_shop', 'bathroom_shop', 'supplier', 'brand_dealer', 'tool_supplier', 'workshop']
const COLS = 'id,name,slug,city,district,service_areas,provider_type,avg_rating,review_count,profile_image,cover_image'

const { data: allActive } = await supabase
  .from('providers').select(COLS).eq('status', 'active')
  .order('avg_rating', { ascending: false })
  .order('review_count', { ascending: false })
  .limit(60)

const isLocal = (p: any) =>
  p.district === DEFAULT_DISTRICT ||
  (p.service_areas || []).includes(DEFAULT_DISTRICT) ||
  (p.city || '').toLowerCase().includes(DEFAULT_DISTRICT.toLowerCase())

const pool = allActive ?? []
const prosAll  = pool.filter((p: any) => !SHOP_TYPES.includes(p.provider_type))
const shopsAll = pool.filter((p: any) =>  SHOP_TYPES.includes(p.provider_type))
const pros  = (prosAll.filter(isLocal).length  ? prosAll.filter(isLocal)  : prosAll ).slice(0, 10)
const shops = (shopsAll.filter(isLocal).length ? shopsAll.filter(isLocal) : shopsAll).slice(0, 10)

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300')
---

<Layout
  title="TilersHub · Find Trusted Tilers in Sri Lanka"
  description="Post your tiling or renovation job free and get quotes from verified professionals near you. Compare ratings, chat on WhatsApp, no commission."
>
  <meta slot="head" name="keywords" content="tilers Sri Lanka, tiling services Colombo, bathroom renovation, floor tiling, tile shop Sri Lanka, find a tiler, TilersHub" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'TilersHub',
    url: 'https://www.tilershub.lk',
    description: 'Find trusted tilers and home-service professionals across Sri Lanka.',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://www.tilershub.lk/providers?search={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  })} />

  <!-- Signed-in providers get their own view; HomeHero hides this wrapper -->
  <div id="homeowner-home">

  <!-- ══ 1. ONE ACTION ══ -->
  <section style="background:linear-gradient(160deg,#0F172A 0%,#1E293B 100%);padding:36px 20px 32px;">
    <div style="max-width:520px;margin:0 auto;text-align:center;">
      <h1 style="font-size:clamp(24px,6vw,32px);font-weight:800;color:#fff;line-height:1.25;margin:0 0 10px;letter-spacing:-0.5px;">
        <span class="en-text">Find trusted tilers near you</span>
        <span class="si-text">ඔබ අසල විශ්වාසනීය ටයිලර්වරු</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.7);line-height:1.7;margin:0 0 20px;">
        <span class="en-text">Post your job free — verified professionals send you quotes on WhatsApp.</span>
        <span class="si-text">නොමිලේ පලකරන්න — සත්‍යාපිත ශිල්පීන් WhatsApp හරහා ලංසු එවයි.</span>
      </p>

      <div style="display:flex;justify-content:center;margin-bottom:16px;">
        <DistrictPicker client:load tone="dark" />
      </div>

      <a href="/post-project"
        style="display:flex;align-items:center;justify-content:center;gap:8px;background:#2563EB;color:#fff;border-radius:14px;padding:16px 24px;font-size:16px;font-weight:700;text-decoration:none;box-shadow:0 6px 20px rgba(37,99,235,0.4);min-height:56px;">
        <span class="en-text">Post your job — free</span>
        <span class="si-text">ඔබේ රැකියාව පලකරන්න — නොමිලේ</span>
      </a>

      <a href="/providers" style="display:inline-block;margin-top:14px;font-size:13px;color:rgba(255,255,255,0.65);text-decoration:none;">
        <span class="en-text">or browse all services →</span>
        <span class="si-text">නැතහොත් සියලු සේවා බලන්න →</span>
      </a>
    </div>
  </section>

  <!-- ══ 2. TOP RATED NEAR YOU ══ -->
  <NearYou client:load initial={pros} />

  <!-- ══ 3. TILE SHOPS NEAR YOU ══ -->
  <NearYou client:load variant="shops" initial={shops} />

  <div style="height:24px;"></div>
  </div>

  <!-- Provider view — replaces everything above once signed in as a provider -->
  <HomeHero client:load />
</Layout>
