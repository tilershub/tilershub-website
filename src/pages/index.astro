---
import Layout from '../layouts/Layout.astro'
import HeroBanner from '../components/HeroBanner.jsx'
import AdSlider from '../components/AdSlider.jsx'
import { supabase } from '../lib/supabase.js'

const { data: featuredTilers } = await supabase
  .from('tilers')
  .select('id,full_name,district,city,services,is_verified,avatar_url,experience_years,avg_rating,phone,whatsapp')
  .eq('featured', true)
  .order('experience_years', { ascending: false })
  .limit(8)

const { data: workshopsData } = await supabase
  .from('providers')
  .select('id,name,city,district,services,is_verified,slug,whatsapp')
  .eq('provider_type', 'workshop')
  .eq('status', 'active')
  .limit(6)

const { data: brandsData } = await supabase
  .from('brands')
  .select('id,name,slug,description,categories,logo_url')
  .eq('status', 'active')
  .limit(8)

const tilers = featuredTilers || []
const workshops = workshopsData || []
const brands = brandsData || []

function initials(name) {
  return name?.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() || 'TH'
}

function waLink(phone, name) {
  const n = (phone || '').replace(/\D/g, '')
  const normalized = n.startsWith('94') ? n : '94' + n.replace(/^0/, '')
  const who = name ? `*${name}*` : 'ඔබව'
  const msg = encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *TilersHub* (www.tilershub.lk) හරහා ${who} සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *TilersHub.lk* Lead\nස්තූතියි! 🏠`)
  return `https://wa.me/${normalized}?text=${msg}`
}

const QUICK_ACTIONS = [
  { icon: '👷', label: 'Find Tiler',  href: '/providers?type=tiler',    bg: '#EEF2FB' },
  { icon: '📋', label: 'Post Project', href: '/post-project',            bg: '#fff1eb' },
  { icon: '💼', label: 'Browse Jobs', href: '/jobs',                     bg: '#F0FDF4' },
  { icon: '🔧', label: 'Tools',       href: '/tools',                    bg: '#FEF3C7' },
  { icon: '🚿', label: 'Bathrooms',   href: '/bathrooms',                bg: '#EFF6FF' },
  { icon: '📐', label: 'Estimator',   href: '/estimator',                bg: '#F5F3FF' },
  { icon: '🏭', label: 'Workshops',   href: '/providers?type=workshop',  bg: '#FFF7ED' },
  { icon: '🪨', label: 'Tile',        href: '/tile',                     bg: '#FFFBEB' },
  { icon: '📦', label: 'Suppliers',   href: '/providers?type=supplier',  bg: '#F0FDF4' },
]

const INSPO = [
  { title: 'Minimalist White Bathroom', tag: 'Bathroom', img: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?auto=format&fit=crop&w=400&q=75', overlay: 'rgba(10,18,32,0.38)' },
  { title: 'Herringbone Floor Pattern', tag: 'Flooring', img: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=400&q=75', overlay: 'rgba(15,20,40,0.42)' },
  { title: 'Dark Luxury Wall Tiles', tag: 'Wall Tiles', img: 'https://images.unsplash.com/photo-1615873968403-89e068629265?auto=format&fit=crop&w=400&q=75', overlay: 'rgba(10,10,20,0.48)' },
  { title: 'Terracotta Kitchen Backsplash', tag: 'Kitchen', img: 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?auto=format&fit=crop&w=400&q=75', overlay: 'rgba(30,12,4,0.40)' },
  { title: 'Marble Effect Living Room', tag: 'Living Room', img: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=400&q=75', overlay: 'rgba(20,18,14,0.35)' },
  { title: 'Blue Mosaic Feature Wall', tag: 'Feature Wall', img: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=400&q=75', overlay: 'rgba(10,20,40,0.44)' },
]

const BLOG_POSTS = [
  { cat: 'Tiling Tips', title: 'How to Choose the Right Tile Size for Your Room', excerpt: 'Larger tiles make rooms look bigger, but installation requires more precision. Learn the pros and cons of each size.', icon: '📐', bg: 'linear-gradient(135deg,#1A2B4A,#2B4275)' },
  { cat: 'Buying Guide', title: 'Understanding Tile Grades: What the Numbers Mean', excerpt: 'PEI ratings, water absorption, slip resistance — here\'s what every homeowner in Sri Lanka should know before buying.', icon: '🏷️', bg: 'linear-gradient(135deg,#C1603A,#8b4513)' },
  { cat: 'Cost Guide', title: 'Tiling Cost Guide for Sri Lanka — 2025 Prices', excerpt: 'Average labour and material costs by room type and tile size across Colombo, Kandy, Galle and beyond.', icon: '💰', bg: 'linear-gradient(135deg,#16a34a,#166534)' },
]

const WORKSHOP_COVERS = [
  { bg: 'linear-gradient(135deg,#1A2B4A,#2B4275)', icon: '🏭' },
  { bg: 'linear-gradient(135deg,#C1603A,#8b4513)', icon: '⚙️' },
  { bg: 'linear-gradient(135deg,#1e3a5f,#0f2444)', icon: '🔧' },
  { bg: 'linear-gradient(135deg,#166534,#14532d)', icon: '🏗️' },
  { bg: 'linear-gradient(135deg,#7c3aed,#4c1d95)', icon: '✂️' },
  { bg: 'linear-gradient(135deg,#92400e,#78350f)', icon: '🪚' },
]

const BRAND_COLORS = ['#1A2B4A','#C1603A','#D4AF37','#1e3a5f','#7c3aed','#166534','#92400e','#374151']
---

<Layout
  title="TilersHub · Sri Lanka's Trusted Tiling Marketplace"
  description="Find verified tilers, workshops, suppliers and tile brands across Sri Lanka. Post your tiling project free on TilersHub."
>

  <!-- ① Hero Slider -->
  <HeroBanner client:load />

  <!-- ② Search Bar + Category Pills -->
  <div class="search-section">
    <div class="search-box">
      <span class="search-icon">🔍</span>
      <input type="text" placeholder="Search tilers, workshops, tile brands…" id="hero-search" />
      <button class="search-btn" onclick="document.location='/providers?q='+encodeURIComponent(document.getElementById('hero-search').value)">Search</button>
    </div>
    <div class="search-pills">
      <a href="/providers?type=tiler" class="search-pill">👷 Find Tiler</a>
      <a href="/jobs" class="search-pill">💼 Browse Jobs</a>
      <a href="/tile" class="search-pill">🪨 Tile</a>
      <a href="/bathrooms" class="search-pill">🚿 Bathrooms</a>
      <a href="/providers?type=workshop" class="search-pill">🏭 Workshops</a>
      <a href="/providers?type=supplier" class="search-pill">📦 Suppliers</a>
      <a href="/tools" class="search-pill">🔧 Tools</a>
      <a href="/estimator" class="search-pill">📐 Estimator</a>
    </div>
  </div>

  <!-- ③ Quick Actions Grid -->
  <section style="background:#fff;padding:20px 0 16px;border-bottom:1px solid var(--border);">
    <div class="quick-grid">
      {QUICK_ACTIONS.map(a => (
        <a href={a.href} class="quick-card">
          <div class="qc-icon" style={`background:${a.bg};`}>{a.icon}</div>
          <span class="qc-label">{a.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ④ Stats Bar -->
  <div style="background:var(--navy);padding:14px 0;">
    <div style="display:flex;justify-content:center;flex-wrap:wrap;">
      {[
        { n: '500+', l: 'Professionals' },
        { n: '25', l: 'Districts' },
        { n: 'Free', l: 'Always' },
        { n: '100%', l: 'WhatsApp Direct' },
      ].map((s, i, arr) => (
        <div style={`text-align:center;padding:8px 20px;border-right:${i < arr.length-1 ? '1px solid rgba(255,255,255,0.1)' : 'none'}`}>
          <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:var(--gold);">{s.n}</div>
          <div style="font-size:10px;color:rgba(255,255,255,0.45);margin-top:1px;">{s.l}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- ⑤ Featured Tilers — Horizontal Shelf -->
  <section class="section" style="background:#fff;">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">⭐ Featured</div>
        <div class="section-title-sm">Verified Tiling <span>Professionals</span></div>
      </div>
      <a href="/providers" class="see-all">View all →</a>
    </div>

    {tilers.length > 0 ? (
      <div class="shelf">
        {tilers.map((t, idx) => {
          return (
            <div class="tiler-card">
              <div class="tiler-cover" style="background:linear-gradient(135deg,#0F2444 0%,#1B3A6B 100%);">
                <span>{t.avatar_url ? '' : '👷'}</span>
                {t.is_verified && <span class="verified-badge">✓ Skilled</span>}
              </div>
              <div class="tiler-body">
                {t.avg_rating > 0 && (
                  <div class="rating">⭐ {(t.avg_rating || 4.8).toFixed(1)}</div>
                )}
                <div class="tiler-name">{t.full_name}</div>
                <div class="tiler-meta">📍 {t.city || t.district}</div>
                {(t.services || []).length > 0 && (
                  <div style="font-size:10px;color:var(--text-4);margin-bottom:8px;">{(t.services || []).slice(0,2).join(' · ')}</div>
                )}
                {(t.whatsapp || t.phone) && (
                  <a href={waLink(t.whatsapp || t.phone, t.full_name)} target="_blank" rel="noopener" class="tiler-wa-btn">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    WhatsApp
                  </a>
                )}
              </div>
            </div>
          )
        })}
      </div>
    ) : (
      <div style="padding:24px 16px;text-align:center;">
        <a href="/providers" class="btn btn-navy">Browse All Tilers →</a>
      </div>
    )}
  </section>

  <!-- ⑥ Workshops — Horizontal Shelf -->
  <section class="section" style="background:var(--surface-2);border-top:1px solid var(--border);">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">🏭 Workshops</div>
        <div class="section-title-sm">Tile & Granite <span>Workshops</span></div>
      </div>
      <a href="/providers?type=workshop" class="see-all">View all →</a>
    </div>

    <div class="shelf">
      {workshops.length > 0 ? workshops.map((w, idx) => (
        <a href={`/providers/${w.slug || w.id}`} class="workshop-card">
          <div class="workshop-cover" style={`background:${WORKSHOP_COVERS[idx % WORKSHOP_COVERS.length].bg};`}>
            <span style="font-size:40px;">{WORKSHOP_COVERS[idx % WORKSHOP_COVERS.length].icon}</span>
          </div>
          <div class="workshop-body">
            <div class="workshop-name">{w.name}</div>
            <div class="workshop-city">📍 {w.city || w.district}</div>
            {(w.services || []).slice(0,1).map(s => (
              <span class="workshop-chip">{s}</span>
            ))}
          </div>
        </a>
      )) : (
        /* Placeholder cards if no data */
        [
          { name: 'Colombo Tile Cutting', city: 'Colombo 3', s: 'Granite Cutting', i: 0 },
          { name: 'Lanka Stone Works', city: 'Kandy', s: 'Routering', i: 1 },
          { name: 'Southern Workshops', city: 'Galle', s: 'Tile Cutting', i: 2 },
          { name: 'Negombo Stone', city: 'Negombo', s: 'Marble Work', i: 3 },
        ].map(w => (
          <a href="/providers?type=workshop" class="workshop-card">
            <div class="workshop-cover" style={`background:${WORKSHOP_COVERS[w.i].bg};`}>
              <span style="font-size:40px;">{WORKSHOP_COVERS[w.i].icon}</span>
            </div>
            <div class="workshop-body">
              <div class="workshop-name">{w.name}</div>
              <div class="workshop-city">📍 {w.city}</div>
              <span class="workshop-chip">{w.s}</span>
            </div>
          </a>
        ))
      )}
    </div>
  </section>

  <!-- ⑦ Estimator CTA -->
  <section style="background:var(--navy);padding:52px 20px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(255,255,255,0.8) 20px,rgba(255,255,255,0.8) 21px);pointer-events:none;"></div>
    <div style="position:absolute;top:-60px;right:-60px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,0.12) 0%,transparent 70%);pointer-events:none;"></div>
    <div style="max-width:720px;margin:0 auto;display:flex;align-items:center;gap:36px;flex-wrap:wrap;position:relative;">
      <!-- Calc visual -->
      <div style="flex-shrink:0;width:120px;height:120px;border-radius:24px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;">
        <span style="font-size:40px;">📐</span>
        <span style="font-size:10px;color:var(--gold);font-weight:700;letter-spacing:1px;">ESTIMATE</span>
      </div>
      <div style="flex:1;min-width:200px;">
        <div style="font-size:10px;font-weight:700;color:rgba(245,158,11,0.7);letter-spacing:3px;text-transform:uppercase;margin-bottom:10px;">Free Tool</div>
        <h2 style="font-family:'Playfair Display',serif;font-size:clamp(20px,3.5vw,32px);font-weight:700;color:#fff;margin-bottom:10px;line-height:1.25;">
          Calculate your <span style="color:var(--gold);">tiling cost</span> before you hire
        </h2>
        <p style="font-size:14px;color:rgba(255,255,255,0.55);margin-bottom:22px;line-height:1.7;">
          Enter room dimensions, tile size and labour rate to get an instant Sri Lanka-specific estimate.
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/estimator" class="btn btn-gold">📐 Open Estimator</a>
          <a href="/post-project" style="background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.8);border:1px solid rgba(255,255,255,0.15);padding:11px 20px;font-size:13px;border-radius:12px;font-weight:600;display:inline-flex;align-items:center;gap:6px;text-decoration:none;">Post a Project →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑦ Open Jobs CTA -->
  <section style="background:var(--surface-2);padding:36px 20px;border-top:1px solid var(--border);">
    <div style="max-width:900px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;">
      <div style="display:flex;align-items:center;gap:18px;">
        <div style="width:56px;height:56px;background:linear-gradient(135deg,#16a34a,#166534);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;">💼</div>
        <div>
          <div style="font-size:17px;font-weight:700;color:var(--text);margin-bottom:4px;">Open Tiling Projects</div>
          <div style="font-size:13px;color:var(--text-3);line-height:1.5;">Homeowners are posting jobs right now. Find work near you.</div>
        </div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/jobs" style="display:inline-flex;align-items:center;gap:7px;background:#16a34a;color:#fff;border-radius:12px;padding:12px 22px;font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap;">
          💼 Browse Jobs →
        </a>
        <a href="/post-project" style="display:inline-flex;align-items:center;gap:7px;background:var(--surface);color:var(--text-2);border:1.5px solid var(--border);border-radius:12px;padding:12px 20px;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap;">
          📋 Post a Project
        </a>
      </div>
    </div>
  </section>

  <!-- ⑧ Sponsor (LUXEhome) -->
  <section style="background:var(--surface-2);padding:44px 0 40px;border-top:1px solid var(--border);">
    <div class="container" style="max-width:860px;">
      <div style="text-align:center;margin-bottom:14px;">
        <span style="font-size:10px;font-weight:700;color:var(--text-4);letter-spacing:2px;text-transform:uppercase;">Sponsored Partner</span>
      </div>
      <AdSlider client:visible />
    </div>
  </section>

  <!-- ⑨ Featured Brands — Horizontal Shelf -->
  <section class="section" style="background:#fff;border-top:1px solid var(--border);">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">🏷️ Brands</div>
        <div class="section-title-sm">Featured Tile <span>Brands</span></div>
      </div>
      <a href="/tile" class="see-all">All brands →</a>
    </div>

    <div class="shelf">
      {brands.length > 0 ? brands.map((b, idx) => (
        <a href={`/brands/${b.slug}`} class="brand-card">
          <div class="brand-logo" style={`background:${BRAND_COLORS[idx % BRAND_COLORS.length]};`}>
            {initials(b.name)}
          </div>
          <div class="brand-name">{b.name}</div>
          <div class="brand-cat">{(b.categories || []).slice(0,2).join(', ')}</div>
        </a>
      )) : (
        [
          { name: 'Lanka Tile', cats: 'Floor · Wall', i: 0 },
          { name: 'Rocell', cats: 'Porcelain · Wall', i: 1 },
          { name: 'LUXEhome', cats: 'Renovation · Bathroom', i: 2 },
          { name: 'Megatile', cats: 'Floor · Outdoor', i: 3 },
          { name: 'Macktiles', cats: 'Floor · Wall', i: 4 },
        ].map(b => (
          <a href="/brands" class="brand-card">
            <div class="brand-logo" style={`background:${BRAND_COLORS[b.i]};`}>{initials(b.name)}</div>
            <div class="brand-name">{b.name}</div>
            <div class="brand-cat">{b.cats}</div>
          </a>
        ))
      )}
    </div>
  </section>

  <!-- ⑩ Bathroom Inspiration — Pinterest Grid -->
  <section class="section" style="background:var(--surface-2);border-top:1px solid var(--border);">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">💡 Inspiration</div>
        <div class="section-title-sm">Tiling <span>Inspiration</span></div>
      </div>
      <a href="/sponsor/luxehome" class="see-all">Browse more →</a>
    </div>
    <div style="padding:0 16px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
      {INSPO.map(card => (
        <a href="/sponsor/luxehome" class="inspo-card" style="background:#0a0a12;">
          <img src={card.img} alt={card.title} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;" loading="lazy" />
          <div style={`position:absolute;inset:0;background:${card.overlay};`}></div>
          <div class="inspo-overlay">
            <div class="inspo-title">{card.title}</div>
            <div class="inspo-tag">{card.tag}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑪ Blog / Tips -->
  <section class="section" style="background:#fff;border-top:1px solid var(--border);">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">📚 Tips & Guides</div>
        <div class="section-title-sm">Tiling <span>Knowledge Hub</span></div>
      </div>
    </div>
    <div style="padding:0 16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;">
      {BLOG_POSTS.map(post => (
        <div class="blog-card">
          <div class="blog-cover" style={`background:${post.bg};`}>
            <span>{post.icon}</span>
          </div>
          <div class="blog-body">
            <div class="blog-cat">{post.cat}</div>
            <div class="blog-title">{post.title}</div>
            <div class="blog-excerpt">{post.excerpt}</div>
            <div class="blog-read">Read guide →</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑫ Community CTA -->
  <section style="background:var(--navy);padding:52px 20px;position:relative;overflow:hidden;border-top:3px solid var(--gold);">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:radial-gradient(circle,rgba(255,255,255,0.8) 1px,transparent 1px);background-size:24px 24px;pointer-events:none;"></div>
    <div style="max-width:560px;margin:0 auto;text-align:center;position:relative;">
      <div style="font-size:10px;font-weight:700;color:rgba(245,158,11,0.7);letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;">Join the Community</div>
