---
import Layout from '../layouts/Layout.astro'
import AdSlider from '../components/AdSlider.jsx'

const HOW_STEPS = [
  { icon: '🔍', num: '01', title: 'ටයිලර් සොයන්න', desc: 'දිස්ත්‍රික්කය, සේවාව හා ශ්‍රේණිගත කිරීම් අනුව ගළපෙන ටයිලර් සොයා ගන්න' },
  { icon: '💬', num: '02', title: 'WhatsApp සම්බන්ධය', desc: 'TilersHub ස්වයංක්‍රීය පණිවිඩයකින් ටයිලර් සමඟ කෙලින්ම සාකච්ඡා කරන්න' },
  { icon: '🏠', num: '03', title: 'ව්‍යාපෘතිය ආරම්භ කරන්න', desc: 'ගාස්තු, කාලසටහන සාකච්ඡා කර ඔබේ නිවස ලස්සන කරගන්න' },
]
---

<Layout title="TilersHub · ශ්‍රී ලංකාවේ #1 ටයිල් සේවා වේදිකාව">

  <!-- ═══ HERO ═══ -->
  <section style="background: var(--charcoal); position: relative; overflow: hidden; padding: 88px 28px 0;">
    <!-- Background grid texture -->
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(193,96,58,0.7) 39px, rgba(193,96,58,0.7) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(193,96,58,0.7) 39px, rgba(193,96,58,0.7) 40px); pointer-events: none;"></div>
    <!-- Glow orbs -->
    <div style="position: absolute; bottom: -60px; left: -60px; width: 360px; height: 360px; background: radial-gradient(circle, var(--terracotta) 0%, transparent 70%); opacity: 0.12; pointer-events: none;"></div>
    <div style="position: absolute; top: -80px; right: -80px; width: 420px; height: 420px; background: radial-gradient(circle, var(--sage) 0%, transparent 70%); opacity: 0.06; pointer-events: none;"></div>

    <!-- Two-column hero inner -->
    <div class="hero-inner">
      <!-- Left: text content -->
      <div>
        <span style="display: inline-flex; align-items: center; gap: 7px; background: rgba(193,96,58,0.14); border: 1px solid rgba(193,96,58,0.28); color: var(--terracotta-muted); font-size: 11px; padding: 5px 16px; border-radius: 20px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; margin-bottom: 28px;">
          🇱🇰 ශ්‍රී ලංකාවේ #1 ටයිල් වේදිකාව
        </span>

        <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(36px, 5.5vw, 64px); font-weight: 700; color: var(--white); line-height: 1.1; margin-bottom: 20px;">
          ඔබේ නිවස<br />
          <span style="color: var(--terracotta);">ලස්සන කරමු</span>
        </h1>

        <p style="font-size: 15px; color: rgba(245,240,232,0.52); max-width: 420px; line-height: 1.9; margin-bottom: 40px;">
          ශ්‍රී ලංකාව පුරා දක්ෂ ටයිලර්වරුන් සෙවිය හැකි, WhatsApp හරහා කෙලින්ම සාකච්ඡා කළ හැකි නොමිලේ සේවාවකි
        </p>

        <a href="/explore" class="btn btn-primary btn-lg">🔍 ටයිලර් සොයන්න</a>

        <!-- Trust row -->
        <div style="display: flex; gap: 20px; margin-top: 36px; flex-wrap: wrap;">
          {[
            { icon: '✓', text: 'නොමිලේ' },
            { icon: '💬', text: 'WhatsApp Direct' },
            { icon: '🛡️', text: 'සහතිකගත ටයිලර්' },
          ].map(t => (
            <div style="display: flex; align-items: center; gap: 7px; font-size: 12px; color: rgba(245,240,232,0.45);">
              <span style="color: var(--terracotta); font-weight: 700;">{t.icon}</span> {t.text}
            </div>
          ))}
        </div>
      </div>

      <!-- Right: profile card preview -->
      <div class="hero-visual">
        <!-- Subtle glow behind card -->
        <div style="position: absolute; inset: -20px; background: radial-gradient(circle at 60% 40%, rgba(193,96,58,0.15) 0%, transparent 70%); pointer-events: none;"></div>

        <div class="hero-preview-card">
          <!-- Card header (dark) -->
          <div style="background: linear-gradient(135deg, #2a2118 0%, #1e1e1e 100%); padding: 22px 22px 18px; position: relative;">
            <div style="display: flex; gap: 13px; align-items: center;">
              <div class="avatar" style="width: 52px; height: 52px; font-size: 19px; flex-shrink: 0;">SK</div>
              <div style="min-width: 0;">
                <div style="font-size: 15px; font-weight: 700; color: var(--white); margin-bottom: 4px;">Saman Kumara</div>
                <div style="font-size: 11px; color: rgba(245,240,232,0.4);">📍 Colombo · ⏱ 12 years</div>
              </div>
              <span style="margin-left: auto; flex-shrink: 0; background: rgba(122,154,126,0.18); border: 1px solid rgba(122,154,126,0.35); color: #9ab89e; padding: 3px 9px; border-radius: 20px; font-size: 9px; font-weight: 700; white-space: nowrap;">✓ ලබාගත හැකිය</span>
            </div>
          </div>
          <!-- Card body (light) -->
          <div style="padding: 18px 22px; background: var(--white);">
            <div style="display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap;">
              <span class="chip chip-terra">Floor Tiling</span>
              <span class="chip chip-terra">Wall Tiling</span>
              <span class="chip chip-cream">Bathroom</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--cream-dark); padding-top: 14px;">
              <div>
                <div style="font-size: 10px; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">ගාස්තු / sqft</div>
                <div style="font-size: 14px; font-weight: 700; color: var(--charcoal);">Rs. 45 – 75</div>
              </div>
              <div style="background: linear-gradient(135deg, #25D366, #20ba5a); color: white; border-radius: 9px; padding: 9px 14px; font-size: 12px; font-weight: 700; display: flex; align-items: center; gap: 5px; box-shadow: 0 3px 10px rgba(37,211,102,0.3);">💬 සම්බන්ධ</div>
            </div>
          </div>
        </div>

        <!-- Floating: verified badge -->
        <div style="position: absolute; top: -14px; right: 4px; background: var(--white); border-radius: 12px; padding: 9px 14px; box-shadow: 0 8px 32px rgba(0,0,0,0.22); display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700; color: var(--charcoal); white-space: nowrap; z-index: 2;">
          <span style="color: var(--terracotta);">✓</span> TilersHub සහතිකගත
        </div>

        <!-- Floating: count badge -->
        <div style="position: absolute; bottom: 24px; left: -20px; background: var(--white); border-radius: 14px; padding: 12px 18px; box-shadow: 0 8px 32px rgba(0,0,0,0.2); z-index: 2;">
          <div style="font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700; color: var(--terracotta); line-height: 1;">500+</div>
          <div style="font-size: 10px; color: var(--text-light); letter-spacing: 0.3px; margin-top: 4px;">ලියාපදිංචි ටයිලර්</div>
        </div>
      </div>
    </div>

    <!-- Stats bar -->
    <div style="max-width: 1100px; margin: 64px auto 0; display: flex; justify-content: center; align-items: stretch; flex-wrap: wrap; border-top: 1px solid rgba(245,240,232,0.07);">
      {[
        { num: '500+', label: 'ලියාපදිංචි ටයිලර්' },
        { num: '25', label: 'දිස්ත්‍රික්ක' },
        { num: '2,000+', label: 'සාර්ථක ව්‍යාපෘති' },
        { num: 'නොමිලේ', label: 'සේවාව' },
      ].map((s, i, arr) => (
        <div style={`text-align: center; padding: 28px clamp(16px, 4vw, 52px); border-right: ${i < arr.length - 1 ? '1px solid rgba(245,240,232,0.07)' : 'none'};`}>
          <div style="font-family: 'Playfair Display', serif; font-size: clamp(24px,3.5vw,38px); color: var(--terracotta); font-weight: 700;">{s.num}</div>
          <div style="font-size: 11px; color: rgba(245,240,232,0.35); margin-top: 5px; letter-spacing: 0.3px;">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ AD STRIP ═══ -->
  <div style="background: var(--charcoal); padding: 0 28px 52px;">
    <div style="max-width: 760px; margin: 0 auto; border-top: 1px solid rgba(245,240,232,0.06); padding-top: 28px;">
      <div style="font-size: 9px; font-weight: 700; color: rgba(245,240,232,0.2); letter-spacing: 2.5px; text-transform: uppercase; text-align: center; margin-bottom: 14px;">ස්පොන්සර්</div>
      <AdSlider client:load />
    </div>
  </div>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section style="padding: 88px 28px; background: var(--cream);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 60px;">
        <span class="section-tag">ක්‍රියාවලිය</span>
        <h2 class="section-title">කෙසේ ක්‍රියා කරයිද?</h2>
        <p class="section-sub" style="margin: 0 auto;">සරල පියවර 3කින් ඔබේ ව්‍යාපෘතිය ආරම්භ කරන්න</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap: 28px;">
        {HOW_STEPS.map((s, idx) => (
          <div class="card" style="padding: 40px 32px 36px; position: relative; border-top: 3px solid var(--terracotta);">
            <!-- Step number watermark -->
            <div style={`position: absolute; bottom: 16px; right: 22px; font-family: 'Playfair Display', serif; font-size: 80px; color: var(--cream-dark); font-weight: 700; line-height: 1; user-select: none; pointer-events: none;`}>{s.num}</div>
            <!-- Icon -->
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, var(--terracotta) 0%, var(--terracotta-light) 100%); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 24px; box-shadow: 0 6px 20px rgba(193,96,58,0.28);">{s.icon}</div>
            <h3 style="font-size: 17px; font-weight: 700; margin-bottom: 12px; color: var(--charcoal);">{s.title}</h3>
            <p style="font-size: 13px; color: var(--text-mid); line-height: 1.85;">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ EXPLORE CTA ═══ -->
  <section style="background: var(--charcoal); padding: 96px 28px; text-align: center; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; opacity: 0.035; background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(193,96,58,0.6) 20px, rgba(193,96,58,0.6) 21px); pointer-events: none;"></div>
    <div style="position: absolute; bottom: -100px; right: -100px; width: 500px; height: 500px; background: radial-gradient(circle, var(--terracotta) 0%, transparent 70%); opacity: 0.08; pointer-events: none;"></div>

    <div style="position: relative; max-width: 640px; margin: 0 auto;">
      <span class="section-tag" style="border-color: rgba(193,96,58,0.3); color: var(--terracotta-muted);">ශ්‍රී ලංකාව පුරා</span>
      <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(26px,4.5vw,44px); color: var(--white); margin: 14px 0 16px; font-weight: 700; line-height: 1.15;">
        ඔබේ ටයිලර් <span style="color: var(--terracotta);">හමු කරගන්න</span>
      </h2>
      <p style="color: rgba(245,240,232,0.45); font-size: 14px; max-width: 440px; margin: 0 auto 36px; line-height: 1.9;">
        දිස්ත්‍රික්කය, සේවා වර්ගය අනුව ශ්‍රී ලංකාවේ සහතිකගත ටයිලර්වරුන් WhatsApp හරහා සොයා ගන්න
      </p>

      <div style="display: flex; justify-content: center; gap: 24px; margin-bottom: 40px; flex-wrap: wrap;">
        {['25+ දිස්ත්‍රික්ක', 'sqft ගාස්තු සැසඳීම', 'WhatsApp Direct'].map(b => (
          <div style="display: flex; align-items: center; gap: 9px; color: rgba(245,240,232,0.6); font-size: 13px;">
            <span style="width: 20px; height: 20px; background: rgba(193,96,58,0.2); color: var(--terracotta); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; flex-shrink: 0;">✓</span>
            {b}
          </div>
        ))}
      </div>

      <a href="/explore" class="btn btn-primary btn-lg">🔍 දැන්ම ටයිලර් සොයන්න</a>
    </div>
  </section>

</Layout>
