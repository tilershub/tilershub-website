---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase.js'
import HomeHero from '../components/HomeHero.jsx'
import { SERVICES_GROUP_1, SERVICES_GROUP_2 } from '../lib/services.js'

const { data: featuredTilers } = await supabase
  .from('tilers')
  .select('id,full_name,district,city,is_verified,slug,avg_rating,experience_years,avatar_url,speciality')
  .eq('featured', true)
  .order('avg_rating', { ascending: false })
  .limit(8)

const { data: projectsData } = await supabase
  .from('projects')
  .select('id,project_type,district,city,created_at,budget_range,description')
  .eq('status', 'active')
  .order('created_at', { ascending: false })
  .limit(8)

const { data: bidCountData } = projectsData?.length
  ? await supabase
      .from('bids')
      .select('project_id')
      .in('project_id', (projectsData || []).map((p: any) => p.id))
  : { data: [] }

const bidsByProject: Record<string, number> = {}
;(bidCountData || []).forEach((b: any) => {
  bidsByProject[b.project_id] = (bidsByProject[b.project_id] || 0) + 1
})

const FALLBACK_TILERS = [
  { id:'p1', full_name:'Lakmal Perera',    city:'Colombo 7',   is_verified:true,  avg_rating:4.9, slug:'lakmal',  avatar_url:null, speciality:'Bathroom Tiling'  },
  { id:'p2', full_name:'Chamara Silva',    city:'Kandy',       is_verified:true,  avg_rating:4.7, slug:'chamara', avatar_url:null, speciality:'Floor Tiling'     },
  { id:'p3', full_name:'Saman Jayantha',   city:'Galle',       is_verified:false, avg_rating:0,   slug:null,      avatar_url:null, speciality:'Tile Cutting'     },
  { id:'p4', full_name:'Kelum Prasad',     city:'Negombo',     is_verified:true,  avg_rating:4.8, slug:'kelum',   avatar_url:null, speciality:'Waterproofing'    },
  { id:'p5', full_name:'Nuwan Bandara',    city:'Kurunegala',  is_verified:true,  avg_rating:4.6, slug:null,      avatar_url:null, speciality:'Granite Works'    },
  { id:'p6', full_name:'Ruwan Perera',     city:'Colombo 3',   is_verified:true,  avg_rating:4.8, slug:null,      avatar_url:null, speciality:'Bathroom Reno'    },
  { id:'p7', full_name:'Sunil Fernando',   city:'Matara',      is_verified:true,  avg_rating:4.5, slug:null,      avatar_url:null, speciality:'Floor Tiling'     },
  { id:'p8', full_name:'Asanka Rajapaksa', city:'Kurunegala',  is_verified:false, avg_rating:0,   slug:null,      avatar_url:null, speciality:'Mosaic Tiling'    },
]

const FALLBACK_PROJECTS = [
  { id:'d1', project_type:'Bathroom Renovation',      city:'Colombo',    district:'Colombo', budget_range:'LKR 850,000', created_at: new Date().toISOString() },
  { id:'d2', project_type:'Glass Vinyl Installation', city:'Kandy',      district:'Kandy',   budget_range:'LKR 250,000', created_at: new Date().toISOString() },
  { id:'d3', project_type:'Large Format Tiling',      city:'Galle',      district:'Galle',   budget_range:'LKR 320,000', created_at: new Date().toISOString() },
  { id:'d4', project_type:'Floor Tiling',             city:'Negombo',    district:'Gampaha', budget_range:'LKR 180,000', created_at: new Date().toISOString() },
  { id:'d5', project_type:'Waterproofing',            city:'Colombo',    district:'Colombo', budget_range:'LKR 95,000',  created_at: new Date().toISOString() },
  { id:'d6', project_type:'Bathroom Renovation',      city:'Kandy',      district:'Kandy',   budget_range:'LKR 650,000', created_at: new Date().toISOString() },
  { id:'d7', project_type:'Tile Cutting & Routering', city:'Gampaha',    district:'Gampaha', budget_range:'LKR 75,000',  created_at: new Date().toISOString() },
  { id:'d8', project_type:'Mosaic Tiling',            city:'Colombo 5',  district:'Colombo', budget_range:'LKR 210,000', created_at: new Date().toISOString() },
]

const allTilers   = (featuredTilers || []).length  > 0 ? (featuredTilers || []) : FALLBACK_TILERS
const allProjects = (projectsData  || []).length   > 0 ? (projectsData  || []) : FALLBACK_PROJECTS

const b1Tilers   = allTilers.slice(0, 3)
const b2Tilers   = allTilers.slice(3, 7)
const b1Projects = allProjects.slice(0, 4)
const b2Projects = allProjects.slice(4, 8)

function initials(name: string) {
  return name.split(' ').slice(0,2).map((w: string) => w[0] || '').join('').toUpperCase() || '?'
}
const AVATAR_COLORS = ['#1B3A6B','#0f766e','#7c3aed','#b45309','#0369a1','#E05A2B','#15803d','#be185d']
function avatarColor(name: string) {
  let h = 0
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}

const TYPE_ICON = {
  'Floor Tiling':'🪨','Bathroom Tiling':'🚿','Bathroom Renovation':'🛁',
  'Granite Works':'💎','Tile Cutting':'✂️','Tile Cutting & Routering':'✂️',
  'Waterproofing':'💧','Tile Shop Inquiry':'🏪','Glass Vinyl Installation':'✨',
  'Large Format Tiling':'📏','Mosaic Tiling':'🎨','Mosaic':'🎨',
}

const PROJ_COLORS = {
  'Bathroom Renovation':'#0f766e','Floor Tiling':'#1B3A6B','Large Format Tiling':'#7c3aed',
  'Granite Works':'#b45309','Waterproofing':'#0369a1','Tile Shop Inquiry':'#E05A2B',
  'Glass Vinyl Installation':'#16a34a','Mosaic Tiling':'#7c3aed',
  'Tile Cutting & Routering':'#b45309',
}

const HERO_IMG = 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?auto=format&fit=crop&w=1400&q=75'
---

<Layout
  title="TilersHub · Sri Lanka's Tile & Bathroom Marketplace"
  description="Post your tiling project free, get bids from verified tilers and contractors. Browse profiles, reviews and prices across Sri Lanka."
>
  <link slot="head" rel="preload" as="image" href={HERO_IMG} fetchpriority="high" />

  <!-- Hero (role-aware React island) -->
  <HomeHero client:load heroImg={HERO_IMG} />

  <!-- ════════════════════════════════════════════════════════
       BLOCK 1
  ════════════════════════════════════════════════════════ -->

  <!-- Services Group 1 -->
  <section style="background:#fff;border-bottom:1px solid #f1f5f9;padding:16px 16px 14px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
      <span style="font-size:15px;font-weight:700;color:#111827;">Popular Services</span>
      <a href="/providers" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View All &rsaquo;</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;">
      {SERVICES_GROUP_1.map(s => (
        <a href={`/services/${s.slug}`}
          style="display:flex;flex-direction:column;align-items:center;gap:7px;padding:12px 4px 10px;border-radius:14px;background:#f8fafc;text-decoration:none;border:1px solid #f1f5f9;">
          <div style="width:46px;height:46px;border-radius:13px;background:#fff;border:1px solid #e2e8f0;box-shadow:0 1px 4px rgba(0,0,0,0.06);display:flex;align-items:center;justify-content:center;font-size:22px;">
            {s.icon}
          </div>
          <span style="font-size:10px;font-weight:600;color:#374151;text-align:center;line-height:1.35;">{s.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Top Providers — Block 1 -->
  <section style="background:#fff;padding:20px 0 24px;">
    <div style="padding:0 16px 14px;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:15px;font-weight:700;color:#111827;">Top Providers</span>
      <a href="/providers" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View all &rsaquo;</a>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;padding:0 16px;">

      <!-- LUXEhome featured -->
      <a href="/sponsor/luxehome" style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1.5px solid #D4AF37;text-decoration:none;color:inherit;box-shadow:0 2px 10px rgba(212,175,55,0.18);">
        <div style="width:82px;height:82px;background:linear-gradient(135deg,#0c0804 0%,#1a120a 100%);flex-shrink:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;">
          <span style="font-family:'Playfair Display',serif;font-size:12px;font-weight:800;color:#D4AF37;letter-spacing:0.5px;">LUXE</span>
          <span style="font-size:8px;color:rgba(255,255,255,0.6);font-weight:400;letter-spacing:1px;">HOME</span>
        </div>
        <div style="flex:1;padding:12px 12px;min-width:0;">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
            <span style="font-size:13px;font-weight:700;color:#111827;">LUXEhome</span>
            <span style="font-size:8px;font-weight:700;color:#b45309;background:#fef3c7;border:1px solid #fde68a;border-radius:20px;padding:1px 6px;flex-shrink:0;">🛡️ TH Master</span>
          </div>
          <div style="font-size:11px;color:#64748b;margin-bottom:2px;">🚿 Bathroom Reno · 🏗️ 12+ Yrs exp</div>
          <div style="font-size:11px;color:#f59e0b;">⭐ 4.9 · 47 reviews</div>
        </div>
        <div style="padding:0 14px;font-size:20px;color:#D4AF37;flex-shrink:0;">›</div>
      </a>

      {b1Tilers.map(t => {
        const color = avatarColor(t.full_name)
        const inits = initials(t.full_name)
        return (
          <a href={t.slug ? `/tilers/${t.slug}` : '/providers'}
            style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
            <div style={`width:82px;height:82px;background:${color};flex-shrink:0;display:flex;align-items:center;justify-content:center;overflow:hidden;`}>
              {t.avatar_url
                ? <img src={t.avatar_url} alt={t.full_name} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                : <span style="font-size:26px;font-weight:800;color:rgba(255,255,255,0.85);">{inits}</span>
              }
            </div>
            <div style="flex:1;padding:12px 12px;min-width:0;">
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">
                <span style="font-size:13px;font-weight:700;color:#111827;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{t.full_name}</span>
                {t.is_verified && <span style="font-size:8px;font-weight:700;color:#16a34a;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:20px;padding:1px 6px;flex-shrink:0;">✓ Pro</span>}
              </div>
              {t.speciality && <div style="font-size:11px;color:#64748b;margin-bottom:2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{t.speciality}</div>}
              <div style="font-size:11px;color:#94a3b8;">📍 {t.city || t.district}</div>
              {t.avg_rating > 0 && <div style="font-size:11px;color:#f59e0b;margin-top:2px;">⭐ {t.avg_rating.toFixed(1)}</div>}
            </div>
            <div style="padding:0 14px;font-size:20px;color:#cbd5e1;flex-shrink:0;">›</div>
          </a>
        )
      })}
    </div>
  </section>

  <!-- Recent Projects — Block 1 -->
  <section style="background:#f8fafc;padding:20px 0 24px;">
    <div style="padding:0 16px 14px;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:15px;font-weight:700;color:#111827;">Recent Projects</span>
      <a href="/jobs" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View All &rsaquo;</a>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;padding:0 16px;">
      {b1Projects.map(job => {
        const bids = bidsByProject[job.id] || 0
        const bg = PROJ_COLORS[job.project_type] || '#1B3A6B'
        return (
          <a href={`/job?id=${job.id}`}
            style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
            <div style={`width:88px;height:82px;background:${bg};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:28px;`}>
              {TYPE_ICON[job.project_type] || '🏠'}
            </div>
            <div style="flex:1;padding:12px 12px;min-width:0;">
              <div style="font-size:13px;font-weight:700;color:#111827;margin-bottom:3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{job.project_type}</div>
              <div style="font-size:11px;color:#64748b;margin-bottom:4px;">📍 {job.city || job.district}</div>
              {job.budget_range && <div style="font-size:11px;font-weight:700;color:#16a34a;">Budget: {job.budget_range}</div>}
              {bids > 0 && <div style="font-size:10px;color:#64748b;margin-top:2px;">{bids} bid{bids !== 1 ? 's' : ''} received</div>}
            </div>
            <div style="padding:0 14px;font-size:20px;color:#cbd5e1;flex-shrink:0;">›</div>
          </a>
        )
      })}
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       BLOCK 2
  ════════════════════════════════════════════════════════ -->

  <!-- Services Group 2 -->
  <section style="background:#fff;border-bottom:1px solid #f1f5f9;padding:16px 16px 14px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
      <span style="font-size:15px;font-weight:700;color:#111827;">More Services</span>
      <a href="/providers" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View All &rsaquo;</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;">
      {SERVICES_GROUP_2.map(s => (
        <a href={`/services/${s.slug}`}
          style="display:flex;flex-direction:column;align-items:center;gap:7px;padding:12px 4px 10px;border-radius:14px;background:#f8fafc;text-decoration:none;border:1px solid #f1f5f9;">
          <div style="width:46px;height:46px;border-radius:13px;background:#fff;border:1px solid #e2e8f0;box-shadow:0 1px 4px rgba(0,0,0,0.06);display:flex;align-items:center;justify-content:center;font-size:22px;">
            {s.icon}
          </div>
          <span style="font-size:10px;font-weight:600;color:#374151;text-align:center;line-height:1.35;">{s.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Top Providers — Block 2 -->
  <section style="background:#fff;padding:20px 0 24px;">
    <div style="padding:0 16px 14px;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:15px;font-weight:700;color:#111827;">Top Providers</span>
      <a href="/providers" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View all &rsaquo;</a>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;padding:0 16px;">
      {b2Tilers.map(t => {
        const color = avatarColor(t.full_name)
        const inits = initials(t.full_name)
        return (
          <a href={t.slug ? `/tilers/${t.slug}` : '/providers'}
            style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
            <div style={`width:82px;height:82px;background:${color};flex-shrink:0;display:flex;align-items:center;justify-content:center;overflow:hidden;`}>
              {t.avatar_url
                ? <img src={t.avatar_url} alt={t.full_name} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                : <span style="font-size:26px;font-weight:800;color:rgba(255,255,255,0.85);">{inits}</span>
              }
            </div>
            <div style="flex:1;padding:12px 12px;min-width:0;">
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">
                <span style="font-size:13px;font-weight:700;color:#111827;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{t.full_name}</span>
                {t.is_verified && <span style="font-size:8px;font-weight:700;color:#16a34a;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:20px;padding:1px 6px;flex-shrink:0;">✓ Pro</span>}
              </div>
              {t.speciality && <div style="font-size:11px;color:#64748b;margin-bottom:2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{t.speciality}</div>}
              <div style="font-size:11px;color:#94a3b8;">📍 {t.city || t.district}</div>
              {t.avg_rating > 0 && <div style="font-size:11px;color:#f59e0b;margin-top:2px;">⭐ {t.avg_rating.toFixed(1)}</div>}
            </div>
            <div style="padding:0 14px;font-size:20px;color:#cbd5e1;flex-shrink:0;">›</div>
          </a>
        )
      })}
    </div>
  </section>

  <!-- Recent Projects — Block 2 -->
  <section style="background:#f8fafc;padding:20px 0 24px;">
    <div style="padding:0 16px 14px;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:15px;font-weight:700;color:#111827;">Recent Projects</span>
      <a href="/jobs" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View All &rsaquo;</a>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;padding:0 16px;">
      {b2Projects.map(job => {
        const bids = bidsByProject[job.id] || 0
        const bg = PROJ_COLORS[job.project_type] || '#1B3A6B'
        return (
          <a href={`/job?id=${job.id}`}
            style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
            <div style={`width:88px;height:82px;background:${bg};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:28px;`}>
              {TYPE_ICON[job.project_type] || '🏠'}
            </div>
            <div style="flex:1;padding:12px 12px;min-width:0;">
              <div style="font-size:13px;font-weight:700;color:#111827;margin-bottom:3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{job.project_type}</div>
              <div style="font-size:11px;color:#64748b;margin-bottom:4px;">📍 {job.city || job.district}</div>
              {job.budget_range && <div style="font-size:11px;font-weight:700;color:#16a34a;">Budget: {job.budget_range}</div>}
              {bids > 0 && <div style="font-size:10px;color:#64748b;margin-top:2px;">{bids} bid{bids !== 1 ? 's' : ''} received</div>}
            </div>
            <div style="padding:0 14px;font-size:20px;color:#cbd5e1;flex-shrink:0;">›</div>
          </a>
        )
      })}
    </div>
  </section>

  <!-- WHY CHOOSE TILERSHUB -->
  <section style="background:#fff;padding:24px 16px 28px;">
    <div style="font-size:15px;font-weight:700;color:#111827;margin-bottom:16px;">Why Choose TILERSHUB?</div>
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;">
      {[
        { icon:'📋', title:'Post Projects for Free',           desc:'No cost, no account needed' },
        { icon:'💬', title:'Multiple Bids',                    desc:'Compare quotes from pros'   },
        { icon:'🏆', title:'Compare Best Provider',            desc:'Ratings & reviews'          },
        { icon:'📱', title:'Contact on WhatsApp',              desc:'Direct, instant chat'       },
        { icon:'✅', title:'Verified & Trusted Professionals', desc:'Background-checked'         },
      ].map(f => (
        <div style="background:#f8fafc;border-radius:14px;padding:16px 14px;border:1px solid #f1f5f9;">
          <div style="font-size:26px;margin-bottom:8px;">{f.icon}</div>
          <div style="font-size:12px;font-weight:700;color:#111827;margin-bottom:3px;line-height:1.35;">{f.title}</div>
          <div style="font-size:11px;color:#94a3b8;">{f.desc}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <div class="hiw-strip">
    <div class="hiw-inner">
      {[
        { icon:'📋', step:'1', title:'Post Your Project', desc:'Free, no login needed.' },
        { icon:'💬', step:'2', title:'Providers Bid',     desc:'Tilers submit quotes directly.' },
        { icon:'✅', step:'3', title:'You Choose',        desc:'Pick the best, chat on WhatsApp.' },
      ].map((s, i, arr) => (
        <div class={`hiw-step${i < arr.length - 1 ? ' sep' : ''}`}>
          <div class="hiw-icon">{s.icon}</div>
          <div class="hiw-num">Step {s.step}</div>
          <div class="hiw-title">{s.title}</div>
          <div class="hiw-desc">{s.desc}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- JOIN AS PROVIDER STRIP -->
  <section class="join-strip">
    <div class="join-strip-inner">
      <div class="join-strip-text">
        <div class="join-strip-eyebrow">For Professionals</div>
        <div class="join-strip-title">Are you a tiler, contractor or supplier?</div>
        <div class="join-strip-sub">Get listed on TilersHub — homeowners find and contact you directly via WhatsApp.</div>
      </div>
      <a href="/join-tilershub" class="join-strip-btn">✅ Join as Provider</a>
    </div>
  </section>

</Layout>

<style>
/* ── LUXEHOME SHELF CARD ─────────────────────────────────── */
.luxe-shelf-card {
  width: 186px;
  flex-shrink: 0;
  background: #fff;
  border: 1.5px solid #D4AF37;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(212,175,55,0.18);
  text-decoration: none;
  color: inherit;
  display: block;
  transition: transform 0.2s, box-shadow 0.2s;
}
.luxe-shelf-card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(212,175,55,0.28); }
