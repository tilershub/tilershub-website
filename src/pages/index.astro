  <script>
    const form = document.getElementById('hero-search')
    const input = document.getElementById('hero-q') as HTMLInputElement
    form?.addEventListener('submit', e => {
      e.preventDefault()
      const q = input?.value.trim()
      if (q) window.location.href = `/providers?q=${encodeURIComponent(q)}`
    })
    // Update search placeholder based on language
    function updatePlaceholder() {
      if (!input) return
      const lang = document.documentElement.getAttribute('data-lang') || 'en'
      input.placeholder = lang === 'si' ? 'ඔබ සොයන සේවාව කුමක්ද?' : 'What service are you looking for?'
    }
    updatePlaceholder()
    new MutationObserver(updatePlaceholder).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] })
  </script>
