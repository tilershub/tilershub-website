---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase.js'

const { data: featuredTilers } = await supabase
  .from('tilers')
  .select('id,full_name,district,city,is_verified,slug,avg_rating,phone,whatsapp,experience_years')
  .eq('featured', true)
  .order('experience_years', { ascending: false })
  .limit(8)

const { data: contractorsData } = await supabase
  .from('providers')
  .select('id,name,city,district,services,slug,whatsapp,phone,is_featured,cover_image')
  .eq('provider_type', 'contractor')
  .eq('status', 'active')
  .limit(6)

const { data: tileShopsData } = await supabase
  .from('providers')
  .select('id,name,city,district,services,slug,whatsapp,phone,is_featured,cover_image')
  .eq('provider_type', 'tile_shop')
  .eq('status', 'active')
  .limit(8)

const { data: brandsData } = await supabase
  .from('brands')
  .select('id,name,slug,categories,logo_url')
  .eq('status', 'active')
  .limit(10)

const { data: jobsData } = await supabase
  .from('jobs')
  .select('id,title,district,city,created_at,budget_min,budget_max')
  .eq('status', 'open')
  .order('created_at', { ascending: false })
  .limit(4)

const tilers      = featuredTilers  || []
const contractors = contractorsData || []
const tileShops   = tileShopsData   || []
const brands      = brandsData      || []
const jobs        = jobsData        || []

function initials(name) {
  return name?.split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase() || 'TH'
}

function waLink(phone, name) {
  const n = (phone||'').replace(/\D/g,'')
  const num = n.startsWith('94') ? n : '94'+n.replace(/^0/,'')
  const msg = encodeURIComponent(`ආයුබෝවන්! 🙏\n\nමම *TilersHub* (www.tilershub.lk) හරහා *${name}* සොයාගතිමි.\n\nඔබගේ සේවාව ගැන දැනගැනීමට කැමැත්තෙමි.\n\n📌 *TilersHub.lk* Lead\nස්තූතියි! 🏠`)
  return `https://wa.me/${num}?text=${msg}`
}

function timeAgo(dateStr) {
  if (!dateStr) return ''
  const diff = Math.floor((Date.now() - new Date(dateStr)) / 86400000)
  if (diff === 0) return 'Today'
  if (diff === 1) return 'Yesterday'
  if (diff < 7)  return `${diff}d ago`
  if (diff < 30) return `${Math.floor(diff/7)}w ago`
  return `${Math.floor(diff/30)}mo ago`
}

const QUICK_ACTIONS = [
  { icon: '👷', label: 'Find Tiler',     href: '/providers?type=tiler',     bg: '#EEF2FB' },
  { icon: '🚿', label: 'Bathroom Quote', href: '/post-project',              bg: '#EFF6FF' },
  { icon: '🏪', label: 'Tile Shops',     href: '/providers?type=tile_shop', bg: '#FFFBEB' },
  { icon: '📐', label: 'Calculator',     href: '/estimator',                 bg: '#F5F3FF' },
]

const PRODUCTS = [
  { icon: '🪨', label: 'Tiles',             href: '/tile',                      bg: '#1A2B4A' },
  { icon: '🚿', label: 'Bathware',          href: '/bathrooms',                 bg: '#0369a1' },
  { icon: '🔩', label: 'Tapware',           href: '/bathrooms',                 bg: '#0891b2' },
  { icon: '🧪', label: 'Adhesives',         href: '/tile',                      bg: '#C1603A' },
  { icon: '🪣', label: 'Grouts',            href: '/tile',                      bg: '#166534' },
  { icon: '💧', label: 'Waterproofing',     href: '/providers?type=contractor', bg: '#1e40af' },
  { icon: '🪵', label: 'Vanity Cupboards',  href: '/bathrooms',                 bg: '#92400e' },
  { icon: '💡', label: 'Lighting',          href: '/bathrooms',                 bg: '#7c3aed' },
]

const SERVICES = [
  { icon: '🪟', label: 'Glass Works',      href: '/providers' },
  { icon: '🪵', label: 'Vanity Cupboards', href: '/providers' },
  { icon: '🔩', label: 'Plumbing Works',   href: '/providers' },
  { icon: '⚡', label: 'Electrical Works', href: '/providers' },
  { icon: '🏗️', label: 'Ceiling Works',    href: '/providers' },
  { icon: '💧', label: 'Waterproofing',    href: '/providers?type=contractor' },
  { icon: '🪨', label: 'Granite Works',    href: '/providers?type=workshop' },
  { icon: '🔲', label: 'Aluminum Works',   href: '/providers' },
  { icon: '✂️', label: 'Tile Cutting',     href: '/providers?type=workshop' },
]

const CONTR_BG = [
  'linear-gradient(135deg,#1A2B4A,#2B4275)',
  'linear-gradient(135deg,#C1603A,#8b4513)',
  'linear-gradient(135deg,#166534,#14532d)',
  'linear-gradient(135deg,#7c3aed,#4c1d95)',
  'linear-gradient(135deg,#0f2444,#1e3a5f)',
  'linear-gradient(135deg,#92400e,#78350f)',
]
const CONTR_ICO = ['🏗️','🔨','🚿','🛁','🪞','🔩']
const BRAND_COL = ['#1A2B4A','#C1603A','#D4AF37','#1e3a5f','#7c3aed','#166534','#92400e','#374151']

const BLOG_POSTS = [
  { slug: 'how-to-choose-tile-size',    cat: 'Tiling Tips',  title: 'How to Choose the Right Tile Size',  icon: '📐', bg: 'linear-gradient(135deg,#1A2B4A,#2B4275)' },
  { slug: 'understanding-tile-grades',   cat: 'Buying Guide', title: 'Understanding Tile Grades',          icon: '🏷️', bg: 'linear-gradient(135deg,#C1603A,#8b4513)' },
  { slug: 'tiling-cost-guide-sri-lanka', cat: 'Cost Guide',   title: 'Tiling Cost Guide — 2025',           icon: '💰', bg: 'linear-gradient(135deg,#16a34a,#166534)' },
]

const PLACEHOLDER_CONTRACTORS = [
  { name: 'LUXEhome Bathrooms',    city: 'Colombo',  slug: '/sponsor/luxehome', i: 0 },
  { name: 'Kandy Bath Centre',     city: 'Kandy',    slug: null,                 i: 1 },
  { name: 'Southern Renovations',  city: 'Galle',    slug: null,                 i: 2 },
  { name: 'Metro Bath & Tile',     city: 'Nugegoda', slug: null,                 i: 3 },
]

const PLACEHOLDER_SHOPS = [
  { name: 'Tile Gedara',       city: 'Colombo 10', slug: null, i: 0 },
  { name: 'Lanka Tile World',  city: 'Kandy',      slug: null, i: 1 },
  { name: 'Serandib Bathware', city: 'Galle',      slug: null, i: 2 },
  { name: 'Metro Tiles',       city: 'Negombo',    slug: null, i: 3 },
]
---

<Layout
  title="TilersHub · Sri Lanka's Tile & Bathroom Marketplace"
  description="Find tilers, contractors, tile shops, brands and products for your tile and bathroom project across Sri Lanka. Free quotes — no login required."
>

<!-- ① HERO ─────────────────────────────────────────────── -->
<div style="position:relative;min-height:380px;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:60px 20px 52px;background:#0a121f;">
  <img
    src="https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?auto=format&fit=crop&w=1400&q=75"
    alt=""
    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:0.22;"
    loading="eager"
    fetchpriority="high"
  />
  <div style="position:absolute;inset:0;background:linear-gradient(160deg,rgba(10,18,31,0.7) 0%,rgba(26,43,74,0.55) 100%);pointer-events:none;"></div>
  <div style="position:absolute;inset:0;opacity:0.035;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
  <div style="position:absolute;top:-60px;right:-60px;width:360px;height:360px;background:radial-gradient(circle,rgba(245,158,11,0.07),transparent 65%);pointer-events:none;"></div>

  <div style="position:relative;text-align:center;max-width:640px;width:100%;">
    <div style="display:inline-flex;align-items:center;gap:6px;background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.25);border-radius:20px;padding:5px 16px;margin-bottom:20px;">
      <span style="font-size:9px;font-weight:700;color:var(--gold);letter-spacing:2.5px;text-transform:uppercase;">🇱🇰 Sri Lanka's Tile & Bathroom Marketplace</span>
    </div>
    <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,5vw,50px);font-weight:700;color:#fff;line-height:1.15;margin-bottom:14px;">
      Everything for Your<br/><span style="color:var(--gold);">Tile &amp; Bathroom Project</span>
    </h1>
    <p style="font-size:clamp(13px,1.8vw,16px);color:rgba(255,255,255,0.6);margin-bottom:30px;line-height:1.8;">
      Find trusted professionals, quality products, leading brands and the best prices.
    </p>

    <!-- Hero search bar -->
    <div style="position:relative;max-width:520px;margin:0 auto 20px;">
      <span style="position:absolute;left:16px;top:50%;transform:translateY(-50%);font-size:18px;pointer-events:none;">🔍</span>
      <input
        type="text"
        id="hero-search"
        placeholder="Search tilers, contractors, shops, brands…"
        style="width:100%;height:52px;padding:0 130px 0 48px;border:none;border-radius:14px;font-size:13px;font-family:inherit;outline:none;background:rgba(255,255,255,0.96);color:#0f172a;box-shadow:0 8px 32px rgba(0,0,0,0.3);"
      />
      <button
        onclick="document.location='/providers?q='+encodeURIComponent(document.getElementById('hero-search').value)"
        style="position:absolute;right:6px;top:6px;bottom:6px;padding:0 20px;background:var(--terra);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;">
        Search
      </button>
    </div>

    <!-- Hero CTAs -->
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="/providers?type=tiler"
        style="display:inline-flex;align-items:center;gap:8px;background:var(--terra);color:#fff;border-radius:12px;padding:13px 24px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(224,90,43,0.4);">
        👷 Find Tiler
      </a>
      <a href="/post-project"
        style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);color:#fff;border:1.5px solid rgba(255,255,255,0.3);border-radius:12px;padding:13px 24px;font-size:14px;font-weight:600;text-decoration:none;backdrop-filter:blur(8px);">
        📋 Get Free Quote
      </a>
    </div>

    <!-- Quick pills -->
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:18px;">
      {[
        { label:'👷 Tilers',     href:'/providers?type=tiler'      },
        { label:'🚿 Bathrooms',  href:'/bathrooms'                 },
        { label:'🏪 Tile Shops', href:'/providers?type=tile_shop'  },
        { label:'🔧 Workshops',  href:'/providers?type=workshop'   },
        { label:'📦 Suppliers',  href:'/providers?type=supplier'   },
        { label:'📐 Estimator',  href:'/estimator'                 },
      ].map(p => (
        <a href={p.href}
          style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:5px 12px;border-radius:20px;background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.8);border:1px solid rgba(255,255,255,0.18);white-space:nowrap;text-decoration:none;backdrop-filter:blur(4px);">
          {p.label}
        </a>
      ))}
    </div>
  </div>
</div>

<!-- ② QUICK ACTIONS ──────────────────────────────────────── -->
<section style="background:#fff;padding:20px 0 18px;border-bottom:1px solid var(--border);">
  <div class="quick-grid">
    {QUICK_ACTIONS.map(a => (
      <a href={a.href} class="quick-card">
        <div class="qc-icon" style={`background:${a.bg};`}>{a.icon}</div>
        <span class="qc-label">{a.label}</span>
      </a>
    ))}
  </div>
</section>

<!-- ③ STATS BAR ───────────────────────────────────────────── -->
<div style="background:var(--navy);padding:14px 0;">
  <div style="display:flex;justify-content:center;flex-wrap:wrap;">
    {[
      { n: '500+', l: 'Professionals' },
      { n: '25',   l: 'Districts' },
      { n: 'Free', l: 'Always' },
      { n: '100%', l: 'WhatsApp Direct' },
    ].map((s, i, arr) => (
      <div style={`text-align:center;padding:8px 24px;border-right:${i < arr.length-1 ? '1px solid rgba(255,255,255,0.1)' : 'none'}`}>
        <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:var(--gold);">{s.n}</div>
        <div style="font-size:10px;color:rgba(255,255,255,0.45);margin-top:1px;">{s.l}</div>
      </div>
    ))}
  </div>
</div>

<!-- ④ FEATURED TILERS ────────────────────────────────────── -->
<section class="section" style="background:#fff;">
  <div class="section-head">
    <div>
      <div class="section-eyebrow">⭐ Featured</div>
      <div class="section-title-sm">Verified Tiling <span>Professionals</span></div>
    </div>
    <a href="/providers?type=tiler" class="see-all">View all →</a>
  </div>

  <div class="shelf">
    {(tilers.length > 0 ? tilers : [
      { id:'p1', full_name:'Lakmal Perera',    city:'Colombo 7', is_verified:true,  avg_rating:4.9, slug:'lakmal'  },
      { id:'p2', full_name:'Chamara Silva',    city:'Kandy',     is_verified:true,  avg_rating:4.7, slug:'chamara' },
      { id:'p3', full_name:'Saman Jayantha',   city:'Galle',     is_verified:false, avg_rating:0,   slug:null      },
      { id:'p4', full_name:'Kelum Prasad',     city:'Negombo',   is_verified:true,  avg_rating:4.8, slug:'kelum'   },
    ]).map(t => (
      <div class="tiler-card" style="width:178px;flex-shrink:0;">
        <!-- blank tile-grid top -->
        <div style="height:90px;background:#f8fafc;background-image:repeating-linear-gradient(0deg,transparent,transparent 19px,#e2e8f0 19px,#e2e8f0 20px),repeating-linear-gradient(90deg,transparent,transparent 19px,#e2e8f0 19px,#e2e8f0 20px);display:flex;align-items:center;justify-content:center;position:relative;">
          <span style="font-size:30px;opacity:0.12;">🪨</span>
          {t.is_verified && <span class="verified-badge">✓ Skilled</span>}
        </div>
        <div class="tiler-body">
          {t.avg_rating > 0 && <div class="rating">⭐ {t.avg_rating.toFixed(1)}</div>}
          <div class="tiler-name">{t.full_name}</div>
          <div class="tiler-meta">📍 {t.city || t.district}</div>
          {t.slug ? (
            <a href={`/tilers/${t.slug}`} style="display:flex;align-items:center;justify-content:center;width:100%;padding:7px;background:var(--navy);color:#fff;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;">
              View Profile →
            </a>
          ) : (t.whatsapp || t.phone) ? (
            <a href={waLink(t.whatsapp || t.phone, t.full_name)} target="_blank" rel="noopener" class="tiler-wa-btn">💬 WhatsApp</a>
          ) : (
            <a href="/providers?type=tiler" style="display:flex;align-items:center;justify-content:center;width:100%;padding:7px;background:#f1f5f9;color:#64748b;border-radius:8px;font-size:11px;font-weight:600;text-decoration:none;">
              View Profile →
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ⑤ BATHROOM CONTRACTORS ──────────────────────────────── -->
<section class="section" style="background:var(--surface-2);border-top:1px solid var(--border);">
  <div class="section-head">
    <div>
      <div class="section-eyebrow">🚿 Contractors</div>
      <div class="section-title-sm">Bathroom <span>Contractors</span></div>
    </div>
    <a href="/providers?type=contractor" class="see-all">View all →</a>
  </div>

  <div class="shelf">
    {(contractors.length > 0 ? contractors : PLACEHOLDER_CONTRACTORS).map((c, i) => {
      const href = c.slug ? (c.slug.startsWith('/') ? c.slug : `/providers/${c.slug}`) : '/providers?type=contractor'
      return (
        <a href={href} style="flex-shrink:0;width:180px;background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;text-decoration:none;color:inherit;box-shadow:var(--shadow-sm);transition:all 0.2s;display:block;"
          onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.1)'"
          onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div style={`height:100px;background:${CONTR_BG[i % CONTR_BG.length]};display:flex;align-items:center;justify-content:center;font-size:38px;`}>
            {c.cover_image ? (
              <img src={c.cover_image} alt={c.name} style="width:100%;height:100%;object-fit:cover;" />
            ) : CONTR_ICO[i % CONTR_ICO.length]}
          </div>
          <div style="padding:10px 12px 14px;">
            <div style="font-size:13px;font-weight:700;color:var(--text);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{c.name}</div>
            <div style="font-size:11px;color:var(--text-3);margin-bottom:8px;">📍 {c.city || c.district}</div>
            <div style="font-size:11px;font-weight:700;color:var(--navy);">View Profile →</div>
          </div>
        </a>
      )
    })}
  </div>
</section>

<!-- ⑥ TILE SHOPS & SHOWROOMS ────────────────────────────── -->
<section class="section" style="background:#fff;border-top:1px solid var(--border);">
  <div class="section-head">
    <div>
      <div class="section-eyebrow">🏪 Showrooms</div>
      <div class="section-title-sm">Tile Shops &amp; <span>Showrooms</span></div>
    </div>
    <a href="/providers?type=tile_shop" class="see-all">View all →</a>
  </div>

  <div class="shelf">
    {(tileShops.length > 0 ? tileShops : PLACEHOLDER_SHOPS).map((s, i) => {
      const href = s.slug ? `/providers/${s.slug}` : '/providers?type=tile_shop'
      const cover = s.cover_image && !s.cover_image.includes('picsum') ? s.cover_image : null
      return (
        <a href={href} style="flex-shrink:0;width:180px;background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;text-decoration:none;color:inherit;box-shadow:var(--shadow-sm);transition:all 0.2s;display:block;"
          onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.1)'"
          onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div style="height:100px;position:relative;">
            {cover ? (
              <img src={cover} alt={s.name} style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
            ) : (
              <div style="width:100%;height:100%;background:#f8fafc;background-image:repeating-linear-gradient(0deg,transparent,transparent 19px,#e2e8f0 19px,#e2e8f0 20px),repeating-linear-gradient(90deg,transparent,transparent 19px,#e2e8f0 19px,#e2e8f0 20px);display:flex;align-items:center;justify-content:center;">
                <span style="font-size:32px;opacity:0.15;">🏪</span>
              </div>
            )}
            {s.is_featured && (
              <div style="position:absolute;top:6px;left:6px;background:#D4AF37;color:#fff;font-size:8px;font-weight:700;padding:2px 7px;border-radius:20px;">⭐ Top Rated</div>
            )}
          </div>
          <div style="padding:10px 12px 14px;">
            <div style="font-size:13px;font-weight:700;color:var(--text);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{s.name}</div>
            <div style="font-size:11px;color:var(--text-3);margin-bottom:8px;">📍 {s.city || s.district}</div>
            <div style="font-size:11px;font-weight:700;color:var(--navy);">View Shop →</div>
          </div>
        </a>
      )
    })}
  </div>
</section>

<!-- ⑦ PRODUCTS & MATERIALS ──────────────────────────────── -->
<section class="section" style="background:var(--surface-2);border-top:1px solid var(--border);">
  <div class="section-head">
    <div>
      <div class="section-eyebrow">🛍️ Materials</div>
      <div class="section-title-sm">Products &amp; <span>Materials</span></div>
    </div>
  </div>
  <div style="display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding:0 16px 12px;">
    {PRODUCTS.map(p => (
      <a href={p.href} style="flex-shrink:0;width:88px;display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;">
        <div style={`width:68px;height:68px;border-radius:18px;background:${p.bg};display:flex;align-items:center;justify-content:center;font-size:28px;box-shadow:0 4px 16px rgba(0,0,0,0.15);transition:transform 0.2s;`}
          onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform=''">
          {p.icon}
        </div>
        <span style="font-size:11px;font-weight:600;color:var(--text-2);text-align:center;line-height:1.3;">{p.label}</span>
      </a>
    ))}
  </div>
</section>

<!-- ⑧ HOME IMPROVEMENT SERVICES ──────────────────────────── -->
<section class="section" style="background:#fff;border-top:1px solid var(--border);">
  <div class="section-head">
    <div>
      <div class="section-eyebrow">🔨 Services</div>
      <div class="section-title-sm">Home Improvement <span>Services</span></div>
    </div>
    <a href="/providers" class="see-all">View all →</a>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:10px;padding:0 16px;">
    {SERVICES.map(s => (
      <a href={s.href}
