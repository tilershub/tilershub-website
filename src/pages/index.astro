---
import Layout from '../layouts/Layout.astro'
import HomeClient from '../components/HomeClient.jsx'
import HomeProvider from '../components/HomeProvider.jsx'
import NearYou from '../components/NearYou.jsx'
import { DEFAULT_DISTRICT } from '../lib/district.js'

const supabase = Astro.locals.supabase
const user = Astro.locals.user

// Which home a visitor gets is decided here, not in the browser: resolving it
// client-side would paint the homeowner page first and then swap it out.
let provider: any = null
if (user) {
  const { data } = await supabase.from('providers').select('*').eq('user_id', user.id).maybeSingle()
  provider = data
}
const isProvider = !!provider

const PROJECT_COLS = 'id,project_type,city,district,description,budget_range,status,created_at'
const WEEK_AGO = new Date(Date.now() - 7 * 86400000).toISOString()

let clientJobs: any[] = []
let openJobs: any[] = []
let newThisWeek = 0
let pros: any[] = []
let shops: any[] = []
let providerCount = 0

if (isProvider) {
  // Provider home: what is open to quote on, theirs first by district.
  const [{ data: open }, { count }] = await Promise.all([
    supabase.from('projects').select(PROJECT_COLS).eq('status', 'active')
      .order('created_at', { ascending: false }).limit(30),
    supabase.from('projects').select('id', { count: 'exact', head: true })
      .eq('status', 'active').gte('created_at', WEEK_AGO),
  ])
  const home = provider.district
  const pool = open ?? []
  const local = pool.filter((p: any) => p.district === home || p.city === home)
  openJobs = [...local, ...pool.filter((p: any) => !local.includes(p))].slice(0, 5)
  newThisWeek = count ?? 0
} else {
  // Homeowner home. Server-render the default district so the page is useful
  // before JS runs and crawlers see real content; NearYou re-queries when the
  // visitor changes district.
  const SHOP_TYPES = ['tile_shop', 'bathroom_shop', 'supplier', 'brand_dealer', 'tool_supplier', 'workshop']
  const COLS = 'id,name,slug,city,district,service_areas,provider_type,avg_rating,review_count,profile_image,cover_image'

  const [{ data: allActive }, mine] = await Promise.all([
    supabase.from('providers').select(COLS).eq('status', 'active')
      .order('avg_rating', { ascending: false })
      .order('review_count', { ascending: false })
      .limit(60),
    user
      ? supabase.from('projects').select(PROJECT_COLS).eq('user_id', user.id)
          .order('created_at', { ascending: false }).limit(3)
      : Promise.resolve({ data: [] as any[] }),
  ])

  const isLocal = (p: any) =>
    p.district === DEFAULT_DISTRICT ||
    (p.service_areas || []).includes(DEFAULT_DISTRICT) ||
    (p.city || '').toLowerCase().includes(DEFAULT_DISTRICT.toLowerCase())

  const pool = allActive ?? []
  const prosAll = pool.filter((p: any) => !SHOP_TYPES.includes(p.provider_type))
  const shopsAll = pool.filter((p: any) => SHOP_TYPES.includes(p.provider_type))
  pros = (prosAll.filter(isLocal).length ? prosAll.filter(isLocal) : prosAll).slice(0, 10)
  shops = (shopsAll.filter(isLocal).length ? shopsAll.filter(isLocal) : shopsAll).slice(0, 10)
  providerCount = prosAll.filter(isLocal).length
  clientJobs = mine.data ?? []
}

Astro.response.headers.set('Cache-Control', user ? 'private, no-store' : 'public, max-age=0, s-maxage=300')
---

<Layout
  title="TilersHub · Find Trusted Tilers in Sri Lanka"
  description="Post your tiling or renovation job free and get quotes from verified professionals near you. Compare ratings, chat on WhatsApp, no commission."
>
  <meta slot="head" name="keywords" content="tilers Sri Lanka, tiling services Colombo, bathroom renovation, floor tiling, tile shop Sri Lanka, find a tiler, TilersHub" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'TilersHub',
    url: 'https://www.tilershub.lk',
    description: 'Find trusted tilers and home-service professionals across Sri Lanka.',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://www.tilershub.lk/providers?search={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  })} />

  {isProvider ? (
    <HomeProvider client:load user={user} provider={provider} initialJobs={openJobs} newThisWeek={newThisWeek} />
  ) : (
    <>
      <HomeClient client:load initialUser={user} providerCount={providerCount} initialJobs={clientJobs} />
      <NearYou client:load initial={pros} />
      <NearYou client:load variant="shops" initial={shops} />
      <div style="height:20px;"></div>
    </>
  )}
</Layout>
