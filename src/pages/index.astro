---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase.js'

const { data: featuredTilers } = await supabase
  .from('tilers')
  .select('id,full_name,district,city,is_verified,slug,avg_rating,experience_years')
  .eq('featured', true)
  .order('experience_years', { ascending: false })
  .limit(8)

const { data: projectsData } = await supabase
  .from('projects')
  .select('id,project_type,district,city,created_at,budget_range')
  .eq('status', 'active')
  .order('created_at', { ascending: false })
  .limit(4)

const tilers   = featuredTilers || []
const projects = projectsData  || []

function timeAgo(dateStr) {
  if (!dateStr) return ''
  const diff = Math.floor((Date.now() - new Date(dateStr)) / 86400000)
  if (diff === 0) return 'Today'
  if (diff === 1) return 'Yesterday'
  if (diff < 7)  return `${diff}d ago`
  if (diff < 30) return `${Math.floor(diff/7)}w ago`
  return `${Math.floor(diff/30)}mo ago`
}

const TYPE_ICON: Record<string, string> = {
  'Floor Tiling':'🪨','Bathroom Tiling':'🚿','Bathroom Renovation':'🛁',
  'Granite Works':'💎','Tile Cutting':'✂️','Routering':'🔧',
  'Waterproofing':'💧','Tile Shop Inquiry':'🏪',
}

const HERO_IMG = 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?auto=format&fit=crop&w=1400&q=75'

const EXPLORE_PROS = [
  { label:'👷 Tilers',              href:'/providers?type=tiler'            },
  { label:'✂️ Tile Cutting',        href:'/providers?q=Tile+Cutting'        },
  { label:'🚿 Bathroom Tiling',     href:'/providers?q=Bathroom+Tiling'     },
  { label:'🛁 Bathroom Renovation', href:'/providers?q=Bathroom+Renovation' },
  { label:'💧 Waterproofing',       href:'/providers?q=Waterproofing'       },
  { label:'🏗️ Ipanel Ceiling',      href:'/providers?q=Ipanel+Ceiling'      },
  { label:'🔩 Bathroom Plumbing',   href:'/providers?q=Bathroom+Plumbing'   },
  { label:'🚿 Shower Cubicle',      href:'/providers?q=Shower+Cubicle'      },
  { label:'💡 Bathroom Lighting',   href:'/providers?q=Bathroom+Lighting'   },
  { label:'⚡ Electrical Works',    href:'/providers?q=Electrical+Works'    },
]

const EXPLORE_MORE = [
  { label:'🪨 Tiles',         href:'/tile'       },
  { label:'🚿 Bathware',      href:'/bathrooms'  },
  { label:'📐 Estimator',     href:'/estimator'  },
  { label:'📚 Guides',        href:'/guides'     },
  { label:'🏷️ Brands',        href:'/tile'       },
  { label:'☰ All Categories', href:'/categories' },
]
---

<Layout
  title="TilersHub · Sri Lanka's Tile & Bathroom Marketplace"
  description="Post your tiling project free, get bids from verified tilers and contractors. Browse profiles, reviews and prices across Sri Lanka."
>
  <link slot="head" rel="preload" as="image" href={HERO_IMG} fetchpriority="high" />

  <!-- ① HERO ──────────────────────────────────────────────── -->
  <div class="home-hero">
    <img
      src={HERO_IMG}
      alt=""
      width="1400"
      height="800"
      class="hero-bg"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
    <div class="hero-overlay"></div>
    <div class="hero-grid-bg"></div>

    <div class="hero-content">
      <div class="hero-badge">
        <span>🇱🇰 Sri Lanka's Tile &amp; Bathroom Marketplace</span>
      </div>
      <h1 class="hero-h1">
        Post. Get Bids.<br/><span>Build with Confidence.</span>
      </h1>
      <p class="hero-sub">
        Post free — verified tilers bid, you compare and choose.
      </p>

      <div class="hero-search-wrap">
        <span class="hero-search-icon">🔍</span>
        <input
          type="text"
          id="hero-search"
          placeholder="Search tilers, services, locations…"
          class="hero-search-input"
          autocomplete="off"
        />
        <button
          onclick="document.location='/providers?q='+encodeURIComponent(document.getElementById('hero-search').value)"
          class="hero-search-btn"
        >Search</button>
      </div>

      <div class="hero-ctas">
        <a href="/post-project" class="hero-cta-primary">📋 Post a Project</a>
        <a href="/providers?type=tiler" class="hero-cta-secondary">👷 Find Tilers</a>
        <a href="/jobs" class="hero-cta-secondary">💼 Browse Projects</a>
      </div>
    </div>
  </div>

  <!-- ② QUICK ACTIONS ─────────────────────────────────────── -->
  <section class="qa-section">
    <div class="qa-grid">
      {[
        { icon:'📋', label:'Post Project',  sub:'Free, no login',    href:'/post-project',        ibg:'rgba(224,90,43,0.14)',  bg:'#fff4f0' },
        { icon:'👷', label:'Find Tilers',   sub:'Islandwide',        href:'/providers?type=tiler', ibg:'rgba(26,43,74,0.12)',   bg:'#eef2fb' },
        { icon:'💼', label:'Browse Jobs',   sub:'Active projects',   href:'/jobs',                 ibg:'rgba(245,158,11,0.15)', bg:'#fffbeb' },
        { icon:'📐', label:'Estimator',     sub:'Cost calculator',   href:'/estimator',            ibg:'rgba(22,163,74,0.14)',  bg:'#f0fdf4' },
      ].map(a => (
        <a href={a.href} class="qa-card" style={`background:${a.bg};`}>
          <div class="qa-icon" style={`background:${a.ibg};`}>{a.icon}</div>
          <div class="qa-label">{a.label}</div>
          <div class="qa-sub">{a.sub}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- ③ LUXEHOME SIGNATURE PARTNER ───────────────────────── -->
  <section class="luxe-banner">
    <div class="luxe-grid-bg"></div>
    <div class="luxe-glow"></div>

    <div class="luxe-card">
      <!-- Top row: eyebrow + wordmark + meta -->
      <div class="luxe-top">
        <div class="luxe-top-left">
          <div class="luxe-eyebrow">◆ Signature Renovation Partner</div>
          <div class="luxe-wordmark">
            <span class="luxe-gold">LUXE</span><span class="luxe-white">home</span>
          </div>
          <div class="luxe-tagline">Premium Bathroom Construction &amp; Renovation · Islandwide</div>
        </div>
        <div class="luxe-top-right">
          <div class="luxe-badge">🛡️ TH Master Verified</div>
          <div class="luxe-rating-row">
            <span class="luxe-stars-sm">⭐⭐⭐⭐⭐</span>
            <span class="luxe-avg">4.9</span>
            <span class="luxe-stat-sep">·</span>
            <span class="luxe-stat">47 Reviews</span>
            <span class="luxe-stat-sep">·</span>
            <span class="luxe-stat">12+ Yrs Exp</span>
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="luxe-divider"></div>

      <!-- Middle: chips + quote side by side -->
      <div class="luxe-mid">
        <div class="luxe-chips-col">
          <div class="luxe-chips">
            {['🚿 Bathroom Renovation','💧 Waterproofing','🏗️ Full Construction','🛡️ 2-Year Warranty','📐 Free 3D Design'].map(s => (
              <span class="luxe-chip">{s}</span>
            ))}
          </div>
        </div>
        <div class="luxe-quote-col">
          <p class="luxe-quote">"LUXEhome transformed our bathroom into a luxury space. Flawless waterproofing and tiling — no issues after 8 months."</p>
          <div class="luxe-quote-author">— Shehara F., Colombo · Bathroom Renovation</div>
        </div>
      </div>

      <!-- Actions -->
      <div class="luxe-actions">
        <a
          href="https://wa.me/94774503744?text=Hi%20LUXEhome%2C%20I%20found%20you%20on%20TilersHub.%20I%27d%20like%20a%20site%20visit%20for%20a%20bathroom%20renovation."
          target="_blank" rel="noopener"
          class="luxe-btn-wa"
        >💬 Book Free Site Visit</a>
        <a href="/sponsor/luxehome" class="luxe-btn-profile">View Full Profile →</a>
      </div>
    </div>
  </section>

  <!-- ④ HOW IT WORKS ──────────────────────────────────────── -->
  <div class="hiw-strip">
    <div class="hiw-inner">
      {[
        { icon:'📋', step:'1', title:'Post Your Project', desc:'Free, no login needed.' },
        { icon:'💬', step:'2', title:'Providers Bid',     desc:'Tilers submit quotes directly.' },
        { icon:'✅', step:'3', title:'You Choose',        desc:'Pick the best, chat on WhatsApp.' },
      ].map((s, i, arr) => (
        <div class={`hiw-step${i < arr.length - 1 ? ' sep' : ''}`}>
          <div class="hiw-icon">{s.icon}</div>
          <div class="hiw-num">Step {s.step}</div>
          <div class="hiw-title">{s.title}</div>
          <div class="hiw-desc">{s.desc}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- ④ STATS BAR ─────────────────────────────────────────── -->
  <div class="stats-bar">
    {[
      { n:'500+', l:'Professionals' },
      { n:'25',   l:'Districts'     },
      { n:'Free', l:'No Login'      },
      { n:'Bid',  l:'& Compare'     },
    ].map((s, i, arr) => (
      <div class={`stat-item${i < arr.length - 1 ? ' sep' : ''}`}>
        <div class="stat-n">{s.n}</div>
        <div class="stat-l">{s.l}</div>
      </div>
    ))}
  </div>

  <!-- ⑤ FEATURED TILERS ───────────────────────────────────── -->
  <section class="section" style="background:#fff;">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">⭐ Featured</div>
        <div class="section-title-sm">Verified Tiling <span>Professionals</span></div>
      </div>
      <a href="/providers?type=tiler" class="see-all">View all →</a>
    </div>

    <div class="shelf">
      {(tilers.length > 0 ? tilers : [
        { id:'p1', full_name:'Lakmal Perera',   city:'Colombo 7',  is_verified:true,  avg_rating:4.9, experience_years:12, slug:'lakmal'  },
        { id:'p2', full_name:'Chamara Silva',   city:'Kandy',      is_verified:true,  avg_rating:4.7, experience_years:8,  slug:'chamara' },
        { id:'p3', full_name:'Saman Jayantha',  city:'Galle',      is_verified:false, avg_rating:0,   experience_years:5,  slug:null      },
        { id:'p4', full_name:'Kelum Prasad',    city:'Negombo',    is_verified:true,  avg_rating:4.8, experience_years:10, slug:'kelum'   },
        { id:'p5', full_name:'Nuwan Bandara',   city:'Kurunegala', is_verified:true,  avg_rating:4.6, experience_years:7,  slug:null      },
      ]).map(t => (
        <div class="tiler-card" style="width:186px;flex-shrink:0;">
          <div style="height:110px;background:#f8fafc;background-image:repeating-linear-gradient(0deg,transparent,transparent 19px,#e2e8f0 19px,#e2e8f0 20px),repeating-linear-gradient(90deg,transparent,transparent 19px,#e2e8f0 19px,#e2e8f0 20px);display:flex;align-items:center;justify-content:center;position:relative;">
            <span style="font-size:32px;opacity:0.1;">🪨</span>
            {t.is_verified
              ? <span class="verified-badge">✓ Skilled</span>
              : <span class="verified-badge" style="background:#f8fafc;color:#94a3b8;border-color:#e2e8f0;">Community</span>
            }
          </div>
          <div class="tiler-body">
            {t.avg_rating > 0 && <div class="rating">⭐ {t.avg_rating.toFixed(1)}</div>}
            <div class="tiler-name">{t.full_name}</div>
            <div class="tiler-meta">
              {t.experience_years > 0 ? `🛡️ ${t.experience_years}+ Yrs · ` : ''}📍 {t.city || t.district}
            </div>
            <a
              href={t.slug ? `/tilers/${t.slug}` : '/providers?type=tiler'}
              style="display:flex;align-items:center;justify-content:center;width:100%;padding:7px;background:#0f172a;color:#fff;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;margin-top:8px;">
              View Profile →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑥ POST + LATEST PROJECTS ──────────────────────────── -->
  <section style="background:var(--navy);padding:36px 20px;border-top:1px solid rgba(255,255,255,0.06);">
    <div class="proj-grid">

      <!-- Post CTA -->
      <div style="background:var(--terra);border-radius:18px;padding:28px 24px;display:flex;flex-direction:column;justify-content:center;">
        <div style="font-size:32px;margin-bottom:12px;">📋</div>
        <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:#fff;margin-bottom:8px;line-height:1.3;">Post Your Project</div>
        <p style="font-size:12px;color:rgba(255,255,255,0.75);margin-bottom:12px;line-height:1.7;">
          Describe what you need — tilers and contractors bid. No login required.
        </p>
        <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px;">
          {['📋 Free to post — no account needed','💬 Providers bid, you choose','✅ Contact your pick via WhatsApp'].map(f => (
            <div style="font-size:11px;color:rgba(255,255,255,0.8);">{f}</div>
          ))}
        </div>
        <a href="/post-project"
          style="display:inline-flex;align-items:center;justify-content:center;gap:7px;background:#fff;color:var(--terra);border-radius:12px;padding:12px 20px;font-size:13px;font-weight:800;text-decoration:none;">
          Post a Project →
        </a>
      </div>

      <!-- Latest projects -->
      <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:20px 20px 16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
          <div style="font-size:13px;font-weight:700;color:#fff;">💼 Latest Projects</div>
          <a href="/jobs" style="font-size:11px;color:rgba(255,255,255,0.5);text-decoration:none;font-weight:600;">Browse all →</a>
        </div>

        {projects.length > 0 ? (
          <div style="display:flex;flex-direction:column;gap:8px;">
            {projects.map(job => (
              <a href={`/job?id=${job.id}`}
                style="display:flex;align-items:center;gap:12px;padding:11px 14px;background:rgba(255,255,255,0.06);border-radius:12px;text-decoration:none;color:inherit;">
                <span style="font-size:20px;flex-shrink:0;">{TYPE_ICON[job.project_type] || '🏠'}</span>
                <div style="flex:1;min-width:0;">
                  <div style="font-size:13px;font-weight:700;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{job.project_type}</div>
                  <div style="font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px;">📍 {job.city || job.district} · {timeAgo(job.created_at)}</div>
                </div>
                {job.budget_range && (
                  <div style="flex-shrink:0;font-size:10px;font-weight:700;color:var(--gold);max-width:80px;text-align:right;line-height:1.3;">{job.budget_range.replace('Rs. ','Rs.')}</div>
                )}
                <div style="font-size:16px;color:rgba(255,255,255,0.3);">›</div>
              </a>
            ))}
          </div>
        ) : (
          <div style="text-align:center;padding:28px 16px;">
            <div style="font-size:36px;margin-bottom:10px;">💼</div>
            <div style="font-size:13px;color:rgba(255,255,255,0.5);line-height:1.65;">
              No open projects yet.<br/>Be the first to post — it's free.
            </div>
            <a href="/post-project" style="display:inline-flex;align-items:center;gap:6px;margin-top:14px;background:rgba(224,90,43,0.8);color:#fff;border-radius:10px;padding:9px 18px;font-size:12px;font-weight:700;text-decoration:none;">Post a Project</a>
          </div>
        )}

        <div style="margin-top:12px;padding:10px 14px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:12px;">
          <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-bottom:6px;font-weight:600;">Are you a tiler or contractor?</div>
          <a href="/jobs" style="font-size:12px;font-weight:700;color:var(--gold);text-decoration:none;">Browse all projects and submit bids →</a>
        </div>
      </div>

    </div>
  </section>

  <!-- ⑦ JOIN AS PROVIDER STRIP ────────────────────────────── -->
  <section class="join-strip">
    <div class="join-strip-inner">
      <div class="join-strip-text">
        <div class="join-strip-eyebrow">For Professionals</div>
        <div class="join-strip-title">Are you a tiler, contractor or supplier?</div>
        <div class="join-strip-sub">Get listed on TilersHub — homeowners find and contact you directly via WhatsApp.</div>
      </div>
      <a href="/join-tilershub" class="join-strip-btn">✅ Join as Provider</a>
    </div>
  </section>

  <!-- ⑧ EXPLORE TILERSHUB ─────────────────────────────────── -->
  <section style="background:var(--surface-2);padding:28px 0 24px;border-top:1px solid var(--border);">
    <div style="padding:0 16px 10px;display:flex;align-items:center;justify-content:space-between;">
      <div style="font-size:13px;font-weight:700;color:var(--text);">Explore TilersHub</div>
      <a href="/categories" style="font-size:11px;font-weight:600;color:var(--navy);text-decoration:none;">All categories →</a>
    </div>

    <div style="display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding:0 16px 10px;">
      {EXPLORE_PROS.map(c => (
        <a href={c.href} class="explore-chip">{c.label}</a>
      ))}
    </div>

    <div style="display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding:0 16px 4px;">
      {EXPLORE_MORE.map(c => (
        <a href={c.href} class="explore-chip">{c.label}</a>
      ))}
    </div>
  </section>

</Layout>

<style>
/* ── HERO ─────────────────────────────────────────────────── */
.home-hero {
  position: relative;
  min-height: 360px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 52px 20px 48px;
  background: #0a121f;
}
.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  opacity: 0.22;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(10,18,31,0.75) 0%, rgba(26,43,74,0.6) 100%);
  pointer-events: none;
}
.hero-grid-bg {
  position: absolute;
  inset: 0;
  opacity: 0.035;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255,255,255,0.8) 39px, rgba(255,255,255,0.8) 40px),
    repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(255,255,255,0.8) 39px, rgba(255,255,255,0.8) 40px);
  pointer-events: none;
}
.hero-content {
  position: relative;
  text-align: center;
  max-width: 580px;
  width: 100%;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(245,158,11,0.12);
  border: 1px solid rgba(245,158,11,0.25);
  border-radius: 20px;
  padding: 5px 16px;
  margin-bottom: 16px;
}
.hero-badge span {
  font-size: 9px;
  font-weight: 700;
  color: var(--gold);
  letter-spacing: 2.5px;
  text-transform: uppercase;
}
.hero-h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(24px, 5vw, 44px);
  font-weight: 700;
  color: #fff;
  line-height: 1.15;
  margin-bottom: 12px;
}
.hero-h1 span { color: var(--gold); }
.hero-sub {
  font-size: clamp(12px, 1.8vw, 14px);
  color: rgba(255,255,255,0.6);
  margin-bottom: 22px;
  line-height: 1.8;
}
.hero-search-wrap {
  position: relative;
  max-width: 480px;
  margin: 0 auto 18px;
}
.hero-search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 17px;
  pointer-events: none;
  z-index: 1;
}
.hero-search-input {
  width: 100%;
  height: 48px;
  padding: 0 108px 0 44px;
  border: none;
  border-radius: 12px;
  font-size: 13px;
  font-family: inherit;
  outline: none;
  background: rgba(255,255,255,0.96);
  color: #0f172a;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}
.hero-search-input::placeholder { color: #94a3b8; }
.hero-search-btn {
  position: absolute;
  right: 5px;
  top: 5px;
  bottom: 5px;
  padding: 0 16px;
  background: var(--terra);
  color: #fff;
  border: none;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s;
}
.hero-search-btn:hover { background: var(--terra-light); }
.hero-ctas {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
}
.hero-cta-primary {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: var(--terra);
  color: #fff;
  border-radius: 12px;
  padding: 12px 24px;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 4px 20px rgba(224,90,43,0.45);
  transition: background 0.15s, transform 0.15s;
}
.hero-cta-primary:hover { background: var(--terra-light); transform: translateY(-1px); }
.hero-cta-secondary {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(255,255,255,0.12);
  color: #fff;
  border: 1.5px solid rgba(255,255,255,0.3);
  border-radius: 12px;
  padding: 12px 20px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s;
}
.hero-cta-secondary:hover { background: rgba(255,255,255,0.2); }

@media (max-width: 480px) {
  .home-hero { min-height: 310px; padding: 40px 16px 36px; }
  .hero-cta-primary  { width: 100%; justify-content: center; }
  .hero-cta-secondary { flex: 1; justify-content: center; min-width: 0; }
}

/* ── LUXEHOME SIGNATURE BANNER ───────────────────────────── */
.luxe-banner {
  position: relative;
