---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase.js'
import { SERVICES } from '../../lib/services.js'
import { BLOG_POSTS } from '../../lib/blog-posts.js'
import { CATEGORIES } from '../../lib/categories.js'

export function getStaticPaths() {
  return CATEGORIES.map(cat => ({ params: { slug: cat.slug }, props: { cat } }))
}

const { cat } = Astro.props

const catServices = SERVICES.filter(s => {
  const text = [s.label, ...s.terms].join(' ').toLowerCase()
  return cat.terms.some((t: string) => text.includes(t))
})

const [{ data: tilersRaw }, { data: providersRaw }] = await Promise.all([
  supabase
    .from('tilers')
    .select('id,full_name,city,district,is_verified,slug,avg_rating,avatar_url,speciality,services,whatsapp,phone,gallery,experience_years,daily_rate_min')
    .eq('is_verified', true)
    .order('avg_rating', { ascending: false })
    .limit(100),
  supabase
    .from('providers')
    .select('id,name,city,district,verification_status,slug,services,provider_type,whatsapp,phone,profile_image,cover_image,description,is_featured')
    .limit(100),
])

function matchesCat(services: any[], speciality: string) {
  const text = [...(services||[]), speciality||''].join(' ').toLowerCase()
  return cat.terms.some((t: string) => text.includes(t))
}

const tilers    = (tilersRaw  ||[]).filter((t:any) => matchesCat(t.services, t.speciality)).slice(0, 12)
const providers = (providersRaw||[]).filter((p:any) => matchesCat(p.services, p.description)).slice(0, 8)

const blogMap  = Object.fromEntries(BLOG_POSTS.map((p:any) => [p.slug, p]))
const blogs    = cat.blogSlugs.map((s:string) => blogMap[s]).filter(Boolean)

const AVATAR_COLORS = ['#1B3A6B','#0f766e','#7c3aed','#b45309','#0369a1','#E05A2B','#15803d','#be185d']
function avatarColor(name: string) {
  let h = 0; for (const c of name) h = (h*31+c.charCodeAt(0))>>>0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function initials(name: string) {
  return name.split(' ').slice(0,2).map((w:string) => w[0]||'').join('').toUpperCase()||'?'
}
function waLink(phone: string, name: string) {
  const cl = (phone||'').replace(/\D/g,'')
  const n  = cl.startsWith('0') ? '94'+cl.slice(1) : cl
  return `https://wa.me/${n}?text=${encodeURIComponent(`Hi ${name}, I found you on TilersHub.`)}`
}

const PROVIDER_TYPE_DISPLAY: Record<string,{label:string,color:string,bg:string,border:string}> = {
  tiler:        { label:'Professional',  color:'#1B3A6B', bg:'#eef3fb', border:'#d5e2f5' },
  contractor:   { label:'Contractor',    color:'#374151', bg:'#f1f5f9', border:'#e2e8f0' },
  tile_shop:    { label:'Tile Shop',     color:'#7c3aed', bg:'#f5f3ff', border:'#ddd6fe' },
  supplier:     { label:'Supplier',      color:'#0f766e', bg:'#f0fdf4', border:'#a7f3d0' },
  workshop:     { label:'Workshop',      color:'#b45309', bg:'#fffbeb', border:'#fde68a' },
  brand_dealer: { label:'Brand Dealer',  color:'#E05A2B', bg:'#fff4f0', border:'#fcd5c0' },
  bathroom_shop:{ label:'Bathware Shop', color:'#0369a1', bg:'#e0f2fe', border:'#bae6fd' },
}
const VERIFIED_STATUSES_CAT = new Set(['th_master','th_certified_pro','th_verified','verified'])
function catVerBadge(vs: string) {
  if (vs === 'th_master')        return { label:'TH Master',     bg:'#92400e', color:'#fef3c7' }
  if (vs === 'th_certified_pro') return { label:'Certified Pro', bg:'#1B3A6B', color:'#bfdbfe' }
  if (VERIFIED_STATUSES_CAT.has(vs)) return { label:'Verified',  bg:'rgba(22,163,74,0.9)', color:'#fff' }
  return null
}

const pageTitle = `${cat.label} in Sri Lanka — Verified Specialists | TilersHub`
const total     = tilers.length + providers.length
---

<Layout title={pageTitle} description={cat.desc}>

  <!-- Header -->
  <div style={`background:linear-gradient(135deg,#0F1E35,#1A2B4A);padding:24px 20px 22px;text-align:center;`}>
    <a href="/" style="font-size:11px;color:rgba(255,255,255,0.4);text-decoration:none;display:inline-block;margin-bottom:12px;">← Home</a>
    <div style={`width:56px;height:56px;border-radius:16px;background:${cat.bg};border:2px solid ${cat.border};display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 12px;`}>{cat.icon}</div>
    <h1 style="font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:#fff;margin:0 0 8px;">{cat.label}</h1>
    <p style="font-size:12px;color:rgba(255,255,255,0.5);margin:0 0 18px;line-height:1.6;max-width:360px;margin-left:auto;margin-right:auto;">{cat.desc}</p>
    <a href={`/post-project`} style="display:inline-flex;align-items:center;gap:7px;background:#E05A2B;color:#fff;border-radius:22px;padding:11px 22px;font-size:13px;font-weight:700;text-decoration:none;">
      📋 Post a {cat.label.replace(' Services','')} Project
    </a>
  </div>

  <!-- Sub-services -->
  <section style="background:#fff;padding:20px 0 20px;">
    <div style="padding:0 16px 12px;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:13px;font-weight:700;color:#374151;">Services in this category</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:0 16px;">
      {catServices.map((s:any) => (
        <a href={`/services/${s.slug}`}
          style={`display:flex;flex-direction:column;align-items:center;gap:6px;padding:10px 4px 9px;border-radius:14px;background:${cat.bg};border:1px solid ${cat.border};text-decoration:none;`}>
          <div style="width:42px;height:42px;border-radius:11px;background:#fff;border:1px solid rgba(0,0,0,0.06);box-shadow:0 1px 4px rgba(0,0,0,0.06);display:flex;align-items:center;justify-content:center;font-size:20px;">{s.icon}</div>
          <span style={`font-size:9px;font-weight:600;color:${cat.color};text-align:center;line-height:1.3;`}>{s.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Providers -->
  <section style="background:#f8fafc;padding:20px 0 24px;">
    <div style="padding:0 16px 14px;display:flex;align-items:center;justify-content:space-between;">
      <div>
        <span style="font-size:15px;font-weight:700;color:#111827;">Providers</span>
        {total > 0 && <span style="font-size:11px;color:#94a3b8;margin-left:7px;">{total} found</span>}
      </div>
      <a href={`/providers?q=${encodeURIComponent(cat.label.replace(' Services',''))}`}
        style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View All ›</a>
    </div>

    {total === 0
      ? (
        <div style="text-align:center;padding:32px 20px;color:#94a3b8;font-size:13px;">
          No providers listed yet for this category. <br />
          <a href="/join-tilershub" style="color:#E05A2B;text-decoration:none;font-weight:600;">Join TilersHub →</a>
        </div>
      )
      : (
        <div style="display:flex;flex-direction:column;gap:10px;padding:0 16px;">
          {tilers.map((t:any) => {
            const color = avatarColor(t.full_name)
            const phone = t.whatsapp || t.phone
            const coverSrc = (t.gallery||[])[0] || t.avatar_url
            return (
              <div style="display:flex;background:#fff;border-radius:18px;border:1px solid #e2e8f0;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
                <div style="width:110px;flex-shrink:0;position:relative;min-height:140px;overflow:hidden;">
                  {coverSrc
                    ? <img src={coverSrc} alt={t.full_name} style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                    : <div style={`width:100%;height:100%;background:${color};display:flex;align-items:center;justify-content:center;`}>
                        <span style="font-size:32px;font-weight:800;color:rgba(255,255,255,0.85);">{initials(t.full_name)}</span>
                      </div>
                  }
                  {t.is_verified && (
                    <div style="position:absolute;top:7px;left:7px;background:rgba(22,163,74,0.92);color:#fff;font-size:8px;font-weight:700;padding:2px 7px;border-radius:20px;white-space:nowrap;">✓ Verified</div>
                  )}
                </div>
                <div style="flex:1;padding:13px 15px;display:flex;flex-direction:column;min-width:0;">
                  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;gap:6px;">
                    <span style="font-size:9px;font-weight:700;color:#1B3A6B;background:#eef3fb;border:1px solid #d5e2f5;border-radius:20px;padding:2px 8px;white-space:nowrap;">Professional</span>
                    {t.daily_rate_min && <span style="font-size:9px;color:#64748b;white-space:nowrap;">Rs.{t.daily_rate_min}/day</span>}
                  </div>
                  <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{t.full_name}</div>
                  {t.avg_rating > 0 && <div style="font-size:11px;color:#f59e0b;margin-bottom:4px;">⭐ {t.avg_rating.toFixed(1)}{t.experience_years > 0 ? ` · ${t.experience_years}+ yrs` : ''}</div>}
                  {t.speciality && <div style="font-size:11px;color:#64748b;margin-bottom:8px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.5;">{t.speciality}</div>}
                  <div style="display:flex;align-items:center;justify-content:space-between;margin-top:auto;gap:6px;">
                    <span style="font-size:10px;color:#94a3b8;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">📍 {t.city||t.district}</span>
                    <div style="display:flex;gap:5px;flex-shrink:0;">
                      {phone && (
                        <a href={waLink(phone, t.full_name)} target="_blank" rel="noopener noreferrer"
                          style="display:inline-flex;align-items:center;background:#25D366;color:#fff;border-radius:8px;padding:5px 9px;font-size:9px;font-weight:700;text-decoration:none;">
                          💬
                        </a>
                      )}
                      {t.slug && (
                        <a href={`/tilers/${t.slug}`}
                          style="display:inline-flex;align-items:center;background:#1B3A6B;color:#fff;border-radius:8px;padding:5px 10px;font-size:9px;font-weight:700;text-decoration:none;white-space:nowrap;">
                          View ›
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )
          })}

          {providers.map((p:any) => {
            const color = avatarColor(p.name||'P')
            const phone = p.whatsapp || p.phone
            const coverSrc = p.cover_image || p.profile_image
            const td = PROVIDER_TYPE_DISPLAY[p.provider_type] || { label:'Provider', color:'#64748b', bg:'#f8fafc', border:'#e2e8f0' }
            const badge = catVerBadge(p.verification_status)
            return (
              <div style="display:flex;background:#fff;border-radius:18px;border:1px solid #e2e8f0;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
                <div style="width:110px;flex-shrink:0;position:relative;min-height:140px;overflow:hidden;">
                  {coverSrc
                    ? <img src={coverSrc} alt={p.name} style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                    : <div style={`width:100%;height:100%;background:${color};display:flex;align-items:center;justify-content:center;`}>
                        <span style="font-size:28px;font-weight:800;color:rgba(255,255,255,0.85);">{initials(p.name||'P')}</span>
                      </div>
                  }
                  {p.is_featured && (
                    <div style="position:absolute;top:7px;left:7px;background:#D4AF37;color:#fff;font-size:7px;font-weight:700;padding:2px 6px;border-radius:20px;white-space:nowrap;">⭐ Top</div>
                  )}
                </div>
                <div style="flex:1;padding:13px 15px;display:flex;flex-direction:column;min-width:0;">
                  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;gap:6px;">
                    <span style={`font-size:9px;font-weight:700;color:${td.color};background:${td.bg};border:1px solid ${td.border};border-radius:20px;padding:2px 8px;white-space:nowrap;`}>{td.label}</span>
                    {badge && <div style={`display:inline-flex;align-items:center;font-size:8px;font-weight:700;padding:2px 7px;border-radius:20px;background:${badge.bg};color:${badge.color};white-space:nowrap;`}>✓ {badge.label}</div>}
                  </div>
                  <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{p.name}</div>
                  {p.description && <div style="font-size:11px;color:#64748b;margin-bottom:8px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.5;">{p.description}</div>}
                  <div style="display:flex;align-items:center;justify-content:space-between;margin-top:auto;gap:6px;">
                    <span style="font-size:10px;color:#94a3b8;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">📍 {p.city||p.district}</span>
                    <div style="display:flex;gap:5px;flex-shrink:0;">
                      {phone && (
                        <a href={waLink(phone, p.name)} target="_blank" rel="noopener noreferrer"
                          style="display:inline-flex;align-items:center;background:#25D366;color:#fff;border-radius:8px;padding:5px 9px;font-size:9px;font-weight:700;text-decoration:none;">
                          💬
                        </a>
                      )}
                      {p.slug && (
                        <a href={`/providers/${p.slug}`}
                          style="display:inline-flex;align-items:center;background:#1B3A6B;color:#fff;border-radius:8px;padding:5px 10px;font-size:9px;font-weight:700;text-decoration:none;white-space:nowrap;">
                          View ›
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      )
    }
  </section>

  <!-- Blog posts -->
  {blogs.length > 0 && (
    <section style="background:#fff;padding:20px 0 24px;border-top:1px solid #f1f5f9;">
      <div style="padding:0 16px 12px;display:flex;align-items:center;justify-content:space-between;">
        <span style="font-size:15px;font-weight:700;color:#111827;">📰 Tips &amp; Guides</span>
        <a href="/blog" style="font-size:12px;font-weight:600;color:#E05A2B;text-decoration:none;">View All ›</a>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px;padding:0 16px;">
        {blogs.map((post:any) => (
          <a href={`/blog/${post.slug}`}
            style="display:flex;align-items:center;gap:0;background:#f8fafc;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;">
            <div style={`width:64px;height:64px;background:${post.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:24px;`}>{post.icon}</div>
            <div style="flex:1;padding:11px 13px;min-width:0;">
              <span style="font-size:9px;font-weight:700;color:#E05A2B;background:#fff4f0;border:1px solid #fcd5c0;border-radius:20px;padding:1px 7px;">{post.category}</span>
              <div style="font-size:12px;font-weight:700;color:#111827;line-height:1.4;margin-top:5px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">{post.title}</div>
            </div>
            <div style="padding:0 14px;font-size:18px;color:#cbd5e1;flex-shrink:0;">›</div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Post project CTA -->
  <section style="background:#E05A2B;padding:24px 20px;">
    <div style="max-width:480px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div>
        <div style="font-size:15px;font-weight:800;color:#fff;margin-bottom:4px;">Need a {cat.label.replace(' Services','')} specialist?</div>
        <div style="font-size:12px;color:rgba(255,255,255,0.72);">Post a project free — get bids on WhatsApp.</div>
      </div>
      <a href="/post-project" style="display:inline-flex;align-items:center;gap:7px;background:#fff;color:#E05A2B;border-radius:12px;padding:11px 20px;font-size:13px;font-weight:800;text-decoration:none;white-space:nowrap;flex-shrink:0;">
        📋 Post Free
      </a>
    </div>
  </section>

</Layout>
