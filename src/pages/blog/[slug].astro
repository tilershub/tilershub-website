---
export const prerender = true
import Layout from '../../layouts/Layout.astro'
import { BLOG_POSTS } from '../../lib/blog-posts.js'

export function getStaticPaths() {
  return BLOG_POSTS.map(p => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const post = BLOG_POSTS.find(p => p.slug === slug)
if (!post) return Astro.redirect('/blog')

const related = BLOG_POSTS.filter(p => post.relatedSlugs.includes(p.slug))

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  author: { '@type': 'Organization', name: 'TilersHub', url: 'https://www.tilershub.lk' },
  publisher: { '@type': 'Organization', name: 'TilersHub', logo: { '@type': 'ImageObject', url: 'https://www.tilershub.lk/favicon.svg' } },
  datePublished: post.datePublished || '2025-01-01',
  dateModified: new Date().toISOString().split('T')[0],
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://www.tilershub.lk/blog/${post.slug}` },
  keywords: `tiling Sri Lanka, ${post.category}, home improvement Sri Lanka`,
})

const faqSchema = post.sections?.length > 0 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.sections.map((s: { heading: string; body: string }) => ({
    '@type': 'Question',
    name: s.heading,
    acceptedAnswer: { '@type': 'Answer', text: s.body },
  })),
}) : null
---

<Layout
  title={`${post.title} · TilersHub Blog`}
  description={post.excerpt}
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={articleSchema} />
  {faqSchema && <script slot="head" type="application/ld+json" set:html={faqSchema} />}

  <!-- Header -->
  <div style={`background:linear-gradient(135deg,${post.color}ee 0%,${post.color} 100%);padding:40px 20px 36px;position:relative;overflow:hidden;`}>
    <div style="position:absolute;inset:0;opacity:0.05;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="max-width:760px;margin:0 auto;position:relative;">
      <a href="/blog" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:rgba(255,255,255,0.55);letter-spacing:1px;font-weight:600;margin-bottom:20px;text-decoration:none;">← Blog & Tips</a>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;">
        <span style="font-size:9px;font-weight:700;color:rgba(255,255,255,0.7);background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.2);border-radius:20px;padding:3px 10px;letter-spacing:1px;text-transform:uppercase;">{post.category}</span>
        <span style="font-size:10px;color:rgba(255,255,255,0.5);">· {post.readTime}</span>
      </div>
      <div style="font-size:44px;margin-bottom:14px;">{post.icon}</div>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(22px,4vw,34px);font-weight:700;color:#fff;line-height:1.25;margin:0;">{post.title}</h1>
    </div>
  </div>

  <style is:global>
    .blog-rich-content { color: #374151; font-size: 14px; line-height: 1.85; }
    .blog-rich-content p { margin: 0 0 16px; }
    .blog-rich-content h2 { font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 700; color: #111827; margin: 32px 0 12px; padding-bottom: 8px; border-bottom: 2px solid #e2e8f0; }
    .blog-rich-content h2:first-child { margin-top: 0; }
    .blog-rich-content h3 { font-size: 15px; font-weight: 700; color: #1B3A6B; margin: 24px 0 10px; }
    .blog-rich-content table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 13px; overflow-x: auto; display: block; }
    .blog-rich-content th { background: #1B3A6B; color: #fff; padding: 10px 12px; text-align: left; font-weight: 700; white-space: nowrap; }
    .blog-rich-content td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
    .blog-rich-content tr:nth-child(even) td { background: #f8fafc; }
    .blog-rich-content ul { margin: 0 0 16px; padding-left: 20px; }
    .blog-rich-content li { margin-bottom: 8px; }
    .blog-rich-content .img-placeholder { background: #f1f5f9; border: 2px dashed #cbd5e1; border-radius: 12px; padding: 16px 18px; margin: 20px 0; font-size: 12px; color: #64748b; font-style: italic; line-height: 1.6; }
    .blog-rich-content .warning-box { background: #fffbeb; border: 1.5px solid #fcd34d; border-left: 4px solid #f59e0b; border-radius: 10px; padding: 16px 18px; margin: 16px 0; font-size: 13px; color: #78350f; line-height: 1.7; }
    .blog-rich-content .disclaimer { font-size: 11px; color: #94a3b8; font-style: italic; border-top: 1px solid #e2e8f0; padding-top: 16px; margin-top: 8px; }
  </style>

  <!-- Content -->
  <div style="background:#f8fafc;padding:28px 16px 64px;">
    <div style="max-width:760px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:20px;">

      <!-- Excerpt -->
      <p style="font-size:15px;color:#374151;line-height:1.85;font-weight:500;border-left:3px solid #E05A2B;padding-left:16px;margin:0;">{post.excerpt}</p>

      <!-- Rich HTML content or plain sections -->
      {post.content
        ? <div class="blog-rich-content" style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:24px 28px;" set:html={post.content} />
        : post.sections?.map(s => (
            <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:24px;">
              <h2 style="font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:#111827;margin:0 0 12px;">{s.heading}</h2>
              <p style="font-size:14px;color:#374151;line-height:1.85;margin:0;">{s.body}</p>
            </div>
          ))
      }

      <!-- Quick tips -->
      <div style="background:linear-gradient(135deg,#0F1E35,#1A2B4A);border-radius:16px;padding:24px;">
        <h2 style="font-size:12px;font-weight:700;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:2px;margin:0 0 16px;">Quick Tips</h2>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {post.tips.map((tip, i) => (
            <div style="display:flex;align-items:flex-start;gap:12px;">
              <div style="width:24px;height:24px;border-radius:50%;background:#E05A2B;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;">{i + 1}</div>
              <p style="font-size:13px;color:rgba(255,255,255,0.75);line-height:1.6;margin:0;">{tip}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div style="background:#E05A2B;border-radius:16px;padding:24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <div>
          <div style="font-size:9px;font-weight:700;color:rgba(255,255,255,0.65);letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;">Take Action</div>
          <div style="font-size:16px;font-weight:700;color:#fff;">Ready to start your project?</div>
          <div style="font-size:12px;color:rgba(255,255,255,0.7);margin-top:3px;">Connect with verified professionals across Sri Lanka.</div>
        </div>
        <a href={post.cta.href} style="display:inline-flex;align-items:center;gap:7px;background:#fff;color:#E05A2B;border-radius:12px;padding:11px 22px;font-size:13px;font-weight:800;text-decoration:none;white-space:nowrap;flex-shrink:0;">
          {post.cta.text} →
        </a>
      </div>

      <!-- Related posts -->
      {related.length > 0 && (
        <div>
          <div style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;">Related Reading</div>
          <div style="display:flex;flex-direction:column;gap:10px;">
            {related.map(r => (
              <a href={`/blog/${r.slug}`}
                style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);"
                onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.09)';this.style.borderColor='#cbd5e1'"
                onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.04)';this.style.borderColor='#e2e8f0'"
              >
                <div style={`width:72px;height:72px;background:${r.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:26px;`}>{r.icon}</div>
                <div style="flex:1;padding:12px 14px;min-width:0;">
                  <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
                    <span style="font-size:9px;font-weight:700;color:#E05A2B;background:#fff4f0;border:1px solid #fcd5c0;border-radius:20px;padding:1px 7px;">{r.category}</span>
                    <span style="font-size:10px;color:#94a3b8;">{r.readTime}</span>
                  </div>
                  <div style="font-size:13px;font-weight:700;color:#111827;line-height:1.3;">{r.title}</div>
                </div>
                <div style="padding:0 14px;font-size:20px;color:#cbd5e1;flex-shrink:0;">›</div>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </div>

</Layout>
