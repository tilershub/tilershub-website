---
import Layout from '../../layouts/Layout.astro'
import { GUIDES } from '../../data/guides.js'
---

<Layout
  title="Tiling Guides & Tips for Sri Lanka · TilersHub"
  description="Free tiling guides for Sri Lanka homeowners — tile sizes, grade ratings, cost guides, installation tips and more."
>

  <!-- Hero -->
  <div style="background:linear-gradient(135deg,#115E59,#0D9488);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span style="font-size:9px;font-weight:700;color:rgba(217,119,6,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:14px;">📚 Knowledge Hub</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,40px);font-weight:700;color:#fff;margin:0 0 12px;line-height:1.2;">
        Tiling <span style="color:var(--terra);">Guides &amp; Tips</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);max-width:480px;margin:0 auto;line-height:1.8;">
        Expert guidance for Sri Lankan homeowners — from choosing the right tile size to understanding costs and grades.
      </p>
    </div>
  </div>

  <!-- Guides grid -->
  <section style="background:var(--surface);padding:52px 20px 64px;">
    <div style="max-width:900px;margin:0 auto;">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px;">
        {GUIDES.map(guide => (
          <a href={`/guides/${guide.slug}`} style="background:#fff;border-radius:18px;border:1px solid var(--border);overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;box-shadow:0 2px 12px rgba(0,0,0,0.05);transition:box-shadow 0.2s,transform 0.2s;"
            onmouseover="this.style.boxShadow='0 8px 28px rgba(0,0,0,0.12)';this.style.transform='translateY(-3px)'"
            onmouseout="this.style.boxShadow='0 2px 12px rgba(0,0,0,0.05)';this.style.transform=''">
            <div style={`background:${guide.bg};height:130px;display:flex;align-items:center;justify-content:center;font-size:44px;position:relative;overflow:hidden;`}>
              <div style="position:absolute;inset:0;opacity:0.06;background-image:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(255,255,255,0.8) 10px,rgba(255,255,255,0.8) 11px);pointer-events:none;"></div>
              <span style="position:relative;">{guide.icon}</span>
            </div>
            <div style="padding:20px;flex:1;display:flex;flex-direction:column;">
              <div style="font-size:9px;font-weight:700;color:var(--text-4);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:6px;">{guide.cat} · {guide.readTime}</div>
              <h2 style="font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:var(--text);margin:0 0 8px;line-height:1.35;">{guide.title}</h2>
              <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin:0 0 16px;flex:1;">{guide.excerpt}</p>
              <div style="font-size:12px;font-weight:700;color:var(--navy);">Read guide →</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--navy);padding:44px 20px;text-align:center;">
    <div style="max-width:560px;margin:0 auto;">
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(18px,3vw,26px);font-weight:700;color:#fff;margin-bottom:8px;">Ready to start your project?</h2>
      <p style="font-size:13px;color:rgba(255,255,255,0.5);margin-bottom:20px;line-height:1.8;">Find a verified tiler or post your project free on TilersHub.</p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="/providers" style="display:inline-flex;align-items:center;gap:7px;background:var(--terra);color:#fff;border-radius:11px;padding:12px 22px;font-size:13px;font-weight:700;text-decoration:none;">👷 Find a Tiler</a>
        <a href="/post-project" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.7);border:1px solid rgba(255,255,255,0.15);border-radius:11px;padding:12px 20px;font-size:13px;font-weight:600;text-decoration:none;">📋 Post My Project</a>
      </div>
    </div>
  </section>

</Layout>
