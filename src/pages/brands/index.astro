---
import Layout from '../../layouts/Layout.astro'

const { data: allBrands } = await Astro.locals.supabase.from('brands').select('*').eq('status', 'active').order('is_featured', { ascending: false }).order('name')
const brands = allBrands || []

const CHEMICAL_CATS = ['Tile Adhesive', 'Waterproofing', 'Construction Chemicals', 'Grout', 'Sealants']
const RENO_CATS = ['Bathroom Renovation', 'Interior Design', 'Construction', 'Premium Partner']
const BATHROOM_CATS = ['Sanitary Ware', 'Faucets', 'Bathroom Fittings', 'Bathroom Products', 'Showers', 'Bathtubs', 'Bathroom Accessories']

const isChemical = (b) => (b.categories || []).some(c => CHEMICAL_CATS.includes(c))
const isReno = (b) => (b.categories || []).some(c => RENO_CATS.includes(c))
const isBathroom = (b) => (b.categories || []).some(c => BATHROOM_CATS.includes(c))

const tileBrands = brands.filter(b => !isChemical(b) && !isReno(b) && !isBathroom(b))
const chemBrands = brands.filter(b => isChemical(b))
const renoBrands = brands.filter(b => isReno(b) && !isChemical(b))
const bathroomBrands = brands.filter(b => isBathroom(b) && !isChemical(b) && !isReno(b))

const BRAND_META = {
  'rocell':      { color: '#FFFFFF', bg: '#002B5B' },
  'lanka-tile':  { color: '#FFFFFF', bg: '#CC2229' },
  'macktiles':   { color: '#FFFFFF', bg: '#2E7D32' },
  'megatile':    { color: '#FFFFFF', bg: '#5D4037' },
  'swisstek':    { color: '#FFFFFF', bg: '#1565C0' },
  'tokyo-super': { color: '#FFFFFF', bg: '#C62828' },
  'dr-fixit':    { color: '#FFFFFF', bg: '#E65100' },
  'sika':        { color: '#FFFFFF', bg: '#B71C1C' },
  'finex':       { color: '#FFFFFF', bg: '#1A237E' },
}

function meta(brand) {
  return BRAND_META[brand.slug] || { color: '#fff', bg: '#0F766E' }
}

function logoText(name) {
  return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()
}
---

<Layout
  title="Tile Brands & Construction Chemical Brands in Sri Lanka · TilersHub"
  description="Discover tile brands, adhesive brands and waterproofing brands in Sri Lanka — Rocell, Lanka Tile, Megatile, Swisstek, Sika and more."
>

  <div style="background:var(--navy);padding:44px 20px 40px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">🏷️ Brands</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:12px 0 10px;line-height:1.2;">
        Brands in <span style="color:var(--terra);">Sri Lanka</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);">Tile brands, adhesives, grouts and waterproofing products</p>
    </div>
  </div>

  <section style="background:var(--surface);padding:52px 20px 64px;">
    <div style="max-width:1100px;margin:0 auto;">

      <!-- ── Tile Brands ── -->
      {tileBrands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,var(--navy),#0D9488);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🪨</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Tile Brands</div>
              <div style="font-size:12px;color:var(--text-4);">Floor tiles, wall tiles, porcelain &amp; ceramic collections</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {tileBrands.map(brand => {
              const m = meta(brand)
              const href = brand.dedicated_page_url || `/brands/${brand.slug}`
              const isFeaturedPage = !!brand.dedicated_page_url
              return (
                <a href={href} style={`background:#fff;border-radius:16px;border:${isFeaturedPage ? '2px solid var(--gold)' : '1px solid #e2e8f0'};padding:22px;display:block;text-decoration:none;color:inherit;position:relative;overflow:hidden;transition:box-shadow 0.2s,transform 0.2s;`}
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(15,118,110,0.12)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0d0b08;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">Sponsored</div>}
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family:'Playfair Display',serif;`}>{logoText(brand.name)}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{brand.name}</div>
                      {isFeaturedPage
                        ? <span style="font-size:10px;color:#92762a;font-weight:700;">⭐ Featured Brand</span>
                        : brand.is_featured && <span style="font-size:10px;color:var(--navy);font-weight:700;">✓ Verified Brand</span>
                      }
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{brand.description}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).slice(0,3).map(c => (
                      <span style={`font-size:10px;padding:2px 9px;border-radius:20px;background:${m.bg}18;color:${m.bg === '#FFFFFF' ? '#0F766E' : m.bg};border:1px solid ${m.bg}30;font-weight:600;`}>{c}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:var(--navy);">{isFeaturedPage ? 'View Sponsor Page →' : 'View Brand →'}</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

      <!-- ── Renovation & Design ── -->
      {renoBrands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#92400e,#78350f);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🛁</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Renovation &amp; Interior Design</div>
              <div style="font-size:12px;color:var(--text-4);">Bathroom construction, renovation packages &amp; interior design services</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {renoBrands.map(brand => {
              const m = meta(brand)
              const href = brand.dedicated_page_url || `/brands/${brand.slug}`
              return (
                <a href={href} style={`background:#fff;border-radius:16px;border:2px solid var(--gold);padding:22px;display:block;text-decoration:none;color:inherit;position:relative;overflow:hidden;transition:box-shadow 0.2s,transform 0.2s;`}
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(212,175,55,0.2)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0d0b08;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">Sponsored</div>
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family:'Playfair Display',serif;`}>{logoText(brand.name)}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{brand.name}</div>
                      <span style="font-size:10px;color:#92762a;font-weight:700;">⭐ Premium Partner</span>
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{brand.description}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).filter(c => c !== 'Premium Partner').slice(0,3).map(c => (
                      <span style="font-size:10px;padding:2px 9px;border-radius:20px;background:#FFF8E1;color:#92762a;border:1px solid #F5D97A;font-weight:600;">{c}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:#92762a;">View Sponsor Page →</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

      <!-- ── Bathroom Products ── -->
      {bathroomBrands.length > 0 && (
        <div style="margin-bottom:56px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#042F2E,#0F766E);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">🚿</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Bathroom Products &amp; Fittings</div>
              <div style="font-size:12px;color:var(--text-4);">Sanitary ware, faucets, showers, bathtubs &amp; bathroom accessories</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {bathroomBrands.map(brand => {
              const m = meta(brand)
              const href = brand.dedicated_page_url || `/brands/${brand.slug}`
              const isFeaturedPage = !!brand.dedicated_page_url
              return (
                <a href={href} style={`background:#fff;border-radius:16px;border:${isFeaturedPage ? '2px solid var(--gold)' : '1px solid #e2e8f0'};padding:22px;display:block;text-decoration:none;color:inherit;position:relative;overflow:hidden;transition:box-shadow 0.2s,transform 0.2s;`}
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(15,118,110,0.12)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0d0b08;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">Sponsored</div>}
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family:'Playfair Display',serif;`}>{logoText(brand.name)}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{brand.name}</div>
                      <span style="font-size:10px;color:#042F2E;font-weight:700;">🚿 Bathroom Products</span>
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{brand.description}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).slice(0,3).map(c => (
                      <span style="font-size:10px;padding:2px 9px;border-radius:20px;background:#EFF6FF;color:#0F766E;border:1px solid #BFDBFE;font-weight:600;">{c}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:var(--navy);">{isFeaturedPage ? 'View Sponsor Page →' : 'View Brand →'}</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

      <!-- ── Adhesives & Waterproofing ── -->
      {chemBrands.length > 0 && (
        <div>
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#0369a1,#075985);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">💧</div>
            <div>
              <div style="font-size:18px;font-weight:700;color:var(--text);">Adhesives &amp; Waterproofing</div>
              <div style="font-size:12px;color:var(--text-4);">Tile adhesives, grouts, waterproofing &amp; construction chemicals</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
            {chemBrands.map(brand => {
              const m = meta(brand)
              return (
                <a href={`/brands/${brand.slug}`} style="background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:22px;display:block;text-decoration:none;color:inherit;transition:box-shadow 0.2s,transform 0.2s;"
                  onmouseover="this.style.boxShadow='0 8px 28px rgba(15,118,110,0.10)';this.style.transform='translateY(-3px)'"
                  onmouseout="this.style.boxShadow='';this.style.transform=''">
                  <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    <div style={`width:56px;height:56px;border-radius:14px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:${m.color};letter-spacing:-0.5px;flex-shrink:0;font-family:'Playfair Display',serif;`}>{logoText(brand.name)}</div>
                    <div>
                      <div style="font-size:16px;font-weight:700;color:var(--text);">{brand.name}</div>
                      <span style="font-size:10px;color:#0369a1;font-weight:700;">💧 Construction Chemicals</span>
                    </div>
                  </div>
                  <p style="font-size:12px;color:var(--text-3);line-height:1.65;margin-bottom:14px;">{brand.description}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;">
                    {(brand.categories || []).slice(0,3).map(c => (
                      <span style={`font-size:10px;padding:2px 9px;border-radius:20px;background:${m.bg}18;color:${m.bg};border:1px solid ${m.bg}28;font-weight:600;`}>{c}</span>
                    ))}
                  </div>
                  <div style="font-size:12px;font-weight:700;color:var(--navy);">View Brand →</div>
                </a>
              )
            })}
          </div>
        </div>
      )}

    </div>
  </section>

</Layout>
