---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase.js'

const { data: brands } = await supabase.from('brands').select('*').eq('status', 'active').order('is_featured', { ascending: false }).order('name')
---

<Layout
  title="Tile Brands in Sri Lanka · TilersHub"
  description="Discover premium tile brands available in Sri Lanka — Lanka Tile, Rocell, LUXEhome and more. Browse collections and find local dealers."
>

  <div style="background:var(--navy);padding:44px 20px 40px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;max-width:600px;margin:0 auto;">
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">🏷️ Brands</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,42px);font-weight:700;color:#fff;margin:12px 0 10px;line-height:1.2;">
        Tile Brands in <span style="color:var(--terra);">Sri Lanka</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);">Explore premium tile brands, collections and find local dealers</p>
    </div>
  </div>

  <section style="background:var(--surface);padding:48px 20px 64px;">
    <div style="max-width:1100px;margin:0 auto;">
      {brands && brands.length > 0 ? (
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;">
          {brands.map(brand => {
            const href = brand.dedicated_page_url || `/brands/${brand.slug}`
            const isFeaturedPage = !!brand.dedicated_page_url
            return (
            <a href={href} class="card" style={`padding:28px;display:block;text-decoration:none;color:inherit;${isFeaturedPage ? 'border:2px solid var(--gold);position:relative;overflow:hidden;' : ''}`}>
              {isFeaturedPage && <div style="position:absolute;top:0;right:0;background:var(--gold);color:#0d0b08;font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 12px;border-bottom-left-radius:10px;">Featured</div>}
              <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px;">
                <div style={`width:52px;height:52px;border-radius:12px;background:${isFeaturedPage ? 'linear-gradient(135deg,#1c1810,#2e2418)' : 'linear-gradient(135deg,var(--navy),var(--navy-light))'};display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;border:${isFeaturedPage ? '1px solid rgba(192,168,120,0.3)' : 'none'};`}>{isFeaturedPage ? '🪨' : '🏷️'}</div>
                <div>
                  <div style="font-size:17px;font-weight:700;color:var(--text);">{brand.name}</div>
                  {isFeaturedPage
                    ? <span style="font-size:10px;color:#92762a;font-weight:700;margin-top:3px;display:inline-block;">⭐ Dedicated Page</span>
                    : brand.is_featured && <span class="chip chip-navy" style="font-size:10px;margin-top:3px;">⭐ Featured</span>
                  }
                </div>
              </div>
              <p style="font-size:13px;color:var(--text-3);line-height:1.6;margin-bottom:16px;">{brand.description}</p>
              <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:16px;">
                {(brand.categories || []).slice(0,3).map(c => (
                  <span class="chip chip-navy" style="font-size:10px;">{c}</span>
                ))}
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:11px;color:var(--text-4);">{isFeaturedPage ? 'Sponsored brand' : 'View collections'}</span>
                <span style={`font-size:12px;font-weight:700;color:${isFeaturedPage ? '#92762a' : 'var(--navy)'};`}>{isFeaturedPage ? 'View Brand →' : 'Explore →'}</span>
              </div>
            </a>
          )})}
        </div>
      ) : (
        <div style="text-align:center;padding:64px 20px;background:var(--surface-2);border-radius:16px;border:1px solid var(--border);">
          <div style="font-size:48px;margin-bottom:16px;">🏷️</div>
          <h3 style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:8px;">Brand pages coming soon</h3>
          <p style="color:var(--text-3);margin-bottom:24px;">We're adding tile brand profiles. Check back soon.</p>
          <a href="/" class="btn btn-navy">Back to Home</a>
        </div>
      )}
    </div>
  </section>

</Layout>
