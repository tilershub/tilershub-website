---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Contact TilersHub · Get in Touch"
  description="Contact the TilersHub team for listing enquiries, partnerships, or general questions about Sri Lanka's tiling marketplace."
>

  <!-- Hero -->
  <div style="background:var(--navy);padding:52px 20px 44px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(255,255,255,0.8) 20px,rgba(255,255,255,0.8) 21px);pointer-events:none;"></div>
    <div style="position:relative;max-width:560px;margin:0 auto;">
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">📬 Contact</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,40px);font-weight:700;color:#fff;margin:12px 0 10px;line-height:1.2;">
        Get in <span style="color:var(--gold);">Touch</span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);line-height:1.8;">Questions, partnerships, or listing enquiries — we're here to help.</p>
    </div>
  </div>

  <section style="background:var(--surface);padding:52px 20px 64px;">
    <div class="contact-grid">

      <!-- Contact Options -->
      <div>
        <h2 style="font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:var(--text);margin-bottom:24px;">How to Reach Us</h2>

        <div style="display:flex;flex-direction:column;gap:14px;">

          <a href="https://wa.me/94774503744" target="_blank" rel="noopener" class="contact-card">
            <div style="width:48px;height:48px;border-radius:14px;background:#f0fdf4;border:1px solid #bbf7d0;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">💬</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px;">WhatsApp</div>
              <div style="font-size:12px;color:var(--text-3);">Fastest response — chat with us directly</div>
              <div style="font-size:12px;font-weight:600;color:#16a34a;margin-top:4px;">+94 77 450 3744</div>
            </div>
          </a>

          <a href="mailto:Tilershub@gmail.com" class="contact-card">
            <div style="width:48px;height:48px;border-radius:14px;background:var(--navy-50);border:1px solid var(--navy-100);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">📧</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px;">Email</div>
              <div style="font-size:12px;color:var(--text-3);">We reply within 1 business day</div>
              <div style="font-size:12px;font-weight:600;color:var(--navy);margin-top:4px;">Tilershub@gmail.com</div>
            </div>
          </a>

          <a href="https://www.facebook.com/share/1BLsTEZ1qW/?mibextid=wwXIfr" target="_blank" rel="noopener" class="contact-card">
            <div style="width:48px;height:48px;border-radius:14px;background:#eff6ff;border:1px solid #bfdbfe;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">👥</div>
            <div>
              <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px;">Facebook</div>
              <div style="font-size:12px;color:var(--text-3);">Like our page and join the community</div>
              <div style="font-size:12px;font-weight:600;color:#1877F2;margin-top:4px;">TilersHub Sri Lanka</div>
            </div>
          </a>

        </div>

        <div style="margin-top:28px;padding:20px;background:var(--surface-2);border-radius:16px;border:1px solid var(--border);">
          <div style="font-size:12px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;">Quick Links</div>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/join-tilershub" style="font-size:13px;color:var(--navy);font-weight:600;text-decoration:none;display:flex;align-items:center;gap:6px;">✅ Join as a Provider →</a>
            <a href="/post-project" style="font-size:13px;color:var(--navy);font-weight:600;text-decoration:none;display:flex;align-items:center;gap:6px;">📋 Post a Project →</a>
            <a href="/providers" style="font-size:13px;color:var(--navy);font-weight:600;text-decoration:none;display:flex;align-items:center;gap:6px;">👷 Find Providers →</a>
          </div>
        </div>
      </div>

      <!-- Topic Guide -->
      <div>
        <h2 style="font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:var(--text);margin-bottom:24px;">Common Enquiries</h2>

        {[
          { icon: '👷', q: 'I want to list my business', a: 'Use our free "Join as Provider" form. We review all applications within 1–2 business days and contact you on WhatsApp.' },
          { icon: '📋', q: 'I want to post a project', a: 'Use the "Post a Project" page — no login required. Describe your project and verified tilers will contact you directly.' },
          { icon: '🏷️', q: 'Tile brand partnership', a: 'Email us at Tilershub@gmail.com or WhatsApp us. We offer featured brand listings and sponsored placement.' },
          { icon: '❌', q: 'Remove my listing', a: 'WhatsApp or email us with your business name and we will remove your listing within 24 hours.' },
          { icon: '🐛', q: 'Report a problem', a: 'Contact us on WhatsApp with a screenshot and a description of the issue. We investigate all reports.' },
        ].map(item => (
          <div style="padding:16px;background:#fff;border:1px solid var(--border);border-radius:14px;margin-bottom:12px;">
            <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:6px;display:flex;align-items:center;gap:8px;">{item.icon} {item.q}</div>
            <p style="font-size:13px;color:var(--text-3);line-height:1.7;margin:0;">{item.a}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <style>
    .contact-grid {
      max-width: 900px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: start;
    }
    .contact-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
      background: #fff;
      border: 1.5px solid var(--border);
      border-radius: 16px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.2s, transform 0.2s;
    }
    .contact-card:hover {
      border-color: var(--navy);
      transform: translateY(-2px);
    }
    @media (max-width: 640px) {
      .contact-grid { grid-template-columns: 1fr; }
    }
  </style>

</Layout>
