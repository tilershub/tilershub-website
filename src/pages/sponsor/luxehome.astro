---
import Layout from '../../layouts/Layout.astro'

const PACKAGES = [
  {
    name: 'Essential',
    price: 'Rs. 45,000',
    coverage: '25 sqft',
    accent: '#C9952A',
    items: [
      'Floor tiles (25 sqft)',
      'Wall tiles (standard finish)',
      'Grout & adhesive included',
      'Basic anti-slip floor',
    ],
  },
  {
    name: 'Complete',
    price: 'Rs. 75,000',
    coverage: '40 sqft',
    accent: '#D4AF37',
    featured: true,
    items: [
      'Premium floor + wall set (40 sqft)',
      'Matched wall & floor design',
      'Anti-slip certified flooring',
      'Waterproof grout included',
      'Free 3D layout preview',
    ],
  },
  {
    name: 'Luxury',
    price: 'Rs. 120,000',
    coverage: '60 sqft',
    accent: '#E8C84A',
    items: [
      'Italian marble-finish tiles (60 sqft)',
      'Designer wall + floor full set',
      'Premium anti-slip flooring',
      'Waterproof grout + adhesive',
      '3D design consultation',
      'Free islandwide delivery',
    ],
  },
]

const FEATURES = [
  { icon: '💧', title: 'Anti-Slip Certified', desc: 'All bathroom floor tiles meet Sri Lankan safety standards for wet area use.' },
  { icon: '🛡️', title: '5-Year Warranty', desc: 'Every tile package comes with a 5-year quality guarantee from LUXEhome.' },
  { icon: '🚚', title: 'Free Delivery', desc: 'Complimentary islandwide delivery on all orders above Rs. 50,000.' },
  { icon: '🎨', title: '3D Design Session', desc: 'Free in-home consultation and 3D tile layout planning with our design team.' },
]
---

<Layout title="LUXEhome Bathroom Renovation · TilersHub Sponsor">

  <!-- ═══ HERO ═══ -->
  <section style="background: linear-gradient(135deg, #0c0804 0%, #1a1008 60%, #0c0804 100%); position: relative; overflow: hidden; padding: 80px 28px 72px; text-align: center;">
    <!-- Grid texture -->
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(212,175,55,0.8) 39px, rgba(212,175,55,0.8) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(212,175,55,0.8) 39px, rgba(212,175,55,0.8) 40px); pointer-events: none;"></div>
    <!-- Glow -->
    <div style="position: absolute; top: -80px; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(212,175,55,0.12) 0%, transparent 70%); pointer-events: none;"></div>
    <div style="position: absolute; bottom: -60px; right: -80px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(212,175,55,0.08) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="position: relative; max-width: 680px; margin: 0 auto;">
      <!-- Back link -->
      <a href="/" style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: rgba(212,175,55,0.5); letter-spacing: 1px; text-transform: uppercase; font-weight: 600; margin-bottom: 32px; text-decoration: none;">
        ← TilersHub.lk
      </a>

      <!-- Sponsor tag -->
      <div style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.6); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 18px;">
        ◆ Sponsored Partner
      </div>

      <!-- Brand -->
      <div style="display: flex; align-items: baseline; gap: 3px; justify-content: center; margin-bottom: 16px;">
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 700; color: #D4AF37; letter-spacing: -1px; line-height: 1;">LUXE</span>
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 400; color: rgba(255,255,255,0.88); letter-spacing: -1px; line-height: 1;">home</span>
      </div>

      <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(28px, 5vw, 48px); font-weight: 700; color: #D4AF37; margin-bottom: 16px; line-height: 1.15;">
        Bathroom Renovation
      </h1>

      <p style="font-size: 15px; color: rgba(255,255,255,0.5); line-height: 1.9; max-width: 500px; margin: 0 auto 40px;">
        Complete premium tile packages for your dream bathroom. Anti-slip certified, waterproof grout included, with free islandwide delivery on orders above Rs. 50,000.
      </p>

      <a
        href="https://luxehome.lk"
        target="_blank"
        rel="noopener noreferrer"
        style="display: inline-flex; align-items: center; gap: 10px; background: #D4AF37; color: #0c0804; border-radius: 12px; padding: 15px 36px; font-size: 14px; font-weight: 800; text-decoration: none; letter-spacing: 0.5px; box-shadow: 0 6px 28px rgba(212,175,55,0.35); margin-bottom: 16px;"
      >
        🛒 Visit LUXEhome.lk
      </a>
      <div style="font-size: 11px; color: rgba(255,255,255,0.25); margin-top: 10px;">You will be redirected to luxehome.lk</div>
    </div>
  </section>

  <!-- ═══ PACKAGES ═══ -->
  <section style="background: var(--cream); padding: 88px 28px;">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 60px;">
        <span class="section-tag">ගෙදර සඳහා</span>
        <h2 class="section-title">Bathroom Tile Packages</h2>
        <p class="section-sub" style="margin: 0 auto;">Choose a package that fits your bathroom size and budget</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; align-items: start;">
        {PACKAGES.map(pkg => (
          <div
            class="card"
            style={`border-top: 3px solid ${pkg.accent}; position: relative; ${pkg.featured ? 'box-shadow: 0 12px 48px rgba(212,175,55,0.18);' : ''}`}
          >
            {pkg.featured && (
              <div style={`position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: ${pkg.accent}; color: #0c0804; font-size: 10px; font-weight: 800; padding: 3px 16px; border-radius: 20px; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap;`}>
                Most Popular
              </div>
            )}
            <div style="padding: 32px 28px 28px;">
              <div style={`font-size: 11px; font-weight: 700; color: ${pkg.accent}; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px;`}>{pkg.name}</div>
              <div style="font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: var(--charcoal); margin-bottom: 4px; line-height: 1;">{pkg.price}</div>
              <div style="font-size: 12px; color: var(--text-light); margin-bottom: 24px;">Coverage: {pkg.coverage}</div>
              <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px;">
                {pkg.items.map(item => (
                  <div style={`display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: var(--text-mid);`}>
                    <span style={`color: ${pkg.accent}; font-weight: 700; font-size: 12px; flex-shrink: 0; margin-top: 1px;`}>✓</span>
                    {item}
                  </div>
                ))}
              </div>
              <a
                href="https://luxehome.lk"
                target="_blank"
                rel="noopener noreferrer"
                style={`display: flex; align-items: center; justify-content: center; gap: 8px; background: ${pkg.featured ? pkg.accent : 'transparent'}; color: ${pkg.featured ? '#0c0804' : pkg.accent}; border: 2px solid ${pkg.accent}; border-radius: 10px; padding: 12px 20px; font-size: 13px; font-weight: 700; text-decoration: none; transition: all 0.2s;`}
              >
                Order Package →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURES ═══ -->
  <section style="background: var(--white); padding: 80px 28px; border-top: 1px solid var(--cream-dark);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 56px;">
        <span class="section-tag">Why LUXEhome</span>
        <h2 class="section-title">Quality You Can Trust</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 28px;">
        {FEATURES.map(f => (
          <div style="text-align: center; padding: 36px 24px;">
            <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #1a1209, #2d1e08); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 20px; box-shadow: 0 6px 20px rgba(0,0,0,0.15);">{f.icon}</div>
            <h3 style="font-size: 16px; font-weight: 700; color: var(--charcoal); margin-bottom: 10px;">{f.title}</h3>
            <p style="font-size: 13px; color: var(--text-mid); line-height: 1.8;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section style="background: linear-gradient(135deg, #0c0804 0%, #1a1008 100%); padding: 88px 28px; text-align: center; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(212,175,55,0.6) 20px, rgba(212,175,55,0.6) 21px); pointer-events: none;"></div>
    <div style="position: relative; max-width: 560px; margin: 0 auto;">
      <div style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 38px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px; line-height: 1.2;">
        Ready to transform your <span style="color: #D4AF37;">bathroom?</span>
      </div>
      <p style="font-size: 14px; color: rgba(255,255,255,0.42); margin-bottom: 36px; line-height: 1.9;">
        Visit luxehome.lk to browse the full collection, request samples, and book your free design consultation.
      </p>
      <a
        href="https://luxehome.lk"
        target="_blank"
        rel="noopener noreferrer"
        style="display: inline-flex; align-items: center; gap: 10px; background: #D4AF37; color: #0c0804; border-radius: 12px; padding: 16px 40px; font-size: 15px; font-weight: 800; text-decoration: none; box-shadow: 0 6px 28px rgba(212,175,55,0.35); letter-spacing: 0.3px;"
      >
        🌐 Visit luxehome.lk →
      </a>
      <div style="margin-top: 24px; font-size: 11px; color: rgba(255,255,255,0.2);">
        This is a sponsored page on TilersHub.lk
      </div>
    </div>
  </section>

</Layout>
