---
import Layout from '../../layouts/Layout.astro'

const PROCESS = [
  { step: '01', icon: '📐', title: 'Free Site Visit & Design', desc: 'Our team visits your home, measures the space, discusses your vision and produces a 3D bathroom layout — completely free, no obligation.' },
  { step: '02', icon: '🔨', title: 'Demolition & Preparation', desc: 'We handle full strip-out, site protection, floor screeding and surface levelling so every tile goes on a perfect base.' },
  { step: '03', icon: '💧', title: 'Waterproofing & Tiling', desc: 'Professional waterproofing membrane applied to all wet areas before precision tile laying — wall and floor, any pattern.' },
  { step: '04', icon: '🚿', title: 'Fixtures & Final Handover', desc: 'Sanitary ware, shower enclosures, faucets, vanities and accessories fitted and tested. Keys handed back on schedule.' },
]

const FEATURES = [
  { icon: '🏗️', title: 'End-to-End Service', desc: 'One team handles design, demolition, waterproofing, tiling, plumbing and fitting. No sub-contracting.' },
  { icon: '💧', title: 'Certified Waterproofing', desc: 'Every bathroom gets a professional-grade waterproofing membrane before tiling — the right way, every time.' },
  { icon: '🛡️', title: '2-Year Warranty', desc: 'Full workmanship warranty on every completed bathroom renovation. We stand behind our work.' },
  { icon: '📞', title: 'Free Site Visit', desc: 'No-obligation consultation, measurements and written quote — we come to you, islandwide.' },
  { icon: '📅', title: 'On-Time Completion', desc: 'Agreed timelines are commitments. We coordinate every trade so your project finishes on schedule.' },
  { icon: '🎨', title: 'Design Included', desc: 'Full 3D bathroom design and tile selection guidance included with every project at no extra cost.' },
]

const PACKAGES = [
  {
    name: 'Essential Bathroom',
    size: 'Up to 60 sq.ft',
    desc: 'Ideal for en-suite or secondary bathrooms. Full strip-out, waterproofing, wall & floor tiling, sanitary ware installation.',
    accent: '#C9952A',
    features: ['Demolition & prep','Waterproofing membrane','Wall & floor tiling','WC, basin & mixer','Grouting & sealing'],
  },
  {
    name: 'Premium Bathroom',
    size: 'Up to 100 sq.ft',
    desc: 'Master bathroom with shower enclosure, bath or walk-in shower, premium fittings and bespoke tile layout.',
    accent: '#D4AF37',
    featured: true,
    features: ['Everything in Essential','Shower enclosure or bathtub','Premium faucets & fittings','Custom tile pattern','3D design included'],
  },
  {
    name: 'Full Renovation',
    size: 'Any size',
    desc: 'Complete gut-and-rebuild for any bathroom size. Structural changes, full plumbing, electrical and tiling — turnkey handover.',
    accent: '#A07010',
    features: ['Full structural capability','Plumbing & electrical coordination','Any tile format & pattern','Vanity & storage units','Project management'],
  },
]
---

<Layout title="LUXEhome Bathroom Construction & Renovation · TilersHub Sponsor" description="Sri Lanka's premium bathroom construction and renovation company. Full service from design to handover — tiling, waterproofing, fixtures and fitting.">

  <!-- ═══ HERO ═══ -->
  <section style="background: linear-gradient(135deg, #0c0804 0%, #1a1008 60%, #0c0804 100%); position: relative; overflow: hidden; padding: 80px 28px 72px; text-align: center;">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(212,175,55,0.8) 39px, rgba(212,175,55,0.8) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(212,175,55,0.8) 39px, rgba(212,175,55,0.8) 40px); pointer-events: none;"></div>
    <div style="position: absolute; top: -80px; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(212,175,55,0.12) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="position: relative; max-width: 680px; margin: 0 auto;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: rgba(212,175,55,0.5); letter-spacing: 1px; text-transform: uppercase; font-weight: 600; margin-bottom: 32px; text-decoration: none;">← TilersHub.lk</a>
      <div style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.6); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 18px;">◆ Premium Sponsored Partner</div>
      <div style="display: flex; align-items: baseline; gap: 3px; justify-content: center; margin-bottom: 20px;">
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 700; color: #D4AF37; letter-spacing: -1px; line-height: 1;">LUXE</span>
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 400; color: rgba(255,255,255,0.88); letter-spacing: -1px; line-height: 1;">home</span>
      </div>
      <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(22px, 4vw, 36px); font-weight: 700; color: rgba(255,255,255,0.9); margin-bottom: 8px; line-height: 1.2;">
        Bathroom <span style="color: #D4AF37;">Construction</span> &amp; <span style="color: #D4AF37;">Renovation</span>
      </h1>
      <p style="font-size: 15px; color: rgba(255,255,255,0.45); line-height: 1.9; max-width: 500px; margin: 0 auto 16px;">
        Sri Lanka's premium bathroom renovation company. We design, build and hand over complete bathrooms — tiling, waterproofing, fixtures and fitting. One team, full service.
      </p>
      <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: 40px;">
        <span style="font-size: 11px; padding: 4px 12px; border-radius: 20px; background: rgba(212,175,55,0.1); color: rgba(212,175,55,0.75); border: 1px solid rgba(212,175,55,0.2);">🚿 Bathroom Renovation</span>
        <span style="font-size: 11px; padding: 4px 12px; border-radius: 20px; background: rgba(212,175,55,0.1); color: rgba(212,175,55,0.75); border: 1px solid rgba(212,175,55,0.2);">💧 Certified Waterproofing</span>
        <span style="font-size: 11px; padding: 4px 12px; border-radius: 20px; background: rgba(212,175,55,0.1); color: rgba(212,175,55,0.75); border: 1px solid rgba(212,175,55,0.2);">🏗️ Full Construction</span>
        <span style="font-size: 11px; padding: 4px 12px; border-radius: 20px; background: rgba(212,175,55,0.1); color: rgba(212,175,55,0.75); border: 1px solid rgba(212,175,55,0.2);">🛡️ 2-Year Warranty</span>
      </div>
      <a href="https://wa.me/94774503744?text=Hi%20LUXEhome%2C%20I%20found%20you%20on%20TilersHub.%20I%27d%20like%20a%20free%20site%20visit%20for%20a%20bathroom%20renovation." target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #D4AF37; color: #0c0804; border-radius: 12px; padding: 15px 36px; font-size: 14px; font-weight: 800; text-decoration: none; letter-spacing: 0.5px; box-shadow: 0 6px 28px rgba(212,175,55,0.35);">
        💬 Book Free Site Visit
      </a>
      <div style="font-size: 11px; color: rgba(255,255,255,0.22); margin-top: 14px;">No obligation · Islandwide · Reply within 24 hrs</div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section style="background: #0e0b06; padding: 88px 28px; border-top: 1px solid rgba(212,175,55,0.08);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 64px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Our Process</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 38px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 12px;">
          From Empty Room to <span style="color: #D4AF37;">Dream Bathroom</span>
        </h2>
        <p style="font-size: 14px; color: rgba(255,255,255,0.35); max-width: 460px; margin: 0 auto; line-height: 1.8;">Four clear stages — we manage every step so you don't have to.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 22px;">
        {PROCESS.map(p => (
          <div style="background: rgba(255,255,255,0.02); border-radius: 18px; border: 1px solid rgba(212,175,55,0.1); padding: 32px 26px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 16px; right: 20px; font-size: 36px; font-weight: 800; color: rgba(212,175,55,0.06); font-family: 'Playfair Display', serif; line-height: 1;">{p.step}</div>
            <div style="width: 52px; height: 52px; background: linear-gradient(135deg, #1a1209, #2d1e08); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 20px; border: 1px solid rgba(212,175,55,0.15);">{p.icon}</div>
            <h3 style="font-size: 16px; font-weight: 700; color: #D4AF37; margin-bottom: 10px;">{p.title}</h3>
            <p style="font-size: 13px; color: rgba(255,255,255,0.4); line-height: 1.8;">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PACKAGES ═══ -->
  <section style="background: #0c0804; padding: 88px 28px; border-top: 1px solid rgba(212,175,55,0.07);">
    <div style="max-width: 960px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 56px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Renovation Packages</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 36px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 12px;">Every Budget. Every Size.</h2>
        <p style="font-size: 14px; color: rgba(255,255,255,0.35); max-width: 420px; margin: 0 auto; line-height: 1.8;">All packages include project management, material sourcing and a 2-year workmanship warranty.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
        {PACKAGES.map(pkg => (
          <div style={`background: rgba(255,255,255,0.02); border-radius: 18px; border: ${pkg.featured ? `2px solid ${pkg.accent}` : '1px solid rgba(212,175,55,0.1)'}; padding: 32px 26px; position: relative; overflow: hidden;`}>
            {pkg.featured && <div style={`position: absolute; top: 0; right: 0; background: ${pkg.accent}; color: #0c0804; font-size: 9px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; padding: 4px 14px; border-bottom-left-radius: 12px;`}>Most Popular</div>}
            <div style={`font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: ${pkg.accent}; margin-bottom: 4px;`}>{pkg.name}</div>
            <div style="font-size: 11px; color: rgba(255,255,255,0.3); margin-bottom: 14px; font-weight: 600;">{pkg.size}</div>
            <p style="font-size: 13px; color: rgba(255,255,255,0.4); line-height: 1.75; margin-bottom: 20px;">{pkg.desc}</p>
            <ul style="list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 8px;">
              {pkg.features.map(f => (
                <li style={`font-size: 12px; color: rgba(255,255,255,0.55); display: flex; align-items: center; gap: 8px;`}>
                  <span style={`color: ${pkg.accent}; font-size: 13px;`}>✓</span> {f}
                </li>
              ))}
            </ul>
            <a href="https://wa.me/94774503744?text=Hi%20LUXEhome%2C%20I%20found%20you%20on%20TilersHub.%20I%27m%20interested%20in%20the%20{pkg.name}%20package.%20Can%20we%20book%20a%20site%20visit%3F" target="_blank" rel="noopener noreferrer"
              style={`display: flex; align-items: center; justify-content: center; gap: 7px; background: ${pkg.featured ? pkg.accent : 'rgba(255,255,255,0.05)'}; color: ${pkg.featured ? '#0c0804' : pkg.accent}; border-radius: 10px; padding: 11px 20px; font-size: 13px; font-weight: 700; text-decoration: none; border: 1px solid ${pkg.featured ? 'transparent' : pkg.accent + '40'};`}>
              💬 Get Free Quote
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHY LUXEHOME ═══ -->
  <section style="background: #0e0b06; padding: 88px 28px; border-top: 1px solid rgba(212,175,55,0.07);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 56px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Why LUXEhome</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 36px); color: rgba(255,255,255,0.9); font-weight: 700;">Built Different.</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        {FEATURES.map(f => (
          <div style="display: flex; gap: 18px; padding: 24px; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(212,175,55,0.08);">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #1a1209, #2d1e08); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; border: 1px solid rgba(212,175,55,0.15);">{f.icon}</div>
            <div>
              <h3 style="font-size: 14px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 6px;">{f.title}</h3>
              <p style="font-size: 12px; color: rgba(255,255,255,0.38); line-height: 1.75;">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section style="background: linear-gradient(135deg, #140d04 0%, #0c0804 100%); padding: 88px 28px; text-align: center; position: relative; overflow: hidden; border-top: 1px solid rgba(212,175,55,0.1);">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(212,175,55,0.6) 20px, rgba(212,175,55,0.6) 21px); pointer-events: none;"></div>
    <div style="position: relative; max-width: 560px; margin: 0 auto;">
      <div style="font-family: 'Playfair Display', serif; font-size: clamp(26px, 4vw, 42px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px; line-height: 1.2;">
        Ready for your new <span style="color: #D4AF37;">bathroom?</span>
      </div>
      <p style="font-size: 14px; color: rgba(255,255,255,0.42); margin-bottom: 36px; line-height: 1.9;">
        Book a free, no-obligation site visit. We'll measure up, discuss your ideas and send you a full written quote within 48 hours.
      </p>
      <a href="https://wa.me/94774503744?text=Hi%20LUXEhome%2C%20I%20found%20you%20on%20TilersHub.%20I%27d%20like%20a%20free%20site%20visit%20for%20a%20bathroom%20renovation." target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #D4AF37; color: #0c0804; border-radius: 12px; padding: 16px 40px; font-size: 15px; font-weight: 800; text-decoration: none; box-shadow: 0 6px 28px rgba(212,175,55,0.35); letter-spacing: 0.3px;">
        💬 WhatsApp LUXEhome →
      </a>
      <div style="margin-top: 16px; font-size: 12px; color: rgba(212,175,55,0.4);">📞 +94 77 450 3744 · Islandwide</div>
      <div style="margin-top: 24px; font-size: 11px; color: rgba(255,255,255,0.15);">This is a sponsored page on TilersHub.lk</div>
    </div>
  </section>

</Layout>
