---
import Layout from '../../layouts/Layout.astro'

const MOSAIC = [
  { col: '1 / 3', row: '1 / 2' },
  { col: '3 / 4', row: '1 / 2' },
  { col: '4 / 5', row: '1 / 3' },
  { col: '1 / 2', row: '2 / 4' },
  { col: '2 / 4', row: '2 / 3' },
  { col: '2 / 3', row: '3 / 4' },
  { col: '3 / 5', row: '3 / 4' },
]

const COLLECTIONS = [
  {
    name: 'Carrara White',
    mood: 'Timeless marble elegance for spa-like calm',
    accent: '#D0CCC6',
    tiles: ['#F5F3F0','#E8E5E0','#D0CCC6','#CCCAC4','#E0DDD8','#B8B5AE','#F8F6F2'],
  },
  {
    name: 'Arabian Gold',
    mood: 'Warm luxury with rich golden warmth',
    accent: '#D4AF37',
    tiles: ['#D4AF37','#C9952A','#F0D070','#B8870A','#E8C860','#A07010','#F8E090'],
  },
  {
    name: 'Aegean Spa',
    mood: 'Cool oceanic blues for a resort feel',
    accent: '#5BC4D8',
    tiles: ['#5BC4D8','#3AAAC0','#7AD8E8','#2090A8','#90D0E0','#1878A0','#A8E4F0'],
  },
  {
    name: 'Terra Blush',
    mood: 'Earthy warmth with Mediterranean soul',
    accent: '#D4784A',
    tiles: ['#C1603A','#D4784A','#E09070','#B05028','#F0A880','#903020','#E88060'],
  },
  {
    name: 'Matte Noir',
    mood: 'Bold contemporary black for dramatic spaces',
    accent: '#888888',
    tiles: ['#2A2A2A','#3A3A3A','#1A1A1A','#444444','#222222','#555555','#333333'],
  },
  {
    name: 'Nordic Stone',
    mood: 'Soft natural tones inspired by Scandinavian light',
    accent: '#C8C0B4',
    tiles: ['#E8E4DC','#D8D2C8','#F0ECE4','#C8C0B4','#E0D8CC','#B8B0A4','#F8F4EC'],
  },
]

const FEATURES = [
  { icon: '💧', title: 'Anti-Slip Certified', desc: 'All bathroom floor tiles meet Sri Lankan safety standards for wet area use.' },
  { icon: '🛡️', title: '5-Year Warranty', desc: 'Every tile comes with a 5-year quality guarantee from LUXEhome.' },
  { icon: '🚚', title: 'Free Delivery', desc: 'Complimentary islandwide delivery on all orders above Rs. 50,000.' },
  { icon: '🎨', title: '3D Design Session', desc: 'Free in-home consultation and 3D tile layout planning with our design team.' },
]
---

<Layout title="LUXEhome Bathroom Renovation · TilersHub Sponsor">

  <!-- ═══ HERO ═══ -->
  <section style="background: linear-gradient(135deg, #0c0804 0%, #1a1008 60%, #0c0804 100%); position: relative; overflow: hidden; padding: 80px 28px 72px; text-align: center;">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(212,175,55,0.8) 39px, rgba(212,175,55,0.8) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(212,175,55,0.8) 39px, rgba(212,175,55,0.8) 40px); pointer-events: none;"></div>
    <div style="position: absolute; top: -80px; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(212,175,55,0.12) 0%, transparent 70%); pointer-events: none;"></div>
    <div style="position: absolute; bottom: -60px; right: -80px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(212,175,55,0.08) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="position: relative; max-width: 680px; margin: 0 auto;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: rgba(212,175,55,0.5); letter-spacing: 1px; text-transform: uppercase; font-weight: 600; margin-bottom: 32px; text-decoration: none;">← TilersHub.lk</a>
      <div style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.6); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 18px;">◆ Sponsored Partner</div>
      <div style="display: flex; align-items: baseline; gap: 3px; justify-content: center; margin-bottom: 16px;">
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 700; color: #D4AF37; letter-spacing: -1px; line-height: 1;">LUXE</span>
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 400; color: rgba(255,255,255,0.88); letter-spacing: -1px; line-height: 1;">home</span>
      </div>
      <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(28px, 5vw, 48px); font-weight: 700; color: #D4AF37; margin-bottom: 16px; line-height: 1.15;">Bathroom Renovation</h1>
      <p style="font-size: 15px; color: rgba(255,255,255,0.5); line-height: 1.9; max-width: 500px; margin: 0 auto 40px;">
        Premium tile collections crafted for Sri Lankan bathrooms. Anti-slip certified, waterproof, and beautifully designed.
      </p>
      <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #D4AF37; color: #0c0804; border-radius: 12px; padding: 15px 36px; font-size: 14px; font-weight: 800; text-decoration: none; letter-spacing: 0.5px; box-shadow: 0 6px 28px rgba(212,175,55,0.35);">
        🛒 Visit LUXEhome.lk
      </a>
      <div style="font-size: 11px; color: rgba(255,255,255,0.25); margin-top: 14px;">You will be redirected to luxehome.lk</div>
    </div>
  </section>

  <!-- ═══ DESIGN SHOWCASE ═══ -->
  <section style="background: #0c0804; padding: 88px 28px;">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 64px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Curated for You</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(26px, 4vw, 40px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px;">Bathroom Collections</h2>
        <p style="font-size: 14px; color: rgba(255,255,255,0.38); max-width: 460px; margin: 0 auto; line-height: 1.8;">Six distinct styles to find the look that speaks to you</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px;">
        {COLLECTIONS.map(col => (
          <div style="background: linear-gradient(160deg, #1a1209, #0e0c08); border-radius: 18px; overflow: hidden; border: 1px solid rgba(212,175,55,0.1); transition: transform 0.2s, box-shadow 0.2s;">
            <!-- Tile mosaic -->
            <div style="padding: 18px 18px 12px; background: rgba(255,255,255,0.01);">
              <div style="display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 1fr); gap: 5px; height: 170px;">
                {MOSAIC.map((pos, i) => (
                  <div style={`grid-column: ${pos.col}; grid-row: ${pos.row}; background: linear-gradient(135deg, ${col.tiles[i]}, ${col.tiles[(i + 3) % 7]}); border-radius: 7px; box-shadow: 0 3px 10px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.12); position: relative; overflow: hidden;`}>
                    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.18) 0%, transparent 55%);"></div>
                  </div>
                ))}
              </div>
            </div>
            <!-- Info -->
            <div style="padding: 18px 22px 24px;">
              <div style={`font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: ${col.accent}; margin-bottom: 6px;`}>{col.name}</div>
              <p style="font-size: 12px; color: rgba(255,255,255,0.4); line-height: 1.7; margin-bottom: 18px;">{col.mood}</p>
              <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style={`display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: ${col.accent}; text-decoration: none; letter-spacing: 0.5px; opacity: 0.85;`}>
                View Collection →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURES ═══ -->
  <section style="background: #0c0804; padding: 0 28px 88px; border-top: 1px solid rgba(212,175,55,0.07);">
    <div style="max-width: 1100px; margin: 0 auto; padding-top: 80px;">
      <div style="text-align: center; margin-bottom: 56px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(212,175,55,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Why LUXEhome</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 36px); color: rgba(255,255,255,0.9); font-weight: 700;">Quality You Can Trust</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 28px;">
        {FEATURES.map(f => (
          <div style="text-align: center; padding: 36px 24px; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(212,175,55,0.08);">
            <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #1a1209, #2d1e08); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 20px; box-shadow: 0 6px 20px rgba(0,0,0,0.3); border: 1px solid rgba(212,175,55,0.15);">{f.icon}</div>
            <h3 style="font-size: 15px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 10px;">{f.title}</h3>
            <p style="font-size: 13px; color: rgba(255,255,255,0.38); line-height: 1.8;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section style="background: linear-gradient(135deg, #140d04 0%, #0c0804 100%); padding: 88px 28px; text-align: center; position: relative; overflow: hidden; border-top: 1px solid rgba(212,175,55,0.1);">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(212,175,55,0.6) 20px, rgba(212,175,55,0.6) 21px); pointer-events: none;"></div>
    <div style="position: relative; max-width: 560px; margin: 0 auto;">
      <div style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 38px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px; line-height: 1.2;">
        Ready to transform your <span style="color: #D4AF37;">bathroom?</span>
      </div>
      <p style="font-size: 14px; color: rgba(255,255,255,0.42); margin-bottom: 36px; line-height: 1.9;">Browse the full collection, request samples, and book your free design consultation at luxehome.lk</p>
      <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #D4AF37; color: #0c0804; border-radius: 12px; padding: 16px 40px; font-size: 15px; font-weight: 800; text-decoration: none; box-shadow: 0 6px 28px rgba(212,175,55,0.35); letter-spacing: 0.3px;">
        🌐 Visit luxehome.lk →
      </a>
      <div style="margin-top: 24px; font-size: 11px; color: rgba(255,255,255,0.18);">This is a sponsored page on TilersHub.lk</div>
    </div>
  </section>

</Layout>
