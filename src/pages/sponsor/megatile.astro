---
import Layout from '../../layouts/Layout.astro'

const COLLECTIONS = [
  {
    name: 'Slate Stone',
    mood: 'Raw natural texture for bold indoor-outdoor spaces',
    accent: '#8B7355',
    tiles: ['#5A5048','#6E6055','#7A6E62','#4A4038','#8A7E72','#3E3530','#9A9088'],
  },
  {
    name: 'Ivory Pearl',
    mood: 'Warm off-white elegance with subtle grain',
    accent: '#C9B89A',
    tiles: ['#EDE0CC','#DDD0B8','#F0E4D0','#CFC0A8','#E4D8C0','#BFB098','#F4EAD8'],
  },
  {
    name: 'Charcoal Matte',
    mood: 'Contemporary dark finish for modern interiors',
    accent: '#6E7278',
    tiles: ['#3A3D42','#4A4D52','#2C2F34','#545860','#3E4248','#606468','#282A2E'],
  },
  {
    name: 'Terracotta Earth',
    mood: 'Warm rustic tones inspired by Sri Lankan soil',
    accent: '#C0784A',
    tiles: ['#B86840','#C87850','#D09060','#A85830','#C88060','#984820','#D8A070'],
  },
  {
    name: 'Concrete Grey',
    mood: 'Industrial-chic surfaces for minimalist design',
    accent: '#9AA0A8',
    tiles: ['#A0A8B0','#909AA2','#B0B8C0','#808890','#98A0A8','#787E86','#C0C8D0'],
  },
  {
    name: 'Marble White',
    mood: 'Classic veined marble look at accessible price',
    accent: '#D0CCCA',
    tiles: ['#F2EEE8','#E8E2DC','#EDE8E2','#DDD8D0','#F8F4EE','#D0CAC4','#FEFAF6'],
  },
]

const FEATURES = [
  { icon: '📐', title: 'Large Format Options', desc: 'Up to 1200×2400mm slabs for seamless, grout-minimal contemporary floors and walls.' },
  { icon: '💪', title: 'Heavy-Duty Grade', desc: 'Slip-resistant, frost-proof tiles rated for heavy commercial and residential traffic.' },
  { icon: '🌿', title: 'Eco Manufacturing', desc: 'Produced with energy-efficient kilns and recyclable packaging to reduce environmental impact.' },
  { icon: '🏗️', title: 'Technical Support', desc: 'In-house technical advisors to help specify the right tile for every application.' },
]

const MOSAIC = [
  { col: '1 / 3', row: '1 / 2' },
  { col: '3 / 4', row: '1 / 2' },
  { col: '4 / 5', row: '1 / 3' },
  { col: '1 / 2', row: '2 / 4' },
  { col: '2 / 4', row: '2 / 3' },
  { col: '2 / 3', row: '3 / 4' },
  { col: '3 / 5', row: '3 / 4' },
]
---

<Layout title="Megatile Sri Lanka · TilersHub Sponsor" description="Discover Megatile's premium tile collections in Sri Lanka — large-format floor tiles, wall tiles, and natural stone finishes.">

  <!-- ═══ HERO ═══ -->
  <section style="background: linear-gradient(135deg, #0d0b08 0%, #1a1610 60%, #0d0b08 100%); position: relative; overflow: hidden; padding: 80px 28px 72px; text-align: center;">
    <div style="position: absolute; inset: 0; opacity: 0.04; background-image: repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(192,168,120,0.6) 59px, rgba(192,168,120,0.6) 60px), repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(192,168,120,0.6) 59px, rgba(192,168,120,0.6) 60px); pointer-events: none;"></div>
    <div style="position: absolute; top: -80px; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(192,168,120,0.1) 0%, transparent 70%); pointer-events: none;"></div>
    <div style="position: absolute; bottom: -60px; right: -80px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(139,115,85,0.1) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="position: relative; max-width: 680px; margin: 0 auto;">
      <a href="/brands" style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: rgba(192,168,120,0.5); letter-spacing: 1px; text-transform: uppercase; font-weight: 600; margin-bottom: 32px; text-decoration: none;">← TilersHub Brands</a>
      <div style="font-size: 9px; font-weight: 700; color: rgba(192,168,120,0.6); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 18px;">◆ Sponsored Partner</div>
      <div style="margin-bottom: 16px;">
        <span style="font-family: var(--th-display); font-size: 56px; font-weight: 700; color: #C0A878; letter-spacing: -2px; line-height: 1;">MEGA</span><span style="font-family: var(--th-display); font-size: 56px; font-weight: 400; color: rgba(255,255,255,0.85); letter-spacing: -2px; line-height: 1;">tile</span>
      </div>
      <h1 style="font-family: var(--th-display); font-size: clamp(22px, 4vw, 36px); font-weight: 700; color: rgba(255,255,255,0.9); margin-bottom: 16px; line-height: 1.2;">Premium Tiles for Every Space</h1>
      <p style="font-size: 15px; color: rgba(255,255,255,0.45); line-height: 1.9; max-width: 500px; margin: 0 auto 40px;">
        Large-format slabs, natural stone finishes and heavy-duty floor tiles — built for Sri Lanka's climate and designed for lasting beauty.
      </p>
      <a href="https://wa.me/94774503744?text=Hi%2C%20I%27d%20like%20to%20know%20more%20about%20Megatile%20products" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #C0A878; color: #0d0b08; border-radius: 12px; padding: 15px 36px; font-size: 14px; font-weight: 800; text-decoration: none; letter-spacing: 0.5px; box-shadow: 0 6px 28px rgba(192,168,120,0.3);">
        💬 Enquire on WhatsApp
      </a>
      <div style="font-size: 11px; color: rgba(255,255,255,0.22); margin-top: 14px;">Get a quote or find a local dealer via WhatsApp</div>
    </div>
  </section>

  <!-- ═══ COLLECTIONS ═══ -->
  <section style="background: #0d0b08; padding: 88px 28px;">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 64px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(192,168,120,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Surface Collections</div>
        <h2 style="font-family: var(--th-display); font-size: clamp(26px, 4vw, 40px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px;">Tile Collections</h2>
        <p style="font-size: 14px; color: rgba(255,255,255,0.35); max-width: 460px; margin: 0 auto; line-height: 1.8;">Six signature finishes from natural stone to contemporary matte</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px;">
        {COLLECTIONS.map(col => (
          <div style="background: linear-gradient(160deg, #1c1810, #100e0a); border-radius: 18px; overflow: hidden; border: 1px solid rgba(192,168,120,0.1);">
            <div style="padding: 18px 18px 12px;">
              <div style="display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 1fr); gap: 5px; height: 170px;">
                {MOSAIC.map((pos, i) => (
                  <div style={`grid-column: ${pos.col}; grid-row: ${pos.row}; background: linear-gradient(135deg, ${col.tiles[i]}, ${col.tiles[(i + 3) % 7]}); border-radius: 7px; box-shadow: 0 3px 10px rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.08); position: relative; overflow: hidden;`}>
                    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 55%);"></div>
                  </div>
                ))}
              </div>
            </div>
            <div style="padding: 18px 22px 24px;">
              <div style={`font-family: var(--th-display); font-size: 19px; font-weight: 700; color: ${col.accent}; margin-bottom: 6px;`}>{col.name}</div>
              <p style="font-size: 12px; color: rgba(255,255,255,0.38); line-height: 1.7; margin-bottom: 16px;">{col.mood}</p>
              <a href="https://wa.me/94774503744?text=Hi%2C%20I%27d%20like%20to%20enquire%20about%20Megatile%20tiles" target="_blank" rel="noopener noreferrer" style={`display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: ${col.accent}; text-decoration: none; letter-spacing: 0.5px; opacity: 0.85;`}>
                Enquire →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURES ═══ -->
  <section style="background: #0d0b08; padding: 0 28px 88px; border-top: 1px solid rgba(192,168,120,0.07);">
    <div style="max-width: 1100px; margin: 0 auto; padding-top: 80px;">
      <div style="text-align: center; margin-bottom: 56px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(192,168,120,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Why Megatile</div>
        <h2 style="font-family: var(--th-display); font-size: clamp(24px, 4vw, 36px); color: rgba(255,255,255,0.9); font-weight: 700;">Built for Performance</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 28px;">
        {FEATURES.map(f => (
          <div style="text-align: center; padding: 36px 24px; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(192,168,120,0.08);">
            <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #1c1810, #2e2418); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 20px; box-shadow: 0 6px 20px rgba(0,0,0,0.4); border: 1px solid rgba(192,168,120,0.12);">{f.icon}</div>
            <h3 style="font-size: 15px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 10px;">{f.title}</h3>
            <p style="font-size: 13px; color: rgba(255,255,255,0.36); line-height: 1.8;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FIND A DEALER ═══ -->
  <section style="background: #0d0b08; padding: 0 28px 64px; border-top: 1px solid rgba(192,168,120,0.06);">
    <div style="max-width: 800px; margin: 0 auto; padding-top: 72px;">
      <div style="background: linear-gradient(135deg, rgba(192,168,120,0.06), rgba(139,115,85,0.04)); border: 1px solid rgba(192,168,120,0.12); border-radius: 20px; padding: 48px 32px; text-align: center;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(192,168,120,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 16px;">Islandwide Network</div>
        <h2 style="font-family: var(--th-display); font-size: clamp(22px, 3.5vw, 32px); color: rgba(255,255,255,0.9); font-weight: 700; margin-bottom: 14px;">Find a Megatile Dealer Near You</h2>
        <p style="font-size: 14px; color: rgba(255,255,255,0.38); line-height: 1.9; max-width: 500px; margin: 0 auto 32px;">Megatile products are available through authorised dealers across all 25 districts. Use TilersHub to locate your nearest showroom.</p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
          <a href="/providers?type=tile_shop" style="display: inline-flex; align-items: center; gap: 8px; background: #C0A878; color: #0d0b08; border-radius: 12px; padding: 13px 28px; font-size: 13px; font-weight: 800; text-decoration: none; box-shadow: 0 4px 20px rgba(192,168,120,0.25);">
            🏪 Browse Tile Shops
          </a>
          <a href="https://wa.me/94774503744?text=Hi%2C%20I%27d%20like%20to%20find%20a%20Megatile%20dealer%20in%20my%20area" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 13px 28px; font-size: 13px; font-weight: 700; text-decoration: none;">
            💬 Ask on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section style="background: linear-gradient(135deg, #161210 0%, #0d0b08 100%); padding: 88px 28px; text-align: center; position: relative; overflow: hidden; border-top: 1px solid rgba(192,168,120,0.08);">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(45deg, transparent, transparent 30px, rgba(192,168,120,0.6) 30px, rgba(192,168,120,0.6) 31px); pointer-events: none;"></div>
    <div style="position: relative; max-width: 560px; margin: 0 auto;">
      <div style="font-family: var(--th-display); font-size: clamp(24px, 4vw, 38px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px; line-height: 1.2;">
        Ready to tile your <span style="color: #C0A878;">space?</span>
      </div>
      <p style="font-size: 14px; color: rgba(255,255,255,0.4); margin-bottom: 36px; line-height: 1.9;">Post your project on TilersHub and get matched with verified tilers who install Megatile products.</p>
      <a href="/post-project" style="display: inline-flex; align-items: center; gap: 10px; background: #C0A878; color: #0d0b08; border-radius: 12px; padding: 16px 40px; font-size: 15px; font-weight: 800; text-decoration: none; box-shadow: 0 6px 28px rgba(192,168,120,0.28); letter-spacing: 0.3px;">
        📋 Post My Tiling Project →
      </a>
      <div style="margin-top: 24px; font-size: 11px; color: rgba(255,255,255,0.18);">This is a sponsored page on TilersHub.lk</div>
    </div>
  </section>

</Layout>
