---
import Layout from '../../layouts/Layout.astro'

const MOSAIC = [
  { col: '1 / 3', row: '1 / 2' },
  { col: '3 / 4', row: '1 / 2' },
  { col: '4 / 5', row: '1 / 3' },
  { col: '1 / 2', row: '2 / 4' },
  { col: '2 / 4', row: '2 / 3' },
  { col: '2 / 3', row: '3 / 4' },
  { col: '3 / 5', row: '3 / 4' },
]

const STEPS = [
  { w: '40%', color: '#8AB8D4', shade: '#5A90B8' },
  { w: '60%', color: '#5A90B8', shade: '#3870A0' },
  { w: '80%', color: '#3870A0', shade: '#2060A0' },
  { w: '100%', color: '#2060A0', shade: '#0E3458' },
]

const COLLECTIONS = [
  {
    name: 'Grand Marble',
    mood: 'Pure white marble risers for timeless elegance',
    accent: '#DDDAD4',
    tiles: ['#F8F6F2','#EEEAE4','#F5F2EE','#E0DDD8','#F0EDE8','#D8D5CE','#FAFAF8'],
  },
  {
    name: 'Warm Oak',
    mood: 'Wood-effect treads for a warm modern staircase',
    accent: '#C09068',
    tiles: ['#8B6040','#A07850','#C09068','#7A5030','#B08058','#6A4020','#D0A880'],
  },
  {
    name: 'Anthracite Edge',
    mood: 'Dark matte grey for a minimal architectural look',
    accent: '#606870',
    tiles: ['#404850','#303840','#505860','#282E38','#484C54','#202830','#585C64'],
  },
  {
    name: 'Golden Travertine',
    mood: 'Warm golden stone for a grand entrance statement',
    accent: '#D4AF37',
    tiles: ['#C9952A','#D4AF37','#E8C860','#B8870A','#F0D070','#A07010','#EAC850'],
  },
  {
    name: 'Mediterranean Blue',
    mood: 'Deep cobalt for bold coastal-inspired staircases',
    accent: '#5AAAD8',
    tiles: ['#2C5F8A','#3A7AAA','#4898C8','#1A4870','#5AAAD8','#0E3458','#70B8E0'],
  },
  {
    name: 'Black Pearl',
    mood: 'Deep lustrous black for luxury contemporary homes',
    accent: '#686880',
    tiles: ['#1A1E28','#0E1218','#252A38','#080C18','#2A3040','#040810','#1E2430'],
  },
]

const FEATURES = [
  { icon: '🛡️', title: 'Anti-Slip Tread', desc: 'All staircase floor tiles meet safety standards — rated R11 anti-slip for tread surfaces.' },
  { icon: '✨', title: 'Premium Risers', desc: 'Beautifully finished riser tiles that complement your tread for a cohesive look.' },
  { icon: '🚚', title: 'Free Delivery', desc: 'Complimentary islandwide delivery on all orders above Rs. 50,000.' },
  { icon: '📐', title: 'Precision Cut', desc: 'Staircase tiles cut to your exact measurements — no wasted material.' },
]
---

<Layout title="LUXEhome Staircase Tiling · TilersHub Sponsor">

  <!-- ═══ HERO ═══ -->
  <section style="background: linear-gradient(135deg, #0d1218 0%, #182030 60%, #0d1218 100%); position: relative; overflow: hidden; padding: 80px 28px 72px; text-align: center;">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(138,184,212,0.8) 39px, rgba(138,184,212,0.8) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(138,184,212,0.8) 39px, rgba(138,184,212,0.8) 40px); pointer-events: none;"></div>
    <div style="position: absolute; top: -80px; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(138,184,212,0.1) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="position: relative; max-width: 780px; margin: 0 auto;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: rgba(138,184,212,0.5); letter-spacing: 1px; text-transform: uppercase; font-weight: 600; margin-bottom: 32px; text-decoration: none;">← TilersHub.lk</a>
      <div style="font-size: 9px; font-weight: 700; color: rgba(138,184,212,0.6); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 18px;">◆ Sponsored Partner</div>
      <div style="display: flex; align-items: baseline; gap: 3px; justify-content: center; margin-bottom: 16px;">
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 700; color: #8AB8D4; letter-spacing: -1px; line-height: 1;">LUXE</span>
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 400; color: rgba(255,255,255,0.88); letter-spacing: -1px; line-height: 1;">home</span>
      </div>
      <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(28px, 5vw, 48px); font-weight: 700; color: #8AB8D4; margin-bottom: 16px; line-height: 1.15;">Staircase Tiling</h1>
      <p style="font-size: 15px; color: rgba(255,255,255,0.5); line-height: 1.9; max-width: 500px; margin: 0 auto 36px;">
        Transform your staircase into an architectural feature. Anti-slip tread tiles with premium matching risers.
      </p>

      <!-- Staircase visual -->
      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 5px; max-width: 360px; margin: 0 auto 40px;">
        {STEPS.map(s => (
          <div style={`width: ${s.w}; height: 32px; background: linear-gradient(135deg, ${s.color}, ${s.shade}); border-radius: 6px 6px 0 0; box-shadow: 0 4px 14px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); position: relative; overflow: hidden;`}>
            <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(255,255,255,0.12) 0%, transparent 60%);"></div>
          </div>
        ))}
      </div>

      <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #8AB8D4; color: #0d1218; border-radius: 12px; padding: 15px 36px; font-size: 14px; font-weight: 800; text-decoration: none; letter-spacing: 0.5px; box-shadow: 0 6px 28px rgba(138,184,212,0.3);">
        🛒 Visit LUXEhome.lk
      </a>
      <div style="font-size: 11px; color: rgba(255,255,255,0.25); margin-top: 14px;">You will be redirected to luxehome.lk</div>
    </div>
  </section>

  <!-- ═══ DESIGN SHOWCASE ═══ -->
  <section style="background: #0a0e14; padding: 88px 28px;">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 64px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(138,184,212,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Curated for You</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(26px, 4vw, 40px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px;">Staircase Collections</h2>
        <p style="font-size: 14px; color: rgba(255,255,255,0.38); max-width: 460px; margin: 0 auto; line-height: 1.8;">Six styles to elevate your staircase from functional to extraordinary</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px;">
        {COLLECTIONS.map(col => (
          <div style="background: linear-gradient(160deg, #141a24, #0a0e14); border-radius: 18px; overflow: hidden; border: 1px solid rgba(138,184,212,0.1);">
            <div style="padding: 18px 18px 12px;">
              <div style="display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 1fr); gap: 5px; height: 170px;">
                {MOSAIC.map((pos, i) => (
                  <div style={`grid-column: ${pos.col}; grid-row: ${pos.row}; background: linear-gradient(135deg, ${col.tiles[i]}, ${col.tiles[(i + 3) % 7]}); border-radius: 7px; box-shadow: 0 3px 10px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.12); position: relative; overflow: hidden;`}>
                    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.18) 0%, transparent 55%);"></div>
                  </div>
                ))}
              </div>
            </div>
            <div style="padding: 18px 22px 24px;">
              <div style={`font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: ${col.accent}; margin-bottom: 6px;`}>{col.name}</div>
              <p style="font-size: 12px; color: rgba(255,255,255,0.4); line-height: 1.7; margin-bottom: 18px;">{col.mood}</p>
              <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style={`display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: ${col.accent}; text-decoration: none; letter-spacing: 0.5px; opacity: 0.85;`}>
                View Collection →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURES ═══ -->
  <section style="background: #0a0e14; padding: 0 28px 88px; border-top: 1px solid rgba(138,184,212,0.07);">
    <div style="max-width: 1100px; margin: 0 auto; padding-top: 80px;">
      <div style="text-align: center; margin-bottom: 56px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(138,184,212,0.5); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Why LUXEhome Staircase</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 36px); color: rgba(255,255,255,0.9); font-weight: 700;">Safe, Stylish, Stunning</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 28px;">
        {FEATURES.map(f => (
          <div style="text-align: center; padding: 36px 24px; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(138,184,212,0.08);">
            <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #0d1218, #182030); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 20px; box-shadow: 0 6px 20px rgba(0,0,0,0.3); border: 1px solid rgba(138,184,212,0.15);">{f.icon}</div>
            <h3 style="font-size: 15px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 10px;">{f.title}</h3>
            <p style="font-size: 13px; color: rgba(255,255,255,0.38); line-height: 1.8;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section style="background: linear-gradient(135deg, #0d1218 0%, #0a0e14 100%); padding: 88px 28px; text-align: center; position: relative; overflow: hidden; border-top: 1px solid rgba(138,184,212,0.1);">
    <div style="position: absolute; inset: 0; opacity: 0.025; background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(138,184,212,0.6) 20px, rgba(138,184,212,0.6) 21px); pointer-events: none;"></div>
    <div style="position: relative; max-width: 560px; margin: 0 auto;">
      <div style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 38px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px; line-height: 1.2;">
        Elevate your <span style="color: #8AB8D4;">staircase</span>
      </div>
      <p style="font-size: 14px; color: rgba(255,255,255,0.42); margin-bottom: 36px; line-height: 1.9;">Browse the full staircase tile collection and get a free consultation at luxehome.lk</p>
      <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #8AB8D4; color: #0d1218; border-radius: 12px; padding: 16px 40px; font-size: 15px; font-weight: 800; text-decoration: none; box-shadow: 0 6px 28px rgba(138,184,212,0.3); letter-spacing: 0.3px;">
        🌐 Visit luxehome.lk →
      </a>
      <div style="margin-top: 24px; font-size: 11px; color: rgba(255,255,255,0.18);">This is a sponsored page on TilersHub.lk</div>
    </div>
  </section>

</Layout>
