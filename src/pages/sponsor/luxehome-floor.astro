---
import Layout from '../../layouts/Layout.astro'

const MOSAIC = [
  { col: '1 / 3', row: '1 / 2' },
  { col: '3 / 4', row: '1 / 2' },
  { col: '4 / 5', row: '1 / 3' },
  { col: '1 / 2', row: '2 / 4' },
  { col: '2 / 4', row: '2 / 3' },
  { col: '2 / 3', row: '3 / 4' },
  { col: '3 / 5', row: '3 / 4' },
]

const COLLECTIONS = [
  {
    name: 'Verona Marble',
    mood: 'Classic Italian marble-look for grand living spaces',
    accent: '#D8D5CE',
    tiles: ['#F0EDE8','#E0DDD8','#D0CDC8','#C8C5BE','#E8E5E0','#B8B5AE','#F8F5F0'],
  },
  {
    name: 'Warm Herringbone',
    mood: 'Rich wood-tone herringbone for welcoming entrances',
    accent: '#C09068',
    tiles: ['#8B6040','#A07850','#C09068','#7A5030','#B08058','#6A4020','#D0A880'],
  },
  {
    name: 'Dark Slate',
    mood: 'Charcoal anthracite for contemporary open-plan floors',
    accent: '#5A6068',
    tiles: ['#3C4048','#2A3038','#484C54','#1E2028','#404850','#161820','#505860'],
  },
  {
    name: 'Desert Sand',
    mood: 'Warm sandy beige for bright airy interiors',
    accent: '#D4C4A0',
    tiles: ['#D4C4A0','#C8B890','#E0D0B0','#B8A880','#DCC8A8','#A89870','#ECE0C0'],
  },
  {
    name: 'Midnight Black',
    mood: 'Bold glossy black for a dramatic signature floor',
    accent: '#606060',
    tiles: ['#181818','#222222','#101010','#2A2A2A','#141414','#323232','#1E1E1E'],
  },
  {
    name: 'French Pattern',
    mood: 'Classic terracotta and cream for Mediterranean charm',
    accent: '#C1603A',
    tiles: ['#C1603A','#F5F0E8','#C86040','#E8D8C0','#D07050','#F0E8D8','#B85030'],
  },
]

const FEATURES = [
  { icon: '📐', title: 'Rectified Edges', desc: 'Precision-cut edges allow near-zero grout lines for a seamless modern look.' },
  { icon: '💪', title: 'High Durability', desc: 'Rated for heavy foot traffic — ideal for hallways, kitchens, and living rooms.' },
  { icon: '🚚', title: 'Free Delivery', desc: 'Complimentary islandwide delivery on all orders above Rs. 50,000.' },
  { icon: '🎨', title: 'Expert Sizing', desc: 'Free consultation on tile quantity, format selection, and laying pattern.' },
]
---

<Layout title="LUXEhome Floor Tiling · TilersHub Sponsor">

  <!-- ═══ HERO ═══ -->
  <section style="background: linear-gradient(135deg, #1c1009 0%, #2c1a0e 60%, #1c1009 100%); position: relative; overflow: hidden; padding: 80px 28px 72px; text-align: center;">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(193,96,58,0.8) 39px, rgba(193,96,58,0.8) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(193,96,58,0.8) 39px, rgba(193,96,58,0.8) 40px); pointer-events: none;"></div>
    <div style="position: absolute; top: -80px; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(193,96,58,0.12) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="position: relative; max-width: 680px; margin: 0 auto;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: rgba(193,96,58,0.55); letter-spacing: 1px; text-transform: uppercase; font-weight: 600; margin-bottom: 32px; text-decoration: none;">← TilersHub.lk</a>
      <div style="font-size: 9px; font-weight: 700; color: rgba(193,96,58,0.6); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 18px;">◆ Sponsored Partner</div>
      <div style="display: flex; align-items: baseline; gap: 3px; justify-content: center; margin-bottom: 16px;">
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 700; color: #C1603A; letter-spacing: -1px; line-height: 1;">LUXE</span>
        <span style="font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 400; color: rgba(255,255,255,0.88); letter-spacing: -1px; line-height: 1;">home</span>
      </div>
      <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(28px, 5vw, 48px); font-weight: 700; color: #C1603A; margin-bottom: 16px; line-height: 1.15;">Floor Tiling</h1>
      <p style="font-size: 15px; color: rgba(255,255,255,0.5); line-height: 1.9; max-width: 500px; margin: 0 auto 40px;">
        Large format, herringbone, and classic floor tiles with rectified edges for a seamless finish.
      </p>
      <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #C1603A; color: #fff; border-radius: 12px; padding: 15px 36px; font-size: 14px; font-weight: 800; text-decoration: none; letter-spacing: 0.5px; box-shadow: 0 6px 28px rgba(193,96,58,0.4);">
        🛒 Visit LUXEhome.lk
      </a>
      <div style="font-size: 11px; color: rgba(255,255,255,0.25); margin-top: 14px;">You will be redirected to luxehome.lk</div>
    </div>
  </section>

  <!-- ═══ DESIGN SHOWCASE ═══ -->
  <section style="background: #100a04; padding: 88px 28px;">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 64px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(193,96,58,0.55); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Curated for You</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(26px, 4vw, 40px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px;">Floor Collections</h2>
        <p style="font-size: 14px; color: rgba(255,255,255,0.38); max-width: 460px; margin: 0 auto; line-height: 1.8;">Six carefully curated floor styles — from marble classics to bold contemporary</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px;">
        {COLLECTIONS.map(col => (
          <div style="background: linear-gradient(160deg, #1c1208, #100a04); border-radius: 18px; overflow: hidden; border: 1px solid rgba(193,96,58,0.12);">
            <div style="padding: 18px 18px 12px;">
              <div style="display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 1fr); gap: 5px; height: 170px;">
                {MOSAIC.map((pos, i) => (
                  <div style={`grid-column: ${pos.col}; grid-row: ${pos.row}; background: linear-gradient(135deg, ${col.tiles[i]}, ${col.tiles[(i + 3) % 7]}); border-radius: 7px; box-shadow: 0 3px 10px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.12); position: relative; overflow: hidden;`}>
                    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.18) 0%, transparent 55%);"></div>
                  </div>
                ))}
              </div>
            </div>
            <div style="padding: 18px 22px 24px;">
              <div style={`font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: ${col.accent}; margin-bottom: 6px;`}>{col.name}</div>
              <p style="font-size: 12px; color: rgba(255,255,255,0.4); line-height: 1.7; margin-bottom: 18px;">{col.mood}</p>
              <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style={`display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: ${col.accent}; text-decoration: none; letter-spacing: 0.5px; opacity: 0.85;`}>
                View Collection →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURES ═══ -->
  <section style="background: #100a04; padding: 0 28px 88px; border-top: 1px solid rgba(193,96,58,0.08);">
    <div style="max-width: 1100px; margin: 0 auto; padding-top: 80px;">
      <div style="text-align: center; margin-bottom: 56px;">
        <div style="font-size: 9px; font-weight: 700; color: rgba(193,96,58,0.55); letter-spacing: 3px; text-transform: uppercase; margin-bottom: 14px;">Why LUXEhome Floors</div>
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 36px); color: rgba(255,255,255,0.9); font-weight: 700;">Built to Last, Built to Impress</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 28px;">
        {FEATURES.map(f => (
          <div style="text-align: center; padding: 36px 24px; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(193,96,58,0.08);">
            <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #1c1009, #2c1a0e); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 20px; box-shadow: 0 6px 20px rgba(0,0,0,0.3); border: 1px solid rgba(193,96,58,0.15);">{f.icon}</div>
            <h3 style="font-size: 15px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 10px;">{f.title}</h3>
            <p style="font-size: 13px; color: rgba(255,255,255,0.38); line-height: 1.8;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section style="background: linear-gradient(135deg, #1c1009 0%, #100a04 100%); padding: 88px 28px; text-align: center; position: relative; overflow: hidden; border-top: 1px solid rgba(193,96,58,0.12);">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(193,96,58,0.6) 20px, rgba(193,96,58,0.6) 21px); pointer-events: none;"></div>
    <div style="position: relative; max-width: 560px; margin: 0 auto;">
      <div style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 4vw, 38px); color: rgba(255,255,255,0.92); font-weight: 700; margin-bottom: 14px; line-height: 1.2;">
        Find your perfect <span style="color: #C1603A;">floor tile</span>
      </div>
      <p style="font-size: 14px; color: rgba(255,255,255,0.42); margin-bottom: 36px; line-height: 1.9;">Browse the complete floor tile collection, request samples, and get expert sizing help at luxehome.lk</p>
      <a href="https://luxehome.lk" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 10px; background: #C1603A; color: #fff; border-radius: 12px; padding: 16px 40px; font-size: 15px; font-weight: 800; text-decoration: none; box-shadow: 0 6px 28px rgba(193,96,58,0.4); letter-spacing: 0.3px;">
        🌐 Visit luxehome.lk →
      </a>
      <div style="margin-top: 24px; font-size: 11px; color: rgba(255,255,255,0.18);">This is a sponsored page on TilersHub.lk</div>
    </div>
  </section>

</Layout>
