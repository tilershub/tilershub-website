---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import Dashboard from '../components/Dashboard.jsx'

if (!Astro.locals.user) return Astro.redirect('/login')

const supabase = Astro.locals.supabase
const user = Astro.locals.user

const [{ data: projects }, { data: provider }] = await Promise.all([
  supabase.from('projects').select('*').eq('user_id', user.id).order('created_at', { ascending: false }),
  supabase.from('providers').select('*').eq('user_id', user.id).maybeSingle(),
])

const projectIds = (projects || []).map(p => p.id)
const { data: bids } = projectIds.length
  ? await supabase.from('bids').select('*').in('job_id', projectIds).order('created_at', { ascending: false })
  : { data: [] }
---

<Layout
  title="My Account · TilersHub"
  description="Manage your projects, track bids and connect with providers on TilersHub."
  noindex={true}
>
  <Dashboard
    initialUser={user}
    initialProjects={projects ?? []}
    initialProvider={provider}
    initialBids={bids ?? []}
    client:only="react"
  />
</Layout>
