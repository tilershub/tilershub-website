---
import '../index.css'
import AuthButton from '../components/AuthButton.jsx'
import DraftLinker from '../components/DraftLinker.jsx'

const user = Astro.locals.user

// Active-project badge count is fetched client-side (see script near the
// bottom nav) so no page blocks on a DB round trip just to render the shell.

const {
  title = "TilersHub · Sri Lanka's Tile & Bathroom Marketplace",
  description = "Find tilers, contractors, tile shops, brands and products for your tile and bathroom project across Sri Lanka. Free — no login required.",
  ogImage = 'https://www.tilershub.lk/og.png',
  ogType = 'website',
  noindex = false,
} = Astro.props
const path = Astro.url.pathname
const SITE = 'https://www.tilershub.lk'
const canonicalUrl = `${SITE}${path}`

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'TilersHub',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}/favicon.svg` },
      sameAs: [
        'https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z',
        'https://www.facebook.com/share/g/1Dsc63BvXS/',
      ],
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', areaServed: 'LK' },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'TilersHub',
      description: "Sri Lanka's tiling & home improvement marketplace",
      publisher: { '@id': `${SITE}/#organization` },
      potentialAction: { '@type': 'SearchAction', target: `${SITE}/providers?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
    },
  ],
})
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="theme-color" content="#2563EB" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" href="/sitemap.xml" />
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="TilersHub" />
  <meta property="og:locale" content="en_LK" />
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Structured data -->
  <script type="application/ld+json" set:html={orgSchema} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <!-- iOS PWA startup images (prevents white flash on launch) -->
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1290x2796.png" media="screen and (device-width:430px) and (device-height:932px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1179x2556.png" media="screen and (device-width:393px) and (device-height:852px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1284x2778.png" media="screen and (device-width:428px) and (device-height:926px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1170x2532.png" media="screen and (device-width:390px) and (device-height:844px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-1080x2340.png" media="screen and (device-width:360px) and (device-height:780px) and (-webkit-device-pixel-ratio:3) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-750x1334.png"  media="screen and (device-width:375px) and (device-height:667px) and (-webkit-device-pixel-ratio:2) and (orientation:portrait)" />
  <link rel="apple-touch-startup-image" href="/splash/apple-splash-640x1136.png"  media="screen and (device-width:320px) and (device-height:568px) and (-webkit-device-pixel-ratio:2) and (orientation:portrait)" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="TilersHub" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" /></noscript>
  <slot name="head" />
  <style is:global>
    html:not([data-lang="si"]) .si-text { display: none; }
    html[data-lang="si"] .en-text { display: none; }
  </style>
  <!-- Pre-paint language init: apply stored choice before first render -->
  <script is:inline>
    ;(function(){try{var l=localStorage.getItem('th_lang');if(l)document.documentElement.setAttribute('data-lang',l)}catch(e){}})()
  </script>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MX727MR5');</script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript is:raw><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MX727MR5" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <!-- ═══ PWA SPLASH SCREEN (installed-app launches only — hidden for web/search visitors) ═══ -->
  <style>
    #pwa-splash { display: none; }
    @media all and (display-mode: standalone) {
      #pwa-splash { display: flex; }
    }
  </style>
  <div id="pwa-splash" style="position:fixed;inset:0;z-index:99999;background:#0F172A;flex-direction:column;align-items:center;justify-content:center;gap:20px;transition:opacity 0.45s ease;pointer-events:none;">
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:5px;width:78px;height:78px;">
      {[0,1,2,3,4,5,6,7,8].map((i) => (
        <div style={`border-radius:3px;background:${[1,3,4,5,7].includes(i)?'#8B5E3C':'#5E4130'};opacity:${[0,2,6,8].includes(i)?'0.55':'1'};`}></div>
      ))}
    </div>
    <div style="font-family:'Inter',sans-serif;font-size:20px;font-weight:700;color:rgba(255,255,255,0.9);letter-spacing:1.5px;">TILERS<span style="color:#2563EB;">HUB</span></div>
    <div style="width:32px;height:3px;border-radius:2px;background:rgba(255,255,255,0.15);overflow:hidden;margin-top:4px;">
      <div id="pwa-splash-bar" style="height:100%;width:0;background:#2563EB;border-radius:2px;transition:width 1.2s ease;"></div>
    </div>
  </div>
  <script is:inline>
    ;(function() {
      var splash = document.getElementById('pwa-splash')
      var bar    = document.getElementById('pwa-splash-bar')
      if (!splash) return
      // Start progress bar animation immediately
      if (bar) requestAnimationFrame(function() { bar.style.width = '90%' })
      function dismiss() {
        if (!splash || splash._gone) return
        splash._gone = true
        if (bar) bar.style.width = '100%'
        setTimeout(function() {
          splash.style.opacity = '0'
          setTimeout(function() { if (splash.parentNode) splash.parentNode.removeChild(splash) }, 450)
        }, 120)
      }
      window.addEventListener('load', dismiss)
      // Hard cap: always remove after 3 s even if load never fires
      setTimeout(dismiss, 3000)
    })()
  </script>

  <!-- ═══ WHITE MARKETPLACE HEADER ═══ -->
  <header class="site-header">
    <a href="/" class="site-logo">
      <div class="site-logo-grid">
        {[0,1,2,3,4,5,6,7,8].map(() => <div class="site-logo-tile"></div>)}
      </div>
      <span class="site-logo-mark">TILERS<span>HUB</span></span>
    </a>

    <div class="header-actions">
      <button id="lang-toggle" aria-label="Switch language" style="min-width:40px;height:28px;padding:0 10px;border-radius:20px;border:1.5px solid var(--border);background:#fff;color:var(--text-2);font-size:11px;font-weight:800;letter-spacing:0.5px;cursor:pointer;font-family:inherit;">සිං</button>
      <a href="/providers" class="header-icon-btn header-search-hide" title="Search" aria-label="Search providers">🔍</a>
      <a href="/notifications" class="header-icon-btn" title="Notifications" aria-label="Notifications">🔔</a>
      <AuthButton initialUser={user} client:load />
      <a href="/post-project" class="header-cta">Post Project</a>
      <button class="header-icon-btn" id="hamburger" aria-label="Menu">☰</button>
    </div>
  </header>

  <!-- Mobile drawer overlay -->
  <div class="mobile-drawer-overlay" id="drawer-overlay"></div>
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="drawer-header">
      <span style="font-family: 'Inter', sans-serif;font-size:16px;font-weight:700;color:#fff;">TILERS<span style="color:#2563EB;">HUB</span></span>
      <button id="close-drawer" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:22px;cursor:pointer;padding:4px;">✕</button>
    </div>
    <a href="/" class={`drawer-link${path==='/'?' active':''}`}>🏠 Home</a>
    <a href="/providers?type=tiler" class={`drawer-link${path.startsWith('/providers')?' active':''}`}>👷 Find Tilers</a>
    <a href="/jobs" class={`drawer-link${path==='/jobs'?' active':''}`}>💼 View Projects</a>
    <a href="/tile" class={`drawer-link${path==='/tile'?' active':''}`}>🏪 Tile Shops & Brands</a>
    <a href="/bathrooms" class={`drawer-link${path==='/bathrooms'?' active':''}`} style="color:rgba(255,255,255,0.6);">🚿 Bathroom Products</a>
    <a href="/tools" class={`drawer-link${path==='/tools'?' active':''}`} style="color:rgba(255,255,255,0.6);">🛠️ Tools & Equipment</a>
    <div class="drawer-divider"></div>
    <a href="/post-project" class="drawer-link highlight">📋 Post a Project — Get Quotes</a>
    <a href="/join-tilershub" class="drawer-link" style="color:rgba(255,255,255,0.6);">✅ Join as a Provider</a>
    <div class="drawer-divider"></div>
    <a href="/estimator" class={`drawer-link${path==='/estimator'?' active':''}`}>📐 Cost Calculator</a>
    <a href="/guides" class={`drawer-link${path.startsWith('/guides')?' active':''}`} style="color:rgba(255,255,255,0.6);">📖 Guides</a>
    <a href="/blog" class={`drawer-link${path.startsWith('/blog')?' active':''}`} style="color:rgba(255,255,255,0.6);">📰 Blog & Tips</a>
    <div class="drawer-divider"></div>
    <a href="/about" class={`drawer-link${path==='/about'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">ℹ️ About TilersHub</a>
    <a href="/contact" class={`drawer-link${path==='/contact'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">📬 Contact Us</a>
  </div>

  <!-- Links anonymous drafts/claims to account after sign-in -->
  <DraftLinker client:load />

  <main class="page-wrap">
    <slot />
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="site-footer">
    <div class="footer-inner">
      <!-- Brand -->
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
          <div class="site-logo-grid">{[0,1,2,3,4,5,6,7,8].map(()=><div class="site-logo-tile"></div>)}</div>
          <span style="font-family: 'Inter', sans-serif;font-size:16px;font-weight:700;color:rgba(255,255,255,0.88);">TILERS<strong>HUB</strong></span>
        </div>
        <p class="footer-brand-text">The home of Sri Lanka's tile trade — homeowners post projects free, tilers win work, and shops, brands &amp; suppliers reach customers islandwide.</p>
        <div style="display:flex;gap:10px;margin-top:16px;">
          <a href="https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#25D366;text-decoration:none;">💬 WhatsApp</a>
          <a href="https://www.facebook.com/share/g/1Dsc63BvXS/" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#60a5fa;text-decoration:none;">👥 Facebook</a>
        </div>
      </div>
      <!-- Discover -->
      <div>
        <div class="footer-col-head">Discover</div>
        <nav class="footer-links">
          <a href="/providers?type=tiler">Find Tilers</a>
          <a href="/jobs">View Projects</a>
          <a href="/estimator">Cost Calculator</a>
          <a href="/tile">Tile Shops &amp; Brands</a>
          <a href="/bathrooms">Bathroom Products</a>
          <a href="/tools">Tools &amp; Equipment</a>
          <a href="/services/floor-tiling">Floor Tiling</a>
        </nav>
      </div>
      <!-- Get Started -->
      <div>
        <div class="footer-col-head">Get Started</div>
        <nav class="footer-links">
          <a href="/post-project">Post a Project</a>
          <a href="/join-tilershub">Join as a Provider</a>
          <a href="/account">My Account</a>
        </nav>
      </div>
      <!-- Popular Areas -->
      <div>
        <div class="footer-col-head">Popular Areas</div>
        <nav class="footer-links">
          <a href="/tilers/colombo">Tilers in Colombo</a>
          <a href="/tilers/gampaha">Tilers in Gampaha</a>
          <a href="/tilers/kandy">Tilers in Kandy</a>
          <a href="/tilers/galle">Tilers in Galle</a>
          <a href="/tilers/kurunegala">Tilers in Kurunegala</a>
          <a href="/tilers/kalutara">Tilers in Kalutara</a>
        </nav>
      </div>
      <!-- Company -->
      <div>
        <div class="footer-col-head">Company</div>
        <nav class="footer-links">
          <a href="/blog">Blog &amp; Tips</a>
          <a href="/about">About TilersHub</a>
          <a href="/contact">Contact Us</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2025 <strong>TilersHub</strong> · tilershub.lk · 🇱🇰 Sri Lanka</span>
      <span style="color:rgba(37,99,235,0.5);font-weight:600;">♥ Made in Sri Lanka</span>
    </div>
  </footer>

  <!-- ═══ BOTTOM NAVIGATION (mobile only) ═══ -->
  <nav class="bottom-nav" aria-label="Main navigation">
    <div class="bottom-nav-inner">
      <a href="/" class={`bottom-nav-item${path==='/'?' active':''}`}>
        <span class="bottom-nav-icon">🏠</span>
        Home
      </a>
      <a href="/providers" class={`bottom-nav-item${path.startsWith('/providers')?' active':''}`}>
        <span class="bottom-nav-icon">👥</span>
        Tilers
      </a>
      <a href="/post-project" class="bottom-nav-post" aria-label="Post a project">
        +
      </a>
      <a href="/jobs" class={`bottom-nav-item${path==='/jobs'?' active':''}`}>
        <span class="bottom-nav-icon" style="position:relative;display:inline-block;">
          📋
          <span id="jobs-badge" style="display:none;position:absolute;top:-5px;right:-8px;background:#2563EB;color:#fff;font-size:8px;font-weight:800;border-radius:20px;padding:1px 4px;min-width:14px;text-align:center;line-height:14px;border:1.5px solid #fff;"></span>
        </span>
        Projects
      </a>
      <a href="/account" class={`bottom-nav-item${path==='/account'||path==='/provider'?' active':''}`}>
        <span class="bottom-nav-icon">👤</span>
        Account
      </a>
    </div>
  </nav>

  <script>
    const hamburger = document.getElementById('hamburger')
    const bottomMenu = document.getElementById('bottom-menu-btn')
    const overlay = document.getElementById('drawer-overlay')
    const drawer = document.getElementById('mobile-drawer')
    const closeBtn = document.getElementById('close-drawer')

    function openDrawer() {
      drawer?.classList.add('open')
      overlay?.classList.add('open')
      document.body.style.overflow = 'hidden'
    }
    function closeDrawer() {
      drawer?.classList.remove('open')
      overlay?.classList.remove('open')
      document.body.style.overflow = ''
    }

    hamburger?.addEventListener('click', openDrawer)
    bottomMenu?.addEventListener('click', openDrawer)
    overlay?.addEventListener('click', closeDrawer)
    closeBtn?.addEventListener('click', closeDrawer)
  </script>
  <!-- ═══ FIRST-VISIT LANGUAGE CHOOSER ═══ -->
  <div id="lang-chooser" hidden style="position:fixed;inset:0;z-index:9999;">
    <div id="lang-chooser-bg" style="position:absolute;inset:0;background:rgba(15,23,42,0.55);opacity:0;transition:opacity 0.3s;"></div>
    <div id="lang-chooser-sheet" style="position:absolute;left:0;right:0;bottom:0;background:#fff;border-radius:22px 22px 0 0;padding:26px 22px calc(26px + env(safe-area-inset-bottom,0px));box-shadow:0 -8px 40px rgba(0,0,0,0.2);transform:translateY(100%);transition:transform 0.3s ease;max-width:480px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:18px;">
        <div style="font-size:30px;margin-bottom:8px;">🇱🇰</div>
        <div style="font-size:16px;font-weight:800;color:#0F172A;margin-bottom:4px;">භාෂාව තෝරන්න · Choose your language</div>
        <div style="font-size:12px;color:#64748B;">ඕනෑම වේලාවක ඉහළින් වෙනස් කළ හැක · Change anytime from the top bar</div>
      </div>
      <div style="display:flex;gap:10px;">
        <button data-pick="si" style="flex:1;background:#2563EB;color:#fff;border:none;border-radius:14px;padding:16px 10px;font-size:16px;font-weight:800;cursor:pointer;font-family:inherit;">සිංහල</button>
        <button data-pick="en" style="flex:1;background:#fff;color:#2563EB;border:2px solid #BFDBFE;border-radius:14px;padding:16px 10px;font-size:16px;font-weight:800;cursor:pointer;font-family:inherit;">English</button>
      </div>
    </div>
  </div>

  <script is:inline>
    ;(function(){
      function setLang(l){
        try{localStorage.setItem('th_lang',l)}catch(e){}
        document.documentElement.setAttribute('data-lang',l)
        window.dispatchEvent(new CustomEvent('th-lang',{detail:l}))
        var t=document.getElementById('lang-toggle')
        if(t) t.textContent = l==='si' ? 'EN' : 'සිං'
      }
      window.__thSetLang = setLang

      // Header toggle
      var toggle=document.getElementById('lang-toggle')
      if(toggle){
        var cur=document.documentElement.getAttribute('data-lang')||'en'
        toggle.textContent = cur==='si' ? 'EN' : 'සිං'
        toggle.addEventListener('click',function(){
          var now=document.documentElement.getAttribute('data-lang')||'en'
          setLang(now==='si' ? 'en' : 'si')
        })
      }

      // First-visit chooser
      var stored=null
      try{stored=localStorage.getItem('th_lang')}catch(e){return}
      if(stored) return
      var box=document.getElementById('lang-chooser')
      if(!box) return
      box.hidden=false
      requestAnimationFrame(function(){
        var bg=document.getElementById('lang-chooser-bg')
        var sheet=document.getElementById('lang-chooser-sheet')
        if(bg) bg.style.opacity='1'
        if(sheet) sheet.style.transform='translateY(0)'
      })
      box.querySelectorAll('[data-pick]').forEach(function(btn){
        btn.addEventListener('click',function(){
          setLang(btn.getAttribute('data-pick'))
          var bg=document.getElementById('lang-chooser-bg')
          var sheet=document.getElementById('lang-chooser-sheet')
          if(bg) bg.style.opacity='0'
          if(sheet) sheet.style.transform='translateY(100%)'
          setTimeout(function(){ if(box.parentNode) box.parentNode.removeChild(box) },320)
        })
      })
    })()
  </script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {})
      })
    }
  </script>
  <script>
    // Active-projects badge — fetched client-side so SSR never blocks on it
    import { supabase } from '../lib/supabase.js'
    const badge = document.getElementById('jobs-badge')
    if (badge) {
      supabase.from('projects').select('id', { count: 'exact', head: true }).eq('status', 'active')
        .then(({ count }) => {
          if (count && count > 0) {
            badge.textContent = count > 99 ? '99+' : String(count)
            badge.style.display = 'block'
          }
        })
    }
  </script>
</body>
</html>
