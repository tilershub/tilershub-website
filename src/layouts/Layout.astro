---
import '../index.css'
import AuthButton from '../components/AuthButton.jsx'
const {
  title = "TilersHub · Sri Lanka's Tile & Bathroom Marketplace",
  description = "Find tilers, contractors, tile shops, brands and products for your tile and bathroom project across Sri Lanka. Free — no login required.",
} = Astro.props
const path = Astro.url.pathname
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="TilersHub" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Sinhala:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- ═══ WHITE MARKETPLACE HEADER ═══ -->
  <header class="site-header">
    <a href="/" class="site-logo">
      <div class="site-logo-grid">
        {[0,1,2,3,4,5,6,7,8].map(i => <div class={`site-logo-tile${i===8?' e':''}`}></div>)}
      </div>
      <span class="site-logo-mark">TILERS<span>HUB</span></span>
    </a>

    <div class="header-actions">
      <a href="/providers" class="header-icon-btn" title="Search" aria-label="Search providers">🔍</a>
      <AuthButton client:load />
      <a href="/post-project" class="header-cta">Post Project</a>
      <button class="header-icon-btn" id="hamburger" aria-label="Menu">☰</button>
    </div>
  </header>

  <!-- Mobile drawer overlay -->
  <div class="mobile-drawer-overlay" id="drawer-overlay"></div>
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="drawer-header">
      <span style="font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:#fff;">TILERS<span style="color:#E05A2B;">HUB</span></span>
      <button id="close-drawer" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:22px;cursor:pointer;padding:4px;">✕</button>
    </div>
    <a href="/" class={`drawer-link${path==='/'?' active':''}`}>🏠 Home</a>
    <a href="/providers?type=tiler" class={`drawer-link${path.startsWith('/providers')?' active':''}`}>👷 Find Tilers</a>
    <a href="/jobs" class={`drawer-link${path==='/jobs'?' active':''}`}>💼 Browse Projects</a>
    <a href="/estimator" class={`drawer-link${path==='/estimator'?' active':''}`}>📐 Cost Estimator</a>
    <div class="drawer-divider"></div>
    <a href="/post-project" class="drawer-link highlight">📋 Post a Project — Get Bids</a>
    <a href="/join-tilershub" class="drawer-link" style="color:rgba(255,255,255,0.6);">✅ Join as Provider</a>
    <div class="drawer-divider"></div>
    <a href="/providers?type=workshop" class="drawer-link" style="color:rgba(255,255,255,0.5);font-size:13px;">🏭 Workshops</a>
    <a href="/providers?type=supplier" class="drawer-link" style="color:rgba(255,255,255,0.5);font-size:13px;">📦 Suppliers</a>
    <a href="/providers?type=tile_shop" class="drawer-link" style="color:rgba(255,255,255,0.5);font-size:13px;">🪨 Tile Shops</a>
    <a href="/providers" class="drawer-link" style="color:rgba(255,255,255,0.5);font-size:13px;">🔍 All Categories</a>
    <div class="drawer-divider"></div>
    <a href="/dashboard" class={`drawer-link${path==='/dashboard'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">👤 My Dashboard</a>
    <a href="/about" class={`drawer-link${path==='/about'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">ℹ️ About TilersHub</a>
    <a href="/contact" class={`drawer-link${path==='/contact'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">📬 Contact Us</a>
  </div>

  <main class="page-wrap">
    <slot />
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
          <div class="site-logo-grid">{[0,1,2,3,4,5,6,7,8].map(i=><div class={`site-logo-tile${i===8?' e':''}`}></div>)}</div>
          <span style="font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:rgba(255,255,255,0.88);">TILERS<strong>HUB</strong></span>
        </div>
        <p class="footer-brand-text">Sri Lanka's bidding marketplace for tiling projects — post a job, get bids, choose your tiler. Free for homeowners.</p>
        <div style="display:flex;gap:6px;margin-top:16px;flex-wrap:wrap;">
          <span style="font-size:11px;color:rgba(255,255,255,0.28);background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);padding:3px 10px;border-radius:8px;">🇱🇰 Sri Lanka</span>
          <span style="font-size:11px;color:rgba(255,255,255,0.28);background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);padding:3px 10px;border-radius:8px;">✓ Free Service</span>
          <span style="font-size:11px;color:rgba(255,255,255,0.28);background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);padding:3px 10px;border-radius:8px;">💬 Bid System</span>
        </div>
      </div>
      <div>
        <div class="footer-col-head">Discover</div>
        <nav class="footer-links">
          <a href="/providers?type=tiler">👷 Find Tilers</a>
          <a href="/jobs">💼 Browse Projects</a>
          <a href="/estimator">📐 Cost Estimator</a>
          <a href="/providers?type=workshop">🏭 Workshops</a>
          <a href="/providers?type=supplier">📦 Suppliers</a>
          <a href="/providers?type=tile_shop">🪨 Tile Shops</a>
        </nav>
      </div>
      <div>
        <div class="footer-col-head">Get Started</div>
        <nav class="footer-links">
          <a href="/post-project">📋 Post a Project</a>
          <a href="/join-tilershub">✅ Join as Provider</a>
          <a href="/dashboard">👤 Dashboard</a>
          <a href="/about">ℹ️ About Us</a>
          <a href="/contact">📬 Contact</a>
        </nav>
        <div style="margin-top:16px;border-top:1px solid rgba(255,255,255,0.08);padding-top:14px;">
          <div style="font-size:9px;font-weight:700;color:rgba(255,255,255,0.3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px;">Join the Community</div>
          <a href="https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:rgba(37,211,102,0.1);border:1px solid rgba(37,211,102,0.2);border-radius:10px;text-decoration:none;margin-bottom:8px;">
            <span style="font-size:18px;">💬</span>
            <div>
              <div style="font-size:12px;font-weight:700;color:#25D366;">WhatsApp Group</div>
              <div style="font-size:10px;color:rgba(255,255,255,0.35);">Tilers &amp; homeowners</div>
            </div>
          </a>
          <a href="https://www.facebook.com/share/g/1Dsc63BvXS/" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:rgba(24,119,242,0.1);border:1px solid rgba(24,119,242,0.2);border-radius:10px;text-decoration:none;">
            <span style="font-size:18px;">👥</span>
            <div>
              <div style="font-size:12px;font-weight:700;color:#60a5fa;">Facebook Group</div>
              <div style="font-size:10px;color:rgba(255,255,255,0.35);">Share projects &amp; tips</div>
            </div>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2025 <strong>TilersHub</strong> · tilershub.lk</span>
      <span style="color:rgba(245,158,11,0.5);font-weight:600;">Made with ♥ in Sri Lanka</span>
    </div>
  </footer>

  <!-- ═══ BOTTOM NAVIGATION (mobile only) ═══ -->
  <nav class="bottom-nav" aria-label="Main navigation">
    <div class="bottom-nav-inner">
      <a href="/" class={`bottom-nav-item${path==='/'?' active':''}`}>
        <span class="bottom-nav-icon">🏠</span>
        Home
      </a>
      <a href="/providers?type=tiler" class={`bottom-nav-item${path.startsWith('/providers')?' active':''}`}>
        <span class="bottom-nav-icon">👷</span>
        Tilers
      </a>
      <a href="/post-project" class="bottom-nav-item bottom-nav-post">
        <span class="bottom-nav-post-icon">📋</span>
        Post
      </a>
      <a href="/jobs" class={`bottom-nav-item${path==='/jobs'?' active':''}`}>
        <span class="bottom-nav-icon">💼</span>
        Projects
      </a>
      <a href="/dashboard" class={`bottom-nav-item${path==='/dashboard'?' active':''}`}>
        <span class="bottom-nav-icon">👤</span>
        Account
      </a>
    </div>
  </nav>

  <script>
    const hamburger = document.getElementById('hamburger')
    const bottomMenu = document.getElementById('bottom-menu-btn')
    const overlay = document.getElementById('drawer-overlay')
    const drawer = document.getElementById('mobile-drawer')
    const closeBtn = document.getElementById('close-drawer')

    function openDrawer() {
      drawer?.classList.add('open')
      overlay?.classList.add('open')
      document.body.style.overflow = 'hidden'
    }
    function closeDrawer() {
      drawer?.classList.remove('open')
      overlay?.classList.remove('open')
      document.body.style.overflow = ''
    }

    hamburger?.addEventListener('click', openDrawer)
    bottomMenu?.addEventListener('click', openDrawer)
    overlay?.addEventListener('click', closeDrawer)
    closeBtn?.addEventListener('click', closeDrawer)
  </script>
</body>
</html>
