---
import '../index.css'
import AuthButton from '../components/AuthButton.jsx'
import DraftLinker from '../components/DraftLinker.jsx'
import { supabase } from '../lib/supabase.js'

const { count: activeProjectCount } = await supabase
  .from('projects')
  .select('id', { count: 'exact', head: true })
  .eq('status', 'active')

const {
  title = "TilersHub · Sri Lanka's Tile & Bathroom Marketplace",
  description = "Find tilers, contractors, tile shops, brands and products for your tile and bathroom project across Sri Lanka. Free — no login required.",
  ogImage = 'https://www.tilershub.lk/og.png',
  noindex = false,
} = Astro.props
const path = Astro.url.pathname
const SITE = 'https://www.tilershub.lk'
const canonicalUrl = `${SITE}${path}`

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'TilersHub',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}/favicon.svg` },
      sameAs: [
        'https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z',
        'https://www.facebook.com/share/g/1Dsc63BvXS/',
      ],
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', areaServed: 'LK' },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'TilersHub',
      description: "Sri Lanka's tiling & home improvement marketplace",
      publisher: { '@id': `${SITE}/#organization` },
      potentialAction: { '@type': 'SearchAction', target: `${SITE}/providers?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
    },
  ],
})
---
<!DOCTYPE html>
<html lang="si">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="theme-color" content="#1B3A6B" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" href="/sitemap.xml" />
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="TilersHub" />
  <meta property="og:locale" content="en_LK" />
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Structured data -->
  <script type="application/ld+json" set:html={orgSchema} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Sinhala:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <slot name="head" />
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MX727MR5');</script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript is:raw><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MX727MR5" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <!-- ═══ WHITE MARKETPLACE HEADER ═══ -->
  <header class="site-header">
    <a href="/" class="site-logo">
      <div class="site-logo-grid">
        {[0,1,2,3,4,5,6,7,8].map(i => <div class={`site-logo-tile${i===8?' e':''}`}></div>)}
      </div>
      <span class="site-logo-mark">TILERS<span>HUB</span></span>
    </a>

    <div class="header-actions">
      <a href="/providers" class="header-icon-btn header-search-hide" title="Search" aria-label="Search providers">🔍</a>
      <a href="/notifications" class="header-icon-btn" title="Notifications" aria-label="Notifications">🔔</a>
      <AuthButton client:load />
      <a href="/post-project" class="header-cta">ව්‍යාපෘතිය ලිය කරන්න</a>
      <button class="header-icon-btn" id="hamburger" aria-label="Menu">☰</button>
    </div>
  </header>

  <!-- Mobile drawer overlay -->
  <div class="mobile-drawer-overlay" id="drawer-overlay"></div>
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="drawer-header">
      <span style="font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:#fff;">TILERS<span style="color:#E05A2B;">HUB</span></span>
      <button id="close-drawer" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:22px;cursor:pointer;padding:4px;">✕</button>
    </div>
    <a href="/" class={`drawer-link${path==='/'?' active':''}`}>🏠 මුල් පිටුව</a>
    <a href="/providers?type=tiler" class={`drawer-link${path.startsWith('/providers')?' active':''}`}>👷 ටයිලර් සොයන්න</a>
    <a href="/jobs" class={`drawer-link${path==='/jobs'?' active':''}`}>💼 ව්‍යාපෘති බලන්න</a>
    <a href="/estimator" class={`drawer-link${path==='/estimator'?' active':''}`}>📐 පිරිවැය ගණනය</a>
    <div class="drawer-divider"></div>
    <a href="/post-project" class="drawer-link highlight">📋 ව්‍යාපෘතිය ලිය කරන්න — ලංසු ලබා ගන්න</a>
    <a href="/join-tilershub" class="drawer-link" style="color:rgba(255,255,255,0.6);">✅ සේවා සපයන්නෙකු ලෙස එකතු වන්න</a>
    <div class="drawer-divider"></div>
    <a href="/providers" class="drawer-link" style="color:rgba(255,255,255,0.5);font-size:13px;">🔍 සියලු සේවා සපයන්නන්</a>
    <div class="drawer-divider"></div>
    <a href="/dashboard" class={`drawer-link${path==='/dashboard'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">👤 මගේ උපකරණ පුවරුව</a>
    <a href="/about" class={`drawer-link${path==='/about'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">ℹ️ TilersHub ගැන</a>
    <a href="/contact" class={`drawer-link${path==='/contact'?' active':''}`} style="color:rgba(255,255,255,0.5);font-size:13px;">📬 අප අමතන්න</a>
  </div>

  <!-- Links anonymous drafts/claims to account after magic-link sign-in -->
  <DraftLinker client:load />

  <main class="page-wrap">
    <slot />
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="site-footer">
    <div class="footer-inner">
      <!-- Brand -->
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
          <div class="site-logo-grid">{[0,1,2,3,4,5,6,7,8].map(i=><div class={`site-logo-tile${i===8?' e':''}`}></div>)}</div>
          <span style="font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:rgba(255,255,255,0.88);">TILERS<strong>HUB</strong></span>
        </div>
        <p class="footer-brand-text">ශ්‍රී ලංකාවේ ටයිල් සහ නිවාස ප්‍රතිසංස්කරණ වෙළඳ පොළ — ව්‍යාපෘතිය ලිය කරන්න, ලංසු ලබා ගන්න, ඔබේ ප්‍රවීණයා තෝරා ගන්න. නිවාස හිමිකරුවන්ට නොමිලේ.</p>
        <div style="display:flex;gap:10px;margin-top:16px;">
          <a href="https://chat.whatsapp.com/IR9ZWyFj7ZN15KeOHqwG3Z" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#25D366;text-decoration:none;">💬 WhatsApp</a>
          <a href="https://www.facebook.com/share/g/1Dsc63BvXS/" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#60a5fa;text-decoration:none;">👥 Facebook</a>
        </div>
      </div>
      <!-- Discover -->
      <div>
        <div class="footer-col-head">සොයා ගන්න</div>
        <nav class="footer-links">
          <a href="/providers?type=tiler">ටයිලර් සොයන්න</a>
          <a href="/jobs">ව්‍යාපෘති බලන්න</a>
          <a href="/estimator">පිරිවැය ගණනය</a>
          <a href="/providers">සියලු සේවා සපයන්නන්</a>
          <a href="/services/bathroom-renovation">නාන කාමර ප්‍රතිසංස්කරණ</a>
          <a href="/services/floor-tiling">බිම් ටයිල්</a>
        </nav>
      </div>
      <!-- Get Started -->
      <div>
        <div class="footer-col-head">ආරම්භ කරන්න</div>
        <nav class="footer-links">
          <a href="/post-project">ව්‍යාපෘතිය ලිය කරන්න</a>
          <a href="/join-tilershub">සේවා සපයන්නෙකු ලෙස එකතු වන්න</a>
          <a href="/dashboard">මගේ උපකරණ පුවරුව</a>
        </nav>
      </div>
      <!-- Company -->
      <div>
        <div class="footer-col-head">සමාගම</div>
        <nav class="footer-links">
          <a href="/blog">බ්ලොග් සහ ඉඟි</a>
          <a href="/about">TilersHub ගැන</a>
          <a href="/contact">අප අමතන්න</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2025 <strong>TilersHub</strong> · tilershub.lk · 🇱🇰 ශ්‍රී ලංකා</span>
      <span style="color:rgba(245,158,11,0.5);font-weight:600;">♥ ශ්‍රී ලංකාවේ නිර්මාණය</span>
    </div>
  </footer>

  <!-- ═══ BOTTOM NAVIGATION (mobile only) ═══ -->
  <nav class="bottom-nav" aria-label="Main navigation">
    <div class="bottom-nav-inner">
      <a href="/" class={`bottom-nav-item${path==='/'?' active':''}`}>
        <span class="bottom-nav-icon">🏠</span>
        මුල් පිටුව
      </a>
      <a href="/providers" class={`bottom-nav-item${path.startsWith('/providers')?' active':''}`}>
        <span class="bottom-nav-icon">👥</span>
        සේවා සපයන්නන්
      </a>
      <a href="/post-project" class="bottom-nav-post" aria-label="Post a project">
        +
      </a>
      <a href="/jobs" class={`bottom-nav-item${path==='/jobs'?' active':''}`}>
        <span class="bottom-nav-icon" style="position:relative;display:inline-block;">
          📋
          {activeProjectCount != null && activeProjectCount > 0 && (
            <span style="position:absolute;top:-5px;right:-8px;background:#E05A2B;color:#fff;font-size:8px;font-weight:800;border-radius:20px;padding:1px 4px;min-width:14px;text-align:center;line-height:14px;border:1.5px solid #fff;">{activeProjectCount > 99 ? '99+' : activeProjectCount}</span>
          )}
        </span>
        ව්‍යාපෘති
      </a>
      <a href="/dashboard" class={`bottom-nav-item${path==='/dashboard'?' active':''}`}>
        <span class="bottom-nav-icon">👤</span>
        පැතිකඩ
      </a>
    </div>
  </nav>

  <script>
    const hamburger = document.getElementById('hamburger')
    const bottomMenu = document.getElementById('bottom-menu-btn')
    const overlay = document.getElementById('drawer-overlay')
    const drawer = document.getElementById('mobile-drawer')
    const closeBtn = document.getElementById('close-drawer')

    function openDrawer() {
      drawer?.classList.add('open')
      overlay?.classList.add('open')
      document.body.style.overflow = 'hidden'
    }
    function closeDrawer() {
      drawer?.classList.remove('open')
      overlay?.classList.remove('open')
      document.body.style.overflow = ''
    }

    hamburger?.addEventListener('click', openDrawer)
    bottomMenu?.addEventListener('click', openDrawer)
    overlay?.addEventListener('click', closeDrawer)
    closeBtn?.addEventListener('click', closeDrawer)
  </script>
</body>
</html>
